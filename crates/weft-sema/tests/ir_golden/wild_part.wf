// A pattern `_` over a part (`docs/ir.md` 5.1.3, 5.13): over a linear part of
// a value that the `let` or the arm takes, `t := move p.k; Dead(t)`. Over a
// part with no linear part, nothing.

linear struct Lock { id: u64 }

// The `let` takes the value: the linear part moves into a temporary and
// ends there.
fn let_wild(t: (Lock, u64)) -> u64 {
    let (_, n) = t
    n
}

// The arm takes the value (it moves `v`): the linear part ends.
fn arm_wild(o: Option<(Vec<u64>, Lock)>, d: Vec<u64>) -> Vec<u64> {
    match o {
        Some((v, _)) => v,
        None => d,
    }
}

// The arm takes nothing: the value stays in the place.
fn arm_keeps(o: Option<(u64, Lock)>) -> u64 {
    match o {
        Some((n, _)) => n,
        None => 0,
    }
}

// A part with no linear part: nothing.
fn plain_wild(t: (Vec<u64>, u64)) -> u64 {
    let (_, n) = t
    n
}
