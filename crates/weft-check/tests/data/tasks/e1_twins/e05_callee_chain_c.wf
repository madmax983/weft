// E-1 (clean twin): the outer callee fails after the inner callee joined
fn inner(t: Task<()>) / async { t.join() }
fn outer(t: Task<()>, c: bool) / fail, async { inner(t); if c { fail("stop") } }
fn main() / async, clock {
    let v = Vec.new()
    v.push(1)
    scope { s =>
        let t = s.spawn(|| v.push(2))
        sleep(1.ms)
        handle Fail { fn fail(m) { print(m) } } in { outer(t, true) }
        v.push(3)
    }
}
