// Plan stage R0k-b2: the clause of `Run` spawns `f`, a closure that
// performs through the local handler of `Note`. The task runs outside the
// handled body of `Note` (W0313, and W0314 for the task).
effect Note { fn note(x: u64) }
effect Run { fn run(f: fn()) }
fn mk() -> fn(fn()) / Run { |g: fn()| run(g) }
fn from_maker() / async {
    handle Run {
        fn run(f) {
            scope { s => s.spawn(f) }   //~ W0314
            resume(())
        }
    } in {
        let c = mk()
        handle Note { fn note(x) { print(x)   //~ W0313
            resume(()) } } in c(|| note(2))
    }
}
fn main() / async { from_maker() }
