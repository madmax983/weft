// The `detach` control of F3-6 (N1 of `r3/issues.md`): `detach` drops the
// linear result of the task, one W0601, and no W0602 at the later end of
// the scope.
linear struct Tx { id: u64 }
fn begin() -> Tx { Tx { id: 1 } }
fn main() / async {
    scope { s =>
        let t = s.spawn(|| begin())
        t.detach() //~ W0601
    }
}
