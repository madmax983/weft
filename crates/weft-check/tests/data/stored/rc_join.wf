// The W0204 store check through a reference that can reach more than one
// `rc` object (class AB-RC1-join of the final check of group C). The store
// can go into the object of the caller, and the reference points into a
// local object that goes away at the return.
struct Cache { refs: Vec<&u64>, data: Vec<u64> }
fn newc() -> Rc<Cache> { Rc.new(Cache { refs: Vec.new(), data: Vec.new() }) }

// A join of a reference to the handle of the caller and to a local handle.
fn join(c: Rc<Cache>, b: bool) / mut(Cache) {
    let d = newc()
    d.data.push(1)
    let x = if b { &c } else { &d }
    x.refs.push(&d.data[0])   //~ W0204
}
// The same through the payload of an `Option`.
fn option_join(c: Rc<Cache>, b: bool) / mut(Cache) {
    let d = newc()
    d.data.push(1)
    let o = if b { Some(&c) } else { Some(&d) }
    match o { Some(x) => x.refs.push(&d.data[0]), None => {} }   //~ W0204
}
// A reference variable that a loop gives a new value.
fn loop_join(c: Rc<Cache>) / mut(Cache) {
    let d = newc()
    d.data.push(1)
    let x = &d
    let i = 0
    while i < 2 {
        x.refs.push(&d.data[0])   //~ W0204
        x = &c
        i += 1
    }
}

// Controls: each handle of the store is the handle of the local object.
fn local_only(b: bool) {
    let d = newc()
    d.data.push(1)
    let x = if b { &d } else { &d }
    x.refs.push(&d.data[0])
}
fn caller_only(c: Rc<Cache>, b: bool) / mut(Cache) {
    c.data.push(1)
    let x = if b { &c } else { &c }
    x.refs.push(&c.data[0])
}
fn main() / mut(Cache) {
    let c = newc()
    join(c, false)
    local_only(true)
}
