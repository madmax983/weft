// A closure that leaves the body (a result, a heap slot) keeps the cell of each
// `Kept` variable: it sees the value of the variable at the return (stage F13,
// `factgen::kept_escapes`; class K3 of stage F12).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
struct Holder { f: fn() }
fn mkw(n: i32) -> World {
    let w = World { entities: Vec.new() }
    w.entities.push(Entity { hp: n })
    w
}
// The variable gets a reference into a local after the closure is made.
fn mk_local(a: &World) -> fn() {
    let r = &a.entities[0]
    let f = || print(r.hp)
    let w = mkw(3)
    r = &w.entities[0]
    f   //~ W0204
}
fn store_late(h: &Holder, a: &World) / mut(h.f) {
    let r = &a.entities[0]
    h.f = || print(r.hp)   //~ W0204
    let w = mkw(3)
    r = &w.entities[0]
}
// Controls: a new value into a parameter, and a new value before the closure.
fn mk_param(a: &World, b: &World) -> fn() {
    let r = &a.entities[0]
    let f = || print(r.hp)
    r = &b.entities[0]
    f
}
fn store_param(h: &Holder, a: &World, b: &World) / mut(h.f) {
    let r = &a.entities[0]
    h.f = || print(r.hp)
    r = &b.entities[0]
}
fn main() {
    let a = mkw(1)
    let b = mkw(2)
    let f = mk_param(&a, &b)
    f()
    let h = Holder { f: || print(0) }
    store_param(&h, &a, &b)
    let g = h.f
    g()
}
