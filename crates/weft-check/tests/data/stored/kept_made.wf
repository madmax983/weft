// A closure that a closure of the body makes shares the variables that its
// makers keep (class K3-Made of the review of stage F13): when it leaves the
// body, it sees the value of each such variable at the return.
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
struct Holder { f: fn() }
fn mkw(n: i32) -> World {
    let w = World { entities: Vec.new() }
    w.entities.push(Entity { hp: n })
    w
}
// A new value of `r` into a local after the maker runs.
fn made_ret(a: &World) -> fn() {
    let r = &a.entities[0]
    let m = || || print(r.hp)
    let g = m()
    let w = mkw(3)
    r = &w.entities[0]
    g   //~ W0204
}
// The same with a parameter: the result points into `b` too.
fn made_ret_param(a: &World, b: &World) -> fn() {
    let r = &a.entities[0]
    let m = |x: i32| || print(r.hp + x)
    let g = m(1)
    r = &b.entities[0]
    g
}
// Into a heap slot of a parameter.
fn made_slot(a: &World, h: &Holder) / mut(h.f) {
    let r = &a.entities[0]
    let m = || || print(r.hp)   //~ W0204
    h.f = m()
    let w = mkw(3)
    r = &w.entities[0]
}
fn main() {
    let a = mkw(1)
    let b = mkw(2)
    let f = made_ret_param(&a, &b)
    b.entities.clear()
    f()   //~ W0301
}
