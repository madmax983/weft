// b14s/s09
fn ro_s09(o: Option<&Vec<fn()>>) { match o { Some(v) => run(v[0]), None => {} } }
fn s09() {
    let b = mkbuf()
    let fs = Vec.new()
    fs.push(|| print(b.items.len()))
    let i = 0
    while i < 2 { ro_s09(Some(&fs)); i += 1 }
}
