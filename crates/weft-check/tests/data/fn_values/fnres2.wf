// Map N2 (tests/gate/probes/ir/work/map/fnres2.wf): the result of code of a
// caller points into the places of the callers, and a second run changes them.
fn body(f: fn(bool) -> &u64) {
    let r = f(false)
    let s = f(true)
    print(r)   //~ W0301
    print(s)
}

fn main() {
    let v = Vec.new()
    v.push(1)
    body(|b| {
        if b { v.push(2) }
        &v[0]
    })
}
