// D-CONT-RUN: as cont_run_callee.wf with a `multi` operation.
effect Pick { multi fn pick() -> bool }
fn g(v: &Vec<i64>) / Pick, mut(v) {
    let b = pick()
    if b { v.clear() }
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { let y = &v[0]; resume(true); print(y + 1); resume(false) } } in { //~ W0301
        g(&v)
    }
}
