// A callee runs the closure: the clause keeps a reference into a variable of
// `main`, which stays valid.
effect Keep { fn keep(r: &i64) }
fn twice(f: fn()) { f(); f() }
fn main() {
    let v = Vec.new()
    v.push(1)
    let o: Option<&i64> = None
    handle Keep { fn keep(r) { o = Some(r); resume(()) } } in {
        twice(|| keep(&v[0]))
    }
    match o { Some(x) => print(x + 1), None => {} }
}
