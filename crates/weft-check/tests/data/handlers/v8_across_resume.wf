// V035 v8: the clause holds a reference into its parameter across `resume`,
// and the handled body changes the place.
effect Bump { fn bump(v: &Vec<u64>) }

fn main() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    handle Bump {
        fn bump(x) {
            let e = &x[0]
            resume(())
            print(e) //~ W0301
        }
    } in {
        bump(&v)
        v.clear()
    }
}
