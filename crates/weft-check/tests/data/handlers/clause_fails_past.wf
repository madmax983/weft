// A clause fails past its handler: the abort starts at the node of the
// handled body that runs the clause, and the frames of the handled body and
// of the site unwind. A linear value with no `on abort` that is live there
// is W0602.
linear struct Tok { id: u64 }
effect Ask { fn ask() -> u64 }

fn past() / fail {
    let t = Tok { id: 1 }
    let r = handle Ask { fn ask() { fail("x"); 0 } } in ask() //~ W0602
    let Tok(i) = t
    print(r + i)
}

fn to_outer() {
    handle Fail { fn fail(m) { print("caught", m) } } in {
        let t = Tok { id: 1 }
        let r = handle Ask { fn ask() { fail("x"); resume(0) } } in ask() //~ W0602
        let Tok(i) = t
        print(r + i)
    }
}

fn clean() / fail {
    let r = handle Ask { fn ask() { fail("x"); 0 } } in ask()
    let t = Tok { id: 1 }
    let Tok(i) = t
    print(r + i)
}

fn main() / fail {
    clean()
    to_outer()
    past()
}
