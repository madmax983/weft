// FP-OWN: a reference into a local of the clause across its own `resume` stays valid.
effect Op { fn op() }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Op { fn op() { let loc = Vec.new(); loc.push(7); let y = &loc[0]; resume(()); print(y + 1) } } in {
        op()
        v.clear()
    }
}
