// The value of a clause that ends with no `resume` is a closure that captures a
// local of the clause; the function runs it after the `handle`.
effect Ask { fn ask() -> u64 }
fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v }
fn main() {
    let f = handle Ask { fn ask() { let v = mk_v(); || print(v.len()) } } in { let k = ask(); || print(k) }
    f()
}
