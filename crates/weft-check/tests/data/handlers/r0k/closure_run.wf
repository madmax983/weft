// Stage R0k-a: the perform is in a closure that the callee makes and runs.
// The copy of the callee does not copy the closure body at its run node
// (stage R0k-a2), so the D3 form keeps the old pipeline.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn run_ref(c: &C) / Get {
    let r = &c.v[0]
    let k = || { let g = get()
        g() }
    k()
    print(r)
}
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    handle Get { fn get() { resume(|| c.v.clear()) } } in { run_ref(&c) }
}
