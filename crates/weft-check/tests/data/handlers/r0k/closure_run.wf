// Stage R0k-a2: the perform is in a closure that the callee makes and runs.
// The copy of the callee has the closure, and the run of the closure gets a
// copy of its body (W0301).
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn run_ref(c: &C) / Get {
    let r = &c.v[0]
    let k = || { let g = get()
        g() }
    k()
    print(r)
}
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    handle Get { fn get() { resume(|| c.v.clear()) } } in { run_ref(&c) }
}
