// An operation gets a `once` closure (it moves a vector), and the clause of
// the caller runs it two times.
effect Run { fn run(g: fn()) }
fn eat(v: Vec<u64>) { print(v.len()) }
fn f() / Run {
    let v = Vec.new()
    v.push(1)
    run(|| eat(v))
}
fn main() {
    handle Run { fn run(g) { g(); g(); resume(()) } } in { f() }
}
