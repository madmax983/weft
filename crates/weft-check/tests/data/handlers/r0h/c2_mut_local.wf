// An operation of a handler of a caller gets a closure that changes a local
// of the callee. The clause is code of a caller: it can run the closure on
// another task while the callee reads the local.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn f() / Run {
    let st = Stats { count: 0 }
    run(|| { st.count += 1 })
    print(st.count)
}
fn main() {
    handle Run { fn run(g) { g(); g(); resume(()) } } in { f() }
}
