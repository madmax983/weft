// A callee gives a closure to an operation of a local handler of its caller.
// The clause runs it two times: the closure moves a vector of the callee.
effect Run { fn run(g: fn()) }
fn eat(v: Vec<u64>) { print(v.len()) }
fn f() / Run {
    let v = Vec.new()
    v.push(1)
    run(|| eat(v))
}
fn main() {
    handle Run { fn run(g) { g(); g(); resume(()) } } in { f() }
}
