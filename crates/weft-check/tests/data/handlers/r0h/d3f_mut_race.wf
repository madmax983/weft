// The clause gives the callee a closure that clears a vector of the site;
// the callee runs it while the site holds a reference into the vector. The
// value can race: the old pipeline checks the program (stage R0h).
effect Get { fn get() -> fn() }
fn run_it() / Get { let g = get(); g() }
fn main() {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    handle Get { fn get() { resume(|| v.clear()) } } in { run_it() }
    print(r)
}
