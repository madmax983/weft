// The clause gives a reference into a local of the site; a callee of the
// callee changes the place through it while the site holds a reference.
struct Counter { items: Vec<u64> }
effect PickC { fn pick_c() -> &Counter }
fn clear_picked() / PickC {
    let r = pick_c()
    r.items.clear()
}
fn outer() / PickC { clear_picked() }
fn main() {
    let c = Counter { items: Vec.new() }
    c.items.push(5)
    let first = &c.items[0]
    handle PickC { fn pick_c() { resume(&c) } } in outer()
    print(first)
}
