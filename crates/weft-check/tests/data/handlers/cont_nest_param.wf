// D-CONT-NEST: as cont_nest.wf, the reference is the parameter of the outer clause.
effect Peek { fn peek(x: &i64) }
effect Op { fn op() }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Peek { fn peek(x) { resume(()); print(x + 1) } } in { //~ W0301
        handle Op { fn op() { peek(&v[0]); resume(()) } } in {
            op()
        }
        v.clear()
    }
}
