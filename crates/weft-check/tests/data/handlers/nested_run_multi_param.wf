// Issue #56 (stage C1): a closure runs a function parameter of its maker. The body does not know the value, and its row has a `multi` operation: the run of the closure can resume more than once.
effect Pick { multi fn pick() -> bool }
linear struct Tx { id: u64 }
fn commit(t: Tx) { let Tx(i) = t; print("commit {i}") }
fn choose() / Pick { let b = pick(); print(b) }
fn apply(f: fn() / Pick) / Pick { f() }
fn outer(h: fn() / Pick) / Pick {
    let tx = Tx { id: 1 }
    let g = || h()
    apply(g)   //~ W0503 W0602
    commit(tx)
}
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        outer(choose)
    }
}
