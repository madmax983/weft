// Hole C1-HA of stage C1.6: a `once` closure from a call result is live across a value that resumes two times. With a value that does not resume two times, there is no error.
effect Pick { multi fn pick() -> bool }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn picky() / Pick { if pick() { print(1) } }
fn quiet() { print(1) }
struct Slot { f: fn() }
fn mkb(g: fn()) -> Box<Slot> { Box.new(Slot { f: g }) }
fn body() / Pick {
    let v = [1]
    let g = || print(take_v(v))
    let b = mkb(g)
    quiet()
    let h = b.f
    h()
}
fn main() { handle Pick { fn pick() { resume(true); resume(false) } } in body() }
