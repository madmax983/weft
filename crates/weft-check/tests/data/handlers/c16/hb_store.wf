// Hole C1-HB of stage C1.6: a struct that gets a `once` closure by a store is live across a value that resumes two times.
effect Pick { multi fn pick() -> bool }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn picky() / Pick { if pick() { print(1) } }
fn quiet() { print(1) }
struct Slot { o: Option<fn()> }
fn body() / Pick {
    let v = [1]
    let s = Slot { o: None }
    s.o = Some(|| print(take_v(v)))
    picky()   //~ W0503
    match s.o { Some(k) => k(), None => {} }
}
fn main() { handle Pick { fn pick() { resume(true); resume(false) } } in body() }
