// D-MULTI-MID (F17.1): the holder is the frame of a closure that the handled body runs.
effect Pick { multi fn pick() -> bool }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(true); v.clear(); resume(false) } } in {
        let f = || {
            let r = &v[0]
            let b = pick()
            print(r + 1)
        }
        f()   //~ W0301
    }
}
