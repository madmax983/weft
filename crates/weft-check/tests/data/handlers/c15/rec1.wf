// Stage C1.5 review: a once closure runs after a value that can resume two times.
effect Pick { multi fn pick() -> bool }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn f(m: fn(), g: fn(), n: u64) { if n == 0 { m(); g() } else { f(m, g, n - 1) } }
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let v = [1]
        f(|| { if pick() { print(1) } }, || print(take_v(v)), 2)   //~ W0502 W0503
    }
}
