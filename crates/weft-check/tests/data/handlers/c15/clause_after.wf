// Stage C1.5: a row in a clause body stays with the old pipeline (group D fallback).
effect Pick { multi fn pick() -> bool }
effect Ask { fn ask() -> bool }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn f(g: fn()) / Pick {
    handle Ask { fn ask() { resume(true); if pick() { print(2) } } } in { if ask() { print(0) } }
    g()
}
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let v = [1]
        f(|| print(take_v(v)))   //~ W0301 W0502 W0503
    }
}
