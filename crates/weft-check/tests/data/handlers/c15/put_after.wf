// Stage C1.5 review: a once closure runs after a value that can resume two times.
effect Pick { multi fn pick() -> bool }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn f(m: fn(), g: fn(), out: &Vec<fn()>) / mut(out) { m(); out.push(g) }
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let v = [1]
        let out: Vec<fn()> = Vec.new()
        f(|| { if pick() { print(1) } }, || print(take_v(v)), &out)   //~ W0503 W0503
        let a = out.pop()
        let b = out.pop()
        match a { Some(h) => h(), None => {} }   //~ W0503
        match b { Some(h) => h(), None => {} }
    }
}
