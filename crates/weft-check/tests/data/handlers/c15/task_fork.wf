// Stage C1.5 review: a once closure, a value that resumes two times and a task.
effect Pick { multi fn pick() -> bool }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn f(m: fn(), g: fn()) / async {
    fork(m, || {})   //~ W0702
    g()
}
fn main() / async {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let v = [1]
        f(|| { if pick() { print(1) } }, || print(take_v(v)))   //~ W0314
    }
}
