// Gap G1 of stage C1.5: a loop around a `handle` or a `scope` runs the nested body (or the clause) again.
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn f(g: fn()) / async {
    let i = 0
    while i < 2 {
        scope { s => g() }
        i += 1
    }
}
fn main() / async {
    let v = [1]
    f(|| print(take_v(v)))   //~ W0502
}
