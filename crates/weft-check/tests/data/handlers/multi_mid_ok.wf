// D-MULTI-MID, the clean twin: the clause only reads the place between the resumes.
effect Pick { multi fn pick() -> bool }
fn g(v: &Vec<i64>) / Pick {
    let r = &v[0]
    let b = pick()
    print(r + 1)
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(true); print(v.len()); resume(false) } } in {
        g(&v)
    }
}
