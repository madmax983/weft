// D3: the callee has two ref params; the given-back closure clears the first; the loan is on the second, which aliases the first? no: on a field of the first
struct C { v: Vec<u64> }
struct D { n: u64 }
effect Get { fn get() -> fn() }
fn run_ref(d: &D, c: &C) / Get {
    let r = &c.v[0]
    let g = get()
    g()
    print(r)
    print(d.n)
}
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    let d = D { n: 1 }
    handle Get { fn get() { resume(|| c.v.clear()) } } in { run_ref(&d, &c) }
}
