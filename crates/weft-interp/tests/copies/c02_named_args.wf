// D3 with named arguments in the other order
struct C { v: Vec<u64> }
struct D { n: u64 }
effect Get { fn get() -> fn() }
fn run_ref(d: &D, c: &C) / Get {
    let r = &c.v[0]
    let g = get()
    g()
    print(r)
}
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    let d = D { n: 1 }
    handle Get { fn get() { resume(|| c.v.clear()) } } in { run_ref(c: &c, d: &d) }
}
