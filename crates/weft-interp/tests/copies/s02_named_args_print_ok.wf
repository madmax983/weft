// D3 with named arguments in the other order. The callee prints both, so a
// copy that binds by position prints them in the other order.
struct D { n: u64 }
effect Get { fn get() -> fn() }
fn show(a: &D, b: &D) / Get {
    let g = get()
    g()
    print(a.n)
    print(b.n)
}
fn main() {
    let x = D { n: 7 }
    let y = D { n: 3 }
    let w = Vec.new()
    w.push(1)
    handle Get { fn get() { resume(|| w.clear()) } } in { show(b: &y, a: &x) }
}
