// Design doc "Places and mutation", with a `main` that runs it.
struct Weapon { dmg: i32 }
struct Entity { id: u32, hp: i32, weapon: Option<Weapon> }
struct Hit { damage: i32 }
enum Event { Died(u32) }
struct World { entities: Vec<Entity>, events: Vec<Event>, score: u32 }

impl Entity {
    fn advance(self) / mut(self) { self.hp -= 1 }
    fn resolve(self, hit: Hit) / mut(self) { self.hp -= hit.damage }
}

impl World {
    fn collision_for(self, e: &Entity) -> Hit { Hit { damage: e.hp / 10 } }
}

fn step(world: &World, e: &Entity in world.entities[]) / mut(e) {
    e.advance()
    let hit = world.collision_for(e)
    e.resolve(hit)
}

fn tick(world: &World) / mut(world.entities[], world.events, world.score) {
    for e in world.entities[] {
        step(world, e)
        if e.hp <= 0 {
            world.events.push(Died(e.id))
            world.score += 10
        }
    }
}

fn main() {
    let world = World { entities: Vec.new(), events: Vec.new(), score: 0 }
    world.entities.push(Entity { id: 1, hp: 2, weapon: None })
    world.entities.push(Entity { id: 2, hp: 50, weapon: Some(Weapon { dmg: 3 }) })
    tick(&world)
    tick(&world)
    print(world.score)
    for ev in world.events[] { print(ev) }
    for e in world.entities[] {
        match e.weapon {
            Some(w) => print("entity {e.id} hp {e.hp} weapon {w.dmg}"),
            None => print("entity {e.id} hp {e.hp} unarmed"),
        }
    }
}
