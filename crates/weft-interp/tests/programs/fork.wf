// `fork` runs branches as tasks and returns a tuple (design doc "Modes and threads").
struct Entity { hp: u64 }
struct World { entities: Vec<Entity> }

fn sum_hp(es: &[Entity]) -> u64 {
    let total = 0
    for e in es[] { total += e.hp }
    total
}

fn heal(es: &[Entity]) / mut(es[]) {
    for e in es[] { e.hp += 1 }
}

fn total_hp(world: &World @ shared) -> u64 / par {
    let (l, r) = world.entities.split_at(world.entities.len() / 2)
    let (a, b) = fork(|| sum_hp(l), || sum_hp(r))
    a + b
}

fn heal_all(world: &World) / mut(world.entities[]), par {
    let mid = world.entities.len() / 2
    let (l, r) = world.entities.split_mut(mid)
    fork(|| heal(l), || heal(r))
}

fn main() / par {
    let world = World { entities: Vec.new() }
    let i = 0
    while i < 6 {
        world.entities.push(Entity { hp: i * 10 })
        i += 1
    }
    print(total_hp(&world))
    heal_all(&world)
    print(total_hp(&world))
}
