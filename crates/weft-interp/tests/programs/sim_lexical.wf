// A simulation is lexical (ADR 0010). The code above the frame of `sim.run`
// and the tasks that it spawns are in the simulation. A task outside it, and
// the clause of a handler outside it, see the clock of the run.
effect Ask { fn ask() -> u64 }

test "clock of a task outside the simulation" {
    scope { s =>
        s.spawn(|| {
            sleep(12.ms)
            print("outside at 12 ms: {Clock.now()}")
            sleep(8.ms)
            print("outside at 20 ms: {Clock.now()}")
        })
        s.spawn(|| {
            sleep(13.ms)
            sim.run(seed: 1) {
                sleep(5.ms)
                print("inside after 5 ms: {Clock.now()}")
                sleep(25.ms)
            }
        })
    }
}

test "a clause outside the simulation" {
    sleep(10.ms)
    print("before: {Clock.now()}")
    let v = handle Ask { fn ask() { print("clause clock: {Clock.now()}"); resume(1) } } in {
        sim.run(seed: 1) {
            sleep(5.ms)
            print("body clock: {Clock.now()}")
            ask()
            ()
        }
        2
    }
    print("after: {Clock.now()} v={v}")
}
