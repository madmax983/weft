struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
impl Entity {
    fn plus(self, n: i32) -> i32 { self.hp + n }
}
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
// The argument gives the field a new, empty `Vec`.
fn renew(w: &World) -> i32 / mut(w.entities) { w.entities = Vec.new(); 0 }
fn main() {
    let w = mkw()
    print(w.entities[0].plus(renew(&w)))
}
