// Issue #94 (ok, form A): the closure is in a `Vec`. Output: 1, 1 (the IR engine of main:
// 0, 0). The old pipeline rejects the program (W0301, a false positive), so it is not a
// probe of the gate.
effect C { multi fn c() -> bool }
fn main() {
    handle C { fn c() { resume(true); resume(false) } } in {
        let n: Vec<usize> = Vec.new()
        let fs: Vec<fn() -> usize> = Vec.new()
        fs.push(|| n.len())
        let b = c()
        n.push(1)
        let g = fs[0]
        print(g())
    }
}
