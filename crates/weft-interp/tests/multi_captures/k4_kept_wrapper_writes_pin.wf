// Issue #94, the rest that stays (form D, a pin): `g` holds the parameter `f` of `mk` as a
// kept capture. The frame of `mk` ended, so no engine walks the cell at a copy. Output:
// 1, 2 on both engines, before and after the fix (the semantics gives 1, 1).
effect C { multi fn c() -> bool }
fn mk(f: fn() -> usize) -> fn() -> usize { || f() + 0 }
fn main() {
    handle C { fn c() { resume(true); resume(false) } } in {
        let n: Vec<u64> = Vec.new()
        let f = || { n.push(1); n.len() }
        let g = mk(f)
        let b = c()
        print(g())
    }
}
