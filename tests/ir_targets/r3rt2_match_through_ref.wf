// Core IR target R3RT2 (review round 3). A `match` reaches its scrutinee
// through a reference, and the payload is a reference too. The binding of the
// payload is a reference to the slot (`o.Some`), with the type `&&Entity`. A
// place below the binding is a place where the stored reference points, not a
// place of `o`. The facts give the binding the places of the slot only, so a
// change of `world.entities` does not invalidate it (W0301, W0312).
// Decision (ADR 0003, open item): a by-reference binding whose type holds
// references gets the held places of the slot, as a field read through a
// reference does. The checker does not enforce it yet.
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
struct Wrap<T> { x: T }

fn mkw() -> World {
    let w = World { entities: Vec.new() }
    w.entities.push(Entity { hp: 1 })
    w
}

// Bad: the binding is used after a change of the places of the payload.
fn ref_to_option(world: &World) / mut(world.entities) {
    let o = Some(&world.entities[0])
    let p = &o
    world.entities.clear()
    match p { Some(e) => print(e.hp), None => {} }   //~ W0301
}
fn field_of_ref(world: &World) / mut(world.entities) {
    let w = Wrap { x: Some(&world.entities[0]) }
    let p = &w
    world.entities.clear()
    match p.x { Some(e) => print(e.hp), None => {} }   //~ W0301
}
fn ref_to_result(world: &World) / mut(world.entities) {
    let r: Result<&Entity, u64> = Ok(&world.entities[0])
    let p = &r
    world.entities.clear()
    match p { Ok(e) => print(e.hp), Err(n) => {} }   //~ W0301
}
fn element_ref(world: &World) / mut(world.entities) {
    let v = Vec.new()
    v.push(Some(&world.entities[0]))
    let p = &v[0]
    world.entities.clear()
    match p { Some(e) => print(e.hp), None => {} }   //~ W0301
}
fn ref_to_tuple(world: &World) / mut(world.entities) {
    let t = (1, &world.entities[0])
    let p = &t
    world.entities.clear()
    match p { (n, e) => print(e.hp) }   //~ W0301
}
fn write_through(world: &World) / mut(world.entities) {
    let o = Some(&world.entities[0])
    let p = &o
    world.entities.clear()
    match p { Some(e) => { e.hp = 5 }, None => {} }   //~ W0301
}

// Bad: the same binding in a callee. The caller gives places that overlap.
fn clear_then(o: &Option<&Entity>, w: &World) / mut(w.entities) {
    w.entities.clear()
    match o { Some(e) => print(e.hp), None => {} }
}
fn callee_side(world: &World) / mut(world.entities) {
    let o = Some(&world.entities[0])
    clear_then(&o, world)   //~ W0312
}

// Control: the checker finds a field read through a reference today.
fn control_field(world: &World) / mut(world.entities) {
    let w = Wrap { x: &world.entities[0] }
    let p = &w
    world.entities.clear()
    print(p.x.hp)   //~ W0301
}

fn bad_ref_to_option() { let w = mkw(); ref_to_option(&w) }
fn bad_field_of_ref() { let w = mkw(); field_of_ref(&w) }
fn bad_ref_to_result() { let w = mkw(); ref_to_result(&w) }
fn bad_element_ref() { let w = mkw(); element_ref(&w) }
fn bad_ref_to_tuple() { let w = mkw(); ref_to_tuple(&w) }
fn bad_write_through() { let w = mkw(); write_through(&w) }
fn bad_callee_side() { let w = mkw(); callee_side(&w) }
fn bad_control_field() { let w = mkw(); control_field(&w) }

// Clean: the same matches before the change.
fn ref_to_option_ok(world: &World) / mut(world.entities) {
    let o = Some(&world.entities[0])
    let p = &o
    match p { Some(e) => print(e.hp), None => {} }
    world.entities.clear()
}
fn field_of_ref_ok(world: &World) / mut(world.entities) {
    let w = Wrap { x: Some(&world.entities[0]) }
    let p = &w
    match p.x { Some(e) => print(e.hp), None => {} }
    world.entities.clear()
}
fn ref_to_result_ok(world: &World) / mut(world.entities) {
    let r: Result<&Entity, u64> = Ok(&world.entities[0])
    let p = &r
    match p { Ok(e) => print(e.hp), Err(n) => {} }
    world.entities.clear()
}
fn element_ref_ok(world: &World) / mut(world.entities) {
    let v = Vec.new()
    v.push(Some(&world.entities[0]))
    let p = &v[0]
    match p { Some(e) => print(e.hp), None => {} }
    world.entities.clear()
}
fn ref_to_tuple_ok(world: &World) / mut(world.entities) {
    let t = (1, &world.entities[0])
    let p = &t
    match p { (n, e) => print(e.hp) }
    world.entities.clear()
}
fn write_through_ok(world: &World) / mut(world.entities) {
    let o = Some(&world.entities[0])
    let p = &o
    match p { Some(e) => { e.hp = 5 }, None => {} }
    world.entities.clear()
}
// Clean: the reference in the argument points into another collection.
fn callee_other(world: &World, other: &World) / mut(world.entities) {
    let o = Some(&other.entities[0])
    clear_then(&o, world)
}

fn ok_ref_to_option() { let w = mkw(); ref_to_option_ok(&w) }
fn ok_field_of_ref() { let w = mkw(); field_of_ref_ok(&w) }
fn ok_ref_to_result() { let w = mkw(); ref_to_result_ok(&w) }
fn ok_element_ref() { let w = mkw(); element_ref_ok(&w) }
fn ok_ref_to_tuple() { let w = mkw(); ref_to_tuple_ok(&w) }
fn ok_write_through() { let w = mkw(); write_through_ok(&w) }
fn ok_callee_other() { let w = mkw(); let other = mkw(); callee_other(&w, &other) }

test "ok_ref_to_option" { ok_ref_to_option() }
test "ok_field_of_ref" { ok_field_of_ref() }
test "ok_ref_to_result" { ok_ref_to_result() }
test "ok_element_ref" { ok_element_ref() }
test "ok_ref_to_tuple" { ok_ref_to_tuple() }
test "ok_write_through" { ok_write_through() }
test "ok_callee_other" { ok_callee_other() }
