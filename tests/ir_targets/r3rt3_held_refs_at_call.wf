// Core IR target R3RT3 (review round 3). A reference argument can point to a
// value that holds references (`rs: &Vec<&Entity>`, `t: &(&Entity, u64)`). The
// callee reads them through a root of its own (`*rs`), which it keeps apart
// from its other parameters. The call gives `call_arg` and the reads of the
// reference argument only, not the places that the references behind it point
// into. So W0312 and W0405 do not see the overlap. This is true for a call of
// an item, a call through a function value or a closure, and a task that makes
// such a call.
// Decision (ADR 0003, open item): for a reference argument whose pointee holds
// references, the caller adds the held places to `call_arg`, with the root of
// the argument, to the reads of the call node, and to the reads of a task that
// makes the call. The checker does not enforce it yet.
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
struct Wrap<T> { x: T }

fn mkw() -> World {
    let w = World { entities: Vec.new() }
    w.entities.push(Entity { hp: 1 })
    w
}

fn read_both(rs: &Vec<&Entity>, w: &World) / mut(w.entities) {
    let e = rs[0]
    w.entities.clear()
    print(e.hp)
}
fn read_both_tuple(t: &(&Entity, u64), w: &World) / mut(w.entities) {
    let e = t.0
    w.entities.clear()
    print(e.hp)
}
fn read_field(w: &Wrap<Option<&Entity>>, world: &World) / mut(world.entities) {
    world.entities.clear()
    match w.x { Some(e) => print(e.hp), None => {} }
}
fn show_first(rs: &Vec<&Entity>) / clock { sleep(1.ms); print(rs[0].hp) }

// Bad: the callee frees what the references in the argument point to (W0312).
fn call_vec(world: &World) / mut(world.entities) {
    let rs = Vec.new()
    rs.push(&world.entities[0])
    read_both(&rs, world)   //~ W0312
}
fn call_tuple(world: &World) / mut(world.entities) {
    let t = (&world.entities[0], 1)
    read_both_tuple(&t, world)   //~ W0312
}
// Bad: the same call through a function value, and through a closure.
fn call_fnval(world: &World) / mut(world.entities) {
    let rs = Vec.new()
    rs.push(&world.entities[0])
    let f = read_both
    f(&rs, world)   //~ W0312
}
fn call_closure(world: &World) / mut(world.entities) {
    let rs = Vec.new()
    rs.push(&world.entities[0])
    let f = |a: &Vec<&Entity>, w: &World| read_both(a, w)
    f(&rs, world)   //~ W0312
}
// Bad: the reference argument is a reference local.
fn call_ref_local(world: &World) / mut(world.entities) {
    let rs = Vec.new()
    rs.push(&world.entities[0])
    let p = &rs
    read_both(p, world)   //~ W0312
}
// Bad: a field of the pointee holds the reference.
fn call_field(world: &World) / mut(world.entities) {
    let w = Wrap { x: Some(&world.entities[0]) }
    read_field(&w, world)   //~ W0312
}
// Bad: the task reads through the references in `rs` while the parent frees
// them (W0405).
fn task_reads_held(world: &World) / mut(world.entities), async, clock {
    let rs = Vec.new()
    rs.push(&world.entities[0])
    scope { s =>
        s.spawn(|| show_first(&rs))
        world.entities.clear()   //~ W0405
    }
}
// Bad: the same task calls through a function value.
fn task_fnval(world: &World) / mut(world.entities), async, clock {
    let rs = Vec.new()
    rs.push(&world.entities[0])
    let f = show_first
    scope { s =>
        s.spawn(|| f(&rs))
        world.entities.clear()   //~ W0405
    }
}

// Control: the checker finds the same value by value today.
fn read_val(o: Option<&Entity>, w: &World) / mut(w.entities) {
    w.entities.clear()
    match o { Some(e) => print(e.hp), None => {} }
}
fn call_by_value(world: &World) / mut(world.entities) {
    read_val(Some(&world.entities[0]), world)   //~ W0312
}
fn call_fnval_by_value(world: &World) / mut(world.entities) {
    let f = read_val
    f(Some(&world.entities[0]), world)   //~ W0312
}

fn bad_call_vec() { let w = mkw(); call_vec(&w) }
fn bad_call_tuple() { let w = mkw(); call_tuple(&w) }
fn bad_call_fnval() { let w = mkw(); call_fnval(&w) }
fn bad_call_closure() { let w = mkw(); call_closure(&w) }
fn bad_call_ref_local() { let w = mkw(); call_ref_local(&w) }
fn bad_call_field() { let w = mkw(); call_field(&w) }
fn bad_task_reads_held() / async, clock { let w = mkw(); task_reads_held(&w) }
fn bad_task_fnval() / async, clock { let w = mkw(); task_fnval(&w) }
fn bad_control_by_value() { let w = mkw(); call_by_value(&w) }
fn bad_control_fnval_by_value() { let w = mkw(); call_fnval_by_value(&w) }

// Clean: the references in the argument point into another collection.
fn call_vec_other(world: &World, other: &World) / mut(world.entities) {
    let rs = Vec.new()
    rs.push(&other.entities[0])
    read_both(&rs, world)
}
fn call_tuple_other(world: &World, other: &World) / mut(world.entities) {
    let t = (&other.entities[0], 1)
    read_both_tuple(&t, world)
}
fn call_fnval_other(world: &World, other: &World) / mut(world.entities) {
    let rs = Vec.new()
    rs.push(&other.entities[0])
    let f = read_both
    f(&rs, world)
}
fn call_closure_other(world: &World, other: &World) / mut(world.entities) {
    let rs = Vec.new()
    rs.push(&other.entities[0])
    let f = |a: &Vec<&Entity>, w: &World| read_both(a, w)
    f(&rs, world)
}
fn call_ref_local_other(world: &World, other: &World) / mut(world.entities) {
    let rs = Vec.new()
    rs.push(&other.entities[0])
    let p = &rs
    read_both(p, world)
}
fn call_field_other(world: &World, other: &World) / mut(world.entities) {
    let w = Wrap { x: Some(&other.entities[0]) }
    read_field(&w, world)
}
// Clean: the task reads through `rs`, and the parent does not change
// `world.entities` while the task runs.
fn task_reads_held_ok(world: &World) / mut(world.entities), async, clock {
    let rs = Vec.new()
    rs.push(&world.entities[0])
    scope { s =>
        s.spawn(|| show_first(&rs))
        print(rs.len())
    }
    world.entities.clear()
}
fn task_fnval_ok(world: &World) / mut(world.entities), async, clock {
    let rs = Vec.new()
    rs.push(&world.entities[0])
    let f = show_first
    scope { s =>
        s.spawn(|| f(&rs))
        print(rs.len())
    }
    world.entities.clear()
}

fn ok_call_vec() { let w = mkw(); let other = mkw(); call_vec_other(&w, &other) }
fn ok_call_tuple() { let w = mkw(); let other = mkw(); call_tuple_other(&w, &other) }
fn ok_call_fnval() { let w = mkw(); let other = mkw(); call_fnval_other(&w, &other) }
fn ok_call_closure() { let w = mkw(); let other = mkw(); call_closure_other(&w, &other) }
fn ok_call_ref_local() { let w = mkw(); let other = mkw(); call_ref_local_other(&w, &other) }
fn ok_call_field() { let w = mkw(); let other = mkw(); call_field_other(&w, &other) }
fn ok_task_reads_held() / async, clock { let w = mkw(); task_reads_held_ok(&w) }
fn ok_task_fnval() / async, clock { let w = mkw(); task_fnval_ok(&w) }

test "ok_call_vec" { ok_call_vec() }
test "ok_call_tuple" { ok_call_tuple() }
test "ok_call_fnval" { ok_call_fnval() }
test "ok_call_closure" { ok_call_closure() }
test "ok_call_ref_local" { ok_call_ref_local() }
test "ok_call_field" { ok_call_field() }
test "ok_task_reads_held" { ok_task_reads_held() }
test "ok_task_fnval" { ok_task_fnval() }
