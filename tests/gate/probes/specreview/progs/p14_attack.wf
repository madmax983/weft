struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn attack(a: &Entity, b: &Entity) / mut(a, b) { a.hp -= 1; b.hp -= 1 }
fn fight(world: &World, i: usize, j: usize) / mut(world.entities[]) {
    let x = &world.entities[i]
    let y = &world.entities[j]
    attack(x, y)
}
fn attack2(w: &World, a: &Entity in w.entities[], b: &Entity in w.entities[]) / mut(a, b) { a.hp -= 1; b.hp -= 1 }
fn fight2(world: &World, i: usize, j: usize) / mut(world.entities[]) {
    let x = &world.entities[i]
    let y = &world.entities[j]
    attack2(world, x, y)
}
