struct Entity { id: u32, hp: i32 }
struct World { entities: Vec<Entity> }

effect Log { fn log(msg: String) }

fn step(world: &World, e: &Entity in world.entities[]) / mut(e) { e.hp -= 1 }

fn simulate(world: &World) / mut(world.entities[]), Log {
    for e in world.entities[] {
        step(world, e)
        log("stepped {e.id} hp={e.hp}")
    }
}

fn main(env: Env) / io {
    let world = World { entities: Vec.new() }
    world.entities.push(Entity { id: 1, hp: 10 })
    world.entities.push(Entity { id: 2, hp: 20 })
    let lines = Vec.new()
    handle Log { fn log(msg) { lines.push(msg); resume(()) } }
    in simulate(&world)
    env.stdout.write_all(lines)
}
