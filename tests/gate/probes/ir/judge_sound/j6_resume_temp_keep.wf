// Judge probe J6 (O3-3 family): `resume` gives the body a reference into a
// temporary of the clause. The body keeps it in an outer local. The clause
// frame ends after the handled body, so the kept reference dangles.
effect Give { fn give() -> &u64 }
fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v.push(2); v }
fn first(v: &Vec<u64>) -> &u64 in v[] { &v[0] }

fn main() {
    let z = 0
    let keep = &z
    handle Give { fn give() { resume(first(&mk_v())); () } } in {
        keep = give()
    }
    print(keep + 1)
}
