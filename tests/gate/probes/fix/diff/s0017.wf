struct S0<T0> { f0: bool, f1: Vec<S4> }
struct S1<T0> { f0: (Box<S4>, u64, Option<S4>), f1: (S4, u64, T0) }
struct S2<T0> { f0: (u64, Vec<Box<u64>>, Option<Vec<T0>>), f1: Vec<Option<S4>>, f2: S1<S2<bool>> }
struct S3<T0> { f0: Vec<Option<S1<bool>>> }
struct S4 { f0: S0<Box<(u64, u64)>>, f1: Box<u64> }
fn main() {}
