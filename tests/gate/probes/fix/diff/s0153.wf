struct S0 { f0: Option<((u64, u64), Vec<u64>, S1)>, f1: Vec<Option<Vec<u64>>>, f2: [(Option<u64>, Option<u64>, Vec<u64>); 2] }
struct S1 { f0: Option<S1>, f1: u64, f2: S1 }
struct S2<T0> { f0: S0, f1: S3<S2<Vec<u64>>, u64>, f2: S3<Vec<Box<T0>>, S1> }
struct S3<T0, T1> { f0: [S1; 1], f1: u64 }
