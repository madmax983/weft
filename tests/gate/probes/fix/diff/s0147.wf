struct S0<T0, T1> { f0: S2<S3<[T1; 1]>>, f1: S4<S1, S3<Box<bool>>>, f2: S0<S2<Vec<u64>>, S1> }
struct S1 { f0: [Vec<S2<u64>>; 0], f1: Box<S4<S0<u64, u64>, u64>>, f2: Vec<S1> }
struct S2<T0> { f0: u64, f1: S3<S0<S4<u64, u64>, S3<u64>>> }
struct S3<T0> { f0: Vec<S2<Vec<u64>>>, f1: S0<T0, S1> }
struct S4<T0, T1> { f0: S1, f1: S2<Option<Vec<T0>>>, f2: u64 }
fn main() {}
