struct S0<T0, T1> { f0: (T1), f1: Option<Box<[u64; 2]>> }
struct S1<T0> { f0: ((S3), S4<S0<u64, u64>>, u64), f1: S1<(u64)>, f2: S1<(S3)> }
struct S2 { f0: S0<Vec<Option<u64>>, S0<S4<u64>, Box<u64>>> }
struct S3 { f0: S1<Option<S0<u64, u64>>>, f1: S0<S4<S2>, S0<S0<u64, u64>, u64>> }
struct S4<T0> { f0: S0<S0<Option<u64>, S3>, S2> }
fn main() {}
