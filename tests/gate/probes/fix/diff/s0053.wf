struct S0 { f0: Vec<Vec<Option<u64>>>, f1: S2<Vec<S0>, S2<S1<u64>, u64>> }
struct S1<T0> { f0: S3<Box<u64>, Vec<(u64, bool)>>, f1: S2<(Option<u64>), u64> }
struct S2<T0, T1> { f0: Box<S2<S3<u64, u64>, S2<T1, bool>>>, f1: (Vec<S3<T1, bool>>), f2: Box<S4<S3<u64, bool>>> }
struct S3<T0, T1> { f0: Box<S3<Option<u64>, Vec<T0>>>, f1: S2<(Box<u64>, (u64)), Vec<u64>> }
struct S4<T0> { f0: S0, f1: Vec<S4<S1<u64>>>, f2: [S2<T0, Vec<u64>>; 0] }
