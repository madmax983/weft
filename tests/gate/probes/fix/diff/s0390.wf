struct S0<T0, T1> { f0: u64, f1: (Box<S2<T0, u64>>, Option<S3<u64, T0>>, Option<(T0, u64, T1)>), f2: S0<S0<S3<T1, u64>, u64>, S0<Vec<u64>, S3<u64, u64>>> }
struct S1 { f0: Vec<S2<S3<u64, u64>, Vec<u64>>> }
struct S2<T0, T1> { f0: (Option<[bool; 2]>, u64), f1: S2<S3<u64, [u64; 0]>, Vec<Box<T1>>> }
struct S3<T0, T1> { f0: S4<S0<(T0), S0<u64, u64>>, T0> }
struct S4<T0, T1> { f0: Box<S3<Vec<T0>, Vec<T1>>>, f1: S1, f2: S0<S4<T1, Vec<u64>>, Box<u64>> }
fn main() {}
