struct S0 { f0: Box<S3<Box<u64>, S5>> }
struct S1<T0> { f0: S3<S3<bool, T0>, Option<Vec<u64>>> }
struct S2<T0, T1> { f0: [S0; 1], f1: T0, f2: S2<S3<Vec<u64>, (u64)>, u64> }
struct S3<T0, T1> { f0: u64, f1: (Option<[u64; 1]>, bool, Box<S1<u64>>) }
struct S4<T0, T1> { f0: S4<(Box<u64>, S5), (S5, S4<u64, u64>)>, f1: S2<S3<T1, Vec<u64>>, u64>, f2: T0 }
struct S5 { f0: u64, f1: (u64), f2: (S2<u64, Vec<u64>>) }
