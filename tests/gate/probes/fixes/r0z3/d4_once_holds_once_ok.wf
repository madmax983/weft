// Plan stage R0z Z3, part d: the clean twin of d4. `g` holds `f`, a `once`
// closure, and runs it one time. The program prints 0, then 0.
effect Run { fn run(g: fn()) }
fn eat(w: Vec<u64>) { print(w.len()) }
fn outer() {
    let w = Vec.new()
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let f = || eat(w)
        let g = || { f()
            run(|| print(0)) }
        handle Run { fn run(g) { g()
            resume(()) } } in { g() }
    }
}
fn main() { outer() }
