// Plan stage R0z Z3, part a: `c` runs before and after a scope body gives
// it a second closure of `mk`. Each run gets a copy whose captures are the
// cells of the actual value. The second value keeps `r`, and the clause
// of `main` keeps the value of the last run, which `main` runs after the
// clear of `v`: W0301.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let c = mk(|| print(0))
        c()
        scope { s => c = mk(|| print(r)) }
        c()
    }
    v.clear()
    let x = h.f
    x()
}
