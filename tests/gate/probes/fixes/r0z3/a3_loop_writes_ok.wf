// Plan stage R0z Z3, part a: the clean twin of a3. The kept value runs
// before the clear of `v`. The program prints 1.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let c = mk(|| print(0))
        let i = 0
        while i < 2 {
            c()
            c = mk(|| print(r))
            i = i + 1
        }
        c()
    }
    let x = h.f
    x()
    v.clear()
}
