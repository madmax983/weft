// Plan stage R0z Z3, part c: the clean twin of c1. The clause of H runs `g`
// and does not clear `v`. The program prints 0, 0, then 1.
effect Run { fn run(g: fn()) }
struct Bx { f: fn() / Run, g: fn() / Run }
fn mk_box(h: fn()) -> Bx / Run { Bx { f: || run(h), g: || run(h) } }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let b = mk_box(|| print(0))
        let r = &v[0]
        handle Run { fn run(g) { g()
            resume(()) } } in {
            let c = b.f
            c()
        }
        let d = b.g
        d()
        print(r)
    }
}
fn main() { outer() }
