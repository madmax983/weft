// Plan stage R0z Z3, fix 3: the bad twin of w1. The kept value reads `q` after the
// clear of `b`. The run gets no copy region, and the program keeps the fallback (the
// old pipeline misses the fault, as with main).
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
effect Sw { fn sw() }
fn dosw() / Sw { sw() }
fn main() / async {
    let a = Vec.new()
    a.push(1)
    let b = Vec.new()
    b.push(2)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &a[0]
        let q = &b[0]
        let c = mk(|| print(r))
        handle Sw { fn sw() { c = mk(|| print(q))
            resume(()) } } in { dosw() }
        c()
    }
    b.clear()
    let x = h.f
    x()
}
