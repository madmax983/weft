// Plan stage R0z Z3, fix 1: the `once` closure `c` is a local of the handled
// body of the local `multi` handler M, and it is live across `m`. The
// `multi` resume copies it: W0503 stays.
effect M { multi fn m() -> bool }
fn eat(w: Vec<u64>) { print(w.len()) }
fn main() {
    let w = Vec.new()
    handle M { fn m() { resume(true)
        resume(false) } } in {
        let c = || eat(w)
        let b = m()
        c()
    }
}
