// Plan stage R0z Z3, part e: a static copy of a `once` closure with a
// `ByMove` capture `w` and a `Kept` capture `n`. The clause of `Get` gives
// back a closure that clears `c.v` while `r` points into it: W0301 at the
// read of `r`. The program faults.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn eat(w: Vec<u64>, n: u64) { print(w.len())
    print(n) }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    let w = Vec.new()
    let n = 2
    handle Get { fn get() { resume(|| c.v.clear()) } } in {
        let r = &c.v[0]
        let k = || { eat(w, n)
            let g = get()
            g() }
        k()
        print(r)
    }
}
