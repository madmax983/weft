// Plan stage R0z Z3, part a: the clean twin of a1. The clear of `v` comes
// after the run of the kept value. The program prints 1.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn mk2(h: fn()) -> fn() / Run { || run(h) }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let c = mk(|| print(0))
        scope { s => c = mk2(|| print(r)) }
        c()
    }
    let x = h.f
    x()
    v.clear()
}
