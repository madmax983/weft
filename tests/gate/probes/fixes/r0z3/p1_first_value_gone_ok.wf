// Plan stage R0z Z3, fix 2: `c` gets a closure of `mk` that keeps `r` (into `a`), and
// a scope body gives it a closure of `mk` that keeps `q` (into `b`) before the one run.
// The copy reads the captures of the closure that the state has at the run: the
// second one. The clause keeps the value, and `main` runs it after the clear of `a`:
// no error. The program prints 2.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn main() / async {
    let a = Vec.new()
    a.push(1)
    let b = Vec.new()
    b.push(2)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &a[0]
        let q = &b[0]
        let c = mk(|| print(r))
        scope { s => c = mk(|| print(q)) }
        c()
    }
    a.clear()
    let x = h.f
    x()
}
