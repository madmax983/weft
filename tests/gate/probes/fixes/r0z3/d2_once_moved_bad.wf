// Plan stage R0z Z3, part d (an adversarial probe): the `once` closure moves
// into `d` and runs there, then `c` runs too: the run of `c` moves a moved
// value (W0502).
effect Run { fn run(g: fn()) }
fn eat(w: Vec<u64>) { print(w.len()) }
fn outer() {
    let w = Vec.new()
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let c = || { eat(w)
            run(|| print(0)) }
        handle Run { fn run(g) { g()
            resume(()) } } in {
            let d = c
            d()
            c()
        }
    }
}
fn main() { outer() }
