// Plan stage R0z Z3, part c (an adversarial probe): the site reads another
// field of the struct of the way, and that field has a function type
// (`b.g`). A read of it can give a closure to code that runs it, so the
// region is not the only run of the closure of `b.f`: the program keeps the
// fallback or is rejected. H clears `v` while `r` points into it.
effect Run { fn run(g: fn()) }
struct Bx { f: fn() / Run, g: fn() / Run }
fn mk_box(h: fn()) -> Bx / Run { Bx { f: || run(h), g: || run(h) } }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { v.clear()
        resume(()) } } in {
        let b = mk_box(|| print(0))
        let r = &v[0]
        handle Run { fn run(g) { g()
            resume(()) } } in {
            let c = b.f
            c()
        }
        let d = b.g
        d()
        print(r)
    }
}
fn main() { outer() }
