// Plan stage R0z Z3, part g: the clean twin of g2. The program prints 4,
// then 1.
effect Run { fn run(g: fn()) }
fn apply(f: fn(fn()), g: fn()) { f(g) }
fn apply2(f: fn(fn()), g: fn()) { apply(f, g) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let k = |g: fn()| run(g)
        apply2(k, || print(4))
    }
    print(r)
}
