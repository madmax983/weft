// Plan stage R0z Z3, part g: the callee puts the weak value into a struct and
// gives it back; `main` runs the field later. The copy of `wrap` at the call
// puts the value into a local of `main`. The clause runs the value that
// clears `v` while `r` points into it: W0301 at the read of `r`.
effect Run { fn run(g: fn()) }
struct W { f: fn(fn()) / Run }
fn wrap(f: fn(fn()) / Run) -> W { W { f: f } }
fn main() {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let k = |g: fn()| run(g)
        let w = wrap(k)
        let f = w.f
        f(|| v.clear())
    }
    print(r)
}
