// Plan stage R0z Z3, part d: the clause of H does not resume, so the run of
// the `once` closure (a copy that moved the value) ends on the cleanup path.
// The closure keeps `r`, and the clause of H runs the value that clears `v`
// before the closure reads `r` (it does not read it: the clause does not
// resume). The old pipeline rejects the program (W0312, W0301).
effect Run { fn run(g: fn()) }
fn show(w: Vec<u64>, r: &u64) { print(w.len())
    print(r) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let w = Vec.new()
    handle Run { fn run(g) { g() } } in {
        let r = &v[0]
        let c = || { run(|| v.clear())
            show(w, r) }
        c()
    }
}
