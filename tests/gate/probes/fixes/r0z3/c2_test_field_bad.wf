// Plan stage R0z Z3, part c: the site tests another field of the struct of
// the way (`b.n > 2`, a part with no function type). The test reads no
// closure, so the region of `b.f` is the only run of its closure. H clears
// `v` while `r` points into it: W0301 at the read of `r`.
effect Run { fn run(g: fn()) }
struct Bx { f: fn() / Run, n: u64 }
fn mk_box(h: fn()) -> Bx / Run { Bx { f: || run(h), n: 3 } }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { v.clear()
        resume(()) } } in {
        let b = mk_box(|| print(0))
        let r = &v[0]
        handle Run { fn run(g) { g()
            resume(()) } } in {
            let c = b.f
            c()
        }
        if b.n > 2 {
            print(r)
        }
    }
}
fn main() { outer() }
