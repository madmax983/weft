// Plan stage R0z Z3, part g: `main` gives the weak value `k` to `apply2`,
// which gives it to `apply`. Each call gets a copy, so the run of `k` is in
// `main`. The clause runs the value that clears `v` while `r` points into
// it: W0301 at the read of `r`.
effect Run { fn run(g: fn()) }
fn apply(f: fn(fn()), g: fn()) { f(g) }
fn apply2(f: fn(fn()), g: fn()) { apply(f, g) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let k = |g: fn()| run(g)
        apply2(k, || v.clear())
    }
    print(r)
}
