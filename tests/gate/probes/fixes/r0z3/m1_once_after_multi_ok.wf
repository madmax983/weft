// Plan stage R0z Z3, fix 1 (the review of Z3: e10): a `once` closure `c`
// performs `run` to a local handler. A local `multi` handler M is in the same
// body, and its handled body ends before the run of `c`. The local of `c` is
// outside the handled body of M, so the `multi` resume of `m` does not copy
// it (`spared_at`): no W0503. The program prints 0.
effect Run { fn run(g: fn()) }
effect M { multi fn m() -> bool }
fn eat(w: Vec<u64>) { print(w.len()) }
fn outer() {
    let w = Vec.new()
    handle Run { fn run(g) { resume(()) } } in {
        let c = || { eat(w)
            run(|| print(0)) }
        handle M { fn m() { resume(true)
            resume(false) } } in {
            let b = m()
        }
        c()
    }
}
fn main() { outer() }
