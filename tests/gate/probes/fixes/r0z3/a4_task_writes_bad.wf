// Plan stage R0z Z3, part a (an adversarial probe): a task gives `c` the
// second closure of `mk` through the environment of its closure. A write
// in a closure body is not a step of the way, so the run gets no copy (the
// program keeps the fallback or is rejected).
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let c = mk(|| print(0))
        scope { s => s.spawn(|| { c = mk(|| print(r)) }) }
        c()
    }
    v.clear()
    let x = h.f
    x()
}
