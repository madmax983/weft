// Plan stage R0z Z3, part d (an adversarial probe): `g` is `once` because it
// holds `f`, a `once` closure, and it runs `f` two times. The copy of `g`
// reads `f` through the environment local of its region; the second run of
// `f` moves a moved value (W0502).
effect Run { fn run(g: fn()) }
fn eat(w: Vec<u64>) { print(w.len()) }
fn outer() {
    let w = Vec.new()
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let f = || eat(w)
        let g = || { f()
            run(|| print(0))
            f() }
        handle Run { fn run(g) { g()
            resume(()) } } in { g() }
    }
}
fn main() { outer() }
