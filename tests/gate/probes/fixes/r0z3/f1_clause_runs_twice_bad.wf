// Plan stage R0z Z3, part f: the only reason of the program is a perform
// whose rest of the handled body the facts do not find (the clause of `Reg`
// runs its parameter two times, and the closure performs `log` through the
// capability of `Log`). The copies of the closure body in the clause put the
// perform there. The clause of `Log` clears `v` while `r` points into it:
// W0301 at the read of `r`.
effect Reg { fn reg(f: fn()) }
effect Log { fn log(m: u64) }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Log { fn log(m) { v.clear()
        resume(()) } } in {
        let r = &v[0]
        handle Reg { fn reg(g) { g()
            g()
            resume(()) } } in reg(|| log(1))
        print(r)
    }
}
