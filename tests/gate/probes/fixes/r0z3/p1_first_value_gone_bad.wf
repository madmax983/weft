// Plan stage R0z Z3, fix 2: the bad twin of p1. `main` clears `b`, and the kept value
// reads `q`: W0301.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn main() / async {
    let a = Vec.new()
    a.push(1)
    let b = Vec.new()
    b.push(2)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &a[0]
        let q = &b[0]
        let c = mk(|| print(r))
        scope { s => c = mk(|| print(q)) }
        c()
    }
    b.clear()
    let x = h.f
    x()
}
