// Plan stage R0z Z3, part d (an adversarial probe): a `once` closure runs
// in a loop. Each run gets a copy that moves the value first, so the run of
// the second turn moves a moved value: W0502.
effect Run { fn run(g: fn()) }
fn eat(w: Vec<u64>) { print(w.len()) }
fn outer() {
    let w = Vec.new()
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let c = || { eat(w)
            run(|| print(0)) }
        handle Run { fn run(g) { g()
            resume(()) } } in {
            let i = 0
            while i < 2 {
                c()
                i = i + 1
            }
        }
    }
}
fn main() { outer() }
