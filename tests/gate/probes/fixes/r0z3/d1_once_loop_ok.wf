// Plan stage R0z Z3, part d: the clean twin of d1. The loop makes a new
// `once` closure in each turn and runs it one time. The program prints 0,
// 0, 0, then 0.
effect Run { fn run(g: fn()) }
fn eat(w: Vec<u64>) { print(w.len()) }
fn outer() {
    handle Run { fn run(g) { g()
        resume(()) } } in {
        handle Run { fn run(g) { g()
            resume(()) } } in {
            let i = 0
            while i < 2 {
                let w = Vec.new()
                let c = || { eat(w)
                    run(|| print(0)) }
                c()
                i = i + 1
            }
        }
    }
}
fn main() { outer() }
