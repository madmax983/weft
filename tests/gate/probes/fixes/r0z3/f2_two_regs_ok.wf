// Plan stage R0z Z3, part f (an adversarial probe): the handled body of
// `Reg` performs `reg` two times with two closures, so the parameter of the
// clause is not one closure and its run gets no copy. The program keeps the
// fallback. The program prints 1, 2, then 1.
effect Reg { fn reg(f: fn()) }
effect Log { fn log(m: u64) }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Log { fn log(m) { print(m)
        resume(()) } } in {
        let r = &v[0]
        handle Reg { fn reg(g) { g()
            resume(()) } } in {
            reg(|| log(1))
            reg(|| log(2))
        }
        print(r)
    }
}
