// Plan stage R0z Z3, fix 2 (the review of Z3, round 2: q04): as n1, the clause keeps its
// parameter in a field. The clause runs at two nodes, so the run gets no copy region,
// and the program keeps the fallback. The program prints 2.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn main() / async {
    let a = Vec.new()
    a.push(1)
    let b = Vec.new()
    b.push(2)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &a[0]
        let q = &b[0]
        let c = mk(|| print(r))
        c()
        c = mk(|| print(q))
        c()
    }
    a.clear()
    let x = h.f
    x()
}
