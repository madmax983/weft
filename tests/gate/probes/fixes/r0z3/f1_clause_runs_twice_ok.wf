// Plan stage R0z Z3, part f: the clean twin of f1. The clause of `Log` does
// not clear `v`. The program prints 1, 1, then 1.
effect Reg { fn reg(f: fn()) }
effect Log { fn log(m: u64) }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Log { fn log(m) { print(m)
        resume(()) } } in {
        let r = &v[0]
        handle Reg { fn reg(g) { g()
            g()
            resume(()) } } in reg(|| log(1))
        print(r)
    }
}
