// Plan stage R0z Z3, fix 2: the bad twin of p2. `main` clears `b`, and the kept value
// reads `q`: W0301.
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn main() {
    let a = Vec.new()
    a.push(1)
    let b = Vec.new()
    b.push(2)
    let keep = || print(0)
    handle Run { fn run(g) { keep = g
        resume(()) } } in {
        let r = &a[0]
        let q = &b[0]
        let c = mk(|| print(r))
        let i = 0
        while i < 2 {
            c = mk(|| print(q))
            c()
            i = i + 1
        }
    }
    b.clear()
    keep()
}
