// Review of stage F13, class AB-RC3: a callee reads the references of an rc object after a change of the group (s7c/e09_struct_with_handle_b.wf).
struct Cache { refs: Vec<&u64>, data: Vec<u64> }
fn newc() -> Rc<Cache> { Rc.new(Cache { refs: Vec.new(), data: Vec.new() }) }
fn fill_self(c: Rc<Cache>) / mut(Cache) {
    c.data.push(7)
    c.refs.push(&c.data[0])
}
fn read0(c: Rc<Cache>) {
    let r = c.refs[0]
    print(r + 0)
}
fn grow(c: Rc<Cache>) / mut(Cache) {
    let i = 0
    while i < 40 {
        c.data.push(1)
        i += 1
    }
}
struct Hold { h: Rc<Cache> }
fn main() / mut(Cache) {
    let k = Hold { h: newc() }
    fill_self(k.h.clone())
    grow(k.h.clone())
    read0(k.h.clone())
}
