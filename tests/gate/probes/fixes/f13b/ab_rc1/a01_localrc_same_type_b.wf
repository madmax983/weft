// Review of stage F13, class AB-RC1: a reference through a whole local handle of another object goes into an rc object (s7/a01_localrc_same_type_b.wf).
struct Cache { refs: Vec<&u64>, data: Vec<u64> }
fn newc() -> Rc<Cache> { Rc.new(Cache { refs: Vec.new(), data: Vec.new() }) }
fn local_rc(c: Rc<Cache>) / mut(Cache) {
    let d = newc()
    d.data.push(1)
    c.refs.push(&d.data[0])
}
fn main() / mut(Cache) {
    let c = newc()
    local_rc(c.clone())
    let r = c.refs[0]
    print(r + 0)
}
