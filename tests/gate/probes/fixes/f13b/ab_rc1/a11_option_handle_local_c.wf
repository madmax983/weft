// Review of stage F13, class AB-RC1: a reference through a whole local handle of another object goes into an rc object (s7/a11_option_handle_local_c.wf).
struct Cache { refs: Vec<&u64>, data: Vec<u64> }
struct Store { xs: Vec<u64> }
fn newc() -> Rc<Cache> { Rc.new(Cache { refs: Vec.new(), data: Vec.new() }) }
fn news() -> Rc<Store> { Rc.new(Store { xs: Vec.new() }) }
fn stash(c: Rc<Cache>, x: &u64) / mut(Cache) { c.refs.push(x) }
fn read0(c: Rc<Cache>) {
    let r = c.refs[0]
    print(r + 0)
}
fn fill(c: Rc<Cache>) / mut(Cache) {
    let o = Some(newc())
    match o {
        Some(d) => {
            d.data.push(1)
            c.data.push(d.data[0])
        },
        None => {}
    }
}
fn main() / mut(Cache) {
    let c = newc()
    fill(c.clone())
    print(c.data.len())
}
