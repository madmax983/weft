// Review of stage F13, a false positive that F13-fix removes (s1/s1_07_readback_option_c.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
struct Cb { f: fn() }
struct Cw { f: fn(&World) }
struct Slot { o: Option<fn()> }
struct Fs { fs: Vec<fn()> }
fn noop() { print(0) }
fn mkw(n: i32) -> World {
    let w = World { entities: Vec.new() }
    w.entities.push(Entity { hp: n })
    w
}
fn run_ref(cb: &Cb) {
    let g = cb.f
    g()
}
fn run_slot(s: &Slot) {
    let o = s.o
    match o {
        Some(f) => f(),
        None => {}
    }
}
fn run_all(fs: &Vec<fn()>) {
    let i = 0
    while i < fs.len() {
        let f = fs[i]
        f()
        i += 1
    }
}
fn bad(world: &World, s: &Slot) / mut(world.entities, s.o) {
    s.o = Some(|| print(world.entities.len()))
    let first = &world.entities[0]
    let o = s.o
    match o {
        Some(f) => f(),
        None => {}
    }
    print(first.hp)
}
fn main() {
    let w = mkw(1)
    let s = Slot { o: None }
    bad(&w, &s)
}
