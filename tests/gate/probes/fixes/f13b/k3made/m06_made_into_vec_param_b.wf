// Review of stage F13, class K3-Made: a closure that a closure makes leaves the body and sees the late value of a kept variable (s3b/m06_made_into_vec_param_b.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
struct Holder { f: fn() }
fn mkw(n: i32) -> World {
    let w = World { entities: Vec.new() }
    w.entities.push(Entity { hp: n })
    w
}
fn st(fs: &Vec<fn()>, a: &World, b: &World) / mut(fs) {
    let r = &a.entities[0]
    let m = || || print(r.hp)
    fs.push(m())
    let w = mkw(3)
    r = &w.entities[0]
}
fn main() {
    let a = mkw(1)
    let b = mkw(2)
    let fs: Vec<fn()> = Vec.new()
    st(&fs, &a, &b)
    let f = fs[0]
    f()
}
