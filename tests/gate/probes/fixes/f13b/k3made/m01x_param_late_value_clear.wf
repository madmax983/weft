// F13-fix variant of class K3-Made (s3b/m01_maker_with_param_c.wf): the result points into the late value `b.entities`, and main clears it before the run.
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
struct Holder { f: fn() }
fn mkw(n: i32) -> World {
    let w = World { entities: Vec.new() }
    w.entities.push(Entity { hp: n })
    w
}
fn mk(a: &World, b: &World, c: bool) -> fn() {
    let r = &a.entities[0]
    let m = |x: i32| || print(r.hp + x)
    let g = m(1)
    let w = mkw(3)
    r = &b.entities[0]
    g
}
fn main() {
    let a = mkw(1)
    let b = mkw(2)
    let f = mk(&a, &b, true)
    b.entities.clear()
    f()
}
