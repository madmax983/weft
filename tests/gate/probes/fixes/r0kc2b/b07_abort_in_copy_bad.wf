// Plan stage R0k-c2 (a probe of the stage: an abort in a copy).
// bad twin of b07_abort_in_copy_ok: `run` clears the `rc` object after the handler; the
// second copy fails, and the clause of the `Fail` handler of `run` reads a freed cell
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
fn body() -> u64 / Pick { pick() + 1 }
fn run(b: &Rc<B>) -> u64 / Choice, mut(B) {
    let r = &b.v[0]
    let x = handle Fail { fn fail(m) { print(r)
        7 } } in {
        handle Pick { fn pick() {
            let c = choose()
            if c { resume(1) } else { { fail("second")
                0 } }
        } } in body()
    }
    b.v.clear()
    x
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    handle Choice { fn choose() { resume(true)
        resume(false) } } in { print(run(&b)) }
}
