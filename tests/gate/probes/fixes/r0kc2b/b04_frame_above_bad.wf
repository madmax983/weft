// Plan stage R0k-c2 (a probe of the stage: a frame above the `multi` handler).
// bad twin of b04_frame_above_ok: the outer clause pushes to the vector of `main` (a place
// of a frame above the handler: shared) between its resumes; the second copy of the clause
// of `Pick` reads a reference into the old buffer
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
fn body() -> u64 / Pick { pick() + 1 }
fn run(v: &Vec<u64>) -> u64 / Choice {
    let r = &v[0]
    handle Pick { fn pick() {
        let b = choose()
        print(r)
        resume(1)
    } } in body()
}
fn mid(v: &Vec<u64>) -> u64 / Choice { run(v) + 1 }
fn main() {
    let v = Vec.new()
    v.push(5)
    handle Choice { fn choose() { resume(true)
        v.clear()
        resume(false) } } in { print(mid(&v)) }
}
