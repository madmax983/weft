// Plan stage R0k-c2 (a probe of the stage: an owned `Vec` buffer across a row).
// clean: the clause makes its own `Vec` and a reference into its buffer before the row;
// the first copy clears it after its resume; the second copy reads the reference into its
// own copy of the buffer (copied with the frame: valid)
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
fn body() -> u64 / Pick { pick() + 1 }
fn run() -> u64 / Choice {
    handle Pick { fn pick() {
        let w = Vec.new()
        w.push(3)
        let r = &w[0]
        let b = choose()
        print(r)
        let y = resume(1)
        w.clear()
        y
    } } in body()
}
fn main() {
    handle Choice { fn choose() { resume(true)
        resume(false) } } in { print(run()) }
}
