// Plan stage R0k-c2 (a probe of the stage: an owned `Vec` buffer across a row).
// bad twin of b01_vec_owned_ok: the `Vec` is in an `rc` object that the clause makes before
// the row; the copies share the object (an `rc` is not copied); the first copy clears it
// after its resume; the second copy reads a freed cell
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
fn body() -> u64 / Pick { pick() + 1 }
fn run() -> u64 / Choice, mut(B) {
    handle Pick { fn pick() {
        let o = Rc.new(B { v: Vec.new() })
        o.v.push(3)
        let r = &o.v[0]
        let b = choose()
        print(r)
        let y = resume(1)
        o.v.clear()
        y
    } } in body()
}
fn main() {
    handle Choice { fn choose() { resume(true)
        resume(false) } } in { print(run()) }
}
