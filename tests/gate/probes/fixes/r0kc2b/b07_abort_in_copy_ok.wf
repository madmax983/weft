// Plan stage R0k-c2 (a probe of the stage: an abort in a copy).
// clean: the second copy fails; the clause of the `Fail` handler of `run` reads a reference
// into an `rc` object that nothing clears
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
fn body() -> u64 / Pick { pick() + 1 }
fn run(b: &Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    handle Fail { fn fail(m) { print(r)
        7 } } in {
        handle Pick { fn pick() {
            let c = choose()
            if c { resume(1) } else { { fail("second")
                0 } }
        } } in body()
    }
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    handle Choice { fn choose() { resume(true)
        resume(false) } } in { print(run(&b)) }
}
