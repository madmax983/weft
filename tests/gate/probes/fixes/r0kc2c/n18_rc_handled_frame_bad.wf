// Stage R0k-c2 fix 1 (a probe of the second review of the fix).
// rc form in the frame of run (not a clause frame): the handled body of run holds a ref into the rc across pick; main's clause clears the rc through a clone
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
fn run(b: &Rc<B>) -> u64 / Choice {
    handle Pick { fn pick() {
        let c = choose()
        resume(1)
    } } in {
        let r = &b.v[0]
        let x = pick()
        print(r)
        x
    }
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { resume(true)
        b2.v.clear()
        resume(false) } } in { print(run(&b)) }
}
