// Stage R0k-c2 fix 1 (a probe of the review of stage R0k-c2: a reference parameter of a clause across a row).
// C8: the Ask clause holds its op arg across pick; the handled body of Ask pushes to the vec after ask returns
effect Pick { multi fn pick() -> bool }
effect Ask { multi fn ask(r: &u64) -> u64 }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(true)
        resume(false) } } in {
        handle Ask { fn ask(r) {
            let b = pick()
            print(r)
            resume(1) } } in {
            let x = ask(&v[0])
            print(v.len())
            print(x)
        }
    }
}
