// Stage R0k-c2 fix 1 (a probe of the review of stage R0k-c2: a reference parameter of a clause across a row).
// no rc: the handled body passes a ref into a vec of main (above Choice) to pick, then clears the vec
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick(r: &u64) -> u64 }
fn run(v: &Vec<u64>) -> u64 / Choice, mut(v) {
    handle Pick { fn pick(r) {
        let c = choose()
        print(r)
        resume(1)
    } } in {
        let x = pick(&v[0])
        v.clear()
        x
    }
}
fn main() {
    let v = Vec.new()
    v.push(4)
    handle Choice { fn choose() { resume(true)
        resume(false) } } in { print(run(&v)) }
}
