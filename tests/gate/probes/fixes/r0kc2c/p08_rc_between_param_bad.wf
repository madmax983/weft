// Stage R0k-c2 fix 1 (a probe of the review of stage R0k-c2: a reference parameter of a clause across a row).
// main's clause clears a clone of the rc between resumes; the clause of run reads a ref through the param
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
fn body() -> u64 / Pick { pick() + 1 }
fn run(b: &Rc<B>) -> u64 / Choice {
    handle Pick { fn pick() {
        let r = &b.v[0]
        let c = choose()
        print(r)
        resume(1)
    } } in body()
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { resume(true)
        b2.v.clear()
        resume(false) } } in { print(run(&b)) }
}
