// Stage R0k-c2 fix 1 (a probe of the review of stage R0k-c2: a reference parameter of a clause across a row).
// the handled body (inline) passes a ref into an rc vec to pick; the handled body clears it after pick
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick(r: &u64) -> u64 }
fn run(b: &Rc<B>) -> u64 / Choice, mut(B) {
    handle Pick { fn pick(r) {
        let c = choose()
        print(r)
        resume(1)
    } } in {
        let x = pick(&b.v[0])
        b.v.clear()
        x
    }
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    handle Choice { fn choose() { resume(true)
        resume(false) } } in { print(run(&b)) }
}
