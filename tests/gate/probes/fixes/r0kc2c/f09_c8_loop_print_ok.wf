// Stage R0k-c2 fix 1 (a probe of the second review of the fix: a path with no run of the clause, or two runs of it).
// C8 clean: the handled body of Ask asks in a loop; nobody changes v after the push at the start
effect Pick { multi fn pick() -> bool }
effect Ask { multi fn ask(r: &u64) -> u64 }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(true)
        resume(false) } } in {
        handle Ask { fn ask(r) {
            let b = pick()
            print(r)
            resume(1) } } in { for i in 0..2 { print(ask(&v[0])) } }
    }
}
