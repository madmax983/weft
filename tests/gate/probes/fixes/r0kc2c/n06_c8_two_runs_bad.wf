// Stage R0k-c2 fix 1 (a probe of the second review of the fix: a path with no run of the clause, or two runs of it).
// C8 two runs: the handled body of Ask clears v after the first ask, then asks again on w
effect Pick { multi fn pick() -> bool }
effect Ask { multi fn ask(r: &u64) -> u64 }
fn main() {
    let v = Vec.new()
    v.push(1)
    let w = Vec.new()
    w.push(2)
    handle Pick { fn pick() { resume(true)
        resume(false) } } in {
        handle Ask { fn ask(r) {
            let b = pick()
            print(r)
            resume(1) } } in {
            let x = ask(&v[0])
            v.clear()
            let y = ask(&w[0])
            print(x + y)
        }
    }
}
