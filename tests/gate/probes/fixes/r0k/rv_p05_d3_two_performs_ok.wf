// The clean twin of rv_p05: the closure only reads `v`, so it can run more
// than once.
effect Get { fn get() -> fn() }
fn twice() / Get { let a = get()
    a()
    let b = get()
    b() }
fn main() {
    let v = Vec.new()
    v.push(1)
    let c = || print(v.len())
    handle Get { fn get() { resume(c) } } in { twice() }
}
