// The clean twin of rv_p10: the value only reads `c.v`.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn run_ref(c: &C) / Get {
    let r = &c.v[0]
    handle Fail { fn fail(m) { let g = get()
        g()
        print(r) } } in { fail("x") }
}
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    handle Get { fn get() { resume(|| print(c.v.len())) } } in { run_ref(&c) }
}
