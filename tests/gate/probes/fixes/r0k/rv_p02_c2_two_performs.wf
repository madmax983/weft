// C2, two performs: the second clause run runs the value of the first, which reads v after the callee cleared it
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn f(v: &Vec<u64>) / Run, mut(v) {
    let r = &v[0]
    run(|| print(r))
    v.clear()
    run(|| print(0))
}
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { let old = h.f
        old()
        h.f = g
        resume(()) } } in { f(&v) }
}
