// D3 on an abort path: a Fail clause of the callee gets g and runs it while a loan of the callee is live
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn run_ref(c: &C) / Get {
    let r = &c.v[0]
    handle Fail { fn fail(m) { let g = get()
        g()
        print(r) } } in { fail("x") }
}
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    handle Get { fn get() { resume(|| c.v.clear()) } } in { run_ref(&c) }
}
