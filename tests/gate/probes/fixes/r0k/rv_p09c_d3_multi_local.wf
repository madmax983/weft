// p09 with the body inline in the handled body (no callee)
struct C { v: Vec<u64> }
effect Get { multi fn get() -> fn() }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    c.v.push(2)
    handle Get { fn get() { resume(|| print(0))
        resume(|| c.v.clear()) } } in {
        let g = get()
        let r = &c.v[0]
        g()
        print(r)
    }
}
