// Plan stage R0j (C, a function value that a function value of a callee
// runs as a task): the closure spawns `h` and a task that writes `c.k`,
// and writes `c.k` itself while the tasks run (W0405).
struct C { k: u64 }
fn run2(f: fn(fn())) { f(|| print(1)) }
fn main() / async {
    let c = C { k: 0 }
    run2(|h| scope { s => s.spawn(h); s.spawn(|| c.k += 1); c.k += 2 })
    print(c.k)
}
