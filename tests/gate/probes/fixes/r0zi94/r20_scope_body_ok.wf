// Issue #94 (ok, form C): a scope body in a closure body performs the `multi` operation. The
// frame of the scope body names the capture cells. Output: 1, 1 (the IR engine of main: 1, 2).
effect C { multi fn c() -> bool }
fn main() {
    handle C { fn c() { resume(true); resume(false) } } in {
        let n: Vec<u64> = Vec.new()
        let f = || {
            scope { s =>
                let b = c()
                n.push(1)
                print(n.len())
            }
        }
        f()
    }
}
