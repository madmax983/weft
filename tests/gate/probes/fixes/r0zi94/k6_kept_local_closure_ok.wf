// Issue #94 (ok, form A): the closure `g` holds the local `f` as a kept capture (the cell of
// `f`, a slot of the copied frame), and `f` holds a reference to `n`. Output: 1, 1 (the IR
// engine of main: 1, 2).
effect C { multi fn c() -> bool }
fn main() {
    handle C { fn c() { resume(true); resume(false) } } in {
        let n: Vec<u64> = Vec.new()
        let f = || { n.push(1); n.len() }
        let g = || f() + 0
        let b = c()
        print(g())
    }
}
