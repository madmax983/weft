// Issue #94 (ok, control): the `handle` of the `multi` effect is in a closure of the site, so
// the mark of the handler names capture cells. The clause writes `out` of the site, which the
// copies share. Output: 3 1, 3 1, 5 1, 5 1, [9, 1, 9, 1, 9] on both engines, also on main.
effect C { multi fn c() -> bool }
fn main() {
    let out: Vec<u64> = Vec.new()
    let g = || {
        handle C { fn c() { out.push(9); resume(true); resume(false) } } in {
            let n: Vec<u64> = Vec.new()
            let b = c()
            n.push(1)
            out.push(1)
            let b2 = c()
            print(out.len(), n.len())
        }
    }
    g()
    print(out)
}
