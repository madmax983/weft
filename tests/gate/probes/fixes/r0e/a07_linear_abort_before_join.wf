// Stage R0e: a linear value moves into a task in a closure; the closure can fail before the join: the cancel drops it (W0602).
linear struct Lock { id: u64 }
fn release(l: Lock) { let Lock(i) = l }
fn risky() / fail { fail("no") }
fn main() / async, fail {
    let f = || {
        let l = Lock { id: 1 }
        scope { s =>
            let h = s.spawn(|| release(l))
            risky()
            h.join()
        }
    }
    f()
}
