// Stage R0e fix 2: the clean twin of rv1_cs2: the reference comes after the handle.
effect Ask { fn ask() -> u64 }
fn main() / async {
    let v = [1, 2]
    let x = handle Ask { fn ask() { scope { t => v.push(3); () }; resume(0) } } in { let y = ask(); y }
    let r = &v[0]
    print(r)
    print(x)
}
