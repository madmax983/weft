// Stage R0e fix 2 (O2 of the review: a callee spawns its parameter two times, and the value of the caller moves a capture (W0502)).
fn take(v: Vec<u64>) { print(v.len()) }
fn twice(f: fn()) / async { scope { s => s.spawn(f); s.spawn(f); () } }
fn main() / async {
    let v = [1]
    twice(|| take(v))
}
