// OR7 fix: the value that reads `w` runs before the task (clean).
fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}
fn call_with(f: fn(), g: fn(), v: &Vec<u64>) / async, mut(v) {
    f()
    scope { s =>
        s.spawn(|| v.clear())
        g()
    }
}
fn main() / async {
    let w = mk_v()
    call_with(|| print(w[0]), || print(7), &w)
}
