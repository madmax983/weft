// Stage R0e fix 4 (R2-B1 of the review of R0e, round 2: a clause spawns on the outer scope and joins the task on one path only; the detach path lets it run past the clause (W0405)).
effect Ask { fn ask() -> u64 }
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    let b = false
    scope { s =>
        let x = handle Ask { fn ask() { let t = s.spawn(|| c.k += 1); if b { t.join() } else { t.detach() }; resume(0) } } in { ask() }
        c.k += 2
    }
    print(c.k)
}
