// Stage R0e fix 2 (O1: the clean twin of rv1_o1_d06c: the write is after the scope).
effect Ask { fn ask() -> u64 }
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    scope { s =>
        let f = || handle Ask { fn ask() { s.spawn(|| c.k += 1); resume(1) } } in { let n = ask(); () }
        f()
    }
    c.k += 2
    print(c.k)
}
