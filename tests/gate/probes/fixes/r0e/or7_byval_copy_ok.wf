// OR7 fix: the value captures a copy of a number, not the vector: no race (clean).
fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}
fn call_with(f: fn(), v: &Vec<u64>) / async, mut(v) {
    scope { s =>
        s.spawn(|| v.clear())
        f()
    }
}
fn main() / async {
    let w = mk_v()
    let n = w.len()
    call_with(|| print(n), &w)
}
