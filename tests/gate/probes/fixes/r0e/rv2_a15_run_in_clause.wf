// Stage R0e fix 4 (an older hole: the callee runs the value in a clause of its own handler while its task clears v (W0312)).
fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}
effect Ask { fn ask() -> u64 }
fn call_with(f: fn(), v: &Vec<u64>) / async, mut(v) {
    scope { s =>
        s.spawn(|| v.clear())
        let x = handle Ask { fn ask() { f(); resume(0) } } in { ask() }
        print(x)
    }
}
fn main() / async {
    let w = mk_v()
    call_with(|| print(w[0]), &w)
}
