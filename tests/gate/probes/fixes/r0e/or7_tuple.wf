// OR7 fix: the value is in a tuple (W0312).
fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}
fn call_with(t: (fn(), u64), v: &Vec<u64>) / async, mut(v) {
    scope { s =>
        s.spawn(|| v.clear())
        let g = t.0
        g()
    }
}
fn main() / async {
    let w = mk_v()
    call_with((|| print(w[0]), 1), &w)
}
