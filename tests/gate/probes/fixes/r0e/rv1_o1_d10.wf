// Stage R0e fix 2 (O1: a callee runs the closure (W0405)).
effect Ask { fn ask() -> u64 }
struct C { k: u64 }
fn later(f: fn()) { f() }
fn main() / async {
    let c = C { k: 0 }
    scope { s =>
        later(|| handle Ask { fn ask() { s.spawn(|| c.k += 1); resume(1) } } in { let n = ask(); () })
        c.k += 2
    }
    print(c.k)
}
