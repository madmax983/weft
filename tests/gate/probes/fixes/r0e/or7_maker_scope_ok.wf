// OR7 fix: the closure of the callee joins its task before it runs the value (clean).
fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}
fn call_with(f: fn(), v: &Vec<u64>) / async, mut(v) {
    scope { s =>
        let k = || { let t = s.spawn(|| v.clear()); t.join(); f() }
        k()
    }
}
fn main() / async {
    let w = mk_v()
    call_with(|| print(w.len()), &w)
}
