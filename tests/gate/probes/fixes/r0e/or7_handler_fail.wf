// OR7 fix: the analog for a handler: the value fails while the callee task writes; the `Fail` clause of the caller reads (W0405).
struct Stats { count: u64 }
fn work(f: fn(), r: &Stats) / fail, async, clock, mut(r) {
    scope { s =>
        let t = s.spawn(|| r.count += 1)
        sleep(1.ms)
        f()
        t.join()
    }
}
fn main() / async, clock {
    let st = Stats { count: 0 }
    handle Fail { fn fail(m) { print(st.count) } } in { work(|| fail("x"), &st) }
}
