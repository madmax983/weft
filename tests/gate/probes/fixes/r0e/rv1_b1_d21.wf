// Stage R0e fix 2 (B1: the same in a clause of a Fail handler (W0405)).
struct C { k: u64 }
fn risky() / fail { fail("x") }
fn main() / async {
    let c = C { k: 0 }
    scope { s =>
        handle Fail { fn fail(m) { scope { t => s.spawn(|| c.k += 1); () } } } in { risky() }
        c.k += 2
    }
    print(c.k)
}
