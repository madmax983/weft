// Stage R0e fix 4 (R2-B1: the clean twin of rv2_b01: the clause joins the task on each path before the resume).
effect Ask { fn ask() -> u64 }
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    let b = false
    scope { s =>
        let x = handle Ask { fn ask() { let t = s.spawn(|| c.k += 1); t.join(); resume(0) } } in { ask() }
        c.k += 2
    }
    print(c.k)
}
