// Stage R0e: a scope in a closure, three closures deep; the task races with the closure body (W0405).
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    let f = || {
        let g = || {
            let h = || scope { s => s.spawn(|| c.k += 1); c.k += 1 }
            h()
        }
        g()
    }
    f()
    print(c.k)
}
