// OR7 fix: the callee runs the value through a local closure while the task runs (W0312).
fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}
fn call_with(f: fn(), v: &Vec<u64>) / async, mut(v) {
    let k = || f()
    scope { s =>
        s.spawn(|| v.clear())
        k()
    }
}
fn main() / async {
    let w = mk_v()
    call_with(|| print(w[0]), &w)
}
