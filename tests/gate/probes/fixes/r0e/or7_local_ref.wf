// OR7 fix: a callee task clears `v` while the callee runs a value that reads the local `w` through a capture (W0312).
fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}
fn call_with(f: fn(), v: &Vec<u64>) / async, mut(v) {
    scope { s =>
        s.spawn(|| v.clear())
        f()
    }
}
fn main() / async {
    let w = mk_v()
    call_with(|| print(w[0]), &w)
}
