// Stage R0e fix 2 (B1 of the review: a spawn on an outer scope in a scope body in a clause; the task races with the scope body after the perform (W0405)).
effect Ask { fn ask() -> u64 }
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    scope { s =>
        let x = handle Ask { fn ask() { scope { t => s.spawn(|| c.k += 1); () }; 0 } } in { ask() }
        c.k += 2
    }
    print(c.k)
}
