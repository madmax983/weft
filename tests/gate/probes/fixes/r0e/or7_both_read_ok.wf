// OR7 fix: the task and the value both only read the vector (clean).
fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}
fn call_with(f: fn(), v: &Vec<u64>) / async {
    scope { s =>
        s.spawn(|| print(v[0]))
        f()
    }
}
fn main() / async {
    let w = mk_v()
    call_with(|| print(w[1]), &w)
}
