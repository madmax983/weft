// Stage R0e (multi re-entry): the clean twin of m5: the `multi` operation comes before the spawn.
effect Pick { multi fn pick() -> bool }
fn take(v: Vec<u64>) { print(v.len()) }
fn main() / async {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let f = || scope { s =>
            let b = pick()
            let h = s.spawn(|| 1)
            print(h.join())
        }
        f()
    }
}
