// Stage R0e fix 4 (R2-B1: in a handled body in the clause (W0405)).
effect Ask { fn ask() -> u64 }
effect Tell { fn tell() }
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    let b = false
    scope { s =>
        let x = handle Ask { fn ask() { handle Tell { fn tell() { resume(()) } } in { let t = s.spawn(|| c.k += 1); tell(); if b { t.join() } else { t.detach() } }; resume(0) } } in { ask() }
        c.k += 2
    }
    print(c.k)
}
