// Stage R0e fix 4 (R2-B1: the task reads, the body pushes (W0405)).
effect Ask { fn ask() -> u64 }
fn main() / async {
    let v = [1, 2]
    let b = false
    scope { s =>
        let x = handle Ask { fn ask() { let t = s.spawn(|| print(v[0])); if b { t.join() } else { t.detach() }; resume(0) } } in { ask() }
        v.push(3)
    }
}
