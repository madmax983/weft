// Stage R0e: a clause of a handler in a closure spawns on a scope of the maker; the task writes `c.k` while the handled body reads it (W0405).
effect Ask { fn ask() -> u64 }
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    scope { s =>
        let f = || handle Ask { fn ask() { s.spawn(|| c.k += 1); resume(1) } } in { let x = ask(); x + c.k }
        print(f())
    }
    print(c.k)
}
