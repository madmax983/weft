// Stage R0e fix 2 (O1: the clause ends with no resume (W0405)).
effect Ask { fn ask() -> u64 }
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    scope { s =>
        let f = || handle Ask { fn ask() { s.spawn(|| c.k += 1); () } } in { let n = ask(); () }
        f()
        c.k += 2
    }
    print(c.k)
}
