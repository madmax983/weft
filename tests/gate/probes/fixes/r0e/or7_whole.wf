// OR7 fix: the value reads the whole local `w`; the task clears the field `w.a` (W0312).
struct W { a: Vec<u64>, b: Vec<u64> }
fn show(x: &W) { print(x.a.len()) }
fn call_with(f: fn(), v: &Vec<u64>) / async, mut(v) {
    scope { s =>
        s.spawn(|| v.clear())
        f()
    }
}
fn main() / async {
    let w = W { a: [1, 2], b: [3, 4] }
    call_with(|| show(&w), &w.a)
}
