// Stage R0e (multi re-entry): a callee with a scope in a closure; the task of the closure performs `pick` of a handler of another task (W0314).
effect Pick { multi fn pick() -> bool }
fn take(v: Vec<u64>) { print(v.len()) }
fn main() / async {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let f = || scope { s => s.spawn(|| { let b = pick(); () }); () }
        f()
    }
}
