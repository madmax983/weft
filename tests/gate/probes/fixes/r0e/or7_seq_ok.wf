// OR7 fix: the callee clears `v`, then runs the value, with no task: no race (clean).
fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}
fn call_with(f: fn(), v: &Vec<u64>) / mut(v) {
    v.clear()
    f()
}
fn main() {
    let w = mk_v()
    call_with(|| print(w.len()), &w)
}
