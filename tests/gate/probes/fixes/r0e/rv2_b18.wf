// Stage R0e fix 4 (R2-B1: a join on one branch, a detach on the other (W0405)).
effect Ask { fn ask(n: u64) -> u64 }
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    scope { s =>
        let x = handle Ask { fn ask(n) { let t = s.spawn(|| c.k += 1); if n > 5 { t.join() } else { t.detach() }; resume(0) } } in { ask(1) }
        c.k += 2
    }
    print(c.k)
}
