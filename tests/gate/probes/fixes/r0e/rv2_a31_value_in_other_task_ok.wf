// Stage R0e fix 4 (the clean twin of rv2_a31_value_in_other_task: the task only reads v).
fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}
fn call_with(f: fn(), v: &Vec<u64>) / async, mut(v) {
    scope { s =>
        s.spawn(|| print(v.len()))
        s.spawn(|| f())
    }
}
fn main() / async {
    let w = mk_v()
    call_with(|| print(w.len()), &w)
}
