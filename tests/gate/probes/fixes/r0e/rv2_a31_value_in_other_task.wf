// Stage R0e fix 4 (an older hole: the callee runs the value in a second task while the first task clears v (W0405)).
fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}
fn call_with(f: fn(), v: &Vec<u64>) / async, mut(v) {
    scope { s =>
        s.spawn(|| v.clear())
        s.spawn(|| f())
    }
}
fn main() / async {
    let w = mk_v()
    call_with(|| print(w.len()), &w)
}
