// Stage R0e fix 2 (B1: the same on a scope of a closure (W0405)).
effect Ask { fn ask() -> u64 }
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    let f = || scope { s =>
        let x = handle Ask { fn ask() { scope { t => s.spawn(|| c.k += 1); () }; resume(1) } } in { ask() }
        c.k += 2
    }
    f()
    print(c.k)
}
