// Stage R0e fix 2 (B1: a scope body in a clause in a function body spawns on the outer scope (W0405)).
effect Ask { fn ask() -> u64 }
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    scope { s =>
        let x = handle Ask { fn ask() { scope { t => s.spawn(|| c.k += 1); () }; resume(1) } } in { ask() }
        c.k += 2
    }
    print(c.k)
}
