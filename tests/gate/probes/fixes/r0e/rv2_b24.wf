// Stage R0e fix 4 (R2-B1: a join in a loop that does not run, then a detach (W0405)).
effect Ask { fn ask() -> u64 }
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    scope { s =>
        let x = handle Ask { fn ask() {
            let t = s.spawn(|| c.k += 1)
            let i = 0
            while i < 0 { t.join(); t = s.spawn(|| c.k += 1); i += 1 }
            t.detach()
            resume(0)
        } } in { ask() }
        c.k += 2
    }
    print(c.k)
}
