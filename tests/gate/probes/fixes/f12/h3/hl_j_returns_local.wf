// F12 review (ABC preview), hole H3: a linear closure that a function or a closure gives back, dropped by the caller (old W0204 at the maker, R3RT5) (h4/hl_j_returns_local.wf).
linear struct Tx { id: u64 }
    on abort = rollback
fn rollback(tx: Tx) { let Tx(i) = tx }
fn mk_release(t: Tx) -> fn() { || rollback(t) }
fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v }
fn eat_h(h: Vec<&u64>) { print(h[0]) }
fn run(f: fn()) { f() }
struct K { f: fn() }
fn mk2() -> fn() { let t = Tx { id: 1 }; || rollback(t) }
fn main() {
    let h = mk2()
    print(1)
}
