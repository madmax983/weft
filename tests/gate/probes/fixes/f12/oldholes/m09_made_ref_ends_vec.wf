// F12 review (ABC preview), old hole kept by ABC (4.7): old and the default AB accept it and the oracle faults; ABC rejects it after F12-fix (h6/m09_made_ref_ends_vec.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
struct K { f: fn() }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn run(f: fn()) { f() }
fn clr(w: &World) -> fn() / mut(w.entities) { || w.entities.clear() }
fn id(f: fn()) -> fn() { f }
fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v }
fn shower(v: &Vec<u64>) -> fn() { || print(v[0]) }
fn main() {
    let fs = Vec.new()
    {
        let v = mk_v()
        fs.push(shower(&v))
    }
    let g = fs[0]
    g()
}
