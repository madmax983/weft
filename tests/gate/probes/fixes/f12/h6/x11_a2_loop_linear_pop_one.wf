// F12 review (ABC preview), hole H6: linear closures that a loop makes and pushes into a Vec (old W0601) (lcv3/x11_a2_loop_linear_pop_one.wf).
struct W { v: Vec<u64> }
struct Bag { items: Vec<u64> }
linear struct Tx { id: u64 }
    on abort = rollback
fn rollback(tx: Tx) { let Tx(i) = tx }
fn take(b: Bag) -> usize { b.items.len() }
fn run(f: fn()) { f() }
fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v }
fn main() {
    let ks = Vec.new()
    let i = 0
    while i < 3 {
        let t = Tx { id: i }
        ks.push(|| rollback(t))
        i += 1
    }
    match ks.pop() { Some(f) => f(), None => {} }
}
