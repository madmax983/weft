// F12 review (ABC preview), hole H4: a closure with a ByRef capture, or a ByMove capture that holds references, in a Vec or an array, runs after its places end or change (old W0301) (fe/e1_05_vec_byref_closure_ends.wf).
struct Entity { hp: i32, id: u64, kids: Vec<Entity> }
struct World { entities: Vec<Entity> }
struct K { f: fn() }
fn ent(id: u64) -> Entity { let e = Entity { hp: 1, id: id, kids: Vec.new() }; e.kids.push(Entity { hp: 2, id: 9, kids: Vec.new() }); e }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(ent(1)); w }
linear struct Tx { id: u64 }
    on abort = rollback
linear struct L { o: Option<&Entity>, n: u64 }
    on abort = undo_l
fn undo_l(l: L) { let L(o, n) = l; match o { Some(e) => print(e.hp), None => {} } }
fn done_l(l: L) { let L(o, n) = l }
fn rollback(tx: Tx) { print(tx.id); let Tx(i) = tx }
fn begin(n: u64) -> Tx { Tx { id: n } }
fn risky(n: u64) / fail { if n > 0 { fail("no") } }
fn run(f: fn()) { f() }
fn run_r(f: fn() -> i32) -> i32 { f() }
fn two(a: i32, b: i32) -> i32 { a + b }
fn use2(f: fn(), r: &Entity) { print(r.hp); f() }
fn clri(w: &World) -> i32 / mut(w.entities) { w.entities.clear(); 1 }
enum Slot { Full(Entity), Empty }
enum Act { Do(fn()), Skip }
enum Two { A(u64, u64), B }
fn main() {
    let fs = Vec.new()
    {
        let w = mkw()
        fs.push(|| print(w.entities[0].hp))
    }
    let g = fs[0]
    g()
}
