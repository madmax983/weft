// F12 review (ABC preview), hole H2: a closure that a function or a closure gives back goes through a call argument, an Option, a field or a tuple, then runs after a reference into what it changes (old W0301) (lcv2/c6_d_vec.wf).
struct Buf { items: Vec<u64> }
struct W { items: Vec<u64> }
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
linear struct Tx { id: u64 }
    on abort = rollback
fn rollback(tx: Tx) { let Tx(i) = tx }
fn eat(b: Buf) { print(b.items.len()) }
fn eat_h(h: Vec<&u64>) { print(h[0]) }
fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v }
fn mkbuf() -> Buf { let b = Buf { items: Vec.new() }; b.items.push(1); b }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn run(f: fn()) { f() }
fn grow(w: &W) -> &u64 in w.items[] / mut(w.items) { w.items.push(1); &w.items[0] }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn mk_eat(b: Buf) -> fn() { || eat(b) }
fn mk_release(t: Tx) -> fn() { || rollback(t) }
fn maker(w: &World) / mut(w.entities) {
    let first = &w.entities[0]
    let mk = || || w.entities.clear()
    let fs = Vec.new()
    fs.push(mk())
    let g = fs[0]
    g()
    print(first.hp)
}
fn main() { let w = mkw(); maker(&w) }
