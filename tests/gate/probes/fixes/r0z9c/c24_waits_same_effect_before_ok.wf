// R0z Z9c-A review round 1 (probe f24): the callee performs note (whose clause runs k) before the spawn, and ping while the task of h runs.
effect Note { fn note(x: u64), fn ping(x: u64) }
struct C { k: u64 }
fn sp(h: fn()) / async, Note { note(1); scope { s => s.spawn(h); ping(1) } }
fn par(h: fn(), k: fn()) / async {
    handle Note { fn note(x) { k(); resume(()) } fn ping(x) { resume(()) } } in { sp(h) }
}
fn main() / async {
    let c = C { k: 0 }
    par(|| print(c.k), || c.k += 1)
    print(c.k)
}
