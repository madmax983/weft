// R0z Z9c-A probe: the callee spawns two parameters, and par gives the same value h to both: two tasks of h at the same time.
struct C { k: u64 }
fn both2(a: fn(), b: fn()) / async { scope { s => s.spawn(a); s.spawn(b); () } }
fn par(h: fn()) / async { both2(h, h) }
fn main() / async {
    let c = C { k: 0 }
    par(|| c.k += 1)
    print(c.k)
}
