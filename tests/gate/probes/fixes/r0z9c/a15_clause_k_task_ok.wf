// R0z Z9c-A probe (clean twin of a15): the clause of par runs k while the task of h runs; both only read.
effect Note { fn note(x: u64) }
struct C { k: u64 }
fn sp(h: fn()) / async, Note { scope { s => s.spawn(h); note(1); () } }
fn par(h: fn(), k: fn()) / async {
    handle Note { fn note(x) { k(); resume(()) } } in { sp(h); () }
}
fn main() / async {
    let c = C { k: 0 }
    par(|| print(c.k + 1), || print(c.k))
}
