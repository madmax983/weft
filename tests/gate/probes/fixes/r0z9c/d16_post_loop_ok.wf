// R0z Z9c-A review round 3 (probe q16): a handle in a loop in the window; the code after resume of ping runs k; only note is performed.
effect Note { fn note(x: u64), fn ping(x: u64) }
struct C { k: u64 }
fn par(h: fn(), k: fn()) / async {
    scope { s =>
        s.spawn(h)
        let i = 0
        while i < 3 { handle Note { fn note(x) { resume(()) } fn ping(x) { resume(()); k() } } in { note(i) }; i += 1 }
    }
}
fn main() / async {
    let c = C { k: 0 }
    par(|| print(c.k), || c.k += 1)
    print(c.k)
}
