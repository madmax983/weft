// R0z Z9c-A probe (clean twin of a12): two tasks of h at the same time, but h only reads.
struct C { k: u64 }
fn both2(a: fn(), b: fn()) / async { scope { s => s.spawn(a); s.spawn(b); () } }
fn par(h: fn()) / async { both2(h, h) }
fn main() / async {
    let c = C { k: 0 }
    par(|| print(c.k))
    print(c.k)
}
