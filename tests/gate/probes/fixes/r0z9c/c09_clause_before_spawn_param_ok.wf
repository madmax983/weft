// R0z Z9c-A review round 1 (probe f09): the callee performs note while the task of k runs, before it spawns h. The clause runs h.
effect Note { fn note(x: u64) }
struct C { k: u64 }
fn sp5(h: fn(), k: fn()) / async, Note { scope { s => s.spawn(k); note(1) }; scope { s => s.spawn(h); () } }
fn par(h: fn(), k: fn()) / async {
    handle Note { fn note(x) { h(); resume(()) } } in { sp5(h, k) }
}
fn main() / async {
    let c = C { k: 0 }
    par(|| c.k += 1, || ())
    print(c.k)
}
