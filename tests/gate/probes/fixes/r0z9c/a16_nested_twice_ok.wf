// R0z Z9c-A probe (clean twin of a16): two runs of h at the same time, but h only reads.
struct C { k: u64 }
fn both(a: fn(), b: fn()) / async { scope { s => s.spawn(a); b(); () } }
fn par(h: fn()) / async { both(|| h(), || h()) }
fn main() / async {
    let c = C { k: 0 }
    par(|| print(c.k))
    print(c.k)
}
