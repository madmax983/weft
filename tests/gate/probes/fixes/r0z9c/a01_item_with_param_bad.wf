// R0z Z9c-A (review probe): R0f item slot, the callee runs a second parameter as plain code while the task of the first runs; both are values of the interface of `par`.
struct C { k: u64 }
fn both(a: fn(), b: fn()) / async { scope { s => s.spawn(a); b(); () } }
fn par(h: fn(), k: fn()) / async { both(h, k) }
fn main() / async {
    let c = C { k: 0 }
    par(|| c.k += 1, || print(c.k))
    print(c.k)
}
