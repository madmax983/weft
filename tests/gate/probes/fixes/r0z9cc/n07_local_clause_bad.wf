// Plan stage R0z Z9c-C (part 2): R-NCLAUSE: a clause of a local handler runs k while the task of h runs.
effect Note { fn note(x: u64) }
struct C { k: u64 }
fn run1(g: fn()) / Note { g() }
fn par(h: fn(), k: fn()) / async {
    handle Note { fn note(x) { k(); resume(()) } } in {
        run1(|| scope { s => s.spawn(h); note(1); () })
    }
}
fn main() / async {
    let c = C { k: 0 }
    par(|| print(c.k), || c.k += 1)
}
