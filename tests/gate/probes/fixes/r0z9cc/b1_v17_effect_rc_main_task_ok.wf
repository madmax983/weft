// Plan stage R0z Z9c-C, review round 2 (B1, R-NREF of the locals: an rc handle from the result of an operation in the body or the callee; with a slot a lost race or a failure of the task cover, now NESTED_TASK_RUN; the probe `z9ccrev2/p4/v17_effect_rc_main_task_ok.wf`).
// Effect rc in B, unused in g; main has no task; h writes. Clean (as v03, with run1).
struct Box1 { n: Vec<u64> }
effect GetBox { fn get_box() -> Rc<Box1> }
fn run1(g: fn()) { g() }
fn par(h: fn()) / GetBox, mut(Box1), async {
    let c = get_box()
    run1(|| scope { s => s.spawn(h); () })
    print(c.n.len())
}
fn main() / mut(Box1), async {
    let b = Rc.new(Box1 { n: [1] })
    let b2 = Rc.clone(&b)
    handle GetBox { fn get_box() { resume(Rc.clone(&b2)) } } in par(|| b.n.push(2))
    print(b.n.len())
}
