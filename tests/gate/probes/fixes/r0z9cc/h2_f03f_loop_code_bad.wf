// Plan stage R0z Z9c-C, review round 1 (H2: a value gives a once parameter to code of a caller that runs it two times; with fix (b) a lost W0502, now NESTED_TASK_RUN and rule E, the rule of main; the probe `z9ccrev1/p/f03f_loop_code_bad.wf`).
// f03: the code runs k in a loop.
fn take(v: Vec<u64>) { print(v.len()) }
fn run1(g: fn()) { g() }
fn mid(f: fn(fn()), k: fn()) / async { run1(|| f(k)) }
fn main() / async {
    let v = [1]
    mid(|x| { for i in 0..2 { x() } }, || take(v))
}
