// Plan stage R0z Z9c-C, review round 1 (H1: code of a caller runs a closure that runs a parameter as a task; with the part-4 extension a HOLE, now NESTED_TASK_RUN, the rule of main; the probe `z9ccrev1/p/w39_code_task_writes_after_x_spawn_ok.wf`).
// w16 class clean: the writer task of the code starts after x returns.
fn one(k: fn()) / async { scope { s => s.spawn(k); () } }
fn mid(f: fn(fn()), k: fn()) / async { f(|| one(k)) }
fn main() / async {
    let w = [1]
    mid(|x| { x(); scope { s => s.spawn(|| w.push(3)); () } }, || print(w.len()))
}
