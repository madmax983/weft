// Plan stage R0z Z9c-C (part 2): in scope: the caller holds `r` across the call; the nested task of the value pushes to `w` (W0301); the clean twin.
fn param_in_sim(f: fn()) {
    sim.run(seed: 1) {
        scope { s => s.spawn(f) }
    }
}
fn main() {
    let w = Vec.new()
    w.push(1)
    param_in_sim(|| w.push(2))
    let r = &w[0]
    print(r)
}
