// Plan stage R0z Z9c-C (part 2): R-NREF: a reference parameter (the old pipeline checks the program).
fn par(h: fn(), v: &Vec<u64>) {
    let r = &v[0]
    sim.run(seed: 1) {
        scope { s => s.spawn(h) }
    }
    print(r)
}
fn main() {
    let w = Vec.new()
    w.push(1)
    par(|| w.push(2), &w)
}
