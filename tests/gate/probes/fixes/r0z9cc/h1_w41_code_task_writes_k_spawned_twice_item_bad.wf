// Plan stage R0z Z9c-C, review round 1 (H1: code of a caller runs a closure that runs a parameter as a task; with the part-4 extension a HOLE, now NESTED_TASK_RUN, the rule of main; the probe `z9ccrev1/p/w41_code_task_writes_k_spawned_twice_item_bad.wf`).
// w16 class: the item spawns k in two scopes one after the other.
fn one2(k: fn()) / async { scope { s => s.spawn(k); () }; scope { s => s.spawn(k); () } }
fn mid(f: fn(fn()), k: fn()) / async { f(|| one2(k)) }
fn main() / async {
    let w = [1]
    mid(|x| scope { s => s.spawn(|| w.push(3)); x(); () }, || print(w.len()))
}
