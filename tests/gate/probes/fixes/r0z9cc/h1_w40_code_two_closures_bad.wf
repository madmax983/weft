// Plan stage R0z Z9c-C, review round 1 (H1: code of a caller runs a closure that runs a parameter as a task; with the part-4 extension a HOLE, now NESTED_TASK_RUN, the rule of main; the probe `z9ccrev1/p/w40_code_two_closures_bad.wf`).
// w16 class with two values of mid given to the code.
fn one(k: fn()) / async { scope { s => s.spawn(k); () } }
fn mid(f: fn(fn(), fn()), k: fn()) / async { f(|| one(k), || ()) }
fn main() / async {
    let w = [1]
    mid(|x, y| scope { s => s.spawn(|| w.push(3)); x(); y(); () }, || print(w.len()))
}
