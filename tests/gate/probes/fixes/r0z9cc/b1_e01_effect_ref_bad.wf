// Plan stage R0z Z9c-C, review round 2 (B1, R-NREF of the locals: a reference from the result of an operation; with a slot the clean twin got a false W0301, now NESTED_TASK_RUN; the probe `z9ccrev2/p/e01_effect_ref_bad.wf`).
// B gets a reference into main's w from an effect operation, and holds it across the nested call; h pushes to w.
effect Peek { fn peek() -> &u64 }
fn par(h: fn()) / Peek {
    let r = peek()
    sim.run(seed: 1) { scope { s => s.spawn(h); () } }
    print(r)
}
fn main() {
    let w = [1]
    handle Peek { fn peek() { resume(&w[0]) } } in par(|| w.push(2))
}
