// Plan stage R0z Z9c-C, review round 1 (H1: code of a caller runs a closure that runs a parameter as a task; with the part-4 extension a HOLE, now NESTED_TASK_RUN, the rule of main; the probe `z9ccrev1/p/w32_one_k_code_spawn_after_x_bad.wf`).
// fix (b): the code runs x inside a scope whose earlier task writes; the item also spawns k (w16, two items).
fn one(k: fn()) / async { scope { s => s.spawn(k); () } }
fn two_step(k: fn()) / async { one(k) }
fn mid(f: fn(fn()), k: fn()) / async { f(|| two_step(k)) }
fn main() / async {
    let w = [1]
    mid(|x| scope { s => s.spawn(|| w.push(3)); x(); () }, || print(w.len()))
}
