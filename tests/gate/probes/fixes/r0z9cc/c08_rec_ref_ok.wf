// Plan stage R0z Z9c-C (part 4, removed in review round 1: the c10 form keeps `NESTED_TASK_RUN`, the rule of main; the task only reads while the caller holds `r` across the call); the clean twin.
fn y(f: fn(fn()), k: fn()) / async { f(|| scope { s => s.spawn(k); () }) }
fn main() / async {
    let w = [1]
    let r = &w[0]
    y(|g| g(), || print(w.len()))
    print(r)
}
