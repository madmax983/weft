// Plan stage R0z Z9c-C (part 2): R-NBUSY: the block performs an operation of a handler of `main` while the task runs.
effect Note { fn note(x: u64) }
struct C { k: u64 }
fn run1(g: fn()) / Note { g() }
fn par(h: fn()) / async, Note { run1(|| scope { s => s.spawn(h); note(1); () }) }
fn main() / async {
    let c = C { k: 0 }
    handle Note { fn note(x) { c.k += x; resume(()) } } in {
        par(|| print(c.k))
    }
}
