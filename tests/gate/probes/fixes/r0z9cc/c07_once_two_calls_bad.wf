// Plan stage R0z Z9c-C (part 2, in scope: a `once` value goes to two calls; each nested task runs it (W0502)).
fn take(v: Vec<u64>) { print(v.len()) }
fn param_in_sim(f: fn()) {
    sim.run(seed: 1) {
        scope { s => s.spawn(f); () }
    }
}
fn main() {
    let v = [1]
    let h = || take(v)
    param_in_sim(h)
    param_in_sim(h)
}
