// Plan stage R0z, rule D (the clean twin): the clause of `Reg` runs its
// parameter inside the handled body of `Note` and does not keep it.
effect Note { fn note(x: u64) }
effect Reg { fn reg(f: fn()) }
struct Job { f: fn() }
fn run_it(j: &Job) { let g = j.f
    g() }
fn stored_reg() {
    handle Note { fn note(x) { resume(()) } } in {
        handle Reg { fn reg(f) { f()
            resume(()) } } in {
            let j = Job { f: || reg(|| note(1)) }
            run_it(&j)
        }
    }
}
fn main() { stored_reg() }
