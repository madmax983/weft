// Plan stage R0z: a probe of the review of Z1 (round 1).
// Rule G (bad twin of g02): the scope fails, so the clause of `Fail` clears
// `v` while `r` borrows it, and `outer` reads `r` after.
fn outer() / io, async {
    let v = Vec.new()
    v.push(1)
    let w = Vec.new()
    w.push(2)
    let r = &w[0]
    handle Fail { fn fail(m) { v.clear() } } in {
        r = &v[0]
        fail("x")
    }
    print(r)
}
fn main() / io, async { outer(); stopper() }
effect RunG { fn rung(g: fn()) }
fn mkg(h: fn()) -> fn() / RunG { || rung(h) }
fn stopper() {
    let v = Vec.new()
    v.push(1)
    handle RunG { fn rung(g) { g()
        resume(()) } } in {
        let c = mkg(|| print(v[0]))
        c()
    }
}
