// Plan stage R0z, rule G (the clean twin): the analysis of `mk` stops as in
// g1_other_body_bad, and `fresh` has no error. The program keeps the
// fallback.
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn fresh() {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    print(r)
}
fn main() {
    fresh()
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let c = mk(|| print(v[0]))
        c()
    }
}
