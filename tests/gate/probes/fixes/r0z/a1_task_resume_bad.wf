// Plan stage R0z, rule A: a task cannot resume a continuation of this task.
// The spawned closure resumes the continuation of the clause, so the rest of
// the handled body runs on another task (W0314 at the spawn).
effect Ask { fn ask() -> u64 }
fn main() {
    let n = 0
    handle Ask { fn ask() { scope { s => s.spawn(|| { let _ = resume(1) }); n += 1 } } } in {
        n += ask()
        print(n)
    }
    print(n)
}
