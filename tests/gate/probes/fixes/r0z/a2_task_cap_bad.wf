// Plan stage R0z, rule A (the structural form): the analysis of `main` stops
// (a closure gives a function value to an operation of a local handler), and
// the spawned closure holds the capability of the local handler `Run`. A task
// cannot perform through a handler of this task (W0314 at the spawn).
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(r))
        scope { s => s.spawn(|| run(|| print(0))) }
        k()
    }
    let x = h.f
    x()
}
