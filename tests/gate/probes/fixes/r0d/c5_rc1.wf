// Stage R0d (a capability captured again, review holes of a05_nested_closure.wf and a29_nested_closure_in_closure_rowfn.wf): a closure that a closure makes performs a `multi` operation through the capability again, and a callee runs it: the once capture `g` runs twice (W0502, W0503).
effect Pick { multi fn pick() -> bool }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn apply(f: fn()) { f() }
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let v = [1]
        let g = || print(take_v(v))
        let h = || { let k = || { if pick() { print(1) } }; apply(k); g() }
        h()
    }
}
