// Stage R0d fix (review of R0d, probe c6g_passon_nested_apply): an operation that a handler with no clause passes on, performed through a callee, a function value or an inner closure.
effect Pick { multi fn pick() -> bool }
effect Ask { fn ask() -> u64 }
effect Two {
    fn a() -> u64
    fn b() -> u64
}
linear struct Lk { id: u64 }
fn unlock(l: Lk) { let Lk(id) = l; print("unlock", id) }
fn maybe(n: u64) -> u64 { if n > 1 { fail("big") }; n }
fn apply(f: fn()) { f() }
fn later(g: fn() -> u64) -> u64 { g() }
fn main() {
  let v = [1, 2]
  handle Two { fn a() { v.push(3); resume(0) } fn b() { resume(1) } } in {
    let r = &v[0]
    let f = || handle Two { fn b() { resume(2) } } in { later(|| a()) }
    print(f())
    print(r)
  }
}
