// Stage R0d fix 2 (round 2 of the review, probe a9b_capture_caller_multi_once): a multi operation that handlers with no clause pass on to a caller, or a clause that a multi re-run runs again.
effect P2 {
    multi fn pk() -> bool
    fn other() -> u64
}
fn take(v: Vec<u64>) { print(v.len()) }
fn helper() -> bool / P2 { pk() }
fn g2() / P2 {
  let v = [1]
  let t = || take(v)
  handle P2 { fn other() { resume(0) } } in {
    let f = || handle P2 { fn other() { resume(1) } } in { if helper() { print(1) } }
    f()
  }
  t()
}
fn main() { handle P2 { fn pk() { resume(true); resume(false) } fn other() { resume(0) } } in { g2() } }
