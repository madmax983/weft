// Stage R0d fix: a closure performs a `multi` operation that its handler with no clause passes on out of the closure (W0502, W0503; the old pipeline misses it).
effect P2 {
    multi fn pk() -> bool
    fn other() -> u64
}
fn take(v: Vec<u64>) { print(v.len()) }
fn main() {
    handle P2 { fn pk() { resume(true); resume(false) } fn other() { resume(0) } } in {
        let v = [1]
        let g = || take(v)
        let h = || { handle P2 { fn other() { resume(1) } } in { if pk() { print(1) } }; g() }
        h()
    }
}
