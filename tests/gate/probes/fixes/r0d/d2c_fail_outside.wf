// The `Fail` handler is outside the closure: a run of the closure can abort.
linear struct Lk { id: u64 }
fn unlock(l: Lk) { let Lk(id) = l; print("unlock", id) }
fn maybe(n: u64) -> u64 { if n > 1 { fail("big") }; n }
effect Ask { fn ask() -> u64 }
fn main() {
    handle Fail { fn fail(m) { print("caught") } } in {
        let l = Lk { id: 1 }
        let f = || handle Ask { fn ask() { resume(1) } } in { maybe(2) + ask() }
        print(f())
        unlock(l)
    }
}
