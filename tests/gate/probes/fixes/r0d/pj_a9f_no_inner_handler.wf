// Stage R0d fix 2 (round 2 of the review, probe a9f_no_inner_handler): a multi operation that handlers with no clause pass on to a caller, or a clause that a multi re-run runs again.
// R0d fix review: the closure performs `pk` (through a callee) past its own
// handler and past the handler of `g2` (no clause for `pk` in both) to the
// `multi` handler of the caller. The once closure `t` is live across `f()`.
// weft-fix accepts; old and weft-final give W0503.
effect P2 {
    multi fn pk() -> bool
    fn other() -> u64
}
fn take(v: Vec<u64>) { print(v.len()) }
fn helper() -> bool / P2 { pk() }
fn g2() / P2 {
  let v = [1]
  let t = || take(v)
  handle P2 { fn other() { resume(0) } } in {
    let f = || helper()
    print(f())
  }
  t()
}
fn main() { handle P2 { fn pk() { resume(true); resume(false) } fn other() { resume(0) } } in { g2() } }
