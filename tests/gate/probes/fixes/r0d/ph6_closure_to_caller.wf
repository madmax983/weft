// Stage R0d: a closure performs an operation that passes on to a caller, which ends it with no `resume` (W0602).
linear struct Lk { id: u64 }
fn unlock(l: Lk) { let Lk(id) = l; print("unlock", id) }
effect Log2 {
    fn info(m: String)
    fn warn(m: String)
}
fn f() / Log2 {
    let l = Lk { id: 1 }
    handle Log2 { fn info(m) { resume(()) } } in {
        let h = || warn("x")
        h()
    }
    unlock(l)
}
fn main() {
    handle Log2 {
        fn info(m) { resume(()) }
        fn warn(m) { print("stop") }
    } in f()
}
