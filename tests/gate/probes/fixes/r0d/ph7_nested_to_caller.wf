// Stage R0d: a handler with no clause for `warn` inside another one: the operation passes on to a caller, which ends it with no `resume` (W0602). The old pipeline misses it.
linear struct Lk { id: u64 }
fn unlock(l: Lk) { let Lk(id) = l; print("unlock", id) }
effect Log2 {
    fn info(m: String)
    fn warn(m: String)
}
fn f() / Log2 {
    let l = Lk { id: 1 }
    handle Log2 { fn info(m) { resume(()) } } in {
        handle Log2 { fn info(m) { resume(()) } } in {
            warn("x")
        }
    }
    unlock(l)
}
fn main() {
    handle Log2 {
        fn info(m) { resume(()) }
        fn warn(m) { print("stop") }
    } in f()
}
