// R0d review: in a closure, a callee performs `a` through an inner handler
// with no clause for `a`; the outer handler of the closure serves it and
// pushes to the captured `v` while `r` points into it. The IR accepts; old W0301.
effect Two {
    fn a() -> u64
    fn b() -> u64
}
fn helper() -> u64 / Two { a() }
fn main() {
  let v = [1, 2]
  let r = &v[0]
  let f = || handle Two { fn a() { v.push(3); resume(0) } fn b() { resume(1) } } in {
      handle Two { fn b() { resume(2) } } in { helper() }
  }
  print(f())
  print(r)
}
