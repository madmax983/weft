// Stage R0d fix: as pm1 through a callee (W0502, W0503).
effect P2 {
    multi fn pk() -> bool
    fn other() -> u64
}
fn take(v: Vec<u64>) { print(v.len()) }
fn helper() -> bool / P2 { pk() }
fn main() {
    handle P2 { fn pk() { resume(true); resume(false) } fn other() { resume(0) } } in {
        let v = [1]
        let g = || take(v)
        let h = || { handle P2 { fn other() { resume(1) } } in { if helper() { print(1) } }; g() }
        h()
    }
}
