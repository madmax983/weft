// F19.5 (R3-2, issue #50): a callee task writes `r` while the callee performs; the clause of the caller reads it
effect Note { fn note() }
struct Stats { count: u64 }
fn work(r: &Stats) / Note, async, mut(r) {
    scope { s =>
        let t = s.spawn(|| r.count += 1)
        note()
        t.join()
    }
}
fn main() / async {
    let st = Stats { count: 0 }
    handle Note { fn note() { print(st.count); resume(()) } } in { work(&st) }
}
