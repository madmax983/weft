// F19.5 (R3-2, issue #50), clean twin: the clause reads another place than the task writes
effect Note { fn note() }
struct Stats { count: u64 }
fn work(r: &Stats) / Note, async, mut(r) {
    scope { s =>
        let t = s.spawn(|| r.count += 1)
        note()
        t.join()
    }
}
fn main() / async {
    let st = Stats { count: 0 }
    let w = Stats { count: 0 }
    handle Note { fn note() { print(w.count); resume(()) } } in { work(&st) }
}
