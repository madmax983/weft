// F19.5 (R3-2, issue #50), clean twin: the callee joins its task before it fails
struct Stats { count: u64 }
fn work(r: &Stats) / fail, async, clock, mut(r) {
    scope { s =>
        let t = s.spawn(|| r.count += 1)
        sleep(1.ms)
        t.join()
        fail("x")
    }
}
fn main() / async, clock {
    let st = Stats { count: 0 }
    handle Fail { fn fail(m) { print(st.count) } } in { work(&st) }
}
