// F19.5 (R3-2, issue #50): the scope function calls a callee that performs while the task writes
effect Note { fn note() }
struct Stats { count: u64 }
fn tell() / Note { note() }
fn work(r: &Stats) / Note, async, mut(r) {
    scope { s =>
        let t = s.spawn(|| r.count += 1)
        tell()
        t.join()
    }
}
fn main() / async {
    let st = Stats { count: 0 }
    handle Note { fn note() { print(st.count); resume(()) } } in { work(&st) }
}
