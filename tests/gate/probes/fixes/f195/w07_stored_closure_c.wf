// F19.5 (R3-1, issue #50), clean twin: the callee performs before it runs the closure of the field
effect Note { fn note() }
struct Stats { count: u64 }
struct J { f: fn() }
fn run_note(j: J) / Note { note(); let g = j.f; g() }
fn work(r: &Stats) / Note, async, mut(r) {
    scope { s => run_note(J { f: || { s.spawn(|| r.count += 1); () } }) }
}
fn main() / async {
    let st = Stats { count: 0 }
    handle Note { fn note() { print(st.count); resume(()) } } in { work(&st) }
}
