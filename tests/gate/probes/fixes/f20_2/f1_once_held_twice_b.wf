// F20.2 F-1 (m06): a once closure that a generic callee holds moves into it; a later call is W0502.
fn consume(v: Vec<u64>) { print(v.len()) }
fn mkv() -> Vec<u64> { let v = Vec.new()
 v.push(1)
 v }
fn hold<T>(x: T, n: u64) -> T / fail { if n > 5 { fail("big") }
 x }
fn main() {
    let v = mkv()
    let f = || consume(v)
    handle Fail { fn fail(m) { print(m) } } in {
        let g = hold(f, 1)
        g()
        f()
    }
}
