// F20.2 F-1 (m03): an Rc that a generic callee holds across a multi operation; the held variable of a once type (W0503).
effect Choice { multi fn choose() -> bool }
struct Hook { f: fn() }
fn hold<T>(x: T) -> T / Choice { let b = choose()
 x }
fn main() {
    handle Choice { fn choose() { resume(true)
 resume(false) } } in {
        let h = Rc.new(Hook { f: || print(1) })
        let g = hold(h)
        let k = g.f
        k()
    }
}
