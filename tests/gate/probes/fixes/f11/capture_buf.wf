// Stage F11 (preview of tier 1 73_immovable.wf): a closure that captures a
// `!Move` struct by reference and reads only a field with a value is valid:
// the borrow for the closure reads no place field.
struct Frame: !Move { buf: [u8; 4], cur: &u8 in self.buf[] }
fn main() {
    let f = Frame { buf: [1, 2, 3, 4] }
    let c = || print(f.buf[0])
    c()
}
