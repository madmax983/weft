// z9d probe (part 3, Unknown, j03 form with struct fields only): g writes `c.k` in a task, main reads after.
struct C { k: u64, j: u64 }
fn run2(f: fn(fn())) / async { f(|| print(1)) }
fn main() / async {
    let c = C { k: 0, j: 0 }
    run2(|h| { scope { s => s.spawn(h); s.spawn(|| c.k += 1); c.j += 1 }; c.k += 2 })
    print(c.k)
}
