// z9d probe (part 3): a known value reads `c.k` in the nested task; g writes `c.k` while the task runs.
struct C { k: u64, j: u64 }
fn run1(g: fn()) / async { g() }
fn main() / async {
    let c = C { k: 0, j: 0 }
    let h = || print(c.k)
    run1(|| scope { s => s.spawn(h); c.k += 2; () })
    print(c.k)
}
