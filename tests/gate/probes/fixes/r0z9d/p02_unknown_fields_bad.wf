// z9d probe (part 3, Unknown): g writes `c.k` in a task and writes `c.k` itself while it runs.
struct C { k: u64, j: u64 }
fn run2(f: fn(fn())) / async { f(|| print(1)) }
fn main() / async {
    let c = C { k: 0, j: 0 }
    run2(|h| { scope { s => s.spawn(h); s.spawn(|| c.k += 1); c.k += 1 }; c.k += 2 })
    print(c.k)
}
