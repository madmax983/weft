// z9d probe (part 3, the j03 form): g spawns the value of the callee and a writer, and writes `c.k` while the tasks run.
struct C { k: u64 }
fn run2(f: fn(fn())) / async { f(|| print(1)) }
fn main() / async {
    let c = C { k: 0 }
    run2(|h| scope { s => s.spawn(h); s.spawn(|| c.k += 1); c.k += 2 })
    print(c.k)
}
