// z9d probe (part 3, in scope): a known value writes a field of main in the nested task; main reads it after the call.
struct C { k: u64, j: u64 }
fn run1(g: fn()) / async { g() }
fn main() / async {
    let c = C { k: 0, j: 0 }
    let h = || c.k += 1
    run1(|| scope { s => s.spawn(h); c.j += 1; () })
    print(c.k)
}
