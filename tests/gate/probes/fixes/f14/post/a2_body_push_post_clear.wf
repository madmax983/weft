// F14 self-attack (the code after resume clears what the handled body keeps): scratchpad f14/att/v/a2_body_push_post_clear.wf
effect Tick { fn tick() }
fn main() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    let out: Vec<&u64> = Vec.new()
    handle Tick { fn tick() { resume(()); v.clear() } } in {
        tick()
        out.push(&v[0])
    }
    print(out[0])
}
