// F14 self-attack (the clause keeps the resume result in a slot of the site; old hole): scratchpad f14/att/v/a3_slot_resume_result.wf
effect Tick { fn tick() }
fn main() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    let slot: Option<&u64> = None
    handle Tick { fn tick() { let x = resume(()); slot = Some(x); x } } in {
        tick()
        &v[0]
    }
    v.clear()
    match slot { Some(r) => print(r), None => print(0) }
}
