// F14 self-attack (clean twin): scratchpad f14/att/v/d3_clause_writes_through_param_c.wf
effect Set { fn set(h: &(&u64, u64), to: &u64) }
fn main() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    let w: Vec<u64> = Vec.new()
    w.push(2)
    let h = (&w[0], 5)
    handle Set { fn set(h, to) { h.0 = to; resume(()) } } in set(&h, &v[0])
    print(h.0)
    v.clear()
}
