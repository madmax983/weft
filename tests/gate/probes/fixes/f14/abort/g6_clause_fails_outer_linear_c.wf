// F14 self-attack (clean twin): scratchpad f14/att/v/g6_clause_fails_outer_linear_c.wf
linear struct Tok { id: u64 }
effect Ask { fn ask() -> u64 }
fn main() {
    handle Fail { fn fail(m) { print("caught", m) } } in {
        let r = handle Ask { fn ask() { fail("x"); resume(0) } } in ask()
        let t = Tok { id: 1 }
        let Tok(i) = t
        print(r + i)
    }
}
