// F14 self-attack (a clause or a handled body runs a closure that a closure of the site made; hole of the F14 review sets (f2_04)): scratchpad f14/att/v/k6_clause_made_in_loop.wf
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
effect Log { fn log(n: u64) }
fn main() {
    let w = World { entities: Vec.new() }
    w.entities.push(Entity { hp: 1 })
    let mk = || || w.entities.clear()
    let first = &w.entities[0]
    handle Log { fn log(n) { let g = mk(); g(); resume(()) } } in { let i = 0; while i < 2 { log(i); i = i + 1 } }
    print(first.hp)
}
