// Plan stage R0z Z9a (E2, a task that runs a value more than once).
// The first run of `f` on the task ends the reference `r` (a push into
// `v`), and the second run reads it.
fn main() {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    let f = || { print(r); v.push(2) }
    scope { s =>
        s.spawn(|| { f(); f() })
    }
}
