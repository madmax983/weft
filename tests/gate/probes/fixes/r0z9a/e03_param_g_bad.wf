// Plan stage R0z Z9a (E2, a task that runs a value more than once).
// Code of a caller (`g`, a parameter) runs `f` on the task, and `f` is a
// `once` closure that the caller gives: the code of `g` runs it two times.
fn take(v: Vec<u64>) { print(v.len()) }
fn mid(g: fn(fn()), f: fn()) / async {
    scope { s =>
        s.spawn(|| g(f))
    }
}
fn main() / async {
    let v = Vec.new()
    v.push(1)
    mid(|x| { x(); x() }, || take(v))
}
