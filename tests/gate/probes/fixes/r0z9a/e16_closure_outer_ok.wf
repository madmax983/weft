// Plan stage R0z Z9a (E2, a task that runs a value more than once).
// A closure spawns on the scope of the scope body a task that runs `f` two
// times; the write of `c.k` is after the scope.
struct C { k: u64 }
fn twice(f: fn()) { f(); f() }
fn main() {
    let c = C { k: 0 }
    let f = || print(c.k)
    scope { s =>
        let go = || { s.spawn(|| twice(f)); () }
        go()
    }
    c.k += 1
}
