// Plan stage R0z Z9a (E2, a task that runs a value more than once).
// A task runs a kept callback two times, and the scope body reads `n` while
// the task runs (W0405).
fn main() {
    scope { s =>
        let n = 1
        let g = || n += 1
        s.spawn(|| { g(); sleep(1.s); g() })
        print(n)
    }
}
