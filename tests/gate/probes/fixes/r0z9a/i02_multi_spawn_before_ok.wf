// Plan stage R0z Z9a, review round 3 (R-MULTI: a run again that only the
// re-entry of a `multi` operation makes; the rule of main stays).
// Z9a review round 3: c06d_multi_spawn_before_a_ok.
effect Pick { multi fn pick() -> bool }
fn mid(f: fn()) / async {
    handle Pick { fn pick() { resume(true); resume(false) } } in { scope { s => s.spawn(|| f()) }; let b = pick(); print(0) }
}
fn main() / async {
    let w = Vec.new()
    w.push(1)
    let a: Option<&u64> = None
    mid(|| {
        match a { Some(y) => print(y), None => print(0) }
        a = Some(&w[0])
        w.push(2)
    })
}
