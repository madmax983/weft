// Plan stage R0z Z9a, review round 1 (B2, R-ONCE: a task body reads a `once`
// element of a captured `Vec` and runs it again; the rule of R0j stays).
// A task runs a once callback copied out of a Vec in a loop.
fn take(v: Vec<u64>) { print(v.len()) }
fn main() {
    let v = Vec.new()
    let fs = Vec.new()
    fs.push(|| take(v))
    scope { s =>
        s.spawn(|| { for j in 0..3 { let g = fs[0]; g() } })
    }
}
