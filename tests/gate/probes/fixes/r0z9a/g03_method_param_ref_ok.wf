// Plan stage R0z Z9a, review round 1 (B1): the clean twin of
// `g03_method_param_ref_bad`: `f` reads the length, not a reference.
struct P { n: u64 }
impl P {
    fn run_n(self, f: fn()) / async { scope { s => s.spawn(|| { for i in 0..self.n { f() } }) } }
}
fn main() / async {
    let p = P { n: 2 }
    let v = Vec.new()
    v.push(1)
    p.run_n(|| { print(v.len()); v.push(2) })
}
