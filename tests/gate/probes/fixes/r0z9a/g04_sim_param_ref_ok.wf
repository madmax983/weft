// Plan stage R0z Z9a, review round 1 (B1): the clean twin of
// `g04_sim_param_ref_bad`: `f` reads the length, not a reference.
fn twice(f: fn()) { f(); f() }
fn run2(f: fn()) / async { scope { s => s.spawn(|| twice(f)) } }
fn main() / clock {
    let v = Vec.new()
    v.push(1)
    sim.run(seed: 1) { run2(|| { print(v.len()); v.push(2) }) }
}
