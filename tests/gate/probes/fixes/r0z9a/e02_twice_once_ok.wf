// Plan stage R0z Z9a (E2, a task that runs a value more than once).
// A task runs a closure two times through `twice`; the closure only reads.
fn show(v: &Vec<u64>) { print(v.len()) }
fn twice(f: fn()) { f(); f() }
fn main() {
    let v = Vec.new()
    v.push(1)
    let f = || show(&v)
    scope { s =>
        s.spawn(|| twice(f))
    }
    print(v.len())
}
