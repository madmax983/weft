// Plan stage R0z Z9a, review round 1 (B1: a callee whose task runs its
// parameter more than once; the caller applies both runs).
// A method whose task runs its parameter f in a loop.
struct P { n: u64 }
impl P {
    fn run_n(self, f: fn()) / async { scope { s => s.spawn(|| { for i in 0..self.n { f() } }) } }
}
fn main() / async {
    let p = P { n: 2 }
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    p.run_n(|| { print(r); v.push(2) })
}
