// Plan stage R0z Z9a (E2, a task that runs a value more than once).
// A spawn in a loop; each task runs `f` two times, and the loop writes
// `c.k` while the tasks run (W0405).
struct C { k: u64 }
fn twice(f: fn()) { f(); f() }
fn main() {
    let c = C { k: 0 }
    let f = || print(c.k)
    scope { s =>
        for i in 0..3 { s.spawn(|| twice(f)); c.k += 1 }
    }
}
