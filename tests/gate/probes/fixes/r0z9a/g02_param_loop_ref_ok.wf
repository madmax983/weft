// Plan stage R0z Z9a, review round 1 (B1): the clean twin of
// `g02_param_loop_ref_bad`: `f` keeps no reference across its runs.
fn run3(f: fn()) / async { scope { s => s.spawn(|| { for i in 0..3 { f() } }) } }
fn main() / async {
    let w = Vec.new()
    w.push(1)
    run3(|| {
        print(w.len())
        w.push(2)
    })
    print(w.len())
}
