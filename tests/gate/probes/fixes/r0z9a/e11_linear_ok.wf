// Plan stage R0z Z9a (E2, a task that runs a value more than once).
// A linear value with `on abort` moves into a task that runs `f` two times.
linear struct Tx { id: u64 }
    on abort = tx_abort
fn tx_abort(t: Tx) { let Tx(id) = t; print("abort", id) }
fn commit(t: Tx) { let Tx(id) = t; print("commit", id) }
fn twice(f: fn()) { f(); f() }
fn main() {
    let c = 1
    let f = || print(c)
    let t = Tx { id: 1 }
    scope { s =>
        s.spawn(|| { twice(f); commit(t) })
    }
}
