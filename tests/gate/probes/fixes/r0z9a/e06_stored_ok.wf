// Plan stage R0z Z9a (E2, a task that runs a value more than once).
// A task runs a stored callback in a loop.
struct R { n: u64 }
fn main() {
    let r = Rc.new(R { n: 0 })
    let fs = Vec.new()
    fs.push(|| print(r.n))
    scope { s =>
        s.spawn(|| { for j in 0..3 { let g = fs[0]; g() } })
    }
    print(fs.len())
}
