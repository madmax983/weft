// Plan stage R0z Z9a, review round 1 (B1): the clean twin of
// `g05_param_code_ref_bad`: code of a caller runs `f` two times on the task,
// and `f` only reads `w` (no reference across its runs, no write).
fn mid(g: fn(fn()), f: fn()) / async {
    scope { s =>
        s.spawn(|| g(f))
    }
}
fn main() / async {
    let w = Vec.new()
    w.push(1)
    mid(|x| { x(); x() }, || {
        print(w.len())
    })
    w.push(2)
}
