// Plan stage R0z Z9a (E2, a task that runs a value more than once).
// A task runs a `once` closure in a loop: the second run uses the moved value.
fn take(v: Vec<u64>) { print(v.len()) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let f = || take(v)
    scope { s =>
        s.spawn(|| { for i in 0..2 { f() } })
    }
}
