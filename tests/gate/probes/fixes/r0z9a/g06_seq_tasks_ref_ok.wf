// Plan stage R0z Z9a, review round 1 (B1): the clean twin of
// `g06_seq_tasks_ref_bad`: two tasks of `f`, one after the other; `f` keeps
// no reference across its runs.
fn seq(f: fn()) / async {
    scope { s => s.spawn(f) }
    scope { s => s.spawn(f) }
}
fn main() / async {
    let w = Vec.new()
    w.push(1)
    seq(|| {
        print(w.len())
        w.push(2)
    })
}
