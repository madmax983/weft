// Plan stage R0z Z9a (E2, a task that runs a value more than once).
// The spawn is in a clause: its task runs a `once` closure two times.
effect Go { fn go() }
fn take(v: Vec<u64>) { print(v.len()) }
fn twice(f: fn()) { f(); f() }
fn main() {
    let v = Vec.new()
    v.push(1)
    let f = || take(v)
    handle Go { fn go() { scope { s => s.spawn(|| twice(f)) }; resume(()) } } in { go() }
}
