// Plan stage R0z Z9a, review round 3 (R-CODE: code of a caller that gets a
// value of the body runs it again on the task; the rule of R0j stays).
// Z9a review round 3: code of a caller holds a reference into w across the run of its parameter, which pushes into w.
fn mid(g: fn(fn()), f: fn()) / async { scope { s => s.spawn(|| g(f)) } }
fn main() / async {
    let w = Vec.new()
    w.push(1)
    mid(|x| { let r = &w[0]; x(); print(r) }, || w.push(3))
}
