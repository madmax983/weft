// Plan stage R0z Z9a, review round 2 (a run on each of two exclusive paths is
// one run: `Run::seq`, `Applied::seq`).
// Clean: the task runs a once closure in one arm of a match on an Option (one run on each path).
fn take(v: Vec<u64>) { print(v.len()) }
fn main() / async {
    let v = Vec.new()
    let o = Some(3)
    let done = || take(v)
    scope { s => s.spawn(|| { match o { Some(x) => { print(x); done() }, None => done() } }) }
}
