// Plan stage R0z Z9a, review round 3 (R-CODE: code of a caller that gets a
// value of the body runs it again on the task; the rule of R0j stays).
// Z9a review round 3: code of a caller reads w, then runs its parameter, which reads w (clean). The task of mid runs g(f).
fn mid(g: fn(fn()), f: fn()) / async { scope { s => s.spawn(|| g(f)) } }
fn main() / async {
    let w = Vec.new()
    w.push(1)
    mid(|x| { print(w.len()); x() }, || print(w.len()))
    w.push(2)
}
