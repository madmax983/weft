// F15 self-attack (a clause that resumes on each path can still abort past its handler): scratchpad f15/att/v/c04_call_resumes_callee_fails.wf
linear struct Tok { id: u64 }
effect Op { fn op() }
fn work(n: u64) / Op, fail {
    op()
    if n > 0 { fail("x") }
}
fn main() {
    handle Fail { fn fail(m) { print("caught", m) } } in {
        let t = Tok { id: 1 }
        handle Op { fn op() { resume(()) } } in work(1)
        let Tok(i) = t
        print(i)
    }
}
