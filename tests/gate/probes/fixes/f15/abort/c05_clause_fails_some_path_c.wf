// F15 self-attack (clean twin): scratchpad f15/att/v/c05_clause_fails_some_path_c.wf
linear struct Tok { id: u64 }
effect Ask { fn ask(n: u64) -> u64 }
fn main() / fail {
    let r = handle Ask { fn ask(n) { if n > 0 { fail("x") }; resume(n) } } in ask(1)
    let t = Tok { id: 1 }
    let Tok(i) = t
    print(r + i)
}
