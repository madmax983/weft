// F15 self-attack (clean twin): scratchpad f15/att/v/c03_inner_resumes_outer_aborts_c.wf
linear struct Tok { id: u64 }
    on abort = drop_tok
fn drop_tok(t: Tok) { let Tok(i) = t }
effect Ask { fn ask() -> u64 }
effect Stop { fn stop() }
fn main() {
    handle Stop { fn stop() { print("stopped"); resume(()) } } in {
        let t = Tok { id: 1 }
        let r = handle Ask { fn ask() { stop(); resume(0) } } in ask()
        let Tok(i) = t
        print(r + i)
    }
}
