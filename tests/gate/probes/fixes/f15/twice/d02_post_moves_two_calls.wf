// F15 self-attack (a clause that runs more than once runs its code after `resume` once for each run): scratchpad f15/att/v/d02_post_moves_two_calls.wf
linear struct Tx { id: u64 }
fn commit(t: Tx) { let Tx(i) = t; print(i) }
effect Tick { fn tick() }
fn work() / Tick { tick() }
fn main() {
    let t = Tx { id: 1 }
    handle Tick { fn tick() { resume(()); commit(t) } } in {
        work()
        work()
    }
}
