// F15 self-attack (clean twin): scratchpad f15/att/v/d04_post_reads_after_body_clears_c.wf
effect Tick { fn tick(x: &u64) }
fn main() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    let w: Vec<u64> = Vec.new()
    w.push(2)
    handle Tick { fn tick(x) { resume(()); print(x) } } in {
        tick(&w[0])
        tick(&v[0])
    }
    v.clear()
}
