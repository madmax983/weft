// F15 self-attack (a clause puts its parameter into a part of a local of the site): scratchpad f15/att/v/b17_direct_tuple_slot.wf
effect Keep { fn keep(r: &u64) }
fn main() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    let y = 1
    let h = (&y, 5)
    handle Keep { fn keep(r) { h.0 = r; resume(()) } } in keep(&v[0])
    v.clear()
    print(h.0)
}
