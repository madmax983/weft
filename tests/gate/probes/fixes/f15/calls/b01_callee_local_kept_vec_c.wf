// F15 self-attack (clean twin): scratchpad f15/att/v/b01_callee_local_kept_vec_c.wf
effect Keep { fn keep(r: &u64) }
fn deep() / Keep {
    let x = 5
    keep(&x)
}
fn main() {
    let store: Vec<u64> = Vec.new()
    handle Keep { fn keep(r) { store.push(r + 0); resume(()) } } in deep()
    print(store[0])
}
