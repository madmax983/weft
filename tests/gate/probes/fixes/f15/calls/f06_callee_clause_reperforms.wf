// F15 self-attack (a call runs a clause whose operation takes a reference): scratchpad f15/att/v/f06_callee_clause_reperforms.wf
effect Keep { fn keep(r: &u64) }
fn deep() / Keep {
    let x = 5
    keep(&x)
}
fn wrap() / Keep {
    handle Keep { fn keep(r) { keep(r); resume(()) } } in deep()
}
fn main() {
    let z = 1
    let last = &z
    handle Keep { fn keep(r) { last = r; resume(()) } } in wrap()
    print(last)
}
