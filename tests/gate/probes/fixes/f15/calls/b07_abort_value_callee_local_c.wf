// F15 self-attack (clean twin): scratchpad f15/att/v/b07_abort_value_callee_local_c.wf
effect Pick { fn pick(v: &Vec<u64>) -> &u64 }
fn body(g: &Vec<u64>) -> &u64 in g[] / Pick {
    let x = pick(g)
    &g[0]
}
fn main() {
    let g = Vec.new()
    g.push(1)
    let r = handle Pick { fn pick(v) { &v[0] } } in body(&g)
    print(r)
}
