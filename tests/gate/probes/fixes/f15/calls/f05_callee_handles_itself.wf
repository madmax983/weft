// F15 self-attack (a call runs a clause whose operation takes a reference): scratchpad f15/att/v/f05_callee_handles_itself.wf
effect Keep { fn keep(r: &u64) }
fn deep() / Keep {
    let x = 5
    keep(&x)
}
fn wrap() / Keep {
    let y = 6
    keep(&y)
    handle Keep { fn keep(r) { print(r); resume(()) } } in deep()
}
fn main() {
    let z = 1
    let last = &z
    handle Keep { fn keep(r) { last = r; resume(()) } } in wrap()
    print(last)
}
