// F15 self-attack (clean twin): scratchpad f15/att/v/b18_post_reads_given_body_clears_c.wf
effect Peek { fn peek(e: &u64) }
fn give(v: &Vec<u64>) / Peek { peek(&v[0]) }
fn main() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    let w: Vec<u64> = Vec.new()
    w.push(2)
    handle Peek { fn peek(e) { resume(()); print(e) } } in {
        give(&v)
        w.clear()
    }
}
