// F15 self-attack (a call runs a clause whose operation takes a reference): scratchpad f15/att/v/b06_callee_holds_across.wf
effect Bump { fn bump(v: &Vec<u64>) }
fn hold(v: &Vec<u64>, e: &u64) / Bump { bump(v); print(e) }
fn main() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    handle Bump { fn bump(x) { x.clear(); resume(()) } } in hold(&v, &v[0])
}
