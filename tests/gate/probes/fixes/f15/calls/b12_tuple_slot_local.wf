// F15 self-attack (a call runs a clause whose operation takes a reference): scratchpad f15/att/v/b12_tuple_slot_local.wf
effect Keep { fn keep(r: &u64) }
fn deep() / Keep {
    let x = 9
    keep(&x)
}
fn main() {
    let y = 1
    let h = (&y, 5)
    handle Keep { fn keep(r) { h.0 = r; resume(()) } } in deep()
    print(h.0)
}
