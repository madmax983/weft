// F15 self-attack (a call runs a clause whose operation takes a reference): scratchpad f15/att/v/b16_eval_order_arg.wf
effect Bump { fn bump(v: &Vec<u64>) }
fn bump_it(v: &Vec<u64>) -> u64 / Bump { bump(v); 0 }
fn use_two(r: &u64, n: u64) { print(r) }
fn main() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    handle Bump { fn bump(x) { x.clear(); resume(()) } } in use_two(&v[0], bump_it(&v))
}
