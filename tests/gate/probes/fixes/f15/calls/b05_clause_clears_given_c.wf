// F15 self-attack (clean twin): scratchpad f15/att/v/b05_clause_clears_given_c.wf
effect Bump { fn bump(v: &Vec<u64>) }
fn bump_it(v: &Vec<u64>) / Bump { bump(v) }
fn main() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    let r = &v[0]
    handle Bump { fn bump(x) { print(x.len()); resume(()) } } in bump_it(&v)
    print(r)
}
