// F15 self-attack (a call runs a clause whose operation takes a reference): scratchpad f15/att/v/b22_clause_stores_behind_param.wf
effect Keep { fn keep(r: &u64) }
fn deep() / Keep {
    let x = 5
    keep(&x)
}
fn fill(out: &Vec<&u64>) / mut(out) {
    handle Keep { fn keep(r) { out.push(r); resume(()) } } in deep()
}
fn main() {
    let out: Vec<&u64> = Vec.new()
    fill(&out)
    print(out[0])
}
