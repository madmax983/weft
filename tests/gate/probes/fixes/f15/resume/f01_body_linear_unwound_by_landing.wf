// F15 self-attack (a clause that resumes on some paths only, or on each path): scratchpad f15/att/v/f01_body_linear_unwound_by_landing.wf
linear struct Tok { id: u64 }
fn eat(t: Tok) { let Tok(i) = t; print(i) }
effect Op { fn op(n: u64) }
fn main() {
    handle Op { fn op(n) { if n > 5 { resume(()) } } } in {
        let t = Tok { id: 1 }
        op(1)
        eat(t)
    }
}
