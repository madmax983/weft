// F15 self-attack (clean twin): scratchpad f15/att/v/c01_linear_leak_on_landing_c.wf
linear struct Tok { id: u64 }
fn eat(t: Tok) { let Tok(i) = t; print(i) }
effect Op { fn op(n: u64) }
fn main() {
    let t = Tok { id: 1 }
    handle Op { fn op(n) { if n > 5 { resume(()) } else { resume(()) } } } in {
        op(1)
        eat(t)
    }
}
