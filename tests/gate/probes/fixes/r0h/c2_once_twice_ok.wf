// The twin of `c2_once_twice.wf`: the closure only reads a copy of the
// length of the vector, so two runs are clean.
effect Run { fn run(g: fn()) }
fn f() / Run {
    let v = Vec.new()
    v.push(1)
    let n = v.len()
    run(|| print(n))
    print(v.len())
}
fn main() {
    handle Run { fn run(g) { g(); g(); resume(()) } } in { f() }
}
