// The twin of `c2_stored_ref.wf`: the callee does not change the vector.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn f(v: &Vec<u64>) / Run {
    let r = &v[0]
    run(|| print(r))
}
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g; resume(()) } } in { f(&v) }
    let x = h.f
    x()
}
