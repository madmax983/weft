// The callee gives the clause a closure that clears a vector of the site
// (through a reference argument). The clause holds a reference into the
// vector across the run.
effect Run { fn run(g: fn()) }
fn f(v: &Vec<u64>) / Run, mut(v) {
    run(|| v.clear())
}
fn main() {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    handle Run { fn run(g) { g(); print(r); resume(()) } } in { f(&v) }
}
