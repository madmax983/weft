// Follow-up F13.2, class UR (a value that a body runs and that no caller gives): a closure that a callee made goes to a callee that runs it; the clean twin (scratchpad f13p2/hole/h3_made_to_callee.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn push1(x: &World) { print(x.entities.len()) }
fn mk_call(g: fn(&World), w: &World) -> fn() { || g(w) }
fn mk_item(w: &World) -> fn() { || push1(w) }
fn call0(f: fn()) { f() }
fn rp(world: &World) { let f = mk_call(push1, world); call0(f) }
fn main() {
    let w = World { entities: [Entity { hp: 3 }] }
    let first = &w.entities[0]
    rp(&w)
    print(first.hp)
}
