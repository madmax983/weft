// Follow-up F13.2, class UR (a value that a body runs and that no caller gives): a closure that a callee made runs in a loop; the clean twin (scratchpad f13d/w/a02_made_in_loop_c.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn push1(x: &World) { print(x.entities.len()) }
fn mk_call(g: fn(&World), w: &World) -> fn() { || g(w) }
fn call0(f: fn()) { f() }
fn rp(world: &World) { let i = 0; while i < 2 { let f = mk_call(push1, world); f(); i += 1 } }
fn main() {
    let w = World { entities: [Entity { hp: 3 }] }
    let first = &w.entities[0]
    rp(&w)
    print(first.hp)
}
