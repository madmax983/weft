// Follow-up F13.2, class UR (a value that a body runs and that no caller gives): a closure of the body that runs a captured item goes to a callee (scratchpad f13d/w/a01_local_closure_to_callee.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn push1(x: &World) { x.entities.push(Entity { hp: 1 }) }
fn mk_call(g: fn(&World), w: &World) -> fn() { || g(w) }
fn call0(f: fn()) { f() }
fn rp(world: &World) { let g = push1; let f = || g(world); call0(f) }
fn main() {
    let w = World { entities: [Entity { hp: 3 }] }
    let first = &w.entities[0]
    rp(&w)
    print(first.hp)
}
