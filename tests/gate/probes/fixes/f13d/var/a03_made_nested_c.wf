// Follow-up F13.2, class UR (a value that a body runs and that no caller gives): a maker gives back a closure that runs a closure of another maker; the clean twin (scratchpad f13d/w/a03_made_nested_c.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn push1(x: &World) { print(x.entities.len()) }
fn mk_call(g: fn(&World), w: &World) -> fn() { || g(w) }
fn call0(f: fn()) { f() }
fn mk2(g: fn(&World), w: &World) -> fn() { let h = mk_call(g, w); || h() }
fn rp(world: &World) { let f = mk2(push1, world); f() }
fn main() {
    let w = World { entities: [Entity { hp: 3 }] }
    let first = &w.entities[0]
    rp(&w)
    print(first.hp)
}
