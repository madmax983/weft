// Follow-up F13.2, class UR (a value that a body runs and that no caller gives): a closure gives a local a new value in a loop (scratchpad f13d/w/a09_rebind_in_closure_loop.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn push1(x: &World) { x.entities.push(Entity { hp: 1 }) }
fn mk_call(g: fn(&World), w: &World) -> fn() { || g(w) }
fn call0(f: fn()) { f() }
fn noop(w: &World) {}
fn rp(world: &World) { let g = noop; let i = 0; while i < 2 { g(world); let set = || { g = push1 }; set(); i += 1 } }
fn main() {
    let w = World { entities: [Entity { hp: 3 }] }
    let first = &w.entities[0]
    rp(&w)
    print(first.hp)
}
