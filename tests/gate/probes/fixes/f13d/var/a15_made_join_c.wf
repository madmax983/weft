// Follow-up F13.2, class UR (a value that a body runs and that no caller gives): an if joins two made closures; the clean twin (scratchpad f13d/w/a15_made_join_c.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn push1(x: &World) { print(x.entities.len()) }
fn mk_call(g: fn(&World), w: &World) -> fn() { || g(w) }
fn call0(f: fn()) { f() }
fn noop(w: &World) {}
fn rp(world: &World, b: bool) { let f = if b { mk_call(noop, world) } else { mk_call(push1, world) }; f() }
fn main() {
    let w = World { entities: [Entity { hp: 3 }] }
    let first = &w.entities[0]
    rp(&w, false)
    print(first.hp)
}
