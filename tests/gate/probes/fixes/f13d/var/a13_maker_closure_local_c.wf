// Follow-up F13.2, class UR (a value that a body runs and that no caller gives): a local closure maker; the clean twin (scratchpad f13d/w/a13_maker_closure_local_c.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn push1(x: &World) { print(x.entities.len()) }
fn mk_call(g: fn(&World), w: &World) -> fn() { || g(w) }
fn call0(f: fn()) { f() }
fn rp(world: &World) { let mk = |g: fn(&World)| || g(world); let f = mk(push1); f() }
fn main() {
    let w = World { entities: [Entity { hp: 3 }] }
    let first = &w.entities[0]
    rp(&w)
    print(first.hp)
}
