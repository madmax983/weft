// Follow-up F13.2, class UR (a value that a body runs and that no caller gives): a made closure in an rc object (scratchpad f13d/w/a17_rc_made.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn push1(x: &World) { x.entities.push(Entity { hp: 1 }) }
fn mk_call(g: fn(&World), w: &World) -> fn() { || g(w) }
fn call0(f: fn()) { f() }
struct Box1 { f: fn() }
fn rp(world: &World) { let b = Rc.new(Box1 { f: mk_call(push1, world) }); let f = b.f; f() }
fn main() {
    let w = World { entities: [Entity { hp: 3 }] }
    let first = &w.entities[0]
    rp(&w)
    print(first.hp)
}
