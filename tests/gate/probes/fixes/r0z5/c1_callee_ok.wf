// Plan stage R0z Z5: the clean twin of c1. The callee only reads `st.count`
// after the perform.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn f() / Run {
    let st = Stats { count: 0 }
    run(|| print(st.count))
    print(st.count)
}
fn main() / async {
    handle Run { fn run(g) { scope { s => s.spawn(g)
        resume(()) } } } in { f() }
}
