// Plan stage R0z Z5: the clause joins the task before the `resume`. The task
// does not run with the rest of the handled body.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => let t = s.spawn(g)
        t.join()
        resume(()) } } } in {
        run(|| print(st.count))
        st.count += 1
    }
}
