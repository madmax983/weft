// Plan stage R0z Z5: the clean twin of m1. Each run of the rest of the
// handled body only reads `st.count`.
struct Stats { count: u64 }
effect Run { multi fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => s.spawn(g)
        resume(())
        resume(()) } } } in {
        run(|| print(st.count))
        print(st.count)
    }
}
