// Plan stage R0z Z5: the bad twin of p1. The clause reads `st.count` after
// the `resume`, inside the scope, while the task can still write it: W0405.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => s.spawn(g)
        resume(())
        print(st.count) } } } in {
        run(|| st.count += 1)
    }
}
