// Plan stage R0z Z5: a read-only footprint. The task and the rest of the
// handled body only read `st`.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => s.spawn(g)
        resume(()) } } } in {
        run(|| print(st.count))
        let k = st.count + 1
        print(k)
    }
}
