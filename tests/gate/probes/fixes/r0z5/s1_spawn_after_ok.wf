// Plan stage R0z Z5: the task starts after the `resume` of a `once` clause.
// The rest of the handled body has ended then, so the write does not
// conflict with the task.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => resume(())
        s.spawn(g)
        print(0) } } } in {
        run(|| print(st.count))
        st.count += 1
    }
}
