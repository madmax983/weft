// Plan stage R0z Z5: two operations of one handler. The clause of `run` waits
// at its `resume` in a scope body while its task reads `st.count`. The clause
// of `bump` resumes, and its code after the `resume` writes `st.count` when
// the handled body ends, while the task can still run: W0405.
struct Stats { count: u64 }
effect Run { fn run(g: fn())
    fn bump() }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => s.spawn(g)
        resume(()) } }
        fn bump() { resume(())
            st.count += 1 } } in {
        run(|| print(st.count))
        bump()
    }
}
