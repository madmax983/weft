// Plan stage R0z Z5: the task writes `st.count` while the rest of the handled
// body reads it: W0405.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => s.spawn(g)
        resume(()) } } } in {
        run(|| st.count += 1)
        print(st.count)
    }
}
