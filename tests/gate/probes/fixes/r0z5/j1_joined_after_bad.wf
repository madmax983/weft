// Plan stage R0z Z5: the bad twin of j1. The clause joins the task after the
// `resume`, so the task runs with the rest of the handled body: W0405.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => let t = s.spawn(g)
        resume(())
        t.join() } } } in {
        run(|| print(st.count))
        st.count += 1
    }
}
