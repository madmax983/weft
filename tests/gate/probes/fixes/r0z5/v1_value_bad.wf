// Plan stage R0z Z5: the clause resumes with a value in the scope body. The
// rest of the handled body writes what the task reads: W0405.
struct Stats { count: u64 }
effect Get { fn get(g: fn()) -> u64 }
fn main() / async {
    let st = Stats { count: 0 }
    handle Get { fn get(g) { scope { s => s.spawn(g)
        resume(41) } } } in {
        let k = get(|| print(st.count))
        st.count += k
    }
}
