// Plan stage R0z Z5: the clean twin of f1. The local is outside the handled
// bodies, so it lives while the task runs.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    let r = &st
    let ok = handle Fail { fn fail(m) { false } } in {
        handle Run { fn run(g) { scope { s => s.spawn(g)
            resume(()) } } } in {
            run(|| print(r.count))
            fail("stop")
        }
        true
    }
    print(ok)
}
