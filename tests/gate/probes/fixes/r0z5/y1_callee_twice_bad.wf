// Plan stage R0z Z5: a callee performs `run` two times, so the clause runs
// again while its first run waits at its `resume`. Each run spawns a task
// that writes `st.count`: the two tasks race. The facts of a clause that
// runs again in its region are weak, so the program keeps the old pipeline
// (W0405).
struct Stats { count: u64 }
effect Run { fn run() }
fn f() / Run {
    run()
    run()
}
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run() { scope { s => s.spawn(|| st.count += 1)
        resume(()) } } } in { f() }
}
