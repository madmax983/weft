// Plan stage R0z Z5: the callee performs the operation, the clause spawns the
// closure of the callee and resumes in the scope body. The callee writes
// what the task reads: W0405 (the copy of the callee at the call).
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn f() / Run {
    let st = Stats { count: 0 }
    run(|| print(st.count))
    st.count += 1
}
fn main() / async {
    handle Run { fn run(g) { scope { s => s.spawn(g)
        resume(()) } } } in { f() }
}
