// Plan stage R0z Z5: the clean twin of n1. The rest of the handled body only
// reads `st.count`.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => s.spawn(g)
        scope { t => resume(()) } } } } in {
        run(|| print(st.count))
        print(st.count)
    }
}
