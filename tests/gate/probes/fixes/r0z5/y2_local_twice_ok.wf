// Plan stage R0z Z5: the clean twin of y2. Each task only reads `st.count`.
// The clause runs again in the region of its `resume`, so the program keeps
// the old pipeline.
struct Stats { count: u64 }
effect Run { fn run() }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run() { scope { s => s.spawn(|| print(st.count))
        resume(()) } } } in {
        run()
        run()
    }
}
