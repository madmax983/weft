// Plan stage R0z Z5: nested scopes. The outer scope body spawns the task, and
// the inner scope body resumes: W0405.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => s.spawn(g)
        scope { t => resume(()) } } } } in {
        run(|| print(st.count))
        st.count += 1
    }
}
