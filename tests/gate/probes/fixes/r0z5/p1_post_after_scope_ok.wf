// Plan stage R0z Z5: the task writes `st.count`, and the clause reads it after
// its scope ends. The task has ended then, so the program is clean.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => s.spawn(g)
        resume(()) }
        print(st.count) } } in {
        run(|| st.count += 1)
    }
}
