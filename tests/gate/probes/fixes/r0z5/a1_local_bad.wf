// Plan stage R0z Z5: the clause spawns the closure on a task of a scope, and
// resumes in the scope body. The task reads `st.count` while the rest of the
// handled body writes it: W0405.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => s.spawn(g)
        resume(()) } } } in {
        run(|| print(st.count))
        st.count += 1
    }
}
