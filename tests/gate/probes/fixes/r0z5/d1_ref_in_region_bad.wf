// Plan stage R0z Z5: the task reads through a reference into a local of the
// handled body, and the handled body ends while the task runs: the local
// goes, and the reference dangles (W0405).
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    handle Run { fn run(g) { scope { s => s.spawn(g)
        resume(()) } } } in {
        let st = Stats { count: 0 }
        let r = &st
        run(|| print(r.count))
    }
}
