// Plan stage R0z Z5: nested scopes. The inner scope body spawns the task and
// resumes: W0405.
struct Stats { count: u64 }
effect Run { fn run(g: fn()) }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => print(0)
        scope { t => t.spawn(g)
            resume(()) } } } } in {
        run(|| print(st.count))
        st.count += 1
    }
}
