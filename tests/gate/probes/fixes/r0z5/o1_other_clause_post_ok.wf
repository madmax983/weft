// Plan stage R0z Z5: the clean twin of o1. The code of `bump` after its
// `resume` only reads `st.count`.
struct Stats { count: u64 }
effect Run { fn run(g: fn())
    fn bump() }
fn main() / async {
    let st = Stats { count: 0 }
    handle Run { fn run(g) { scope { s => s.spawn(g)
        resume(()) } }
        fn bump() { resume(())
            print(st.count) } } in {
        run(|| print(st.count))
        bump()
    }
}
