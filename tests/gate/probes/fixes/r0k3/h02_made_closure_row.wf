// Plan stage R0k-b1 (design check, m2): the closure of `mk` performs `Run`
// through the row of `mk`, so it goes to the handler of the call of `mk`
// (the handler of `main`), not to the local handler of `outer` where it
// runs. The program prints 1, not 9. A copy of the closure body at the run
// that took the handlers of the run node would print 9.
effect Run { fn run(g: fn()) }
fn mk() -> fn() / Run { || run(|| print(1)) }
fn outer() / Run {
    let c = mk()
    handle Run { fn run(g) { print(9)
        resume(()) } } in { c() }
}
fn main() {
    handle Run { fn run(g) { g()
        resume(()) } } in { outer() }
}
