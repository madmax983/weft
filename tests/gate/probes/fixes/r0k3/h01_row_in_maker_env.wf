// Plan stage R0k-b1 (design check, m1): a closure performs an effect with
// no local handler where it is made through the handler environment of its
// maker, not through the handlers of its run node. Here the handled body of
// `Note` runs the closure, but its `note` goes to the row of `main`: W0805.
effect Run { fn run(g: fn()) }
effect Note { fn note(x: u64) }
fn main() {
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let k = || {
            run(|| print(1))
            note(2)
        }
        handle Note { fn note(x) { print(x)
            resume(()) } } in { k() }
    }
}
