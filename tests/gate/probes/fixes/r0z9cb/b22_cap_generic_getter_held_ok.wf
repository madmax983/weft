// Plan stage R0z Z9c-B (R-VIFACE, review round 3, B5 and B6; the ok twin):
// the closure runs a value of the interface of the body, so the call keeps
// the rule of main. The probe of the review:
// Review probe Z9c-B r3 (clean twin of t01): `h` pushes to another vector.
fn par<T>(h: fn(), get: fn() -> T, show: fn(T)) / async {
    let x = get()
    let f = || scope { s => s.spawn(h); () }
    f()
    show(x)
}
fn main() / async {
    let w = Vec.new()
    w.push(1)
    let u = Vec.new()
    par(|| u.push(2), || &w[0], |y: &u64| print(y))
}
