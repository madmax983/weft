// Plan stage R0z Z9c-B (R-VREF, review round 1, B1; probe r37 of the
// review): as b13, and `h` clears the vector (W0312 at the call of `par`).
fn par(h: fn(), v: &Vec<u64>) / async {
    let f = || scope { s => s.spawn(h); () }
    let r = &v[0]
    f()
    print(r)
}
fn main() / async {
    let w = Vec.new()
    w.push(1)
    par(|| w.clear(), &w)
}
