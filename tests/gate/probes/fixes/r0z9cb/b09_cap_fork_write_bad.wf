// Plan stage R0z Z9c-B (part 1): `f` runs its capture `g` in a branch of a
// `fork`, and `g` changes `c.k` through the environment of the closure
// (W0403 or W0405).
struct C { k: u64 }
fn main() / par {
    let c = C { k: 0 }
    let g = || c.k += 1
    let f = || { let _ = fork(g, || print(c.k)); () }
    f()
}
