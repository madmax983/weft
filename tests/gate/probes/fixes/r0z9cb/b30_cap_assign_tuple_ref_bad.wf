// Plan stage R0z Z9c-B (R-VSTORE, review round 4, B7; the bad twin): the
// closure stores a reference into a capture before its task starts, so the
// call keeps the rule of main (root: issue #104). The probe of the review:
// Review probe Z9c-B r4: f sets a captured tuple (&u64, u64) into w, then g pushes w; main reads it.
fn main() / async {
    let w = Vec.new()
    w.push(1)
    let u = Vec.new()
    u.push(5)
    let t = (&u[0], 1)
    let g = || w.push(2)
    let f = || { t = (&w[0], 2); scope { s => s.spawn(g); () } }
    f()
    print(t.0)
}
