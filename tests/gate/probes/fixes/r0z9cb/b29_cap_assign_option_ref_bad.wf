// Plan stage R0z Z9c-B (R-VSTORE, review round 4, B7; the bad twin): the
// closure stores a reference into a capture before its task starts, so the
// call keeps the rule of main (root: issue #104). The probe of the review:
// Review probe Z9c-B r4: f sets a captured Option<&u64> into w, then g pushes w; main reads it after f().
fn main() / async {
    let w = Vec.new()
    w.push(1)
    let o = None
    let g = || w.push(2)
    let f = || { o = Some(&w[0]); scope { s => s.spawn(g); () } }
    f()
    match o { Some(x) => print(x), None => () }
}
