// Plan stage R0z Z9c-B (part 1): the closure `c` runs its capture `f` as
// plain code, then again as a task. The second run reads `a`, which the
// first run made point into `w` before it pushed to `w`.
fn main() / async {
    let w = Vec.new()
    w.push(1)
    let a: Option<&u64> = None
    let f = || {
        match a { Some(y) => print(y), None => print(0) }
        a = Some(&w[0])
        w.push(2)
    }
    let c = || { f(); scope { s => s.spawn(f) } }
    c()
}
