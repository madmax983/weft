// Plan stage R0z Z9c-B (part 1, R-VCLAUSE): the clean twin of b05. The task
// and the clause only read `c.k`.
effect Note { fn note(x: u64) }
struct C { k: u64 }
fn par(h: fn(), k: fn()) / async {
    handle Note { fn note(x) { k(); resume(()) } } in {
        let g = || scope { s => s.spawn(h); note(1) }
        g()
    }
}
fn main() / async {
    let c = C { k: 0 }
    par(|| print(c.k), || print(c.k + 1))
}
