// Plan stage R0z Z9c-B (R-VREF, review round 2, B3 and B4; the ok twin):
// a reference can be live in the window of the task, so the call keeps the
// rule of main. The probe of the review:
// Review probe Z9c-B r2 (B1 with a known capture in a function): `par` gets `v`, and its closure `f` gets
// `&v` and holds `r` into it while the task of the capture `g` pushes through `v`.
fn par(v: &Vec<u64>) / mut(v), async {
    let g = || print(v.len())
    let f = |u: &Vec<u64>| { let r = &u[0]; scope { s => s.spawn(g); () }; print(r) }
    f(v)
}
fn main() / async {
    let w = Vec.new()
    w.push(1)
    par(&w)
}
