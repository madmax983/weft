// Plan stage R0z Z9c-B (R-VCLAUSE): the clean twin of b15. `k` reads a
// separate place.
effect Note { fn note(x: u64) }
struct C { k: u64, j: u64 }
fn helper() / Note { note(1) }
fn par(h: fn(), k: fn()) / async {
    let f = || handle Note { fn note(x) { k(); resume(()) } } in { scope { s => s.spawn(h); helper(); () } }
    f()
}
fn main() / async {
    let c = C { k: 0, j: 0 }
    par(|| c.k += 1, || print(c.j))
}
