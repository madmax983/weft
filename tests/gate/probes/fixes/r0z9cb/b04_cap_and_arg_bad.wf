// Plan stage R0z Z9c-B (part 1, R-VARG): `f` spawns its capture `g` and runs
// its parameter `x` while the task runs. The summary of `f` has no `with` of
// two kinds, so the old pipeline checks the program (W0405).
struct C { k: u64 }
fn main() / async {
    let c = C { k: 0 }
    let g = || print(c.k)
    let f = |x: fn()| scope { s => s.spawn(g); x(); () }
    f(|| c.k += 1)
}
