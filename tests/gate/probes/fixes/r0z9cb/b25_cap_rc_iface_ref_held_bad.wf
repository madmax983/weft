// Plan stage R0z Z9c-B (R-VIFACE, review round 3, B5 and B6; the bad twin):
// the closure runs a value of the interface of the body, so the call keeps
// the rule of main. The probe of the review:
// Review probe Z9c-B r3: `par` holds a reference into an `rc` object across the call of `f`, whose task `h` pushes to the object.
struct Cache { w: Vec<u64>, u: Vec<u64> }
fn par(h: fn(), c: Rc<Cache>) / mut(Cache), async {
    let r = &c.w[0]
    let f = || scope { s => s.spawn(h); () }
    f()
    print(r)
}
fn main() / mut(Cache), async {
    let c = Rc.new(Cache { w: Vec.new(), u: Vec.new() })
    c.w.push(1)
    let d = c.clone()
    par(|| d.w.push(2), c)
}
