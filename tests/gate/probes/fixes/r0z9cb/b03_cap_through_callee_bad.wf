// Plan stage R0z Z9c-B (part 1): `f` gives its capture `g` to `run`, which
// spawns it. A task of `main` reads `c.k` while the task of `g` changes it
// (W0405).
struct C { k: u64, j: u64 }
fn run(h: fn()) / async { scope { s => s.spawn(h); () } }
fn main() / async {
    let c = C { k: 0, j: 0 }
    let g = || c.k += 1
    let f = || run(g)
    scope { s0 =>
        s0.spawn(|| print(c.k))
        f()
    }
}
