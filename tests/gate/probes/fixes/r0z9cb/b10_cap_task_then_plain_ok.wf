// Plan stage R0z Z9c-B (part 1): the clean twin of b10. The closure `c`
// runs its capture `f` as a task, then again as plain code; `f` only
// prints.
fn mid(f: fn()) / async {
    let c = |b: bool| { scope { s => s.spawn(|| f()) }; f() }
    c(true)
}
fn main() / async {
    let w = Vec.new()
    w.push(1)
    mid(|| print(w[0]))
}
