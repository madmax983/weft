// Plan stage R0z Z8, part (b).
// A loop in the handled body: each turn gives `f` the closure that
// performs `log`, runs it, and then gives `f` a new value.
effect Log { multi fn log(msg: String) }
fn main() {
    let f = || print(0)
    let i = 0
    handle Log { fn log(m) { resume(())
        resume(()) } } in {
        while i < 2 {
            f = || log("x")
            f()
            f = || print(1)
            i += 1
        }
    }
    f()
}
