// Plan stage R0z Z8, part (c).
// g prints. The handled body gives g to the clause of an outer handler.
effect Note { fn note(x: u64) }
effect Give { fn give(f: fn()) }
fn main() {
    handle Give { fn give(f) { f(); resume(()) } } in {
        handle Note { fn note(x) { print(x); resume(()) } } in {
            let f1 = || note(5)
            let g = || { print(1) }
            f1()
            give(g)
        }
    }
}
