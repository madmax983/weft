// weft: library
// Plan stage R0z Z8, part (c).
// Library mode: a public function gives back g, which runs f1 after the
// `handle`.
effect Note { fn tell(x: u64) }
pub fn make() -> fn() {
    handle Note { fn tell(x) { print(x); resume(()) } } in {
        let f1 = || tell(5)
        let g = || { f1() }
        g
    }
}
