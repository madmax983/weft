// Plan stage R0z Z8, part (a).
// The closure that the inner clause gives back performs `get` of the outer
// handler, and runs the function value that it gets.
effect GN {
    fn get() -> fn()
    fn note(x: u64)
}
fn main() {
    handle GN {
        fn get() { resume(|| print(0)) }
        fn note(x) { print("outer", x); resume(()) }
    } in {
        handle GN {
            fn get() { resume(|| { let g = get(); g() }) }
            fn note(x) { print("inner", x); resume(()) }
        } in {
            let f = get()
            f()
        }
    }
}
