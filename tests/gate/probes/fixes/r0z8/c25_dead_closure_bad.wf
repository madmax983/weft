// Plan stage R0z Z8, part (c), R-DEAD (the review of Z8, round 2).
// The form of `z7rev1/p/k4_two` and an unrelated function `other` with a
// closure `d` that no code runs; `d` runs `f1`, a closure of its maker.
// The clause of `Run` reads `r` after `v.clear()`. The dead closure keeps
// the pending escape of main, so the view with the copies stays in scope.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn w2(g: fn() / Pick) / Run, Pick { run(g) }
fn w(g: fn() / Pick) / Run, Pick { w2(g) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { g()
        print(r)
        resume(()) } } in { w(|| print(pick())) }
    v.clear()
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}

effect DNote { fn dnote(x: u64) }
fn other() {
    handle DNote { fn dnote(x) { print(x); resume(()) } } in {
        let f1 = || dnote(5)
        let d = || { f1() }
        print(1)
    }
}
