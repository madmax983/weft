// Plan stage R0z Z8, part (c).
// h runs g, which runs f1: two levels of closures. h runs after the
// `handle`.
effect Note { fn note(x: u64) }
fn main() {
    let keep = || print(0)
    handle Note { fn note(x) { print(x); resume(()) } } in {
        let f1 = || note(5)
        let g = || { f1() }
        let h = || { g() }
        keep = h
    }
    keep()
}
