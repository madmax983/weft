// Plan stage R0z Z8, part (c).
// g runs f1 in the handled body; a task gets a closure that only prints.
effect Note { fn note(x: u64) }
fn main() {
    handle Note { fn note(x) { print(x); resume(()) } } in {
        let f1 = || note(5)
        let g = || { f1() }
        g()
        scope { s =>
            s.spawn(|| print(2))
        }
    }
}
