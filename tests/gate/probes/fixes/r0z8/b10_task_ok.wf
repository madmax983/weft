// Plan stage R0z Z8, part (b).
// A `multi` continuation, and a scope in the handled body after the run of
// the clause. The write of `f` follows the scope.
effect Log { multi fn log(msg: String) }
fn main() {
    let f = || print(0)
    handle Log { fn log(m) { resume(())
        resume(()) } } in {
        f = || log("x")
        f()
        scope { s =>
            s.spawn(|| print(2))
        }
        f = || print(1)
    }
    f()
}
