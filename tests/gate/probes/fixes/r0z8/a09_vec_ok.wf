// Plan stage R0z Z8, part (a).
// The closure that the inner clause gives back goes into a Vec of the
// handled body, and runs from there.
effect GN {
    fn get() -> fn()
    fn note(x: u64)
}
fn main() {
    handle GN {
        fn get() { resume(|| print(0)) }
        fn note(x) { print("outer", x); resume(()) }
    } in {
        handle GN {
            fn get() { resume(|| note(1)) }
            fn note(x) { print("inner", x); resume(()) }
        } in {
            let fs: Vec<fn()> = Vec.new()
            fs.push(get())
            let f = fs[0]
            f()
        }
    }
}
