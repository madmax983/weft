// Plan stage R0z Z8, part (b).
// A `multi` clause runs `f` after its `resume`. The rest of the handled
// body runs `stop`, whose clause does not resume: the write of `f` after
// it does not run, and `f` performs `log` outside the handler.
effect Log {
    multi fn log(msg: String)
    fn stop()
}
fn main() {
    let f = || print(0)
    handle Log {
        fn log(m) { resume(()); f(); resume(()) }
        fn stop() { print("stop") }
    } in {
        f = || log("x")
        f()
        stop()
        f = || print(1)
    }
}
