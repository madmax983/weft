// Plan stage R0z Z8, part (a).
// The closure that the inner clause gives back captures a local of the
// clause. The clause waits in its `resume` while the handled body runs it.
effect GN {
    fn get() -> fn()
    fn note(x: u64)
}
fn main() {
    handle GN {
        fn get() { resume(|| print(0)) }
        fn note(x) { print("outer", x); resume(()) }
    } in {
        handle GN {
            fn get() {
                let v = 7
                resume(|| note(v))
            }
            fn note(x) { print("inner", x); resume(()) }
        } in {
            let f = get()
            f()
        }
    }
}
