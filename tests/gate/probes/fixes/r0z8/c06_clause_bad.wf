// Plan stage R0z Z8, part (c).
// The closure g runs f1, which performs `note`. The body gives g to the
// clause of `run` of the same handler: the clause runs outside the handler.
effect Note {
    fn note(x: u64)
    fn run(f: fn())
}
fn main() {
    handle Note {
        fn note(x) { print(x); resume(()) }
        fn run(f) { f(); resume(()) }
    } in {
        let f1 = || note(5)
        let g = || { f1() }
        run(g)
    }
}
