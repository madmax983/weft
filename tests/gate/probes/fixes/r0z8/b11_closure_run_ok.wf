// Plan stage R0z Z8, part (b).
// A closure of the handled body performs the `multi` operation and runs
// two times. A write of `f` follows each run.
effect Log { multi fn log(msg: String) }
fn main() {
    let f = || print(0)
    handle Log { fn log(m) { resume(())
        resume(()) } } in {
        let g = || log("g")
        f = || log("x")
        g()
        f = || log("y")
        g()
        f = || print(1)
    }
    f()
}
