// Plan stage R0z Z8, part (a).
// The closure that the inner clause gives back reads a Vec of the clause
// through a reference. It runs after the inner `handle`, when the frame of
// the clause is gone.
effect GN {
    fn get() -> fn()
    fn note(x: u64)
}
fn main() {
    handle GN {
        fn get() { resume(|| print(0)) }
        fn note(x) { print("outer", x); resume(()) }
    } in {
        let keep = || print(9)
        handle GN {
            fn get() {
                let v = Vec.new()
                v.push(4)
                resume(|| note(v[0]))
                v.clear()
            }
            fn note(x) { print("inner", x); resume(()) }
        } in {
            let f = get()
            keep = f
        }
        keep()
    }
}
