// Plan stage R0z Z8, part (a).
// The closure that the inner clause gives back performs `note` of the
// outer handler. The inner handler has no clause for `keep`: the clause of
// the outer handler gets the closure, and runs it after its `resume`.
effect GN {
    fn get() -> fn()
    fn note(x: u64)
    fn keep(f: fn())
}
fn main() {
    handle GN {
        fn get() { resume(|| print(0)) }
        fn note(x) { print("outer", x); resume(()) }
        fn keep(f) { resume(()); f() }
    } in {
        handle GN {
            fn get() { resume(|| note(1)) }
            fn note(x) { print("inner", x); resume(()) }
        } in {
            let f = get()
            keep(f)
        }
    }
}
