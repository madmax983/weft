// Plan stage R0z Z8, part (c).
// The closure g runs f1, which performs `Note`. g goes into a local Vec and
// runs in the handled body.
effect Note { fn note(x: u64) }
fn main() {
    handle Note { fn note(x) { print(x); resume(()) } } in {
        let keep: Vec<fn()> = Vec.new()
        let f1 = || note(5)
        let g = || { f1() }
        keep.push(g)
        let k = keep[0]
    k()
    }
}
