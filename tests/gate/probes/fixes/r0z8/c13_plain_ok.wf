// Plan stage R0z Z8, part (c).
// A closure g runs the closure f1, which performs `Note` through the capability of the handled body.
effect Note { fn note(x: u64) }
fn main() {
    handle Note { fn note(x) { print(x); resume(()) } } in {
        let f1 = || note(5)
        let g2 = || {
            f1()
        }
        g2()
    }
}
