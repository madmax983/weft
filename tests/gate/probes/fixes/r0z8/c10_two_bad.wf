// Plan stage R0z Z8, part (c).
// g runs f1 in one arm; the other arm keeps g in an outer local, which runs
// after the `handle`.
effect Note { fn note(x: u64) }
fn main() {
    let keep = || print(0)
    handle Note { fn note(x) { print(x); resume(()) } } in {
        let f1 = || note(5)
        let g = || { f1() }
        if true { g() } else { print(1) }
        keep = g
    }
    keep()
}
