// Plan stage R0z Z8, part (a).
// A callee performs `get` and runs the closure that the inner clause gives
// back.
effect GN {
    fn get() -> fn()
    fn note(x: u64)
}
fn use_it() / GN {
    let f = get()
    f()
}
fn main() {
    handle GN {
        fn get() { resume(|| print(0)) }
        fn note(x) { print("outer", x); resume(()) }
    } in {
        handle GN {
            fn get() { resume(|| note(1)) }
            fn note(x) { print("inner", x); resume(()) }
        } in {
            use_it()
        }
    }
}
