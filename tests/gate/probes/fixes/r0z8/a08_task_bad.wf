// Plan stage R0z Z8, part (a).
// A task runs the closure that the inner clause gives back: the outer
// handler is on another task.
effect GN {
    fn get() -> fn()
    fn note(x: u64)
}
fn main() {
    handle GN {
        fn get() { resume(|| print(0)) }
        fn note(x) { print("outer", x); resume(()) }
    } in {
        handle GN {
            fn get() { resume(|| note(1)) }
            fn note(x) { print("inner", x); resume(()) }
        } in {
            let f = get()
            scope { s =>
                s.spawn(|| f())
            }
        }
    }
}
