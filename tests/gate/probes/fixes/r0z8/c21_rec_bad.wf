// Plan stage R0z Z8, part (c).
// A recursive function installs the handler. The inner level keeps g of
// the outer level in a struct field and gives it back; the outer level runs
// it after its own `handle`.
effect Note { fn tell(x: u64) }
struct K { f: fn() }
fn go(n: u64) -> K {
    let out = handle Note { fn tell(x) { print(x); resume(()) } } in {
        let f1 = || tell(n)
        let g = || { f1() }
        g()
        K { f: g }
    }
    out
}
fn main() {
    let k = go(1)
    let f = k.f
    f()
}
