// Plan stage R0z Z8, part (c).
// The closure g runs f1, which performs `Note`. g goes into a Vec of an
// outer local and runs after the `handle`: no handler.
effect Note { fn note(x: u64) }
fn main() {
    let keep: Vec<fn()> = Vec.new()
    handle Note { fn note(x) { print(x); resume(()) } } in {
        let f1 = || note(5)
        let g = || { f1() }
        g()
        keep.push(g)
    }
    let k = keep[0]
    k()
}
