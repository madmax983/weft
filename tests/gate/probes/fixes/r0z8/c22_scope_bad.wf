// Plan stage R0z Z8, part (c).
// A task of a scope runs h, which runs g, which runs f1: the handler is on
// the task of the scope body.
effect Note { fn tell(x: u64) }
fn main() {
    handle Note { fn tell(x) { print(x); resume(()) } } in {
        let f1 = || tell(5)
        let g = || { f1() }
        let h = || { g() }
        scope { s =>
            s.spawn(h)
        }
    }
}
