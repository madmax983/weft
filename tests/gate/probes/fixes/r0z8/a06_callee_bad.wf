// Plan stage R0z Z8, part (a).
// A callee performs `get` and gives back the closure of the inner clause.
// `main` runs it after the outer `handle`.
effect GN {
    fn get() -> fn()
    fn note(x: u64)
}
fn take() -> fn() / GN { get() }
fn main() {
    let keep = || print(0)
    handle GN {
        fn get() { resume(|| print(0)) }
        fn note(x) { print("outer", x); resume(()) }
    } in {
        handle GN {
            fn get() { resume(|| note(1)) }
            fn note(x) { print("inner", x); resume(()) }
        } in {
            keep = take()
        }
    }
    keep()
}
