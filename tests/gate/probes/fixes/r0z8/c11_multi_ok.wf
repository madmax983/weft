// Plan stage R0z Z8, part (c).
// g runs f1 in a handled body that a `multi` clause runs two times.
effect Note { fn note(x: u64) }
effect Pick { multi fn pick() -> bool }
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        handle Note { fn note(x) { print(x); resume(()) } } in {
            let f1 = || note(5)
            let g = || { f1() }
            let b = pick()
            g()
            print(b)
        }
    }
}
