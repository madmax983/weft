// Plan stage R0z Z7: the clean twin of o2. The clause runs `c` before
// `g`, so `c` is not live across `g`.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn eat(w: Vec<u64>) { print(w.len()) }
fn f() / Pick {
    let w = Vec.new()
    let c = || eat(w)
    handle Run { fn run(g) { c()
        g()
        resume(()) } } in { run(|| print(pick())) }
}
fn main() {
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f() }
}
