// Plan stage R0z Z7 (review round 2): as g1, but `f` makes the closure
// `p` before the `handle`. The row of the clause stays pending, and the
// program keeps the fallback (the old pipeline misses the fault).
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn(), r: &u64) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let p = || v.push(pick())
    handle Run { fn run(g, r) { g()
        print(r)
        resume(()) } } in {
        p()
        let r = &v[0]
        run(|| print(pick()), r)
        v.clear()
    }
}
fn main() {
    let v = Vec.new()
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
