// Plan stage R0z Z7 (review round 2): the clean twin of c4. The rest of
// `f` reads `v` and does not change it.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { g()
        resume(()) } } in { run(|| { print(pick())
            print(r) }) }
    print(v.len())
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
