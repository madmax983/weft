// Plan stage R0z Z7 (review round 2): as z3, but the handled body runs the
// local closure `p`, which performs `pick`, before `run`. The rest of `f`
// clears `v`, so a later run of the clause reads `r` after the clear: a
// fault. The run of a function value of `f` can wait at a `multi`
// operation of a caller, so the row of the clause stays pending, and the
// program keeps the fallback (the old pipeline misses the fault).
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn(), r: &u64) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    handle Run { fn run(g, r) { g()
        print(r)
        resume(()) } } in {
        let p = || pick()
        let n = p()
        v.push(n)
        let r = &v[0]
        run(|| print(pick()), r)
        v.clear()
    }
}
fn main() {
    let v = Vec.new()
    
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
