// Plan stage R0z Z7 (the review of Z7): as z1, with the value given at the
// perform. The handled body performs `pick` before `run`, pushes to `v` and
// gives `&v[0]` to the clause, and the clause runs `g`, which performs
// `pick`. The rest of `f` clears `v`, so a later run of the clause reads `r`
// after the clear: a fault. The row stays pending, the old pipeline misses
// the fault, and the program keeps the fallback.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn(), r: &u64) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    handle Run { fn run(g, r) { g()
        print(r)
        resume(()) } } in {
        let n = pick()
        v.push(n)
        let r = &v[0]
        run(|| print(pick()), r)
        v.clear()
    }
}
fn main() {
    let v = Vec.new()
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
