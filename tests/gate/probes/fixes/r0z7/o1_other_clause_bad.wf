// Plan stage R0z Z7: the clause of `Run` gives `g` to the clause of `Go`,
// which runs it. The value performs `pick`, so the clause of `Go` runs again
// after the rest of `f` cleared `v`: a fault. The facts of the clause of
// `Run` do not have the row of the clause of `Go`, so the program is pending.
// The `ir` pipeline rejects it (W0301).
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
effect Go { multi fn go(g: fn()) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Go { fn go(g) { g()
        print(r)
        resume(()) } } in {
        handle Run { fn run(g) { go(g)
            resume(()) } } in { run(|| print(pick())) }
    }
    v.clear()
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
