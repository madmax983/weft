// Plan stage R0z Z7 (review round 4): as m1, but the clause makes
// `r = &v[0]` in its own body. The row stays pending, so the program keeps
// the fallback (a refusal probe).
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn(&u64)) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    handle Run { fn run(g) { let r = &v[0]
        g(r)
        resume(()) } } in { run(|x| { print(pick())
            print(x) }) }
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
