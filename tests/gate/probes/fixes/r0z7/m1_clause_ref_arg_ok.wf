// Plan stage R0z Z7 (review round 4): the clause gives the captured
// `r = &v[0]` to `g` as an argument, and `g` performs `pick`, then reads
// it. The rest of `f` does not change `v`. A reference goes into the run,
// so the row stays pending: the copy of the frame of `g` would give a false
// W0301. The program keeps the fallback (a refusal probe).
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn(&u64)) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { g(r)
        resume(()) } } in { run(|x| { print(pick())
            print(x) }) }
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
