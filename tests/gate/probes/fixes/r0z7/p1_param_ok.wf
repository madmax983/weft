// Plan stage R0z Z7: the clean twin of p1. The handled body reads `v`
// and does not change it. The value `f` does not resume more than once, so
// the run of `f` is no row of the clause (main gives a false W0301 here).
effect Run { multi fn run(n: u64, f: fn() -> u64) -> u64 }
fn main() {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    let total = handle Run { fn run(n, f) { let a = resume(n + f())
        resume(a + f()) } } in {
        let x = run(1) { print(r)
            10 }
        print(v.len())
        x
    }
    print(total)
}
