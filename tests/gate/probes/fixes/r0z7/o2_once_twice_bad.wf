// Plan stage R0z Z7: the clause runs the `once` closure `c` after `g`.
// The value `g` performs `pick`, so each later `resume` of `pick` runs the
// rest of the clause again, and `c` runs again. `c` is live across `g`,
// which can resume more than once: W0503.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn eat(w: Vec<u64>) { print(w.len()) }
fn f() / Pick {
    let w = Vec.new()
    let c = || eat(w)
    handle Run { fn run(g) { g()
        c()
        resume(()) } } in { run(|| print(pick())) }
}
fn main() {
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f() }
}
