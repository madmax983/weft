// Plan stage R0z Z7: the clean twin of c1. The rest of `f` does not
// change `v`.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn pk() -> u64 / Pick { pick() + 1 }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { g()
        print(r)
        resume(()) } } in { run(|| print(pk())) }
    print(v.len())
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
