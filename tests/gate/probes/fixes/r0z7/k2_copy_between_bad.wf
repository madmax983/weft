// Plan stage R0z Z7, the copies of stage R0k-a (the form of
// fixes/r0k/rv_p04_c2_multi): between its two `resume`s the clause runs `h`,
// which performs `pick`, and `g`. The first `resume` runs the rest of `w`,
// which clears `v`. Then `g` reads `r`, which points into `v`: W0301.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn w(v: &Vec<u64>) / Run, mut(v) {
    let r = &v[0]
    run(|| print(r))
    v.clear()
}
fn f(v: &Vec<u64>) / Pick, mut(v) {
    handle Run { fn run(g) { resume(())
        let h = || print(pick())
        h()
        g()
        resume(()) } } in { w(v) }
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
