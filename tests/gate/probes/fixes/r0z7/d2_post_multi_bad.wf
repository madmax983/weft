// Plan stage R0z Z7: as d1, but the clause runs `g` after its `resume`
// (a row after the `resume`). The second run of the rest of the clause
// reads `r` after the first run cleared `v`: W0301.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { resume(())
        g()
        print(r) } } in { run(|| print(pick())) }
    v.clear()
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
