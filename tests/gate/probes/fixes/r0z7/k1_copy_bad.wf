// Plan stage R0z Z7, the copies of stage R0k-a: the callee `w` gives `g`
// to the operation `run` of the handler of `f`. With the copy of `w` at the
// call, the clause runs the value of `f`, which performs `pick`. The second
// run of the clause reads `r` after the rest of `f` cleared `v`: W0301.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn w(g: fn()) / Run { run(g) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { g()
        print(r)
        resume(()) } } in { w(|| print(pick())) }
    v.clear()
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
