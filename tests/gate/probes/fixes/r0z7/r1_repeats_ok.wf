// Plan stage R0z Z7: the clean twin of r1. The rest of `f` does not
// change `v`.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn twice(g: fn()) { g()
    g() }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { twice(g)
        print(r)
        resume(()) } } in { run(|| print(pick())) }
    print(v.len())
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
