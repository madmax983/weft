// Plan stage R0z Z7: the clean twin of k2. The callee changes `v` before
// it makes `r`.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn w(v: &Vec<u64>) / Run, mut(v) {
    v.push(2)
    let r = &v[0]
    run(|| print(r))
}
fn f(v: &Vec<u64>) / Pick, mut(v) {
    handle Run { fn run(g) { resume(())
        let h = || print(pick())
        h()
        g()
        resume(()) } } in { w(v) }
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
