// Plan stage R0z Z7 (review round 3): the clause runs the value of the
// perform, which performs `pick` and then reads `v.len()` through the
// captured `v`. After the `handle`, `f` pushes to `v`. The `Vec` stays, so
// no fault. The environment of the value holds a reference, so the row stays
// pending: the copy of the frame of the value would give a false W0301 (main
// gives the same false W0301 for a known closure, issue #79). The program
// keeps the fallback (a refusal probe).
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    handle Run { fn run(g) { g()
        resume(()) } } in { run(|| { print(pick())
            print(v.len()) }) }
    v.push(4)
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
