// Plan stage R0z Z7: a `multi` clause runs its function value `g` between
// two `resume`s. The first `resume` runs the rest of the handled body, and
// that code clears `v`. Then `g` reads `r`, which points into `v`: W0301.
// The value does not resume more than once, so the clause has no row.
effect Run { multi fn run(g: fn()) }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { resume(())
        g()
        resume(()) } } in {
        let r = &v[0]
        run(|| print(r))
        v.clear()
    }
}
