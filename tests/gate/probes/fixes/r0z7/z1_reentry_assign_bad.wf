// Plan stage R0z Z7 (the review of Z7): the handled body performs `pick`, a
// `multi` operation of a handler of a caller, then pushes to `v` and gives
// `&v[0]` to the clause. The clause runs `k`, which performs `pick`. The rest
// of `f` clears `v`, so a later run of the clause reads `r` after the clear:
// a fault. The row of the run of `k` comes only from the analysis, and the
// clause has a reference parameter, so the row stays pending (the shadow
// variable of `r` would give the clean twin a false W0301). The old pipeline
// misses the fault, and the program keeps the fallback.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn(), r: &u64) }
fn f(v: &Vec<u64>, ks: &Vec<fn() / Pick>) / Pick, mut(v, ks) {
    handle Run { fn run(g, r) { g()
        print(r)
        resume(()) } } in {
        let n = pick()
        v.push(n)
        let r = &v[0]
        let k = ks[0]
        run(k, r)
        ks[0] = || print(pick())
        v.clear()
    }
}
fn main() {
    let v = Vec.new()
    let ks = Vec.new()
    ks.push(|| print(7))
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v, &ks) }
}
