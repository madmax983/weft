// Plan stage R0z Z7: the clean twin of a1. The handled body changes `v`
// before it makes `r`. The value `g` does not resume more than once, so the
// run of `g` is no `multi` point (main gives a false W0301 here).
effect Run { multi fn run(g: fn()) }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { resume(())
        g()
        resume(()) } } in {
        v.push(2)
        let r = &v[0]
        run(|| print(r))
    }
}
