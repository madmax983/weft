// Plan stage R0z Z7 (the review of Z7): the clean twin of z1. The rest of
// `f` reads `v` and does not change it. The row of the run of `k` in the
// clause stays pending, so the program keeps the fallback and gets no false
// W0301 (a refusal probe).
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn(), r: &u64) }
fn f(v: &Vec<u64>, ks: &Vec<fn() / Pick>) / Pick, mut(v, ks) {
    handle Run { fn run(g, r) { g()
        print(r)
        resume(()) } } in {
        let n = pick()
        v.push(n)
        let r = &v[0]
        let k = ks[0]
        run(k, r)
        ks[0] = || print(pick())
        print(v.len())
    }
}
fn main() {
    let v = Vec.new()
    let ks = Vec.new()
    ks.push(|| print(7))
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v, &ks) }
}
