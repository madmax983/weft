// Plan stage R0z Z7 (review round 2): the clean twin of g1. The rest of
// `f` reads `v`. The row stays pending, so the program keeps the fallback
// and gets no false W0301 (a refusal probe).
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn(), r: &u64) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    handle Run { fn run(g, r) { g()
        print(r)
        resume(()) } } in {
        let p = || pick()
        let n = p()
        v.push(n)
        let r = &v[0]
        run(|| print(pick()), r)
        print(v.len())
    }
}
fn main() {
    let v = Vec.new()
    
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
