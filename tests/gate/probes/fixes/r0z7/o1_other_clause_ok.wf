// Plan stage R0z Z7: the clean twin of o1. The program keeps the
// fallback: the facts of the clause of `Run` do not have the row of the
// clause of `Go` (a refusal probe).
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
effect Go { multi fn go(g: fn()) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Go { fn go(g) { g()
        print(r)
        resume(()) } } in {
        handle Run { fn run(g) { go(g)
            resume(()) } } in { run(|| print(pick())) }
    }
    print(v.len())
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
