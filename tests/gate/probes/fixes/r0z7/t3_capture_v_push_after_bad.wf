// Plan stage R0z Z7 (review round 3): the bad twin of t3. The value reads
// the captured `r`, which points into `v`, after `pick`, and `f` pushes to
// `v` after the `handle`. A later `resume` of `pick` reads `r` after the
// push: a fault. The row stays pending, so the program keeps the fallback,
// and the old pipeline misses the fault.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { g()
        resume(()) } } in { run(|| { print(pick())
            print(r) }) }
    v.push(4)
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
