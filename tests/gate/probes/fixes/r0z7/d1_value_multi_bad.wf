// Plan stage R0z Z7: the clause runs `g`, and `g` performs `pick`, a
// `multi` operation of a handler of a caller of `f`. The handler in `main`
// resumes two times. So the rest of the clause and the rest of `f` after
// the `handle` run two times. The first run clears `v`. The second run reads
// `r`, which points into `v`: W0301. Only the analysis finds this row.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { g()
        print(r)
        resume(()) } } in { run(|| print(pick())) }
    v.clear()
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
