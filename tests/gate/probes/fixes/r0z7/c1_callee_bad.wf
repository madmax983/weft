// Plan stage R0z Z7: `g` performs `pick` through the callee `pk`. The
// handler in `main` resumes two times, so the clause runs again after the
// rest of `f` cleared `v`: W0301.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
fn pk() -> u64 / Pick { pick() + 1 }
fn f(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { g()
        print(r)
        resume(()) } } in { run(|| print(pk())) }
    v.clear()
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(1)
        resume(2) } } in { f(&v) }
}
