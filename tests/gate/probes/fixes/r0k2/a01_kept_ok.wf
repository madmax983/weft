// Plan stage R0k-a2: the clean twin of a01. The closure reads `r` before it
// runs the value of the clause.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    handle Get { fn get() { resume(|| c.v.clear()) } } in {
        let r = &c.v[0]
        let k = || { print(r)
            let g = get()
            g() }
        k()
    }
}
