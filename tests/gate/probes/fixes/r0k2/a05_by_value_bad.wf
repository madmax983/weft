// Plan stage R0k-a2 (a refusal: a `ByMove` capture): the closure moves `w`
// into its value, so the run of `k` gets no copy and the program keeps the
// old pipeline. The value of the clause clears `c.v` while `r` points
// into it.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn eat(w: Vec<u64>) { print(w.len()) }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    let w = Vec.new()
    handle Get { fn get() { resume(|| c.v.clear()) } } in {
        let r = &c.v[0]
        let k = || { eat(w)
            let g = get()
            g() }
        k()
        print(r)
    }
}
