// Plan stage R0k-a2 (a `ByMove` capture): the closure moves `w` into its
// value. Plan stage R0z Z3: the run of `k` gets a copy that moves the value
// first and reads `w` through its environment local. The value of the clause
// clears `c.v` while `r` points into it: W0301.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn eat(w: Vec<u64>) { print(w.len()) }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    let w = Vec.new()
    handle Get { fn get() { resume(|| c.v.clear()) } } in {
        let r = &c.v[0]
        let k = || { eat(w)
            let g = get()
            g() }
        k()
        print(r)
    }
}
