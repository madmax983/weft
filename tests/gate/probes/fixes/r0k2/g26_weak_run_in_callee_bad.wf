// Plan stage R0k-a2 fix (the order of the weak guard): `k` performs through
// a captured capability with a function value, so its summary has the weak
// form. `main` gives it to `apply`, a body that the analysis runs before
// `main`, the maker of `k`. Plan stage R0z Z3: the call of `apply` gets a
// copy, so the run of `k` is in `main` and gets a copy of its body. The
// clause runs the value that clears `v` while `r` points into it: W0301.
effect Run { fn run(g: fn()) }
fn apply(f: fn(fn()), g: fn()) { f(g) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let k = |g: fn()| run(g)
        apply(k, || v.clear())
    }
    print(r)
}
