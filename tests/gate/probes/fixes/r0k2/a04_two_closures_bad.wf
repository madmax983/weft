// Plan stage R0k-a2 (a refusal: two closures can reach the local): `k` gets
// one of two closures, so the run of `k` gets no copy and the program keeps
// the old pipeline. Both closures run the value of the clause, which clears
// `c.v` while `r` points into it.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn pick(b: bool) -> bool { b }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    handle Get { fn get() { resume(|| c.v.clear()) } } in {
        let r = &c.v[0]
        let k = if pick(true) { || { let g = get()
            g() } } else { || { let g = get()
            g() } }
        k()
        print(r)
    }
}
