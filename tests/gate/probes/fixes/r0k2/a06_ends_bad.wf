// Plan stage R0k-a2 (a refusal: the source of a capture ends before the
// run): the closure that `k` holds captures `x` of a block that ends before
// the run, so the run of `k` gets no copy and the program keeps the old
// pipeline. The value of the clause clears `c.v` while `r` points into it.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    handle Get { fn get() { resume(|| c.v.clear()) } } in {
        let r = &c.v[0]
        let k = { let x = 1
            || { let g = get()
                g()
                print(x) } }
        k()
        print(r)
    }
}
