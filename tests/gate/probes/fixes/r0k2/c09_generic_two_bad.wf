// Plan stage R0k-a2 (a generic callee, two type arguments at two sites):
// each copy has the body of `run_ref` under its own type argument. At the
// second site the value of the clause clears `c.v` while the callee reads
// `r` (W0301).
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn run_ref<T>(c: &C, x: T) -> T / Get {
    let r = &c.v[0]
    let g = get()
    g()
    print(r)
    x
}
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    let a = handle Get { fn get() { resume(|| print(0)) } } in { run_ref(&c, 5) }
    let b = handle Get { fn get() { resume(|| c.v.clear()) } } in { run_ref(&c, "s") }
    print(a)
    print(b)
}
