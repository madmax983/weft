// Plan stage R0k-a2: the clean twin of a06 (the refusal keeps the old
// pipeline). The handled body reads `r` before the run.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    handle Get { fn get() { resume(|| c.v.clear()) } } in {
        let r = &c.v[0]
        print(r)
        let k = { let x = 1
            || { let g = get()
                g()
                print(x) } }
        k()
    }
}
