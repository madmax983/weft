// Plan stage R0k-a2 (a static closure copy, a `Kept` capture): the closure
// keeps `r`, gets a value from the clause that clears `c.v`, runs it, and
// then reads `r` (W0301).
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    handle Get { fn get() { resume(|| c.v.clear()) } } in {
        let r = &c.v[0]
        let k = || { let g = get()
            g()
            print(r) }
        k()
    }
}
