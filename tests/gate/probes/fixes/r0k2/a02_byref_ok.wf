// Plan stage R0k-a2: the clean twin of a02. The handled body reads `r`
// before it runs the closure.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    handle Get { fn get() { resume(|| c.v.clear()) } } in {
        let w = Vec.new()
        let r = &c.v[0]
        print(r)
        let k = || { w.push(1)
            let g = get()
            g() }
        k()
        print(w.len())
    }
}
