// Plan stage R0k-a2 fix (the review of R0k-a2, probe u04_task_reassigns.wf): a body inside the owner writes `k` through an upvar or a capture, so the run of `k` gets no copy of the closure body (the program keeps the fallback, or the `ir` pipeline rejects it).
// The probe: k is reassigned by a scope task before the run
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(0))
        scope { s => s.spawn(|| { k = || run(|| print(r)) }) }
        k()
    }
    v.clear()
    let x = h.f
    x()
}
