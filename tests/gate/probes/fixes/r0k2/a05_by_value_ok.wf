// Plan stage R0k-a2: the clean twin of a05 (the refusal keeps the old
// pipeline). The handled body reads `r` before the run.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn eat(w: Vec<u64>) { print(w.len()) }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    let w = Vec.new()
    handle Get { fn get() { resume(|| c.v.clear()) } } in {
        let r = &c.v[0]
        print(r)
        let k = || { eat(w)
            let g = get()
            g() }
        k()
    }
}
