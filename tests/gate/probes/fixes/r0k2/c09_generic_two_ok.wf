// Plan stage R0k-a2: the clean twin of c09_generic_two. No value of a
// clause changes `c.v`.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn run_ref<T>(c: &C, x: T) -> T / Get {
    let r = &c.v[0]
    let g = get()
    g()
    print(r)
    x
}
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    let a = handle Get { fn get() { resume(|| print(0)) } } in { run_ref(&c, 5) }
    let b = handle Get { fn get() { resume(|| print(c.v.len())) } } in { run_ref(&c, "s") }
    print(a)
    print(b)
}
