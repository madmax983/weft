// E-1: a callee performs an operation whose clause does not resume, before it joins
effect Stop { fn stop() }
fn wait(t: Task<()>) / Stop, async { stop(); t.join() }
fn main() / async, clock {
    let v = Vec.new()
    v.push(1)
    scope { s =>
        let t = s.spawn(|| v.push(2))
        sleep(1.ms)
        handle Stop { fn stop() { print("stopped") } } in { wait(t) }
        v.push(3)
    }
}
