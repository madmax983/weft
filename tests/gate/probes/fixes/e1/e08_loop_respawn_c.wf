// E-1 (clean twin): in each turn the callee joins, then fails
fn wait(t: Task<()>, c: bool) / fail, async { t.join(); if c { fail("stop") } }
fn main() / async, clock {
    let v = Vec.new()
    v.push(1)
    scope { s =>
        let i = 0
        while i < 2 {
            let t = s.spawn(|| v.push(2))
            sleep(1.ms)
            handle Fail { fn fail(m) { print(m) } } in { wait(t, i == 0) }
            i += 1
        }
        v.push(3)
    }
}
