// E-1 (clean twin): the callee of the closure joins, then fails
fn wait(t: Task<()>, c: bool) / fail, async { t.join(); if c { fail("stop") } }
fn main() / async, clock {
    let v = Vec.new()
    v.push(1)
    let c = true
    scope { s =>
        let t = s.spawn(|| v.push(2))
        sleep(1.ms)
        handle Fail { fn fail(m) { print(m) } } in {
            let g = || wait(t, c)
            g()
        }
        v.push(3)
    }
}
