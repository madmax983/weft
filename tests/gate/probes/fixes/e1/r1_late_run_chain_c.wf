// R2-1 (clean twin): the outer callee performs, then runs the chain: the clause runs before the writer starts
effect Note { fn note() }
struct Stats { count: u64 }
fn inner(g: fn()) { g() }
fn outer(g: fn()) / Note { note(); inner(g) }
fn main() / async {
    let st = Stats { count: 0 }
    scope { s =>
        handle Note { fn note() { print(st.count); resume(()) } } in {
            outer(|| { s.spawn(|| st.count += 1); () })
        }
    }
}
