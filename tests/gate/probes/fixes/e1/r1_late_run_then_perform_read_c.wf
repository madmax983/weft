// R2-1 (clean twin): the callee performs, then runs the closure: the clause runs before the writer starts
effect Note { fn note() }
struct Stats { count: u64 }
fn run_note(g: fn()) / Note { note(); g() }
fn main() / async {
    let st = Stats { count: 0 }
    scope { s =>
        handle Note { fn note() { print(st.count); resume(()) } } in {
            run_note(|| { s.spawn(|| st.count += 1); () })
        }
    }
}
