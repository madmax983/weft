// E-1: a closure gives its captured handle to a callee that fails before its join
fn wait(t: Task<()>, c: bool) / fail, async { if c { fail("stop") }; t.join() }
fn main() / async, clock {
    let v = Vec.new()
    v.push(1)
    let c = true
    scope { s =>
        let t = s.spawn(|| v.push(2))
        sleep(1.ms)
        handle Fail { fn fail(m) { print(m) } } in {
            let g = || wait(t, c)
            g()
        }
        v.push(3)
    }
}
