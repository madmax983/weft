// E-1: a callee fails before it joins the handle; a handler of the caller stops the abort
fn wait(t: Task<()>, c: bool) / fail, async { if c { fail("stop") }; t.join() }
fn main() / async, clock {
    let v = Vec.new()
    v.push(1)
    scope { s =>
        let t = s.spawn(|| v.push(2))
        sleep(1.ms)
        handle Fail { fn fail(m) { print(m) } } in { wait(t, true) }
        v.push(3)
    }
}
