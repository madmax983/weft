// E-1 (clean twin): the closure joins the writer first, then the other handle, then fails
fn main() / async, clock {
    let v = Vec.new()
    v.push(1)
    let c = true
    scope { s =>
        let a = s.spawn(|| v.push(2))
        let b = s.spawn(|| print(0))
        sleep(1.ms)
        handle Fail { fn fail(m) { print(m) } } in {
            let g = || { a.join(); b.join(); if c { fail("stop") } }
            g()
        }
        v.push(3)
    }
}
