// E-1: the inner callee of a chain fails before its join
fn inner(t: Task<()>, c: bool) / fail, async { if c { fail("stop") }; t.join() }
fn outer(t: Task<()>, c: bool) / fail, async { inner(t, c) }
fn main() / async, clock {
    let v = Vec.new()
    v.push(1)
    scope { s =>
        let t = s.spawn(|| v.push(2))
        sleep(1.ms)
        handle Fail { fn fail(m) { print(m) } } in { outer(t, true) }
        v.push(3)
    }
}
