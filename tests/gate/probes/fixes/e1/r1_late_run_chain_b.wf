// R2-1: a chain of callees runs the closure that starts a writer; the outer callee performs after the inner one returns
effect Note { fn note() }
struct Stats { count: u64 }
fn inner(g: fn()) { g() }
fn outer(g: fn()) / Note { inner(g); note() }
fn main() / async {
    let st = Stats { count: 0 }
    scope { s =>
        handle Note { fn note() { print(st.count); resume(()) } } in {
            outer(|| { s.spawn(|| st.count += 1); () })
        }
    }
}
