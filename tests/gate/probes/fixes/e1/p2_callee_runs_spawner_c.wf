// E-2: a callee runs a closure that starts a writer in a scope of the caller (no conflict with the run)
struct Stats { count: u64 }
fn once(g: fn()) { g() }
fn main() / async {
    let st = Stats { count: 0 }
    scope { s =>
        once(|| { s.spawn(|| st.count += 1); () })
    }
    print(st.count)
}
