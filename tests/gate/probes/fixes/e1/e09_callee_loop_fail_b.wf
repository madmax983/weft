// E-1: a callee joins after a loop that can fail
fn wait(t: Task<()>, n: u64) / fail, async {
    let i = 0
    while i < n { if i == 1 { fail("stop") }; i += 1 }
    t.join()
}
fn main() / async, clock {
    let v = Vec.new()
    v.push(1)
    scope { s =>
        let t = s.spawn(|| v.push(2))
        sleep(1.ms)
        handle Fail { fn fail(m) { print(m) } } in { wait(t, 3) }
        v.push(3)
    }
}
