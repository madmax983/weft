// E-1: a helper validates its input and fails, then joins the worker
fn finish(t: Task<()>, items: &Vec<u64>) / fail, async {
    if items.len() < 2 { fail("too few items") }
    t.join()
}
fn main() / async, clock {
    let v = Vec.new()
    v.push(1)
    let items = Vec.new()
    items.push(1)
    scope { s =>
        let t = s.spawn(|| v.push(2))
        sleep(1.ms)
        handle Fail { fn fail(m) { print(m) } } in { finish(t, &items) }
        v.push(3)
    }
}
