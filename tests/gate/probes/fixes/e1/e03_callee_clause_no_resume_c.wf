// E-1 (clean twin): the callee joins, then performs the operation
effect Stop { fn stop() }
fn wait(t: Task<()>) / Stop, async { t.join(); stop() }
fn main() / async, clock {
    let v = Vec.new()
    v.push(1)
    scope { s =>
        let t = s.spawn(|| v.push(2))
        sleep(1.ms)
        handle Stop { fn stop() { print("stopped") } } in { wait(t) }
        v.push(3)
    }
}
