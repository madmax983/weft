// D-COPY-WAIT: a `multi` re-run copies an inner clause frame that waits at its `resume`; the code after the inner `handle` runs before the copy goes on
effect Pick { multi fn pick() -> bool }
effect Op { fn op() }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        handle Op { fn op() { let y = &v[0]; resume(()); print(y + 1) } } in {
            op()
            let b = pick()
            print(b)
        }
        v[0] = 3
    }
}
