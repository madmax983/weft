// D-CLAUSE-RUNS: a clause runs a function value of the interface of its function; the summary of the function has that run (more than once)
effect Note { fn note() }
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn via(f: fn()) { handle Note { fn note() { f(); resume(()) } } in { note(); note() } }
fn main() {
    let b = Buf { items: Vec.new() }
    via(|| print(b.items.len()))
}
