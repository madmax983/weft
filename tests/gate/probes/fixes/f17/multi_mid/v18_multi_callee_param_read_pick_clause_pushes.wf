// D-MULTI-MID: a `multi` clause changes a place between two `resume`s while a copied callee or closure frame holds a reference into it (the copy of the frame is used at the `Copy` node)
effect Pick { multi fn pick() -> bool }
fn g(v: &Vec<i64>) / Pick {
    let r = &v[0]
    if pick() { print(r + 1) } else { print(r + 2) }
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { let a = resume(true); v.clear(); v.push(5); resume(false) } } in {
        g(&v)
    }
}
