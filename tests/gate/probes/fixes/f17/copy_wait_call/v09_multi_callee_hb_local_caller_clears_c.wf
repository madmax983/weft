// D-COPY-WAIT-CALL: a copied callee frame (or a clause that waits in it) holds a reference across a `multi` operation; the caller changes the place after the call, before the second run
effect Pick { multi fn pick() -> bool }
fn g(v: &Vec<i64>) / Pick {
    let r = &v[0]
    let b = pick()
    print(r + 1)
}
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        g(&v)
        print(v.len())
    }
}
