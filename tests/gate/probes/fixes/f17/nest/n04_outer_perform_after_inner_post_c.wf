// D-CONT-NEST: a perform in a clause of an inner handler: the continuation is the rest of that clause and of the outer handled body
effect Peek { fn peek() }
effect Op { fn op() }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Peek { fn peek() { let y = &v[0]; resume(()); print(y + 1) } } in {
        handle Op { fn op() { resume(()); peek() } } in {
            op()
        }
        print(v.len())
    }
}
