// D-CONT-NEST: a perform in a clause of an inner handler: the continuation is the rest of that clause and of the outer handled body
effect Peek { fn peek(x: &i64) }
effect Op { fn op() }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Peek { fn peek(x) { resume(()); print(x + 1) } } in {
        handle Op { fn op() { peek(&v[0]); resume(()) } } in {
            op()
        }
        v.clear()
    }
}
