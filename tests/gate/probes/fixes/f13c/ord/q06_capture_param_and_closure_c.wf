// Final check of group C, class H-ORD: the same value of the caller is one argument of a body that runs two values and runs in a closure that is the other argument; the clean twin (ord2/q06_capture_param_and_closure_c.wf).
struct Buf { items: Vec<u64> }
fn mkbuf() -> Buf { let b = Buf { items: Vec.new() }; b.items.push(1); b }
fn eat(b: Buf) { print(b.items.len()) }
fn both(f: fn(), g: fn()) { f(); g() }
fn twice(f: fn()) { f(); f() }
fn run(f: fn()) { f() }
fn each(n: u64, f: fn()) { let i = 0; while i < n { f(); i += 1 } }
fn outer(h: fn()) { both(|| h(), || print(6)) }
fn main() {
    let b = mkbuf()
    outer(|| eat(b))
}
