// Final check of group C, class H-ORD: a closure argument of a body that runs two values runs a value of the caller two times; the clean twin (ord/o02_nested_twice_callee_c.wf).
struct Buf { items: Vec<u64> }
fn mkbuf() -> Buf { let b = Buf { items: Vec.new() }; b.items.push(1); b }
fn eat(b: Buf) { print(b.items.len()) }
fn both(f: fn(), g: fn()) { f(); g() }
fn twice(f: fn()) { f(); f() }
fn run(f: fn()) { f() }
fn outer(h: fn()) { both(|| twice(h), || print(1)) }
fn main() {
    let b = mkbuf()
    outer(|| print(2))
}
