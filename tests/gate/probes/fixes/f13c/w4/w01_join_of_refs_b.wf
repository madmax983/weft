// Final check of group C, class AB-RC1-join: a store through a reference that can reach the object of the caller and a local object (w4/w01_join_of_refs_b.wf).
struct Cache { refs: Vec<&u64>, data: Vec<u64> }
struct H { c: Rc<Cache> }
fn newc() -> Rc<Cache> { Rc.new(Cache { refs: Vec.new(), data: Vec.new() }) }
fn same(x: Rc<Cache>) -> Rc<Cache> { x }
fn read0(c: Rc<Cache>) {
    if c.refs.len() > 0 {
        let r = c.refs[0]
        print(r + 0)
    }
}
fn fill(c: Rc<Cache>, b: bool) / mut(Cache) {
    let d = newc()
    d.data.push(1)
    let x = if b { &c } else { &d }
    x.refs.push(&d.data[0])
}
fn main() / mut(Cache) {
    let c = newc()
    fill(c.clone(), true)
    read0(c)
}
