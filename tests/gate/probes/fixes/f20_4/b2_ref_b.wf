// F20.4 B-2 (b04): a clause reads a reference into an argument that a call that is not generic moved (W0301).
fn mkv() -> Vec<u64> { let v = Vec.new()
 v.push(1)
 v }
fn consume(v: Vec<u64>) { print(v.len()) }
fn eat_fail(v: Vec<u64>) / fail { print(v.len())
 fail("x") }
fn main() {
    let v = mkv()
    let r = &v
    handle Fail { fn fail(e) { print(r.len()) } } in { eat_fail(v) }
}
