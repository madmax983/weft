// The clean twin: the local gets a new value before the abort.
effect Log { fn log(m: String) }
effect Op { fn op() }
fn main() {
    let f = || print(0)
    handle Op { fn op() { print(9) } } in {
        handle Log { fn log(m) { resume(()) } } in {
            f = || log("x")
            f()
            f = || print(1)
            op()
        }
    }
    f()
}
