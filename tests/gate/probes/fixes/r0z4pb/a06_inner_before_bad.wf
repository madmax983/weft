// r0z4pb probe (bad, refusal R-INNER): the nested handled body performs the operation of the inner handler before its `resume`. The inner clause clears `v` after its own `resume`, which is after the rest took `keep = &v[0]` (W0301). The program keeps the fallback.
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()); v.clear() } } in {
                other()
                resume(())
            }
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
