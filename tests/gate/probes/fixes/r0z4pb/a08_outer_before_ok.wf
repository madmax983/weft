// r0z4pb probe (ok): the clean twin of a08_outer_before_bad.
effect Log { fn log(x: u64) }
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Log { fn log(x: u64) { print(x); resume(()) } } in {
        handle Tick { fn tick() {
                handle Other { fn other() { resume(()) } } in {
                    log(1)
                    resume(())
                }
            } } in {
            tick()
            keep = &v[0]
        }
        print(keep + 1)
    }
}
