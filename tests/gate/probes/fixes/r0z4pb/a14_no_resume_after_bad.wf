// r0z4pb probe (bad, refusal R-INNER): after the `resume` the nested body performs the operation of the nested handler, whose clause does not resume and clears `v` (W0301). The program keeps the fallback.
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { v.clear() } } in {
                resume(())
                other()
            }
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
