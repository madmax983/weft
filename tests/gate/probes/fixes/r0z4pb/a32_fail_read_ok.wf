// r0z4pb probe (ok, refusal R-INNER): the clean twin of a32_fail_read_bad. The `Fail` clause prints. The program keeps the fallback.
effect Tick { fn tick() }
fn main(env: Env) / fs {
    let fs = env.fs
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Fail { fn fail(m) { print(m) } } in {
                resume(())
                print(fs.read("/nonexistent/z4pb.txt"))
            }
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
