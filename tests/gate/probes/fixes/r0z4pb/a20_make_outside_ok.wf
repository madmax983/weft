// r0z4pb probe (ok): the clean twin of a20_make_outside_bad.
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            let k = || resume(())
            handle Other { fn other() { resume(()) } } in {
                k()
            }
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
