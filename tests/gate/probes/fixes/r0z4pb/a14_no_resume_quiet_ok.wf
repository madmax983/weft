// r0z4pb probe (ok): the nested handler has a clause with no `resume`, but nothing performs its operation.
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { print(3) } } in {
                resume(())
            }
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
