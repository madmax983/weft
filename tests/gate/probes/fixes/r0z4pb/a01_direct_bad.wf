// r0z4pb probe (bad): the clause resumes in the handled body of a local handler. After the `handle`, the clause clears `v`. The rest took `keep = &v[0]`, so the read of `keep` is a read of a freed cell (W0301).
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()) } } in {
                resume(())
            }
            v.clear()
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
