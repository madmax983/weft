// r0z4pb probe (bad): `sim.run` is around the `handle`. After the nested `handle` the clause clears `v`, which the rest borrowed (W0301).
effect Tick { fn tick() }
effect Other { fn other() }
fn main() / clock {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    sim.run(seed: 1) {
        handle Tick { fn tick() {
                handle Other { fn other() { resume(()) } } in {
                    resume(())
                }
                v.clear()
            } } in {
            tick()
            keep = &v[0]
        }
    }
    print(keep + 1)
}
