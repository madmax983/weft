// r0z4pb probe (ok): the clean twin of a17_abort_linear_bad. `T` has an `on abort` function, so the abort ends `t`.
effect Stop { fn stop() }
linear struct T { id: u64 }
    on abort = fin
fn fin(t: T) { let T(i) = t }
fn done(t: T) { let T(i) = t }
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    handle Stop { fn stop() { print(9) } } in {
        handle Tick { fn tick() {
                handle Other { fn other() { resume(()) } } in {
                    let t = T { id: 1 }
                    resume(())
                    done(t)
                }
            } } in {
            tick()
            stop()
            print(1)
        }
    }
}
