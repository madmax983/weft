// r0z4pb probe (ok): the clean twin of a29_two_points_bad. The clause reads `v`.
effect Ask { fn ask(b: bool) }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Ask { fn ask(b: bool) {
            if b {
                handle Other { fn other() { resume(()) } } in { resume(()) }
            } else {
                resume(())
            }
            print(v.len())
        } } in {
        ask(true)
        keep = &v[0]
    }
    print(keep + 1)
}
