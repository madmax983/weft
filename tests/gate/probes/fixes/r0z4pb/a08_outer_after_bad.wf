// r0z4pb probe (bad): the nested handled body resumes, then performs an operation of an outer handler. After the nested `handle` the clause clears `v`, which the rest borrowed (W0301).
effect Log { fn log(x: u64) }
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Log { fn log(x: u64) { print(x); resume(()) } } in {
        handle Tick { fn tick() {
                handle Other { fn other() { resume(()) } } in {
                    resume(())
                    log(1)
                }
                v.clear()
            } } in {
            tick()
            keep = &v[0]
        }
        print(keep + 1)
    }
}
