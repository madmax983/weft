// r0z4pb probe (bad): after its `resume` the nested handled body clears `v`, which the rest borrowed (W0301).
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()) } } in {
                resume(())
                v.clear()
            }
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
