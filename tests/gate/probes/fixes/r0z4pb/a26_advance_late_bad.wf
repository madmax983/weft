// r0z4pb probe (bad, refusal R-PB-CLOCK): `with_timeout` is around the perform, and the clause resumes in a nested handled body. The rest moves the clock past the deadline with `sim.clock.advance` (no wait), so the deadline holds at the next `resume` of a nested handler in the rest, while a linear value with no `on abort` is live. The program keeps the fallback.
effect Tick { fn tick() }
effect Other { fn other() }
effect N { fn n() }
linear struct T { id: u64 }
fn done(t: T) { let T(i) = t }
fn main() / clock, fail {
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()) } } in { resume(()) }
        } } in {
        with_timeout(5.ms) {
            tick()
            sim.clock.advance(10.ms)
            let t = T { id: 1 }
            handle N { fn n() { resume(()) } } in { n() }
            done(t)
        }
    }
}
