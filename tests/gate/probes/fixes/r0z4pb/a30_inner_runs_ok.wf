// r0z4pb probe (ok): the clean twin of a30_inner_runs_bad. The clause does not clear `v`.
effect Tick { fn tick() }
effect Other { fn other() }
effect Inner { fn inner() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()) } } in {
                handle Inner { fn inner() { resume(()); print(v.len()) } } in { inner() }
                resume(())
            }
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
