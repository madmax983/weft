// r0z4pb probe (bad, refusal): a clause of the nested handler runs the closure that resumes the continuation. After the nested `handle`, the clause clears `v` (W0301). The program keeps the fallback.
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            let k = || resume(())
            handle Other { fn other() { k(); resume(()) } } in { other() }
            v.clear()
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
