// r0z4pb probe (ok, refusal R-INNER): the clean twin of a06_inner_after_bad. The inner clause reads `v`.
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()); print(v.len()) } } in {
                resume(())
                other()
            }
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
