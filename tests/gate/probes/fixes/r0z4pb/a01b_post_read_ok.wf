// r0z4pb probe (ok): the clause resumes in the handled body of a local handler, then reads `v` after the `handle`. The read is clean.
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()) } } in {
                resume(())
            }
            print(v.len())
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
