// r0z4pb probe (ok, refusal): the nested handled body resumes in the block of `sim.run` (a runtime resume node in a nested handled body). The program keeps the fallback.
effect Tick { fn tick() }
effect Other { fn other() }
fn main() / clock {
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()) } } in {
                sim.run(seed: 1) { resume(()) }
            }
        } } in {
        tick()
        print(1)
    }
}
