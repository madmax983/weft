// r0z4pb probe (ok, refusal): the clean twin of a07_in_inner_clause_bad. The program keeps the fallback.
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            let k = || resume(())
            handle Other { fn other() { k(); resume(()) } } in { other() }
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
