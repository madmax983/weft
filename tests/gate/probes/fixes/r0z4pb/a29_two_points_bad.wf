// r0z4pb probe (bad): the clause resumes in a nested handled body on one path and in the clause body on the other. After the `if`, the clause clears `v`, which the rest borrowed (W0301).
effect Ask { fn ask(b: bool) }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Ask { fn ask(b: bool) {
            if b {
                handle Other { fn other() { resume(()) } } in { resume(()) }
            } else {
                resume(())
            }
            v.clear()
        } } in {
        ask(true)
        keep = &v[0]
    }
    print(keep + 1)
}
