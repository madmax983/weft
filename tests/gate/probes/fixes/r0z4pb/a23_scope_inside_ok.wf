// r0z4pb probe (ok, refusal: a scope body in the chain): the clause resumes in a scope body inside a nested handled body. The program keeps the fallback.
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()) } } in {
                scope { s =>
                    resume(())
                }
            }
        } } in {
        tick()
        print(1)
    }
}
