// r0z4pb probe (bad): the rest performs `tick` again. The second activation resumes in its nested handled body while the first waits, then clears `v` after its nested `handle`, and the rest of the first activation reads `keep` (W0301).
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()) } } in {
                resume(())
            }
            v.clear()
        } } in {
        tick()
        keep = &v[0]
        tick()
    }
    print(keep + 1)
}
