// r0z4pb probe (ok): the clean twin of a12_callee_bad.
effect Tick { fn tick() }
effect Other { fn other() }
fn call_it(f: fn()) { f() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()) } } in {
                call_it(|| resume(()))
            }
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
