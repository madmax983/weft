// r0z4pb probe (bad): the clause borrows `v[0]` across the nested `resume`. The rest clears `v`, then the clause reads the borrow (W0301).
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Tick { fn tick() {
            let r = &v[0]
            handle Other { fn other() { resume(()) } } in { resume(()) }
            print(r + 1)
        } } in {
        tick()
        v.clear()
    }
}
