// r0z4pb probe (ok): the clean twin of a22_branch_bad. The clause does not clear `v`. On the path with no `resume`, the clause ends with no resume and aborts the handled body.
effect Ask { fn ask(b: bool) }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Ask { fn ask(b: bool) {
            handle Other { fn other() { resume(()) } } in {
                if b { resume(()) } else { print(0) }
            }
            print(v.len())
        } } in {
        ask(false)
        keep = &v[0]
    }
    print(keep + 1)
}
