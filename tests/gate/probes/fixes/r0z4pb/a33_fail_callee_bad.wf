// r0z4pb probe (bad, refusal R-INNER): as a32_fail_read_bad, but a callee with no `fail` in its row reads the file. The program keeps the fallback.
effect Tick { fn tick() }
fn look(fs: FsCap) / fs { print(fs.read("/nonexistent/z4pb.txt")) }
fn main(env: Env) / fs {
    let fs = env.fs
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Fail { fn fail(m) { v.clear() } } in {
                resume(())
                look(fs)
            }
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
