// Review Z6: the one-node analog of j3 (a local `k` with two closures, one run in the
// loop). Clean: the program prints 5.
effect Run { fn run(g: fn()) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let keep = || print(0)
    let i = 0
    handle Run { fn run(g) { keep = g
        resume(()) } } in {
        while i < 2 {
            v.push(2)
            let w = || print(5)
            if i == 0 { w = || print(v[0]) }
            run(w)
            i = i + 1
        }
    }
    keep()
}
