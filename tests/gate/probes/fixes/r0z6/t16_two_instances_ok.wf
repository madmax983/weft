// Plan stage R0z Z6: the clean twin of t16. The clause of the inner `Run` does not
// clear `v`. The program prints 9, then 1.
effect Run { fn run(g: fn()) }
fn outer(t: bool) {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let r = &v[0]
        let k0 = || run(|| print(0))
        handle Run { fn run(g) { print(9)
            resume(()) } } in {
            let k = k0
            if t { k = || run(|| print(2)) }
            k()
        }
        print(r)
    }
}
fn main() { outer(true) }
