// Plan stage R0z Z6: the clean twin of t09. The second closure keeps no reference.
// The program prints 6.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
effect Sw { fn sw(n: u64) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        handle Sw { fn sw(n) { let k = || run(|| print(0))
            if n > 0 { k = || run(|| print(6)) }
            k()
            resume(()) } } in { sw(1) }
    }
    v.clear()
    let x = h.f
    x()
}
