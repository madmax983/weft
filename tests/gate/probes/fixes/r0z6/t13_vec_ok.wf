// Plan stage R0z Z6 (a refusal): the clean twin of t13. The program prints 5.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let fs = Vec.new()
        fs.push(|| run(|| print(0)))
        fs.push(|| run(|| print(5)))
        let k = fs[1]
        k()
    }
    v.clear()
    let x = h.f
    x()
}
