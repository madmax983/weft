// Plan stage R0z Z6: the clean twin of t07. The closure of `mk2` keeps no reference.
// The program prints 2, then 3.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn mk2(h: fn()) -> fn() / Run { || { print(2)
    run(h) } }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let c = mk(|| print(0))
        if v.len() > 0 { c = mk2(|| print(3)) }
        c()
    }
    v.clear()
    let x = h.f
    x()
}
