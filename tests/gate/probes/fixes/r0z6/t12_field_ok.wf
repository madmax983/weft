// Plan stage R0z Z6 (a refusal): the clean twin of t12. The program prints 5.
struct H { f: fn() }
struct B { f: fn() / Run }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let b = B { f: || run(|| print(0)) }
        if v.len() > 0 { b = B { f: || run(|| print(5)) } }
        let k = b.f
        k()
    }
    v.clear()
    let x = h.f
    x()
}
