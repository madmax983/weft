// Plan stage R0z Z6: the two closures come from two handled bodies of the same effect.
// The first one (made in the outer handled body) performs through the outer `Run`, the
// second one through the inner `Run`, whose clause clears `v`. Each arm runs with the
// handlers of its own closure. With the second closure the clear comes before the read
// of `r`: W0301.
effect Run { fn run(g: fn()) }
fn outer(t: bool) {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let r = &v[0]
        let k0 = || run(|| print(0))
        handle Run { fn run(g) { v.clear()
            resume(()) } } in {
            let k = k0
            if t { k = || run(|| print(2)) }
            k()
        }
        print(r)
    }
}
fn main() { outer(true) }
