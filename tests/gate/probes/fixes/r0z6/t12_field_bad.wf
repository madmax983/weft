// Plan stage R0z Z6 (a refusal: a value from a field with two values). `b` gets one of
// two structs, and the run reads the closure out of a field. The walk takes no part of a
// local with more values (a `None` of an `Option` or another variant is never a leaf),
// so no dispatch, and the program keeps the fallback.
struct H { f: fn() }
struct B { f: fn() / Run }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let b = B { f: || run(|| print(0)) }
        if v.len() > 0 { b = B { f: || run(|| print(r)) } }
        let k = b.f
        k()
    }
    v.clear()
    let x = h.f
    x()
}
