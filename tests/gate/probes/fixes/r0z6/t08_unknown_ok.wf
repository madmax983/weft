// Plan stage R0z Z6 (a refusal): the clean twin of t08. The first closure keeps no
// reference. No dispatch; the program keeps the fallback. It prints 4.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn outer(f: fn() / Run) {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(4))
        if v.len() > 5 { k = f }
        k()
    }
    v.clear()
    let x = h.f
    x()
}
fn main() { outer(|| print(7)) }
