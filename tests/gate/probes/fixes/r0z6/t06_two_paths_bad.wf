// Plan stage R0z Z6: `mk` gives back one of two closures on two paths (the form of a01).
// The copy of `mk` at its call makes both closures in `outer`, so the run of `c` gets a
// dispatch. With `t` true the closure gives `h` to `run` through the row of `mk`, so the
// `run` goes to H, whose clause clears `v`: W0301 at the read of `r`.
effect Run { fn run(g: fn()) }
fn mk(h: fn(), b: bool) -> fn() / Run {
    if b { || run(h) } else { || run(|| print(1)) }
}
fn outer(t: bool) {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { v.clear()
        resume(()) } } in {
        let c = mk(|| print(0), t)
        let r = &v[0]
        handle Run { fn run(g) { g()
            resume(()) } } in { c() }
        print(r)
    }
}
fn main() { outer(true) }
