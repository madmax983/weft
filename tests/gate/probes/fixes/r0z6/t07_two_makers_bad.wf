// Plan stage R0z Z6: `c` gets the closure of one of two makers, `mk` or `mk2` (the form
// of a1_other_maker, in a branch). The closure of `mk2` keeps `r`, the clause keeps the
// value, and `main` runs it after the clear of `v`: W0301.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn mk2(h: fn()) -> fn() / Run { || { print(2)
    run(h) } }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let c = mk(|| print(0))
        if v.len() > 0 { c = mk2(|| print(r)) }
        c()
    }
    v.clear()
    let x = h.f
    x()
}
