// Plan stage R0z Z6 (the review of Z6, round 3, the root fix): the form with one value. A
// closure that holds a reference to `v` runs in the handled body of a handler, and runs no
// clause. Before the fix (`clause::call_landings` took each handler that the call can reach,
// not only those whose clauses it can run) the run gave that reference to the
// function-typed parameter of the clause, and main gave a false W0301. Clean with the fix.
effect Run { fn run(g: fn()) }

fn outer(t: bool) {
    let v = Vec.new()
    v.push(1)
    let ff = || print(v.len())
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let r = &v[0]
        let k1 = || run(|| print(1))

        handle Run { fn run(g) { print(v.len())
            resume(()) } } in {
            let kb = || run(|| print(2))

            let k = k1

            k()
        }
        print(r)
        ff()
    }
}
fn main() { outer(false) }
