// Plan stage R0z Z6: the clean twin of t06. The clause of H runs `g` and does not clear
// `v`. The program prints 0, then 1.
effect Run { fn run(g: fn()) }
fn mk(h: fn(), b: bool) -> fn() / Run {
    if b { || run(h) } else { || run(|| print(1)) }
}
fn outer(t: bool) {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let c = mk(|| print(0), t)
        let r = &v[0]
        handle Run { fn run(g) { print(9)
            resume(()) } } in { c() }
        print(r)
    }
}
fn main() { outer(true) }
