// Plan stage R0z Z6 (a refusal: a value that the walk does not know): the second value of
// `k` is a parameter of `outer`. No dispatch, and the program keeps the fallback.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn outer(f: fn() / Run) {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(r))
        if v.len() > 5 { k = f }
        k()
    }
    v.clear()
    let x = h.f
    x()
}
fn main() { outer(|| print(7)) }
