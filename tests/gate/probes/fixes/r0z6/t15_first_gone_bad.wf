// Plan stage R0z Z6 (a dead arm): `k` first gets a closure that gives `run` a closure that
// keeps `r`. A scope body gives `k` another closure only if `t`, and `t` is false here,
// so the first closure runs: W0301. The analysis keeps the first value after the
// scope body, so its arm is live.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    let t = v.len() > 5
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(r))
        scope { s => if t { k = || run(|| print(5)) } }
        k()
    }
    v.clear()
    let x = h.f
    x()
}
