// Plan stage R0z Z6 (a dead arm): the clean twin of t15. The scope body gives `k` the
// second closure on each path, so the first closure (which gives `run` a closure that
// keeps `r`) never runs. The analysis finds its arm dead, and the static check agrees:
// the facts have no edge into the arm, and the program has no error. It prints 5.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(r))
        scope { s => k = || run(|| print(5)) }
        k()
    }
    v.clear()
    let x = h.f
    x()
}
