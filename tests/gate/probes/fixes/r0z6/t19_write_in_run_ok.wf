// Plan stage R0z Z6 (a refusal): the clean twin of t19. No dispatch; the program has the
// result of main (W0313, as the old pipeline). It prints 5.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
effect Sw { fn sw() }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(0))
        handle Sw { fn sw() { k = || run(|| print(5))
            resume(()) } } in {
            k = || { sw()
                run(|| print(1)) }
            k()
            k()
        }
    }
    v.clear()
    let x = h.f
    x()
}
