// Plan stage R0z Z6 (a refusal, R-REF; the review of Z6, round 2): the shape of t16 (a copy
// arm performs through the capability of the outer `Run`), and a function value whose value
// can hold a reference runs in the handled body of the outer `Run` (a closure made before the
// `handle`, a copy of a reference, a closure of a callee). After that run the facts of the
// perform of the copy give the clause the places below the reference, a false W0301 that main
// gives for the region with one value. No dispatch: the program keeps the fallback.
effect Run { fn run(g: fn()) }

fn outer(t: bool) {
    let v = Vec.new()
    v.push(1)
    let ff = || print(v.len())
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let r = &v[0]
        let k1 = || run(|| print(1))

        handle Run { fn run(g) { print(v.len())
            resume(()) } } in {
            let kb = || run(|| print(2))

            let k = kb
            if v.len() > 0 { k = k1 }
            k()
        }
        print(r)
        ff()
    }
}
fn main() { outer(false) }
