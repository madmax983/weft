// Plan stage R0z Z6 (a refusal: a dispatch in a copy region). The run of `c` gets a copy
// region; its code runs a local `k` with two closures. No dispatch inside a region, so
// the program keeps the fallback (or the pending rule rejects it).
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let c = || { let k = || run(|| print(0))
            if v.len() > 0 { k = || run(|| print(r)) }
            k() }
        handle Run { fn run(g) { g()
            resume(()) } } in { c() }
    }
    v.clear()
    let x = h.f
    x()
}
