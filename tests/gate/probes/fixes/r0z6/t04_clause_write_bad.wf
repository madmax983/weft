// Plan stage R0z Z6: the clause of `Sw` gives `k` its second closure before the run
// (the form of u13). Its one perform runs before the run.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
effect Sw { fn sw() }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(0))
        handle Sw { fn sw() { k = || run(|| print(r))
            resume(()) } } in { sw() }
        k()
    }
    v.clear()
    let x = h.f
    x()
}
