// Plan stage R0z Z6 (a refusal, R-LOOP): the clean twin of t11. No dispatch; the
// program keeps the fallback. It prints 5.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(0))
        let i = 0
        while i < 2 {
            k()
            k = || run(|| print(5))
            i = i + 1
        }
    }
    v.clear()
    let x = h.f
    x()
}
