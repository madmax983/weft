// Plan stage R0z Z6 (the review of Z6, round 1, B2): the shape of t16 (a copy arm performs
// through the capability of the outer `Run`), and a closure that holds a reference to `v`
// runs in its handled body. The first build gave a false W0301 at `print(r)`; round 1 added a
// refusal (R-REF). Round 3 found the root (`clause::call_landings` gave the reference of a run
// that runs no clause to the parameter of each clause it could reach) and fixed it, so R-REF
// went: the dispatch is in scope with no error.
effect Run { fn run(g: fn()) }
fn outer(t: bool) {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let r = &v[0]
        let k1 = || run(|| print(1))
        let ff = || print(v.len())
        ff()
        handle Run { fn run(g) { print(v.len())
            resume(()) } } in {
            let kb = || run(|| print(2))
            let k = kb
            if v.len() > 0 { k = k1 }
            k()
        }
        print(r)
    }
}
fn main() { outer(false) }
