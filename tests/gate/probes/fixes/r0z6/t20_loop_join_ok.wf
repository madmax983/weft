// Plan stage R0z Z6 (a refusal, R-LOOP; the form j3 of the review, with a dispatch):
// the run of `k` in a loop has two arms that perform `run`, and the clause keeps its
// parameter. The kept value of the last turn holds `r`, a reference into `v` that is
// still valid at its run. A dispatch gave a false W0301 here (the value of the first turn
// joins the push of the second turn; main gives the same error for the form with one
// value), so the dispatch is refused: the program keeps the fallback. It prints 1.
effect Run { fn run(g: fn()) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let keep = || print(0)
    let i = 0
    handle Run { fn run(g) { keep = g
        resume(()) } } in {
        while i < 2 {
            v.push(2)
            let r = &v[0]
            let k = || run(|| print(5))
            if i == 1 { k = || run(|| print(r)) }
            k()
            i = i + 1
        }
    }
    keep()
}
