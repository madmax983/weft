// Plan stage R0z Z6: a scope body gives `k` its second closure (the form of u05).
// The arm of the first closure is dead: the scope body writes `k` on each path.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(0))
        scope { s => k = || run(|| print(r)) }
        k()
    }
    v.clear()
    let x = h.f
    x()
}
