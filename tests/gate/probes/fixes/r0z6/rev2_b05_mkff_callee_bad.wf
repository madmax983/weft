// Plan stage R0z Z6 (the review of Z6, round 2): the shape of t16, and `ff = mk(&v)`, a
// closure that a callee makes, runs in the handled body of the outer `Run`. The walk does not
// know the value of `ff`, so R-JOIN refuses the dispatch (an unknown value can run the clause):
// the program keeps the fallback, as with main.
// The bad twin: the inner clause clears `v`.
effect Run { fn run(g: fn()) }
fn mk(w: &Vec<i64>) -> fn() { || print(w.len()) }
fn outer(t: bool) {
    let v = Vec.new()
    v.push(1)

    handle Run { fn run(g) { g()
        resume(()) } } in {
        let r = &v[0]
        let k1 = || run(|| print(1))

        handle Run { fn run(g) { v.clear()
            resume(()) } } in {
            let kb = || run(|| print(2))
            let ff = mk(&v)
            ff()
            let k = kb
            if v.len() > 0 { k = k1 }
            k()
        }
        print(r)
    }
}
fn main() { outer(false) }
