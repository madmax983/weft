// Plan stage R0z Z6 (the review of Z6, round 3): a dispatch, then a region of Z7 in the same
// function. With the root fix of the round the program is in scope: the bad twin is rejected
// (W0301), the clean twin has no error.
struct H { f: fn() }
fn noop() {}
effect Run { multi fn run(g: fn()) }
effect Go { fn go(g: fn()) }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Go { fn go(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || go(|| print(0))
        let t = v.len() > 0
        if t { k = || go(|| print(r)) }
        k()
    }
    handle Run { fn run(g) { resume(())
        g()
        resume(()) } } in {
        run(|| print(3))
        let x = h.f
        x()
        v.clear()
    }
}
