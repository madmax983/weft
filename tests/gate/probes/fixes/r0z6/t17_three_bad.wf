// Plan stage R0z Z6: three groups. `k` gets one of three closures; the third one gives
// `run` a closure that keeps `r`: W0301.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(0))
        if v.len() > 3 { k = || print(1) }
        if v.len() > 0 { k = || run(|| print(r)) }
        k()
    }
    v.clear()
    let x = h.f
    x()
}
