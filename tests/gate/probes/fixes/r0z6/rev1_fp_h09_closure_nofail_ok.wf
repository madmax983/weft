// Plan stage R0z Z6 (a refusal, R-REF; the review of Z6, round 1, B2): a copy arm performs
// `run` through the capability of the outer `Run`, and a closure with a `ByRef` capture of
// `v` is made in its handled body. The facts of the perform give the clause the places below
// that reference ("run: gets v.."), a false W0301 that main gives for the region with one
// value. No dispatch: the program keeps the fallback.
effect Run { fn run(g: fn()) }
effect Sw { fn sw() }

fn outer(t: bool) {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let r = &v[0]
        let k0 = || run(|| print(0))
        let k1 = || run(|| print(1))
        handle Run { fn run(g) { print(v.len())
            resume(()) } } in {
            let kb = || run(|| print(2))
            let k = k0
            k = kb
            let ff = || { if v.len() > 5 { fail("x") } }
            handle Fail { fn fail(m) { print(m) } } in {
                ff()
                k = k1
            }
            k()
        }
        print(r)
    }
}
fn main() { outer(false) }
