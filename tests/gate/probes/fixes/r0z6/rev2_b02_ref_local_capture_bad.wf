// Plan stage R0z Z6 (the review of Z6, round 2): the shape of t16, and a function value that
// holds a reference runs in the handled body of the outer `Run` (a closure made before the
// `handle`, a copy of a reference, a closure of a callee). Round 2 refused the dispatch
// (R-REF); with the root fix of round 3 (`clause::call_landings`) it is in scope, and its facts
// have no false W0301.
// The bad twin: the inner clause clears `v`; rejected (W0301).
effect Run { fn run(g: fn()) }

fn outer(t: bool) {
    let v = Vec.new()
    v.push(1)

    handle Run { fn run(g) { g()
        resume(()) } } in {
        let r = &v[0]
        let k1 = || run(|| print(1))

        handle Run { fn run(g) { v.clear()
            resume(()) } } in {
            let kb = || run(|| print(2))
            let rv = &v
            let ff = || print(rv.len())
            ff()
            let k = kb
            if v.len() > 0 { k = k1 }
            k()
        }
        print(r)
    }
}
fn main() { outer(false) }
