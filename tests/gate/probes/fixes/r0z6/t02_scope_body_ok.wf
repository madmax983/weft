// Plan stage R0z Z6: the clean twin of t02.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(0))
        scope { s => k = || run(|| print(5)) }
        k()
    }
    v.clear()
    let x = h.f
    x()
}
