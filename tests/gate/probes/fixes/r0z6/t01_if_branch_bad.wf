// Plan stage R0z Z6 (a dispatch): `k` gets one of two closures in the body of the run.
// The second closure gives the clause a closure that keeps `r`. The clause keeps it in
// `h.f`, and `main` runs it after the clear of `v`. The run of `k` gets a dispatch: W0301.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(0))
        let t = v.len() > 0
        if t { k = || run(|| print(r)) }
        k()
    }
    v.clear()
    let x = h.f
    x()
}
