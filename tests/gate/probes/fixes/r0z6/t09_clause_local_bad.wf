// Plan stage R0z Z6: a dispatch in a clause (no `multi` operation in the program). The
// clause of `Sw` gives its local `k` one of two closures and runs it. The second one
// gives `run` a closure that keeps `r`; the clause of `Run` keeps it, and `main` runs it
// after the clear of `v`: W0301.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
effect Sw { fn sw(n: u64) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        handle Sw { fn sw(n) { let k = || run(|| print(0))
            if n > 0 { k = || run(|| print(r)) }
            k()
            resume(()) } } in { sw(1) }
    }
    v.clear()
    let x = h.f
    x()
}
