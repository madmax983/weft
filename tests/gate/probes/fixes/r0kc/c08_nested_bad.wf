// Plan stage R0k-c1 (bad): a body inside the clause (a handled body) makes and runs the closure: no copy, the program keeps the fallback.
// The clause clears `v` after the handled body took `keep = &v[0]`:
// the read of `keep` after the `handle` is a read of a freed cell (W0301).
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()) } } in {
                let k = || resume(())
                k()
            }
            v.clear()
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
