// Plan stage R0k-c1 (ok): a perform lies between the make and the run: no copy, the program keeps the fallback.
// The clean twin: the clause does not clear `v`.
effect Tick { fn tick() }
effect Ask { fn ask() -> u64 }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Ask { fn ask() { resume(1) } } in {
        handle Tick { fn tick() {
                let k = || resume(())
                let y = ask()
                k()
            } } in {
            tick()
            keep = &v[0]
        }
    }
    print(keep + 1)
}
