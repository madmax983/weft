// Plan stage R0k-c1 (ok): a closure that resumes a `once` continuation, run once in the clause: the copy of its body has the resume point of the clause, and the make goes (in scope).
// The clean twin: the clause does not clear `v`.
effect Tick { fn tick() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            let k = || resume(())
            k()
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
