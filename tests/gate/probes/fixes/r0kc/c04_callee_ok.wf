// Plan stage R0k-c1 (ok): the clause gives the closure to a callee that runs it (D1c): the callee gets a copy at the call, then the run in the copy gets a copy of the closure body (in scope).
// The clean twin: the clause does not clear `v`.
effect Tick { fn tick() }
fn call_it(f: fn()) { f() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            call_it(|| resume(()))
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
