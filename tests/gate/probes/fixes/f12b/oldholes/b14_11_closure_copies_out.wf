// F12 review 2 (ABC preview), old hole b14-run: a callee or a closure runs a once closure that it copies out of a referent, two times; old and the default AB accept it and the oracle faults; ABC rejects it after F12-fix2 (ab14/b14_11_closure_copies_out.wf).
struct Buf { items: Vec<u64> }
struct K { f: fn() }
struct S { k: K }
fn mkbuf() -> Buf { let b = Buf { items: Vec.new() }; b.items.push(1); b }
fn eat(b: Buf) { print(b.items.len()) }
fn hi() { print(0) }
fn first(fs: &Vec<fn()>) -> fn() { fs[0] }
fn getk(k: &K) -> fn() { k.f }
fn gets(s: &S) -> fn() { s.k.f }
struct KO { o: Option<fn()> }
fn copyo(k: &KO) -> Option<fn()> { k.o }
fn firstvv(ffs: &Vec<Vec<fn()>>) -> fn() { ffs[0][0] }
fn first2(fs: &Vec<fn()>) -> fn() { first(fs) }
fn runfirst(fs: &Vec<fn()>) { let g = fs[0]; g() }
fn main() { let b = mkbuf(); let fs = Vec.new(); fs.push(|| eat(b)); let fst = |v: &Vec<fn()>| v[0]; let g = fst(&fs); g(); let h = fst(&fs); h() }
