// F12 review 2 (ABC preview), hole N1: the result of a closure maker, called or given back in a second closure or a callee (old W0301) (h2y/y04_fn_body_param_maker.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn run(f: fn()) { f() }
fn clr(w: &World) -> fn() / mut(w.entities) { || w.entities.clear() }
fn go(m: fn() -> fn()) { let k = || { let h = m(); h() }; k() }
fn main() {
    let w = mkw()
    let first = &w.entities[0]
    go(|| || w.entities.clear())
    print(first.hp)
}
