// F12 review 2 (ABC preview), hole N1: the result of a closure maker, called or given back in a second closure or a callee (old W0301) (h2y/y11_byref_dead_through_mk2.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn run(f: fn()) { f() }
fn clr(w: &World) -> fn() / mut(w.entities) { || w.entities.clear() }
fn main() {
    let g = || print(0)
    {
        let v = Vec.new(); v.push(1)
        let mk = || || print(v[0])
        let mk2 = || mk()
        g = mk2()
    }
    g()
}
