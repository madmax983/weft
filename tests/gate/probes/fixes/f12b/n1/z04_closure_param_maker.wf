// F12 review 2 (ABC preview), hole N1: the result of a closure maker, called or given back in a second closure or a callee (old W0301) (h2z/z04_closure_param_maker.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn run(f: fn()) { f() }
fn mkmk(w: &World) -> fn() -> fn() / mut(w.entities) { || || w.entities.clear() }
fn main() {
    let w = mkw()
    let first = &w.entities[0]
    let go = |m: fn() -> fn()| { let g = m(); g() }
    go(|| || w.entities.clear())
    print(first.hp)
}
