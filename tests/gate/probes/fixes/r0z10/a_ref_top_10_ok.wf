// Plan stage R0z Z10 probe: a chain of 10 closures; the bottom pushes to `w.v` while a reference into `w.v` is live; the reference is dead (clean).
struct W { v: Vec<u64> }
fn main() {
    let w = W { v: Vec.new() }
    w.v.push(0)
    let r = &w.v[0]
    print(r)
    let c0 = || w.v.push(1)
    let c1 = || c0()
    let c2 = || c1()
    let c3 = || c2()
    let c4 = || c3()
    let c5 = || c4()
    let c6 = || c5()
    let c7 = || c6()
    let c8 = || c7()
    let c9 = || c8()
    c9()
}
