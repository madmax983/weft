// Plan stage R0z Z10 probe: a chain of 10 closures; level 5 is in a field of a struct, and level 6 runs it from the field; the bottom pushes to `w.v` while a reference is live (W0301).
struct W { v: Vec<u64> }
struct H { f: fn() }
fn main() {
    let w = W { v: Vec.new() }
    w.v.push(0)
    let r = &w.v[0]
    let c0 = || w.v.push(1)
    let c1 = || c0()
    let c2 = || c1()
    let c3 = || c2()
    let c4 = || c3()
    let c5 = || c4()
    let hk = H { f: c5 }
    let c6 = || { let g = hk.f; g() }
    let c7 = || c6()
    let c8 = || c7()
    let c9 = || c8()
    c9()
    print(r)
}
