// Plan stage R0z Z10 probe: a chain of 10 closures; levels 0 and 1 run one value `h` with `w.a` and with `w.b`; a reference into `w.b` is live (W0301: the second run pushes to `w.b`).
struct W { a: Vec<u64>, b: Vec<u64>, c: Vec<u64> }
fn push1(v: &Vec<u64>) / mut(v) { v.push(1) }
fn main() {
    let w = W { a: Vec.new(), b: Vec.new(), c: Vec.new() }
    w.a.push(0)
    w.b.push(0)
    w.c.push(0)
    let r = &w.b[0]
    let h = |v: &Vec<u64>| push1(v)
    let c0 = || h(&w.a)
    let c1 = || { c0(); h(&w.b) }
    let c2 = || c1()
    let c3 = || c2()
    let c4 = || c3()
    let c5 = || c4()
    let c6 = || c5()
    let c7 = || c6()
    let c8 = || c7()
    let c9 = || c8()
    c9()
    print(r)
}
