// Plan stage R0z Z10 probe: a task runs a chain of 10 closures that pushes to `w.v`; main reads `w.v` after the scope (clean).
struct W { v: Vec<u64> }
fn main() / async {
    let w = W { v: Vec.new() }
    let c0 = || w.v.push(1)
    let c1 = || c0()
    let c2 = || c1()
    let c3 = || c2()
    let c4 = || c3()
    let c5 = || c4()
    let c6 = || c5()
    let c7 = || c6()
    let c8 = || c7()
    let c9 = || c8()
    scope { s =>
        s.spawn(|| c9())
    }
    print(w.v.len())
}
