// Plan stage R0z Z10 probe: a chain of 10 closures; the top level moves a `Vec` and runs the level below, and the bottom pushes to `w.v`; main runs the top one time (clean).
struct W { v: Vec<u64> }
fn take(v: Vec<u64>) { print(v.len()) }
fn main() {
    let w = W { v: Vec.new() }
    let v = Vec.new()
    v.push(1)
    let c0 = || w.v.push(1)
    let c1 = || c0()
    let c2 = || c1()
    let c3 = || c2()
    let c4 = || c3()
    let c5 = || c4()
    let c6 = || c5()
    let c7 = || c6()
    let c8 = || c7()
    let c9 = || c8()
    let top = || { take(v); c9() }
    top()
    print(w.v.len())
}
