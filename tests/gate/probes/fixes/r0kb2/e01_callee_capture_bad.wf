// Plan stage R0k-b2 (form 2 with a capture): `mk` makes a closure that
// keeps its parameter `h` and gives it to `run` through the row of `mk`.
// The frame of `mk` ends before the run, so the copy reads `h` as a cell
// of the closure value (the environment local of the region). `mk` is
// called in the handled body of H, whose clause clears `v`. The closure
// runs in the handled body of H2, but its `run` goes to H.
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { v.clear()
        resume(()) } } in {
        let c = mk(|| print(0))
        let r = &v[0]
        handle Run { fn run(g) { g()
            resume(()) } } in { c() }
        print(r)
    }
}
fn main() { outer() }
