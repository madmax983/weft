// Plan stage R0k-b2 (an acceptance probe of the B1 note): `c` is a `once`
// closure (it moves `w` out of its environment), and the site runs it two
// times in the handled body of H2: the second run is W0502. A copy of a
// `once` closure is refused, so the program keeps the fallback.
effect Run { fn run(g: fn()) }
fn eat(w: Vec<u64>) { print(w.len()) }
fn outer() {
    let w = Vec.new()
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let c = || { eat(w)
            run(|| print(0)) }
        handle Run { fn run(g) { g()
            resume(()) } } in {
            c()
            c()
        }
    }
}
fn main() { outer() }
