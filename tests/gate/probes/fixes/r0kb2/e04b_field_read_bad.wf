// Plan stage R0k-b2 (form 3, a field; another field is read too): `mk_box` makes a struct whose field
// holds a closure that keeps `h` and gives it to `run` through the row of
// `mk_box`. `mk_box` is called in the handled body of H, whose clause
// clears `v`. The site reads the field into a local and runs it in the
// handled body of H2. The `run` goes to H. The site also reads `b.n`: a
// use of the local of the way that is no step of the way, so the closure
// body can run elsewhere (no `sole`), and the program keeps the fallback.
effect Run { fn run(g: fn()) }
struct Bx { f: fn() / Run, n: u64 }
fn mk_box(h: fn()) -> Bx / Run { Bx { f: || run(h), n: 3 } }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { v.clear()
        resume(()) } } in {
        let b = mk_box(|| print(0))
        let r = &v[0]
        handle Run { fn run(g) { g()
            resume(()) } } in {
            let c = b.f
            c()
        }
        print(r)
        print(b.n)
    }
}
fn main() { outer() }
