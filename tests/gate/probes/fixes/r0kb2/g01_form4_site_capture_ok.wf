// Plan stage R0k-b2 (the review of R0k-b2, form 4 with a capture whose
// source is a live local of the site): the clause of `Give` runs its
// parameter `c`, and the copy in the clause reads `h` through the
// environment local of the region. The cell of `h` is a cell of the frame
// of `main`, so the facts of the read name `h` too (the fact oracle and
// the summary oracle check it). The program prints 0, then 1.
effect Run { fn run(g: fn()) }
effect Give { fn give(a: fn() / Run) }
fn main() {
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let h = || print(0)
        let c = || run(h)
        handle Give { fn give(a) { a()
            resume(()) } } in { give(c) }
        print(1)
    }
}
