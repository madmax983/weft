// Plan stage R0k-b2 (the clean twin of u13: the clear of `v` comes after the
// run of the kept value). `c` gets a closure of `mk` with a capture,
// then a clause gives `c` a second closure of `mk` before the run. The
// second one keeps `r`, a reference into `v`. The clause of the handler of
// `main` keeps the value, and `main` runs it before the clear of `v`. A body
// inside the owner writes `c`, so the run gets no copy.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
effect Sw { fn sw() }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let c = mk(|| print(0))
        handle Sw { fn sw() { c = mk(|| print(r))
            resume(()) } } in { sw() }
        c()
    }
    let x = h.f
    x()
    v.clear()
}
