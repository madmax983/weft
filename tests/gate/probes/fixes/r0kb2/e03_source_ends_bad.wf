// Plan stage R0k-b2 (a source that ends before the run): the closure that
// `k` holds keeps `x`, a local of a block that ends before the run. The
// cell of `x` stays alive through the closure value, so the copy reads it
// through the environment local of the region. The value of the clause
// clears `c.v` while `r` points into it.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    handle Get { fn get() { resume(|| c.v.clear()) } } in {
        let r = &c.v[0]
        let k = { let x = 7
            || { let g = get()
                g()
                print(x) } }
        k()
        print(r)
    }
}
