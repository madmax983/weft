// Plan stage R0k-b2 (a source that ends before the run), the clean twin:
// the value of the clause prints the length of `c.v` and does not change
// it. The program prints 1, 7, then 1.
struct C { v: Vec<u64> }
effect Get { fn get() -> fn() }
fn main() {
    let c = C { v: Vec.new() }
    c.v.push(1)
    handle Get { fn get() { resume(|| print(c.v.len())) } } in {
        let r = &c.v[0]
        let k = { let x = 7
            || { let g = get()
                g()
                print(x) } }
        k()
        print(r)
    }
}
