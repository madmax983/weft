// Plan stage R0k-b2 (an acceptance probe of the B1 note): the same closure
// of `mk` goes into a `Vec` two times, with other captures. The second run
// comes after the source of the capture of the first one changed: `b` is
// cleared, and the second closure reads `rb`, a reference into `b`. A copy
// that took the captures of the first value would read `ra`. A value in a
// `Vec` keeps the fallback.
effect Run { fn run(g: fn()) }
fn mk(r: &u64) -> fn() / Run { || run(|| print(r)) }
fn main() {
    let a = Vec.new()
    a.push(1)
    let b = Vec.new()
    b.push(2)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let fs = Vec.new()
        fs.push(mk(&a[0]))
        fs.push(mk(&b[0]))
        let f0 = fs[0]
        f0()
        b.clear()
        let f1 = fs[1]
        f1()
    }
}
