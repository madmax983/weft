// Plan stage R0k-b2 (form 2 with a capture that holds a reference), the
// clean twin: the clause of `main` runs the value at once, while `v` is
// alive. The program prints 1.
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn outer() / Run {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    let c = mk(|| print(r))
    handle Run { fn run(g) { resume(()) } } in { c() }
}
fn main() {
    handle Run { fn run(g) { g()
        resume(()) } } in { outer() }
}
