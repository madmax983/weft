// Plan stage R0k-b2 (an acceptance probe of the B1 note), the clean twin:
// the site runs the `once` closure one time. The program prints 0, then 0.
effect Run { fn run(g: fn()) }
fn eat(w: Vec<u64>) { print(w.len()) }
fn outer() {
    let w = Vec.new()
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let c = || { eat(w)
            run(|| print(0)) }
        handle Run { fn run(g) { g()
            resume(()) } } in {
            c()
        }
    }
}
fn main() { outer() }
