// Plan stage R0k-b2 (an acceptance probe of the B1 note), the clean twin:
// the clause of H runs `g` and does not clear `v`.
effect Run { fn run(g: fn()) }
fn mk(h: fn(), b: bool) -> fn() / Run {
    if b { || run(h) } else { || print(1) }
}
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let c = mk(|| print(0), true)
        let r = &v[0]
        handle Run { fn run(g) { print(9)
            resume(()) } } in { c() }
        print(r)
    }
}
fn main() { outer() }
