// Plan stage R0k-b2 (form 4 with a capture; p02 of the design review of
// R0k), the clean twin: the handled body clears `v` after the second
// perform. The program prints 1.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
fn main() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { let old = h.f
        old()
        h.f = g
        resume(()) } } in {
        let r = &v[0]
        run(|| print(r))
        run(|| print(0))
        v.clear()
    }
}
