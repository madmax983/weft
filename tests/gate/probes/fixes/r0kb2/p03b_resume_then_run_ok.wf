// Plan stage R0k-b2 (form 4 with a capture; p03 of the design review of
// R0k), the clean twin: the clause runs `g` before its `resume`, while the
// handled body waits and `v` is alive. The program prints 1.
effect Run { fn run(g: fn()) }
fn main() {
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let v = Vec.new()
        v.push(1)
        let r = &v[0]
        run(|| print(r))
    }
}
