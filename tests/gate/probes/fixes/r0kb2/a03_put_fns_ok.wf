// Plan stage R0k-b2 (an acceptance probe of the B1 note), the clean twin:
// the clause of H runs `g` and does not clear `v`.
effect Run { fn run(g: fn()) }
struct Bx { f: fn() / Run }
fn mk_box() -> Bx { Bx { f: || print(1) } }
fn noop() {}
fn put_fns(b: &Bx, f: fn() / Run) / mut(b) { b.f = f }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let b = mk_box()
        put_fns(&b, || run(noop))
        let r = &v[0]
        handle Run { fn run(g) { print(9)
            resume(()) } } in {
            let c = b.f
            c()
        }
        print(r)
    }
}
fn main() { outer() }
