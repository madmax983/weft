// Plan stage R0k-b2 (form 2 with a capture), the clean twin: the clause of
// H runs `g` and does not clear `v`. The program prints 0, then 1.
effect Run { fn run(g: fn()) }
fn mk(h: fn()) -> fn() / Run { || run(h) }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let c = mk(|| print(0))
        let r = &v[0]
        handle Run { fn run(g) { print(9)
            resume(()) } } in { c() }
        print(r)
    }
}
fn main() { outer() }
