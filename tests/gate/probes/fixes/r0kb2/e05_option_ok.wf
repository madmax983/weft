// Plan stage R0k-b2 (form 3, an `Option`), the clean twin: the clause of H
// runs `g` and does not clear `v`. The program prints 0, then 1.
effect Run { fn run(g: fn()) }
fn mk_opt(h: fn()) -> Option<fn() / Run> / Run { Some(|| run(h)) }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let o = mk_opt(|| print(0))
        let r = &v[0]
        handle Run { fn run(g) { print(9)
            resume(()) } } in {
            match o {
                Some(c) => c(),
                None => (),
            }
        }
        print(r)
    }
}
fn main() { outer() }
