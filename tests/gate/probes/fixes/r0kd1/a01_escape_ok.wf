// Plan stage R0k-d1 (A, the twin): the same shape, but the inner closure
// performs no operation of the handler, so no run of the clause maps to no
// node, and the program is in scope (as before the stage).
effect Ask { fn ask() -> u64 }
struct H { f: fn() }
fn apply(f: fn()) { f() }
fn call_h(h: &H) { let g = h.f; g() }
fn main() {
    let h = handle Ask { fn ask() { resume(5) } } in { H { f: || apply(|| print(1)) } }
    call_h(&h)
}
