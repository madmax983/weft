// F20-PARAMS (stage F20), clean twin: the linear type goes to the parameter that the callee gives back.
linear struct Tx { id: u64 }
fn begin(n: u64) -> Tx { Tx { id: n } }
fn commit(t: Tx) { let Tx(i) = t; print("commit {i}") }
fn first<A, B>(a: A, b: B) -> A { a }
fn main() { commit(first(begin(1), 2)) }
