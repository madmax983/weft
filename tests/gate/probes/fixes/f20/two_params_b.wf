// F20-PARAMS (stage F20): drops names each type parameter apart: the dropped parameter gets a linear type.
linear struct Tx { id: u64 }
fn begin(n: u64) -> Tx { Tx { id: n } }
fn commit(t: Tx) { let Tx(i) = t; print("commit {i}") }
fn first<A, B>(a: A, b: B) -> A { a }
fn main() { commit(first(begin(1), begin(2))) }
