// F10 review, hole H-B: a body with no IR and no error for it (w/w23_optRefNextIter.wf).
fn main() {
    let v = Vec.new()
    v.push(1)
    let o = None
    let i = 0
    while i < 3 {
        match o { Some(r) => print(r), None => {} }
        o = Some(&v[0])
        v.push(i)
        i += 1
    }
}
