// Stage F10a (tier 2 lost fault `W3_store_behind.wf`, here with no loop): a
// body puts `&v[0]` behind the reference parameter `out`, reads it back,
// borrows into it, and clears `v[0].kids`. The heap slot of `*out`
// (docs/ir.md 6.6) keeps the places of the stored reference: W0301.
struct Entity { hp: i32, id: u64, kids: Vec<Entity> }
fn behind(v: &Vec<Entity>, out: &Vec<&Entity>) / mut(v.., out) {
    let e = &v[0]
    out.push(e)
    let c = out[out.len() - 1]
    let k = &c.kids[0]
    e.kids.clear()
    print(k.hp)   //~ W0301
}
fn ent(id: u64) -> Entity {
    let e = Entity { hp: 1, id: id, kids: Vec.new() }
    e.kids.push(Entity { hp: 2, id: 9, kids: Vec.new() })
    e
}
test "behind" {
    let v = Vec.new()
    v.push(ent(1))
    let w = Vec.new()
    w.push(ent(2))
    let out = Vec.new()
    out.push(&w[0])
    behind(&v, &out)
}
