// F10 review, hole H-A: a reference in a heap slot read back after its referent changes (hA/ha07_paramStoreBehindRefLocal.wf).
struct Entity { hp: i32, id: u64, kids: Vec<Entity> }
fn ent(id: u64) -> Entity {
    let e = Entity { hp: 1, id: id, kids: Vec.new() }
    e.kids.push(Entity { hp: 2, id: 9, kids: Vec.new() })
    e
}
fn behind(v: &Vec<Entity>, out: &Vec<&Entity>) / mut(v.., out) {
    let e = &v[0]
    out.push(e)
    v.clear()
    print(out[1].hp)
}
fn main() {
    let v = Vec.new()
    v.push(ent(1))
    let w = ent(2)
    let out = Vec.new()
    out.push(&w)
    behind(&v, &out)
}
