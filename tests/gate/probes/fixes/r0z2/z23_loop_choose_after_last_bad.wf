// Plan stage R0z Z2, fix 2 (a probe of the second review of the stage: c03_loop_choose_after_last_bad).
// bad: `run` performs `choose` in a loop and holds a reference across it. The
// clause clears the object after its last resume.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    let i = 0
    while i < 2 {
        let c = choose()
        i += 1
    }
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { resume(true)
        resume(false)
        b2.v.clear() } } in { print(run(b.clone())) }
}
