// Plan stage R0z Z2 (the gap root_rc_between of stage R0k-c2, with a handle that
// moves into the call).
// clean twin of z02_root_moved_bad: the clause of `main` pushes to another object
// between its two resumes.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let w = Vec.new()
    handle Choice { fn choose() { resume(true)
        w.push(1)
        resume(false) } } in { print(run(b)) }
    print(w.len())
}
