// Plan stage R0z Z2, fix 3 (a probe of the third review of the stage: e16_ref_arg_after_bad).
// bad: run takes &Rc<B>; the handled body performs choose after the call.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: &Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { resume(true)
        resume(false)
        b2.v.clear() } } in { print(run(&b))
        print(choose()) }
}
