// Plan stage R0z Z2 (a handle that an operation gives).
// clean twin of z05_op_handle_bad: the clause of `main` reads the object between its
// two resumes. The handle of `run` goes out of scope at the end of the first run,
// but the copy holds its own copy of the handle.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
effect Get { fn get() -> Rc<B> }
fn run() -> u64 / Choice, Get {
    let h = get()
    let r = &h.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Get { fn get() { resume(b.clone()) } } in {
        handle Choice { fn choose() { resume(true)
            print(b2.v.len())
            resume(false) } } in { print(run()) }
    }
}
