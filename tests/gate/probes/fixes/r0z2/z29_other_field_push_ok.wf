// Plan stage R0z Z2, fix 2 (a probe of the second review of the stage: a13c_other_field_push_ok).
// clean: `run` holds a reference into field v; the clause pushes to field w first (a common log pattern).
struct B { v: Vec<u64>, w: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: &Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new(), w: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { b2.w.push(1)
        resume(true)
        b2.w.push(2)
        resume(false) } } in { print(run(&b)) }
}
