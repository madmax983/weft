// Plan stage R0z Z2, fix 3 (a probe of the third review of the stage: e01_body_perform_after_bad).
// bad: run waits once; the handled body performs choose again after the call. The inner clause clears after its last resume, before the outer second resume copies run.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { resume(true)
        resume(false)
        b2.v.clear() } } in { print(run(b.clone()))
        let z = choose()
        print(z) }
}
