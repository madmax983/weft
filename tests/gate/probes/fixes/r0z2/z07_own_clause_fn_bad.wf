// Plan stage R0z Z2, fix 1 (a probe of the review of the stage: m03_own_clause_fn_bad).
// bad: as m01_own_clear_first_bad, but a function that the clause calls
// clears the object before the first resume.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    let c = choose()
    print(r)
    1
}
fn wipe(x: &Rc<B>) / mut(B) {
    x.v.clear()
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { wipe(&b2)
        resume(true)
        resume(false) } } in { print(run(b.clone())) }
}
