// Plan stage R0z Z2, fix 1 (a probe of the review of the stage: m01_own_clear_first_ok).
// clean twin of m01_own_clear_first_bad: the clause reads the object.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { print(b2.v.len())
        resume(true)
        resume(false) } } in { print(run(b.clone())) }
}
