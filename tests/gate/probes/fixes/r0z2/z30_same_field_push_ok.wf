// Plan stage R0z Z2, fix 2 (a probe of the second review of the stage: a13d_same_field_push_ok).
// clean?: the clause pushes to field v (a push may move the cells: the checker treats it as a change).
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: &Rc<B>) -> u64 / Choice {
    let c = choose()
    print(b.v.len())
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { b2.v.push(1)
        resume(true)
        b2.v.push(2)
        resume(false) } } in { print(run(&b)) }
}
