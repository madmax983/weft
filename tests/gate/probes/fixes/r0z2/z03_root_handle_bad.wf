// Plan stage R0z Z2 (the false W0301 of root_rc_ok, stage R0k-c2 as built, "Open").
// bad twin of z03_root_handle_ok: after the read, the first run clears the object
// through its handle. The copies share the object, so the second copy reads a
// freed cell.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: Rc<B>) -> u64 / Choice, mut(B) {
    let r = &b.v[0]
    let c = choose()
    print(r)
    b.v.clear()
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    handle Choice { fn choose() { resume(true)
        resume(false) } } in { print(run(b)) }
}
