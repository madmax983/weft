// Plan stage R0z Z2 (the false W0301 of root_rc_ok, stage R0k-c2 as built, "Open").
// clean: `run` owns a handle of the `rc` object and holds a reference through it
// across the row `choose`. The handle goes out of scope at the end of the first
// run, but the copy of the frame holds its own copy of the handle, so the object
// lives, and the second copy reads it.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: Rc<B>) -> u64 / Choice, mut(B) {
    let r = &b.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    handle Choice { fn choose() { resume(true)
        resume(false) } } in { print(run(b)) }
}
