// Plan stage R0z Z2 (a handle that an operation gives).
// bad: `run` gets a handle of the `rc` object of `main` from the operation `get`,
// and holds a reference through it across the row `choose`. The clause of `main`
// clears the object through another handle between its two resumes. The copy of
// the frame of `run` reads a freed cell.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
effect Get { fn get() -> Rc<B> }
fn run() -> u64 / Choice, Get {
    let h = get()
    let r = &h.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Get { fn get() { resume(b.clone()) } } in {
        handle Choice { fn choose() { resume(true)
            b2.v.clear()
            resume(false) } } in { print(run()) }
    }
}
