// Plan stage R0z Z2 (the gap root_rc_between of stage R0k-c2).
// clean twin of z01_root_between_bad: the clause of `main` reads the object through
// the other handle between its two resumes, and does not change it.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: &Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { resume(true)
        print(b2.v.len())
        resume(false) } } in { print(run(&b)) }
}
