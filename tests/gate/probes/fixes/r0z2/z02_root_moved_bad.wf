// Plan stage R0z Z2 (the gap root_rc_between of stage R0k-c2, with a handle that
// moves into the call).
// bad: `run` gets a handle of the `rc` object of `main` and holds a reference
// through it across the row `choose`. The clause of `main` clears the object
// through another handle between its two resumes. The copy of the frame of `run`
// reads a freed cell.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { resume(true)
        b2.v.clear()
        resume(false) } } in { print(run(b)) }
}
