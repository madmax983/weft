// Plan stage R0z Z2, fix 1 (a probe of the review of the stage: f15_after_last_noref_ok).
// clean: `run` reads the object before the row only. The clause clears the
// object after its last resume.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: &Rc<B>) -> u64 / Choice {
    print(b.v.len())
    let c = choose()
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { resume(true)
        resume(false)
        b2.v.clear() } } in { print(run(&b)) }
}
