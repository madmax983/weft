// Plan stage R0z Z2, fix 2 (a probe of the second review of the stage: a13b_other_field_between_bad).
// bad: the clause clears field v between its resumes.
struct B { v: Vec<u64>, w: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: &Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new(), w: Vec.new() })
    b.v.push(4)
    b.w.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { resume(true)
        b2.v.clear()
        resume(false) } } in { print(run(&b)) }
}
