// Plan stage R0z Z2, fix 3 (a probe of the third review of the stage: e04_body_helper_after_bad).
// bad: the handled body calls a helper that performs choose after run.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    let c = choose()
    print(r)
    1
}
fn again() -> bool / Choice { choose() }
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { resume(true)
        resume(false)
        b2.v.clear() } } in { print(run(b.clone()))
        print(again()) }
}
