// Plan stage R0z Z2, fix 1 (a probe of the review of the stage: f13_count_ok).
// clean: a counter in an `rc` object. `step` reads the counter, chooses, and
// adds one to the counter after the row through a new read. The clause adds
// to the counter between its two resumes.
struct Ctr { n: u64 }
effect Choice { multi fn choose() -> bool }
fn step(c: &Rc<Ctr>) -> u64 / Choice, mut(Ctr) {
    let before = c.n
    let x = choose()
    c.n += 1
    before
}
fn main() {
    let c = Rc.new(Ctr { n: 0 })
    let c2 = c.clone()
    handle Choice { fn choose() { resume(true)
        c2.n += 10
        resume(false) } } in { print(step(&c)) }
    print(c.n)
}
