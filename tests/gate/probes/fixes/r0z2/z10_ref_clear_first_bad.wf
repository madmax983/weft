// Plan stage R0z Z2, fix 1 (a probe of the review of the stage: m01_ref_clear_first_bad).
// bad (once1 with `multi`): `run` holds a reference into the object across
// the row `choose`. The clause clears the object through another handle
// before its first resume. Each copy reads a freed cell.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(b: &Rc<B>) -> u64 / Choice {
    let r = &b.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Choice { fn choose() { b2.v.clear()
        resume(true)
        resume(false) } } in { print(run(&b)) }
}
