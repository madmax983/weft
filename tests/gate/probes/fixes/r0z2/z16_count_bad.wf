// Plan stage R0z Z2, fix 1 (a probe of the review of the stage: f13_count_bad).
// bad twin of f13_count_ok: `step` holds a reference into the vector of the
// `rc` object across the row; the clause clears the vector between its two
// resumes. The second copy reads a freed cell.
struct Ctr { n: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn step(c: &Rc<Ctr>) -> u64 / Choice {
    let r = &c.n[0]
    let x = choose()
    print(r)
    1
}
fn main() {
    let c = Rc.new(Ctr { n: Vec.new() })
    c.n.push(1)
    let c2 = c.clone()
    handle Choice { fn choose() { resume(true)
        c2.n.clear()
        resume(false) } } in { print(step(&c)) }
}
