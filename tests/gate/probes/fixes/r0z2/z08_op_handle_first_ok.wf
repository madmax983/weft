// Plan stage R0z Z2, fix 1 (a probe of the review of the stage: m08_op_handle_first_ok).
// clean twin of m08_op_handle_first_bad: the clause reads the object.
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
effect Get { fn get() -> Rc<B> }
fn run() -> u64 / Choice, Get {
    let h = get()
    let r = &h.v[0]
    let c = choose()
    print(r)
    1
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    let b2 = b.clone()
    handle Get { fn get() { resume(b.clone()) } } in {
        handle Choice { fn choose() { print(b2.v.len())
            resume(true)
            resume(false) } } in { print(run()) }
    }
}
