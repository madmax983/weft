// Plan stage R0z Z2, fix 1 (a probe of the review of the stage: f11_body_after_ok).
// clean: a search. `run` reads the log, then chooses. The handled body pushes
// the result to the log after the call. No reference into the log crosses
// the row.
struct Log { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
fn run(l: &Rc<Log>) -> usize / Choice {
    let n = l.v.len()
    let c = choose()
    if c { n + 1 } else { n + 2 }
}
fn main() {
    let l = Rc.new(Log { v: Vec.new() })
    handle Choice { fn choose() { resume(true)
        resume(false) } } in {
        let x = run(&l)
        l.v.push(3)
        print(x)
    }
    print(l.v.len())
}
