// Code of the caller stores a closure of a local handler into a place that outlives the handler.
effect Note { fn note(x: u64) }
struct Job { f: fn() }
fn copy(src: &Job, dst: &Job) / mut(dst) { dst.f = src.f }
fn apply(k: fn(&Job, &Job), a: &Job, b: &Job) { k(a, b) }
fn main() {
    let keep = Job { f: || print(0) }
    handle Note { fn note(x) { print(x)
 resume(()) } } in {
        let j = Job { f: || note(2) }
        apply(copy, &j, &keep)
    }
    let g = keep.f
    g()
}
