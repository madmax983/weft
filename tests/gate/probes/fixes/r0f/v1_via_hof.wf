// A callee gives a closure of a local handler to code of the caller, which stores it into a
// place that outlives the handler (W0313).
effect Note { fn note(x: u64) }
struct Job { f: fn() }
fn inner(src: &Job, dst: &Job) / mut(dst) { dst.f = src.f }
fn hof(src: &Job, dst: &Job, k: fn(&Job, &Job)) { k(src, dst) }
fn main() {
    let keep = Job { f: || print(0) }
    handle Note { fn note(x) { resume(()) } } in {
        let j = Job { f: || note(6) }
        hof(&j, &keep, inner)
    }
    let g = keep.f
    g()
}
