// The callee runs code of the caller in its task, and writes w while that code runs f, which reads n.
struct C { k: u64 }
fn mid(g: fn(fn()), f: fn(), w: &C) / async, mut(w) {
    scope { s =>
        s.spawn(|| g(f))
        w.k += 1
    }
}
fn main() / async {
    let c = C { k: 0 }
    mid(|x| x(), || print(c.k), &c)
    print(c.k)
}
