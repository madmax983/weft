// Hole C1-H1 (stage C1.1): the same with a generic callee.
linear struct Tx { id: u64 }
effect Pick { multi fn pick() -> bool }
fn commit(t: Tx) { let Tx(id) = t; print("commit", id) }
fn run_both(f: fn(), g: fn()) { f(); g() }
fn apply(f: fn()) { f() }
fn picky() / Pick { if pick() { print(1) } }
fn rb<T>(x: T, f: fn(), g: fn()) -> T { f(); g(); x }
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let t = Tx { id: 7 }
        let n = rb(1, || { if pick() { print(1) } }, || commit(t))
        print(n)
    }
}
