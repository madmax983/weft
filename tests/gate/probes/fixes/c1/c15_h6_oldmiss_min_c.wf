// Hole C1-H6, gap G2 of stage C1.5: a resume inside a nested body runs the code after the nested body again. Clean twin: the value resumes one time (or no loop), so there is no error.
effect Pick { multi fn pick() -> bool }
effect Ask { fn ask() -> bool }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn f(g: fn()) / Pick {
    let h = || g()
    handle Ask { fn ask() { resume(true) } } in { print(1) }
    h()
}
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let v = [1]
        f(|| print(take_v(v)))
    }
}
