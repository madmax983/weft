// Hole C1-H4 (follow-up C1.3): a closure performs a multi operation through a captured capability, then runs a captured once closure; a callee runs the closure. The second resume runs the once closure again (W0502 W0503).
effect Pick { multi fn pick() -> bool }
fn take(v: Vec<u64>) { print(v.len()) }
fn apply(f: fn()) { f() }
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let v = [1]
        let g = || take(v)
        apply(|| { if pick() { print(1) }; g() })
    }
}
