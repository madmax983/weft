// Issue #56 (stage C1, self-attack): two levels of closures that run a captured closure that performs nothing; the clause resumes one time. No W0503.
effect Pick { multi fn pick() -> bool }
linear struct Tx { id: u64 }
fn commit(t: Tx) { let Tx(i) = t; print("commit {i}") }
fn choose() / Pick { let b = pick(); print(b) }
fn apply(f: fn()) { f() }
fn main() {
    handle Pick { fn pick() { resume(true) } } in {
        let tx = Tx { id: 1 }
        let f1 = || print(1)
        let h = || f1()
        let g = || h()
        apply(g)
        commit(tx)
    }
}
