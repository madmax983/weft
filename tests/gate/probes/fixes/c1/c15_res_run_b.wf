// Gap G3 of stage C1.5: a run of a result comes after the run of the parameter that gives it.
effect Pick { multi fn pick() -> bool }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn run2(w: fn() -> fn()) { let k = w(); k() }
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let v = [1]
        let g = || print(take_v(v))
        run2(|| { if pick() { print(1) }; g })
    }
}
