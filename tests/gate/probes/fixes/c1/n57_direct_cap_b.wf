// Issue #57 (stage C1, self-attack): a closure that performs through its captured capability: the run of the closure runs the clause (W0602).
effect Grab { fn grab(r: &u64) -> u64 }
linear struct Lk { id: u64 }
fn unlock(l: Lk) { let Lk(i) = l; print("unlock {i}") }
fn apply(f: fn()) { f() }
fn run_both(f: fn(), g: fn()) { f(); g() }
fn main() {
    handle Grab { fn grab(r) { let z = r + 0; resume(z) } } in {
        let lk = Lk { id: 1 }
        let g = || { let x = 1; print(grab(&x)) }
        apply(g)
        unlock(lk)
    }
}
