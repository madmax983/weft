// Hole C1-H6, gap G2 of stage C1.5: a resume inside a nested body runs the code after the nested body again.
effect Pick { multi fn pick() -> bool }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn f(m: fn(), g: fn()) {
    let x = handle Fail { fn fail(e) { 0 } } in { m(); fail("stop"); 1 }
    g()
}
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let v = [1]
        f(|| { if pick() { print(1) } }, || print(take_v(v)))
    }
}
