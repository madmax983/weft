// Hole C1-H1 (stage C1.1): a callee runs a function value that performs a multi operation, then a once closure. The second resume runs the once closure again (W0502 W0503).
linear struct Tx { id: u64 }
effect Pick { multi fn pick() -> bool }
fn commit(t: Tx) { let Tx(id) = t; print("commit", id) }
fn run_both(f: fn(), g: fn()) { f(); g() }
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let t = Tx { id: 7 }
        run_both(|| { if pick() { print(1) } }, || commit(t))
    }
}
