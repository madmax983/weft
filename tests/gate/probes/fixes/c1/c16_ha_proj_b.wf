// Hole C1-HA of stage C1.6: a `once` closure from a call result is live across a value that resumes two times.
effect Pick { multi fn pick() -> bool }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn picky() / Pick { if pick() { print(1) } }
fn quiet() { print(1) }
fn mk(g: fn()) -> (u64, fn()) { (1, g) }
fn body() / Pick {
    let v = [1]
    let g = || print(take_v(v))
    let h = mk(g).1
    picky()
    h()
}
fn main() { handle Pick { fn pick() { resume(true); resume(false) } } in body() }
