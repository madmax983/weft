// Plan stage R0z Z9b (bad): `go` goes into another local and runs later; the
// scope body gives `f` a new value after the run, while the task can run.
fn main() / async {
    let f = || print(1)
    f = || print(2)
    scope { s =>
        let go = || s.spawn(|| f())
        let keep = go
        print(0)
        keep()
        f = || print(3)
    }
