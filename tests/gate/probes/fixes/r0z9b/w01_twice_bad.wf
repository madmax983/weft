// Plan stage R0z Z9b (bad): the closure `go` runs two times. Each run gives
// `f` a new value, and the second run does it while the first task can run.
fn main() / async {
    let f = || print(1)
    f = || print(2)
    scope { s =>
        let go = || {
            f = || print(3)
            s.spawn(|| f())
        }
        go()
        go()
    }
}
