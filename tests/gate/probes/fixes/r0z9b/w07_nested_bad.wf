// Plan stage R0z Z9b (bad): `go` spawns on the outer scope from an inner
// scope; the task outlives the inner scope, and the outer scope body gives
// `f` a new value after the inner scope.
fn main() / async {
    let f = || print(1)
    f = || print(2)
    scope { s =>
        scope { s2 =>
            let go = || s.spawn(|| f())
            go()
            s2.spawn(|| print(0))
        }
        f = || print(3)
    }
}
