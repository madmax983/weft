// Plan stage R0z Z9b (bad): a task of the scope runs `go`; the scope body
// gives `f` a new value while both tasks can run.
fn main() / async {
    let f = || print(1)
    f = || print(2)
    scope { s =>
        let go = || { s.spawn(|| f()); () }
        s.spawn(|| go())
        f = || print(3)
    }
}
