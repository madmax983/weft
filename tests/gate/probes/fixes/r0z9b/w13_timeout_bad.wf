// Plan stage R0z Z9b (bad): `with_timeout` runs `go` in the scope; the scope
// body gives `f` a new value after it.
fn main() / async, clock, fail {
    let f = || print(1)
    f = || print(2)
    scope { s =>
        let go = || { s.spawn(|| f()); () }
        with_timeout(50.ms) { go() }
        f = || print(3)
    }
}
