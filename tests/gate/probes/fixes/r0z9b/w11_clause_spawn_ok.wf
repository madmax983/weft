// Plan stage R0z Z9b (clean): a clause spawns on the scope around its
// handle.
effect Op { fn op() }
fn main() / async {
    let f = || print(1)
    f = || print(2)
    scope { s =>
        handle Op {
            fn op() {
                s.spawn(|| f())
                resume(())
            }
        } in {
            op()
            print(0)
        }
    }
}
