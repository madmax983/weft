// Plan stage R0z Z9b (escape): a closure that spawns on the scope goes out
// of the scope and runs after it. `f` gets no value after the scope, so the
// task runs the value that the spawn sees. The old pipeline gives W0405 (the
// end of `main` frees `f` while the task can read it).
fn main() / async {
    let f = || print(1)
    f = || print(2)
    let g = || print(0)
    scope { s =>
        g = || { s.spawn(|| f()); () }
    }
    g()
}
