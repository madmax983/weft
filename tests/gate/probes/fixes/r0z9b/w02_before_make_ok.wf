// Plan stage R0z Z9b (clean, refusal): the scope body gives `f` a new value
// before it makes `go`. Each write of the scope body counts (the window is
// not exact there), so the program keeps the fallback.
fn main() / async {
    let f = || print(1)
    scope { s =>
        f = || print(2)
        let go = || s.spawn(|| f())
        go()
    }
}
