// Plan stage R0z Z9b (R-ESCAPE, clean, refusal): `mk` returns a function
// value, but the closure that spawns on the scope stays in `mk`. The result
// type can hold a function value, so the old rule stays (two writes of `f`:
// the fallback).
fn mk() -> fn() / async {
    let f = || print(1)
    f = || print(2)
    scope { s =>
        let go = || s.spawn(|| f())
        go()
    }
    || print(0)
}
fn main() / async {
    let g = mk()
    g()
}
