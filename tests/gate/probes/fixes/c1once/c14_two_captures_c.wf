// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): the made closure runs two captures one time each; the clean twin (scratchpad c1once/v/v15_two_caps_c.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn both(f: fn(), h: fn()) -> fn() { || {
    f()
    h() } }
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let g = both(|| eat(b), || print(1))
    g()
}
fn main() { once_returned() }
