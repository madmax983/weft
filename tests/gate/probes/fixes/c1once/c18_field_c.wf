// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): a callee puts a made closure that runs the capture one time into a field; the clean twin (scratchpad c1once/v/v19_field_callee_c.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap1(f: fn()) -> fn() { || f() }
struct Hook { f: fn() }
fn hook(f: fn()) -> Hook { Hook { f: f } }
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let h = hook(wrap1(|| eat(b)))
    let g = h.f
    g()
}
fn main() { once_returned() }
