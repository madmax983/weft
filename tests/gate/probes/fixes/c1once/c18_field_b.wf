// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): a callee puts the made closure into a field (scratchpad c1once/v/v19_field_callee_b.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap(f: fn()) -> fn() { || {
    f()
    f() } }
struct Hook { f: fn() }
fn hook(f: fn()) -> Hook { Hook { f: f } }
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let h = hook(wrap(|| eat(b)))
    let g = h.f
    g()
}
fn main() { once_returned() }
