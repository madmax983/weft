// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): a closure gives back a made closure that runs the capture one time; the clean twin (scratchpad c1once/v/v06_closure_ret_c.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap1(f: fn()) -> fn() { || f() }
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let mk = || wrap1(|| eat(b))
    let g = mk()
    g()
}
fn main() { once_returned() }
