// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): a callee runs a made closure that runs the capture one time; the clean twin (scratchpad c1once/v/v11_callee_runs_c.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap1(f: fn()) -> fn() { || f() }
fn call0(g: fn()) { g() }
fn once_given() {
    let b = Buf { items: Vec.new() }
    call0(wrap1(|| eat(b)))
}
fn main() { once_given() }
