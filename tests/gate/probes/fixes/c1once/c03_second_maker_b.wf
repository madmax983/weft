// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): a second maker gives back the made closure (scratchpad c1once/v/v03_wrapper2_b.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap(f: fn()) -> fn() { || {
    f()
    f() } }
fn wrap2(f: fn()) -> fn() { wrap(f) }
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let g = wrap2(|| eat(b))
    g()
}
fn main() { once_returned() }
