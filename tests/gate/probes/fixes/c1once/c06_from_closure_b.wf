// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): a closure gives back the made closure (scratchpad c1once/v/v06_closure_ret_b.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap(f: fn()) -> fn() { || {
    f()
    f() } }
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let mk = || wrap(|| eat(b))
    let g = mk()
    g()
}
fn main() { once_returned() }
