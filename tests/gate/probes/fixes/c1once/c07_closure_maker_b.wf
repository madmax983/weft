// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): a closure is the maker (scratchpad c1once/v/v06b_closure_maker_b.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let mk = |f: fn()| {
        || {
            f()
            f() }
    }
    let g = mk(|| eat(b))
    g()
}
fn main() { once_returned() }
