// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): the made closure gets another made closure (scratchpad c1once/v/v03c_nested_b.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap1(f: fn()) -> fn() { || f() }
fn wrap(f: fn()) -> fn() { || {
    f()
    f() } }
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let g = wrap(wrap1(|| eat(b)))
    g()
}
fn main() { once_returned() }
