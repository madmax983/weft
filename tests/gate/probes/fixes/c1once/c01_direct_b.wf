// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): the made closure runs the capture two times (scratchpad f19/or3c1.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap(f: fn()) -> fn() { || {
 f()
 f() } }
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let g = wrap(|| eat(b))
    g()
}
fn main() {
    once_returned()
}
