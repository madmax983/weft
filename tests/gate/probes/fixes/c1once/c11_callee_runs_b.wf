// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): a callee runs the made closure one time (scratchpad c1once/v/v11_callee_runs_b.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap(f: fn()) -> fn() { || {
    f()
    f() } }
fn call0(g: fn()) { g() }
fn once_given() {
    let b = Buf { items: Vec.new() }
    call0(wrap(|| eat(b)))
}
fn main() { once_given() }
