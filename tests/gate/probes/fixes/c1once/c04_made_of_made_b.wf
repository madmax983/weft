// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): the made closure runs another made closure two times (scratchpad c1once/v/v03b_made_twice_b.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap1(f: fn()) -> fn() { || f() }
fn wrap2(f: fn()) -> fn() {
    let h = wrap1(f)
    || {
        h()
        h() }
}
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let g = wrap2(|| eat(b))
    g()
}
fn main() { once_returned() }
