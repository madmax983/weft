// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): the `once` closure is in a local, and the made closure runs it one time; the clean twin (scratchpad c1once/v/v10_via_local_c.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap1(f: fn()) -> fn() { || f() }
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let e = || eat(b)
    let g = wrap1(e)
    g()
}
fn main() { once_returned() }
