// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): a made closure that runs the capture one time is in a tuple; the clean twin (scratchpad c1once/v/v18_tuple_c.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap1(f: fn()) -> fn() { || f() }
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let t = (wrap1(|| eat(b)), 1)
    let g = t.0
    g()
}
fn main() { once_returned() }
