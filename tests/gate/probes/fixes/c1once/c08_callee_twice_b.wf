// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): a callee runs the made closure two times (scratchpad c1once/v/v07b_twice_buf_b.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap1(f: fn()) -> fn() { || f() }
fn twice(g: fn()) {
    g()
    g()
}
fn once_twice() {
    let b = Buf { items: Vec.new() }
    twice(wrap1(|| eat(b)))
}
fn main() { once_twice() }
