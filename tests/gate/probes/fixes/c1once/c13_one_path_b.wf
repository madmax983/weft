// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): the made closure runs the capture a second time on one path (scratchpad c1once/v/v14_branch_b.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap(f: fn(), two: bool) -> fn() { || {
    f()
    if two { f() } } }
fn once_returned() {
    let b = Buf { items: Vec.new() }
    let g = wrap(|| eat(b), true)
    g()
}
fn main() { once_returned() }
