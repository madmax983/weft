// Follow-up F19.2, class C1-ONCE (a closure that a callee made runs a `once` capture two times): the argument is a `many` closure; the clean twin (scratchpad c1once/v/v01_direct_m.wf).
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn wrap(f: fn()) -> fn() { || {
    f()
    f() } }
fn many_returned() {
    let b = Buf { items: Vec.new() }
    let g = wrap(|| print(b.items.len()))
    g()
}
fn main() { many_returned() }
