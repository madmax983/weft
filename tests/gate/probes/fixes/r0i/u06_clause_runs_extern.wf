// on abort: a local clause calls an extern result
effect Stop { fn stop() }
extern fn mk() -> fn()
linear struct T { n: u64 }
    on abort = undo
effect Q { fn q() }
fn undo(t: T) {
    let T(n) = t
    handle Fail { fn fail(m) { print("caught {m}") } } in {
        handle Q { fn q() { let f = mk()
            f()
            resume(()) } } in q()
    }
}
fn done(t: T) { let T(n) = t }
fn par() { scope { s => s.spawn(|| print(1)) } }
fn body() / Stop {
    let t = T { n: 1 }
    stop()
    done(t)
}
fn main() {
    par()
    handle Stop { fn stop() { () } } in body()
}
