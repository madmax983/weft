// nonportable closure through: a non-generic struct with a fn field, captured whole; fork branch runs it (W0401 expected)
struct Holder { cb: fn() }
fn main() {
    let r = Rc.new(0)
    let c = || { let y = r.clone() }
    let h = Holder { cb: c }
    let f = || { let g = h.cb
        g() }
    fork(|| f(), || print(1))
}
