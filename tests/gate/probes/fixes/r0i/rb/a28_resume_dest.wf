// a clause gets a linear closure as the value of resume (the rest of the handled body
// gives it), then an abort: the unwinder must roll back tx
linear struct Tx { id: u64 }
    on abort = rollback
fn rollback(t: Tx) { let Tx(i) = t
    print("rollback {i}") }
fn commit(t: Tx) { let Tx(i) = t
    print("commit {i}") }
effect Stop { fn stop() }
effect Q { fn q() }
fn body() / Stop {
    let f = handle Q { fn q() {
        let g = resume(())
        stop()
        g
    } } in {
        q()
        let tx = Tx { id: 1 }
        || commit(tx)
    }
    f()
}
fn main() {
    handle Stop { fn stop() { () } } in body()
    print("end")
}
