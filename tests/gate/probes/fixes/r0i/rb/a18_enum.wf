// abort with a linear closure held through: a generic enum payload (the unwinder must roll back tx)
linear struct Tx { id: u64 }
    on abort = rollback
fn rollback(t: Tx) { let Tx(i) = t
    print("rollback {i}") }
fn commit(t: Tx) { let Tx(i) = t
    print("commit {i}") }
effect Stop { fn stop() }
fn id<T>(x: T) -> T { x }
enum E<T> { A(T), B }
fn body() / Stop {
    let tx = Tx { id: 1 }
    let c = || commit(tx)
    let e = A(c)
    let f = match e { A(g) => g, B => || print(0) }
    stop()
    f()
}
fn main() {
    handle Stop { fn stop() { () } } in body()
    print("end")
}
