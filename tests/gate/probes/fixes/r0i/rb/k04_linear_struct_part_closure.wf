// a part of a linear struct (u64) captured by a closure, the rest consumed (clean)
linear struct Tx { id: u64 }
fn commit(t: Tx) { let Tx(i) = t
    print(i) }
fn keep<T>(x: T) -> T { x }
linear struct P { t: Tx, n: u64 }
fn main() { let p = P { t: Tx { id: 1 }, n: 2 }
    let P(t, n) = p
    let c = || print(n)
    commit(t) }
