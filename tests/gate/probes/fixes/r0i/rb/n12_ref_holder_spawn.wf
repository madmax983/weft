// nonportable closure through: a reference to a holder struct; a scope task runs it (must be pinned)
struct Holder { cb: fn() }
fn main() {
    let r = Rc.new(0)
    let c = || { let y = r.clone() }
    let h = Holder { cb: c }
    let hr = &h
    let f = hr.cb
    scope { s =>
        let t = s.spawn(|| f())
        t.join()
    }
}
