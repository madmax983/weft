// nonportable closure through: a function item that returns a closure capturing its Rc param; a scope task runs it (must be pinned)
fn mk(r: Rc<u64>) -> fn() { || { let y = r.clone() } }
fn main() {
    let r = Rc.new(0)
    let c = || { let y = r.clone() }
    let f = mk(r)
    scope { s =>
        let t = s.spawn(|| f())
        t.join()
    }
}
