// abort with a linear closure held through: a recursive generic callee (the unwinder must roll back tx)
linear struct Tx { id: u64 }
    on abort = rollback
fn rollback(t: Tx) { let Tx(i) = t
    print("rollback {i}") }
fn commit(t: Tx) { let Tx(i) = t
    print("commit {i}") }
effect Stop { fn stop() }
fn id<T>(x: T) -> T { x }
fn r<T>(n: u64, x: T) -> T { if n == 0 { x } else { r(n - 1, x) } }
fn body() / Stop {
    let tx = Tx { id: 1 }
    let c = || commit(tx)
    let f = r(2, c)
    stop()
    f()
}
fn main() {
    handle Stop { fn stop() { () } } in body()
    print("end")
}
