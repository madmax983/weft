// nonportable closure through: a Vec push and an index; a scope task runs it (must be pinned)

fn main() {
    let r = Rc.new(0)
    let c = || { let y = r.clone() }
    let v: Vec<fn()> = Vec.new()
    v.push(c)
    let f = v[0]
    scope { s =>
        let t = s.spawn(|| f())
        t.join()
    }
}
