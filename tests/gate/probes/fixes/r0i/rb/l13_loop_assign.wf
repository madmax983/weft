// a linear closure assigned in a loop to an outer local, dropped
linear struct Tx { id: u64 }
fn commit(t: Tx) { let Tx(i) = t
    print("commit {i}") }
fn main() {
    let tx = Tx { id: 1 }
    let c = || commit(tx)
    let f = || print(0)
    let n = 0
    while n < 1 {
        f = c
        n = n + 1
    }
}
