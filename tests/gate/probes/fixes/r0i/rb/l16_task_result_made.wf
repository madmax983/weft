// a task makes a linear closure and gives it back by join; dropped
linear struct Tx { id: u64 }
fn commit(t: Tx) { let Tx(i) = t
    print("commit {i}") }
fn main() {
    let tx = Tx { id: 1 }
    scope { s =>
        let t = s.spawn(|| { let c = || commit(tx)
            c })
        let f = t.join()
    }
}
