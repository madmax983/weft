// abort with a linear closure held through: a callee that writes it behind a reference (the unwinder must roll back tx)
linear struct Tx { id: u64 }
    on abort = rollback
fn rollback(t: Tx) { let Tx(i) = t
    print("rollback {i}") }
fn commit(t: Tx) { let Tx(i) = t
    print("commit {i}") }
effect Stop { fn stop() }
fn id<T>(x: T) -> T { x }
struct W<T> { x: T }
fn put<T>(dst: &W<T>, v: T) { dst.x = v }
fn body() / Stop {
    let tx = Tx { id: 1 }
    let c = || commit(tx)
    let w = W { x: || print(0) }
    put(&w, c)
    let W(f) = w
    stop()
    f()
}
fn main() {
    handle Stop { fn stop() { () } } in body()
    print("end")
}
