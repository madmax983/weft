// a join gives back a Tx (type shows linear); abort after
linear struct Tx { id: u64 }
    on abort = rollback
fn rollback(t: Tx) { let Tx(i) = t
    print("rollback {i}") }
fn commit(t: Tx) { let Tx(i) = t
    print("commit {i}") }
effect Stop { fn stop() }
fn body() / Stop, async {
    let tx = Tx { id: 1 }
    let x = scope { s =>
        let t = s.spawn(|| tx)
        t.join()
    }
    stop()
    commit(x)
}
fn main() / async {
    handle Stop { fn stop() { () } } in body()
    print("end")
}
