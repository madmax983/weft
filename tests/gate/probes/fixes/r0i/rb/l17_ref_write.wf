// a callee writes a linear closure behind a reference parameter; the caller drops it
linear struct Tx { id: u64 }
fn commit(t: Tx) { let Tx(i) = t
    print("commit {i}") }
fn put(dst: &fn(), v: fn()) { *dst = v }
fn main() {
    let tx = Tx { id: 1 }
    let c = || commit(tx)
    let f = || print(0)
    put(&f, c)
}
