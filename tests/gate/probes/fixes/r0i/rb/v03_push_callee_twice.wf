// a once closure pushed (no stated local) into a Vec; a callee calls two copies
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn twice(fs: &Vec<fn()>) { let g = fs[0]
    g()
    let h = fs[0]
    h() }
fn main() {
    let v = [1]
    let xs = Vec.new()
    xs.push(|| print(take_v(v)))
    twice(&xs)
}
