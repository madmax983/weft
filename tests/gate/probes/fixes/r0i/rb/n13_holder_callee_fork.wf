// a callee makes a Holder (non-generic, fn field) whose closure captures an Rc;
// a closure captures the holder whole and a fork branch runs it (W0401 expected)
struct Holder { cb: fn() }
fn mkh() -> Holder {
    let r = Rc.new(0)
    Holder { cb: || { let y = r.clone() } }
}
fn main() {
    let h = mkh()
    let f = || { let g = h.cb
        g() }
    fork(|| f(), || print(1))
}
