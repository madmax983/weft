// on abort: a local clause gives back an extern result, the handled body calls it
effect Stop { fn stop() }
extern fn mk() -> fn()
linear struct T { n: u64 }
    on abort = undo
effect Q { fn q() -> fn() }
fn undo(t: T) {
    let T(n) = t
    handle Fail { fn fail(m) { print("caught {m}") } } in {
        handle Q { fn q() { resume(mk()) } } in {
            let f = q()
            f()
        }
    }
}
fn done(t: T) { let T(n) = t }
fn par() { scope { s => s.spawn(|| print(1)) } }
fn body() / Stop {
    let t = T { n: 1 }
    stop()
    done(t)
}
fn main() {
    par()
    handle Stop { fn stop() { () } } in body()
}
