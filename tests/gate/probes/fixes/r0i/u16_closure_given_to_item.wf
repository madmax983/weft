// on abort gives a closure that calls an extern result to an item that calls it, all caught
effect Stop { fn stop() }
extern fn mk() -> fn()
linear struct T { n: u64 }
    on abort = undo
fn apply(g: fn()) { g() }
fn undo(t: T) {
    let T(n) = t
    handle Fail { fn fail(m) { print("caught {m}") } } in { apply(|| { let f = mk()
        f() }) }
}
fn done(t: T) { let T(n) = t }
fn par() { scope { s => s.spawn(|| print(1)) } }
fn body() / Stop {
    let t = T { n: 1 }
    stop()
    done(t)
}
fn main() {
    par()
    handle Stop { fn stop() { () } } in body()
}
