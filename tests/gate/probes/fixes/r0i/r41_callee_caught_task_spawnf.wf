// as r40, the callee spawns the value itself
effect Stop { fn stop() }
effect Ask { fn ask() -> u64 }
linear struct T { f: fn() }
    on abort = undo
fn go(f: fn()) {
    handle Fail { fn fail(m) { print("caught {m}") } } in {
        scope { s =>
            let k = s.spawn(f)
            k.join()
        }
    }
}
fn undo(t: T) {
    let T(f) = t
    go(f)
}
fn done(t: T) { let T(f) = t
    f() }
fn body() / Stop, Ask {
    let t = T { f: || print(ask()) }
    stop()
    done(t)
}
fn main() {
    handle Ask { fn ask() { resume(5) } } in {
        handle Stop { fn stop() { () } } in body()
    }
}
