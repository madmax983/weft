// extern returns a fn value with a row; on abort calls it
effect Stop { fn stop() }
extern fn mk() -> fn() / log
linear struct T { n: u64 }
    on abort = undo
fn undo(t: T) {
    let T(n) = t
    let f = mk()
    f()
}
fn done(t: T) { let T(n) = t }
fn body() / Stop {
    let t = T { n: 1 }
    stop()
    done(t)
}
fn main() {
    handle Stop { fn stop() { () } } in body()
}
