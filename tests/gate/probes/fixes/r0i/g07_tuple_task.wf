// a tuple (u64, fn()) field, the fn run as a task under a caught Fail
effect Stop { fn stop() }
effect Ask { fn ask() -> u64 }

linear struct T { p: (u64, fn()) }
    on abort = undo
fn undo(t: T) {
    let T(p) = t
    let (i, f) = p
    handle Fail { fn fail(m) { print("caught {m}") } } in {
        scope { s =>
            let k = s.spawn(|| f())
            k.join()
        }
    }
}
fn done(t: T) {
    let T(p) = t
    let (i, f) = p
    f()
}
fn body() / Stop, Ask {
    let t = T { p: (1, || print(ask())) }
    stop()
    done(t)
}
fn main() {
    handle Ask { fn ask() { resume(5) } } in {
        handle Stop { fn stop() { () } } in body()
    }
}
