// on abort calls a local closure that calls an extern result under its own caught Fail
effect Stop { fn stop() }
extern fn mk() -> fn()
linear struct T { n: u64 }
    on abort = undo

fn undo(t: T) {
    let T(n) = t
    let g = || { handle Fail { fn fail(m) { print("caught {m}") } } in {
        let f = mk()
        f()
    } }
    g()
}
fn done(t: T) { let T(n) = t }
fn par() { scope { s => s.spawn(|| print(1)) } }
fn body() / Stop {
    let t = T { n: 1 }
    stop()
    done(t)
}
fn main() {
    par()
    handle Stop { fn stop() { () } } in body()
}
