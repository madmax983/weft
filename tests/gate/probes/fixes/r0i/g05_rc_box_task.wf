// an Rc<Box> field with a fn field (no type argument), run as a task under a caught Fail
effect Stop { fn stop() }
effect Ask { fn ask() -> u64 }
struct Box { f: fn() }
linear struct T { r: Rc<Box> }
    on abort = undo
fn undo(t: T) {
    let T(r) = t
    let f = r.f
    handle Fail { fn fail(m) { print("caught {m}") } } in {
        scope { s =>
            let k = s.spawn(|| f())
            k.join()
        }
    }
}
fn done(t: T) {
    let T(r) = t
    let f = r.f
    f()
}
fn body() / Stop, Ask {
    let t = T { r: Rc.new(Box { f: || print(ask()) }) }
    stop()
    done(t)
}
fn main() {
    handle Ask { fn ask() { resume(5) } } in {
        handle Stop { fn stop() { () } } in body()
    }
}
