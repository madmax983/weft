// Third review of the ABC preview, old hole b14-agg: a once closure copied out through a reference inside an aggregate argument (b14s/h03_tuple_two_refs.wf).
struct Buf { items: Vec<u64> }
fn mkbuf() -> Buf { let b = Buf { items: Vec.new() }; b.items.push(1); b }
fn eat(b: Buf) { print(b.items.len()) }
fn run(f: fn()) { f() }
struct K { f: fn() }
fn rt(t: (&Vec<fn()>, &Vec<fn()>)) { let (a, c) = t; let g = a[0]; g() }
fn main() {
    let b = mkbuf()
    let fs = Vec.new()
    fs.push(|| eat(b))
    let es = Vec.new()
    rt((&fs, &es))
    rt((&fs, &es))
}
