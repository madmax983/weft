// Third review of the ABC preview, clean twin of old hole b14-agg (b14s/s09_ctl_option_ref_loop.wf).
struct Buf { items: Vec<u64> }
fn mkbuf() -> Buf { let b = Buf { items: Vec.new() }; b.items.push(1); b }
fn eat(b: Buf) { print(b.items.len()) }
fn run(f: fn()) { f() }
struct K { f: fn() }
fn ro(o: Option<&Vec<fn()>>) { match o { Some(v) => run(v[0]), None => {} } }
fn main() {
    let b = mkbuf()
    let fs = Vec.new()
    fs.push(|| print(b.items.len()))
    let i = 0
    while i < 2 { ro(Some(&fs)); i += 1 }
}
