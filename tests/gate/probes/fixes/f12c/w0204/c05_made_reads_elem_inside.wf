// Third review of the ABC preview, a made closure reads a reference that its maker took (ABC rejected it only through the W0204 of the unit tail) (n1c/c05_made_reads_elem_inside.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
struct K { f: fn() }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn run(f: fn()) { f() }
fn give(m: fn() -> fn()) -> fn() { m() }
fn main() {
    let w = mkw()
    let mk = || { let first = &w.entities[0]; || print(first.hp) }
    let mk2 = || mk()
    let g = mk2()
    w.entities.clear()
    g()
}
