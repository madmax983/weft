// Third review of the ABC preview, false positive W0204 at a unit tail call (fpx2/u_d.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn give(m: fn() -> fn()) -> fn() { m() }
fn main() {
let w = mkw(); let first = &w.entities[0]; let g = give(|| || print(first.hp)); g()
}
