// Third review of the ABC preview, false positive W0204 at a unit tail call (n1c/x09_ctl_made_reads_ref_loop.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
struct K { f: fn() }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn run(f: fn()) { f() }
fn give(m: fn() -> fn()) -> fn() { m() }
fn main() {
    let w = mkw()
    let first = &w.entities[0]
    let mk = || || print(first.hp)
    let mk2 = || mk()
    let g = mk2()
    let i = 0
    while i < 2 { if i == 1 { print(w.entities.len()) }; i += 1 }
    g()
}
