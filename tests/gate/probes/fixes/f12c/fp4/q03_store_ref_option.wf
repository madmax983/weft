// Third review of the ABC preview, false positive FP4: a wrong capture mapping of a made closure (st/q03_store_ref_option.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn go(m: fn() -> fn()) { let g = m(); g() }
fn main() {
    let w = mkw()
    let o = None
    let mk = || || { o = Some(&w.entities[0]) }
    let g = mk()
    g()
    match o { Some(e) => print(e.hp), None => {} }
}
