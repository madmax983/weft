// Third review of the ABC preview, false positive FP4: a wrong capture mapping of a made closure (st/m04_go_clean.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn go(m: fn() -> fn()) { let g = m(); g() }
fn give(m: fn() -> fn()) -> fn() { m() }
fn run(f: fn()) { f() }
fn main() {
    let w = mkw()
    let rs = Vec.new()
    go(|| || rs.push(&w.entities[0]))
    print(rs[0].hp)
}
