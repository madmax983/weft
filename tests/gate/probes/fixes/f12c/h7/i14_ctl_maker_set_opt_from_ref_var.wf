// Third review of the ABC preview, clean twin of hole H7 (it failed the fact oracle) (pi/i14_ctl_maker_set_opt_from_ref_var.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn go(m: fn() -> fn()) { let g = m(); g() }
fn give(m: fn() -> fn()) -> fn() { m() }
fn run(f: fn()) { f() }
fn main() {
    let w = mkw()
    let o = None
    let first = &w.entities[0]
    let mk = || || { o = Some(first) }
    let g = mk()
    g()
    match o { Some(e) => print(e.hp), None => {} }
    print(1)
}
