// Third review of the ABC preview, H7 shape that failed the fact oracle (pi/i05_maker_set_opt_copy_out_then_clear.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn go(m: fn() -> fn()) { let g = m(); g() }
fn give(m: fn() -> fn()) -> fn() { m() }
fn run(f: fn()) { f() }
fn main() {
    let w = mkw()
    let o = None
    let mk = || || { o = Some(&w.entities[0]) }
    let g = mk()
    g()
    let r = match o { Some(e) => e, None => &w.entities[0] }
    w.entities.clear()
    print(r.hp)
}
