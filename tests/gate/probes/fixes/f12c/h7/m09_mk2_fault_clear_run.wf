// Third review of the ABC preview, H7 shape that ABC rejected only through the wrong fact of FP4 (st/m09_mk2_fault_clear_run.wf).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
fn go(m: fn() -> fn()) { let g = m(); g() }
fn give(m: fn() -> fn()) -> fn() { m() }
fn run(f: fn()) { f() }
fn main() {
    let w = mkw()
    let rs = Vec.new()
    let mk = || || rs.push(&w.entities[0])
    let mk2 = || mk()
    run(mk2())
    w.entities.clear()
    print(rs[0].hp)
}
