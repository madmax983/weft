// Plan stage R0k-b1' (the clean twin of n05): the clause of H1 does not
// clear `v`. The run gets no copy (the agreement rule), so the program keeps
// the fallback.
effect Run { fn run(g: fn()) }
fn work() / fail { fail("t") }
fn outer() / Run, io, async {
    let v = Vec.new()
    v.push(1)
    let w = Vec.new()
    w.push(2)
    let r = &w[0]
    handle Fail { fn fail(m) { print("H1") } } in {
        let c = || { run(|| print(0))
            scope { s =>
                s.spawn(|| work())
                ()
            } }
        r = &v[0]
        handle Fail { fn fail(m) { print("H2") } } in {
            handle Run { fn run(g) { g()
                resume(()) } } in { c() }
        }
    }
    print(r)
}
fn main() / io, async {
    handle Run { fn run(g) { g()
        resume(()) } } in { outer() }
}
