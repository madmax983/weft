// Plan stage R0k-b1' (an acceptance probe of the design review of B1').
// B1' review c13 (a C2 form, `Fail`): the closure of `mk_cap` gives `h` to
// `run`, then fails through the row of `mk_cap`. `mk_cap` is called in the
// handled body of H1, a `Fail` handler whose clause clears `v`. The closure
// runs in the handled body of H2 (a harmless `Fail` handler) and of a local
// `Run` handler (the C2 fallback today). The failure goes to H1 (the maker
// env), so the read of `r` after H1 reads a freed cell. The `run` goes to
// the handler of `main` (the maker env of `mk_cap`, through the row).
effect Run { fn run(g: fn()) }
fn mk_cap(h: fn()) -> fn() { || { run(h)
    fail("x") } }
fn outer() / Run {
    let v = Vec.new()
    v.push(1)
    let w = Vec.new()
    w.push(2)
    let r = &w[0]
    handle Fail { fn fail(m) { v.clear() } } in {
        let c = mk_cap(|| print(0))
        r = &v[0]
        handle Fail { fn fail(m) { print("H2") } } in {
            handle Run { fn run(g) { g()
                resume(()) } } in { c() }
        }
    }
    print(r)
}
fn main() {
    handle Run { fn run(g) { g()
        resume(()) } } in { outer() }
}
