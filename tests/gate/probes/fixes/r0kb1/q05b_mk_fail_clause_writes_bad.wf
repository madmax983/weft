// Plan stage R0k-b1' (an acceptance probe of the design review of B1').
// B1' review q05b: the closure of `mk` fails through the row of `mk`.
// `mk` is called in the handled body of H1, whose clause clears `v`. The
// closure runs in the handled body of H2, but the failure goes to H1 (the
// maker env). `r` points into `v`, so the read of `r` after H1 reads a
// freed cell.
fn mk() -> fn() / fail { || fail("x") }
fn outer() {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    handle Fail { fn fail(m) { v.clear() } } in {
        let c = mk()
        handle Fail { fn fail(m) { print("H2") } } in { c() }
    }
    print(r)
}
fn main() { outer() }
