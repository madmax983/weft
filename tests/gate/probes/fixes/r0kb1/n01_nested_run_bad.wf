// Plan stage R0k-b1' (a copy region, the closure of the same function): the
// closure `c` is made in the handled body of H, so its `run` goes to H (the
// handler environment of the maker), whose clause clears `v`. It runs in the
// handled body of H2, an inner handler of the same effect. A copy of the
// closure body with the handlers of the run node gives the `run` to H2: no
// clear, a hole. The copy region runs with the handlers of `c`: W0301.
effect Run { fn run(g: fn()) }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { v.clear()
        resume(()) } } in {
        let c = || run(|| print(0))
        let r = &v[0]
        handle Run { fn run(g) { g()
            resume(()) } } in { c() }
        print(r)
    }
}
fn main() { outer() }
