// Plan stage R0k-b1' (an acceptance probe of the design review of B1').
// B1' review c19, the clean twin: the clause of H runs `g` and does not clear `v`.
effect Run { fn run(g: fn()) }
effect Give { fn give(f: fn()) }
fn mk_cap(h: fn()) -> fn() / Run { || run(h) }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let c = mk_cap(|| print(0))
        let r = &v[0]
        handle Run { fn run(g) { g()
            resume(()) } } in {
            handle Give { fn give(f) { f()
                resume(()) } } in { give(c) }
        }
        print(r)
    }
}
fn main() { outer() }
