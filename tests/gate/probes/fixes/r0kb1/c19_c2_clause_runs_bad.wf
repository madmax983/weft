// Plan stage R0k-b1' (an acceptance probe of the design review of B1').
// B1' review c19 (form 4: a clause gets the closure and runs it): the
// closure of `mk_cap` comes from a call in the handled body of H (whose
// clause clears `v`). The handled body gives it to `give`; the clause of
// `Give` runs it. The clause runs in the env of its site (H2), but the
// `run` of the closure goes to H (the maker env).
effect Run { fn run(g: fn()) }
effect Give { fn give(f: fn()) }
fn mk_cap(h: fn()) -> fn() / Run { || run(h) }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { v.clear()
        resume(()) } } in {
        let c = mk_cap(|| print(0))
        let r = &v[0]
        handle Run { fn run(g) { g()
            resume(()) } } in {
            handle Give { fn give(f) { f()
                resume(()) } } in { give(c) }
        }
        print(r)
    }
}
fn main() { outer() }
