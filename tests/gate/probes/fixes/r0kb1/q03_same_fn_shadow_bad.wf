// Plan stage R0k-b1' (an acceptance probe of the design review of B1').
// B1' review q03 (control): the closure is made in `outer`, in the handled
// body of H, so it has a `Cap` capture of H. It runs in the handled body
// of the harmless H2, and its `run` goes to H, which clears `v`.
effect Run { fn run(x: u64) }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(x) { v.clear()
        resume(()) } } in {
        let c = || run(1)
        let r = &v[0]
        handle Run { fn run(x) { resume(()) } } in { c() }
        print(r)
    }
}
fn main() { outer() }
