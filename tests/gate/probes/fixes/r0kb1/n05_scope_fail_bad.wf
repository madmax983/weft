// Plan stage R0k-b1' (the agreement rule, as c14 with a closure of the same
// function): the closure opens a scope whose task fails. The end of the
// scope fails to the `Fail` handler of the maker (H1, whose clause clears
// `v`), not to the one of the run node (H2). The facts of a scope take the
// environment of the body, so the run gets no copy (the program keeps the
// fallback).
effect Run { fn run(g: fn()) }
fn work() / fail { fail("t") }
fn outer() / Run, io, async {
    let v = Vec.new()
    v.push(1)
    let w = Vec.new()
    w.push(2)
    let r = &w[0]
    handle Fail { fn fail(m) { v.clear() } } in {
        let c = || { run(|| print(0))
            scope { s =>
                s.spawn(|| work())
                ()
            } }
        r = &v[0]
        handle Fail { fn fail(m) { print("H2") } } in {
            handle Run { fn run(g) { g()
                resume(()) } } in { c() }
        }
    }
    print(r)
}
fn main() / io, async {
    handle Run { fn run(g) { g()
        resume(()) } } in { outer() }
}
