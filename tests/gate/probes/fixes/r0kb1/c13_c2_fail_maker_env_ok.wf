// Plan stage R0k-b1' (an acceptance probe of the design review of B1').
// B1' review c13, the clean twin: the clause of H1 does not clear `v`.
effect Run { fn run(g: fn()) }
fn mk_cap(h: fn()) -> fn() { || { run(h)
    fail("x") } }
fn outer() / Run {
    let v = Vec.new()
    v.push(1)
    let w = Vec.new()
    w.push(2)
    let r = &w[0]
    handle Fail { fn fail(m) { print("H1") } } in {
        let c = mk_cap(|| print(0))
        r = &v[0]
        handle Fail { fn fail(m) { print("H2") } } in {
            handle Run { fn run(g) { g()
                resume(()) } } in { c() }
        }
    }
    print(r)
}
fn main() {
    handle Run { fn run(g) { g()
        resume(()) } } in { outer() }
}
