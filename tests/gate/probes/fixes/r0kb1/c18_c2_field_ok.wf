// Plan stage R0k-b1' (an acceptance probe of the design review of B1').
// B1' review c18, the clean twin: the clause of H runs `g` and does not clear `v`.
effect Run { fn run(g: fn()) }
struct Bx { f: fn() }
fn mk_box(h: fn()) -> Bx / Run { Bx { f: || run(h) } }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { g()
        resume(()) } } in {
        let b = mk_box(|| print(0))
        let r = &v[0]
        handle Run { fn run(g) { g()
            resume(()) } } in {
            let c = b.f
            c()
        }
        print(r)
    }
}
fn main() { outer() }
