// F20.3 B-1 (cl4): a clause reads a linear argument that the call moved (W0302).
linear struct Tx { id: u64 }
fn begin(n: u64) -> Tx { Tx { id: n } }
fn commit_fail(t: Tx) / fail { let Tx(i) = t; print("commit {i}")
 fail("x") }
fn main() {
    let t = begin(1)
    handle Fail { fn fail(m) { print(t.id) } } in { commit_fail(t) }
}
