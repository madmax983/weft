// F20.3 B-1 (r1m2): a clause reads an argument that the callee consumes before it fails (W0302).
fn consume(v: Vec<u64>) / fail { print(v.len()) 
 fail("x") }
fn mkv() -> Vec<u64> { let v = Vec.new()
 v.push(1)
 v }
fn main() {
    let v = mkv()
    handle Fail { fn fail(m) { print(v.len()) } } in { consume(v) }
}
