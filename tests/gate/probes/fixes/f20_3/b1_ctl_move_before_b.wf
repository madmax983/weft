// F20.3 B-1 control (cl7): the argument is a copy of a moved local (W0302, no change).
fn eat_fail(v: Vec<u64>) / fail { print(v.len())
 fail("x") }
fn mkv() -> Vec<u64> { let v = Vec.new()
 v.push(1)
 v }
fn main() {
    let v = mkv()
    handle Fail { fn fail(m) { print(v.len()) } } in { let w = v
 eat_fail(w) }
}
