// F20.3 I-2 (f1j): one once closure in two arguments of a generic call that can fail (W0502).
fn consume(v: Vec<u64>) { print(v.len()) }
fn mkv() -> Vec<u64> { let v = Vec.new()
 v.push(1)
 v }
fn pair<T>(a: T, b: T, n: u64) -> (T, T) / fail { if n > 5 { fail("big") }
 (a, b) }
fn main() {
    let v = mkv()
    let f = || consume(v)
    handle Fail { fn fail(m) { print(m) } } in {
        let (g, h) = pair(f, f, 1)
        g()
        h()
    }
}
