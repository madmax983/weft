// Plan stage R0z Z4 (bad): the closure has code before and after its resume, and it runs two times.
// The clause clears `v` after the second run, and the handled body took `keep = &v[0]`:
// the read of `keep` after the `handle` is a read of a freed cell (W0301).
effect Tick { multi fn tick() -> u64 }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v: Vec<u64> = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            let k = |x: u64| { print(x); let y = resume(x); print(y); y }
            let a = k(1)
            let b = k(a)
            v.clear()
            b
        } } in {
        let t = tick()
        keep = &v[0]
        t + 1
    }
    print(keep + 1)
}
