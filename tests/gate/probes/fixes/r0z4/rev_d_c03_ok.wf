// Direct twin of a06_borrow_run_ok.wf: two direct resumes (c03 form).
// Z4 review (ok): the clause runs the closure through a shared borrow `r`.
effect Tick { multi fn tick() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            resume(())
            resume(())
            print(v.len())
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
