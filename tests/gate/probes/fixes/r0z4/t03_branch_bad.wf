// Plan stage R0z Z4 (bad): one path of the clause runs the closure; the other path does not resume.
// The clause clears `v` after the run, and the handled body took `keep = &v[0]`:
// the read of `keep` after the `handle` is a read of a freed cell (W0301).
effect Tick { fn tick(b: bool) -> u64 }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    let r = handle Tick { fn tick(b) {
            let k = || resume(1)
            if b {
                let x = k()
                v.clear()
                x
            } else { 7 }
        } } in {
        let a = tick(true)
        keep = &v[0]
        a + 1
    }
    print(keep + r)
}
