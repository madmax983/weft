// Direct twin of a05_result_ok.wf: a direct resume.
// Z4 review (ok): the closure gives back the value of its resume plus one.
effect Ask { fn ask() -> u64 }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    let n = handle Ask { fn ask() {
            let y = resume(3) + 1
            print(v.len())
            y
        } } in {
        let a = ask()
        keep = &v[0]
        a
    }
    print(keep + n)
}
