// Plan stage R0z Z4 (bad, refusal R-REC): as the ok twin, but the clause clears `v`. The program keeps the fallback or is rejected.
effect Tick { fn tick() }
fn run(n: u64) {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            let k = || resume(())
            if n > 0 { tick() }
            k()
            v.clear()
        } } in {
        if n > 0 { apply(run, n - 1) }
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
fn main() {
    handle Tick { fn tick() { resume(()) } } in { run(2) }
}
fn apply(f: fn(u64), n: u64) { f(n) }
