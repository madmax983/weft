// Plan stage R0z Z4 (ok, refusal R-ROW-K): a `multi` operation of a caller lies between the make and the runs. The program keeps the fallback.
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
fn run() -> u64 / Choice {
    handle Pick {
        fn pick() {
            let k = |x: u64| resume(x)
            let b = choose()
            if b { resume(1) } else { k(10) }
        }
    } in {
        let x = pick()
        x
    }
}
fn main() {
    let out: Vec<u64> = Vec.new()
    handle Choice { fn choose() { resume(true); resume(false) } } in out.push(run())
    print(out)
}
