// Z4 review (bad): the closure gives back the value of its resume plus one; the clause clears `v`.
effect Ask { fn ask() -> u64 }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    let n = handle Ask { fn ask() {
            let k = |x: u64| resume(x) + 1
            let y = k(3)
            v.clear()
            y
        } } in {
        let a = ask()
        keep = &v[0]
        a
    }
    print(keep + n)
}
