// Z4 review (ok): the rest performs `tick` again while the first activation waits at its run; each activation runs its own k.
effect Tick { fn tick() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            let k = || resume(())
            k()
            print(v.len())
        } } in {
        tick()
        keep = &v[0]
        tick()
    }
    print(keep + 1)
}
