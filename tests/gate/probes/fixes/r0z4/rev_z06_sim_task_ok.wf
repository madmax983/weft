// Z4 review (ok, R-RT-TASK): sim.run; the rest of the handled body starts a task in a scope.
effect Ask { fn ask() -> u64 }
fn main() / clock {
    let r = handle Ask {
        fn ask() {
            sim.run(seed: 1) { let v = resume(1); print("in sim {v}") }
            0
        }
    } in {
        let a = ask()
        scope { s => s.spawn(|| print("task")) }
        a + 1
    }
    print(r)
}
