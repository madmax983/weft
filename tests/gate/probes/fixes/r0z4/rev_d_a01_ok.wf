// Direct twin of a01_param_after_run_ok.wf: a direct resume. (`w` is outside the handled body.)
// Z4 review (ok): as a01 bad, but the rest does not free `w`.
effect Tick { fn tick(r: &u64) }
fn main() {
    let w = Vec.new()
    w.push(5)
    handle Tick { fn tick(r: &u64) {
            resume(())
            print(r + 1)
        } } in {
        tick(&w[0])
        print(w.len())
    }
}
