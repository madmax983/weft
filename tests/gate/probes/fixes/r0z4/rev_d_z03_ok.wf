// Direct twin of z03_timeout_ref_ok.wf: a direct resume (no block). (`w` is outside the handled body.)
// Z4 review (ok, Z4b): as z03 bad, but the rest does not free `w`.
effect Tick { fn tick(r: &u64) }
fn main() / clock, fail {
    let w = Vec.new()
    w.push(5)
    handle Tick { fn tick(r: &u64) {
            resume(())
            print(r + 1)
        } } in {
        tick(&w[0])
        print(w.len())
    }
}
