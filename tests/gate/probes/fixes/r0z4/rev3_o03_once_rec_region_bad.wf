// z4rev3 (bad): once h by recursion; the inner clause's closure runs between ops of the outer instance (a perform between make and run).
effect Tick { fn tick() }
fn run(n: u64) {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            let k = || resume(())
            if n > 0 { tick() }
            k()
            v.clear()
        } } in {
        if n > 0 { run(n - 1) }
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
fn main() {
    handle Tick { fn tick() { resume(()) } } in { run(2) }
}
