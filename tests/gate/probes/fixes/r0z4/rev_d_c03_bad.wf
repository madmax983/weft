// Direct twin of a06_borrow_run_bad.wf: two direct resumes (c03 form).
// Z4 review (bad): the clause runs the closure through a shared borrow `r`; the clause clears `v` after.
effect Tick { multi fn tick() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            resume(())
            resume(())
            v.clear()
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
