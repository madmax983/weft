// Direct twin of a10_clause_local_after_ok.wf: direct resumes.
// Z4 review (ok): the closure reads a local of the clause by reference before and after its resume.
effect Tick { multi fn tick() }
fn main() {
    handle Tick { fn tick() {
            let c = Vec.new()
            c.push(3)
            print(c.len())
            resume(())
            print(c.len())
            print(c.len())
            resume(())
            print(c.len())
        } } in {
        tick()
        print(9)
    }
}
