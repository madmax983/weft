// Z4 review (ok, Part B lands_in): g's handled body runs k on one path only. The clean twin.
// The clause does not clear `v`.
effect Ask { fn ask(b: bool) }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Ask { fn ask(b: bool) {
            handle Other { fn other() { resume(()) } } in {
                let k = || resume(())
                if b { k() } else { print(0) }
            }
            print(v.len())
        } } in {
        ask(true)
        keep = &v[0]
    }
    print(keep + 1)
}
