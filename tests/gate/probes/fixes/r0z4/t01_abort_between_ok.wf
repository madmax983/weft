// Plan stage R0z Z4 (ok): a perform between the make and the run aborts to an outer handler.
// The clause of `Ask` does not resume: the closure value and its continuation drop.
effect Tick { fn tick() }
effect Ask { fn ask() -> u64 }
fn main() {
    let v = Vec.new()
    v.push(1)
    let n = handle Ask { fn ask() { 5 } } in {
        handle Tick { fn tick() {
                let k = || resume(())
                let y = ask()
                k()
            } } in {
            tick()
            print(v[0])
        }
        0
    }
    print(n)
}
