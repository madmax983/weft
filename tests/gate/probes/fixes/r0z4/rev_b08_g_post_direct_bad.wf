// Z4 review (bad, R-INNER by cause): g's handled body performs g's op before the resume point (direct form). g's clause resumes, and after its resume it clears `v`: that
// runs after the rest of h's handled body took `keep = &v[0]`. The read of `keep` is a read of a freed cell.
effect Tick { fn tick() }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()); v.clear() } } in {
                let k = || resume(())
                other()
                k()
            }
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
