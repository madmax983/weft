// Z4 review (bad, Z4b): the deadline cuts the rest; the cut unwinds the handled body, which frees `w`.
// The local Fail handler gets the timeout and the clause reads its parameter after that.
effect Tick { fn tick(r: &u64) }
fn main() / clock {
    handle Tick { fn tick(r: &u64) {
            handle Fail { fn fail(m) { print("cut") } } in {
                with_timeout(5.ms) { resume(()) }
            }
            print(r + 1)
        } } in {
        let w = Vec.new()
        w.push(5)
        tick(&w[0])
        sleep(10.ms)
        print(w.len())
    }
}
