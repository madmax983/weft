// Z4 review (bad, Z4b): the clause reads its reference parameter after the run; the rest clears `w` (outside the handled body).
effect Tick { fn tick(r: &u64) }
fn main() / clock, fail {
    let w = Vec.new()
    w.push(5)
    handle Tick { fn tick(r: &u64) {
            with_timeout(50.ms) { resume(()) }
            print(r + 1)
        } } in {
        tick(&w[0])
        w.clear()
    }
}
