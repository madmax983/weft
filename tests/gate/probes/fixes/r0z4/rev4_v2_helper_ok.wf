// Plan stage R0z Z4 (ok, refusal R-REC): a `once` handler of a function that runs again through a function value (the check of 29b6877).
effect Tick { fn tick() }
fn run(n: u64) {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            let k = || resume(())
            if n > 0 { tick() }
            k()
            let z = v.len()
        } } in {
        if n > 0 { apply(run, n - 1) }
        tick()
        keep = &v[0]
    }
    print(keep + 1)
}
fn main() {
    handle Tick { fn tick() { resume(()) } } in { run(2) }
}
fn apply(f: fn(u64), n: u64) { f(n) }
