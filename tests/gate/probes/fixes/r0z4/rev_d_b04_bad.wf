// Direct twin of b04_branch_lands_bad.wf: a direct resume in the handled body of g (Part B direct).
// Z4 review (bad, Part B lands_in): g's handled body runs k on one path only. On the path with the
// run, the clause clears `v` after the rest took `keep = &v[0]`.
effect Ask { fn ask(b: bool) }
effect Other { fn other() }
fn main() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Ask { fn ask(b: bool) {
            handle Other { fn other() { resume(()) } } in {
                if b { resume(()) } else { print(0) }
            }
            v.clear()
        } } in {
        ask(true)
        keep = &v[0]
    }
    print(keep + 1)
}
