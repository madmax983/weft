// F16-CAP: a closure performs through a captured capability; the node that runs it runs the clause
effect Log { fn log(m: u64) }
fn apply(f: fn()) { f() }
fn main() {
    let v = Vec.new()
    v.push(1)
    handle Log { fn log(m) { print(m); resume(()) } } in {
        let r = &v[0]
        apply(|| log(1))
        print(r + 1)
    }
}
