// F16-CAP: a closure performs through a captured capability; the node that runs it runs the clause
effect Ask { fn ask() -> u64 }
linear struct Lk { id: u64 }
fn unlock(l: Lk) { let Lk(i) = l }
fn main() {
    let n = handle Ask { fn ask() { 7 } } in {
        let l = Lk { id: 1 }
        let f = || ask()
        let x = f()
        unlock(l)
        x
    }
    print(n)
}
