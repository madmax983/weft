// F16-MULTI: a `multi` resume runs the rest of the handled body again (re-entry from `Post`)
effect Pick { multi fn pick() -> bool }
fn main() {
    let v = Vec.new()
    v.push(1)
    let w = Vec.new()
    w.push(2)
    let keep = &w[0]
    handle Pick { fn pick() { resume(true); v.clear(); resume(false) } } in {
        let b = pick()
        print(keep + 1)
        keep = &v[0]
    }
}
