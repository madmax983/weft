// F16-MULTI: a `multi` resume runs the rest of the handled body again (re-entry from `Post`)
effect Pick { multi fn pick() -> bool }
linear struct Tx { id: u64 }
fn commit(t: Tx) { let Tx(i) = t; print(i) }
fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        let b = pick()
        let t = Tx { id: 1 }
        commit(t)
    }
}
