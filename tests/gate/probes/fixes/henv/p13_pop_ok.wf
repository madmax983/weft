// HENV-SHADOW p13, the clean twin: the clause of H does not clear `v`.
effect Run { fn run(x: u64) }
fn mk() -> fn() / Run { || run(1) }
fn nop() { }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(x) { print(x)
        resume(()) } } in {
        let c0 = mk()
        let vs = Vec.new()
        vs.push(c0)
        let r = &v[0]
        handle Run { fn run(x) { resume(()) } } in { let o = vs.pop()
            match o { Some(g) => g(), None => {} } }
        print(r)
    }
}
fn main() { outer() }
