// HENV-SHADOW h02, the clean twin: the clause of H does not clear `v`.
effect Run { fn run(x: u64) }
effect Get { fn get() -> fn() / Run }
fn mk() -> fn() / Run { || run(1) }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(x) { print(x)
        resume(()) } } in {
        handle Get { fn get() { resume(mk()) } } in {
            let c = get()
            let r = &v[0]
            handle Run { fn run(x) { resume(()) } } in { c() }
            print(r)
        }
    }
}
fn main() { outer() }
