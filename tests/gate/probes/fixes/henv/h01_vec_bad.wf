// HENV-SHADOW h01 (a container): `mk` puts its closure into a `Vec`. `mk`
// is called in the handled body of H, so the closure runs with H. The
// closure runs in the handled body of H2, but its `run` goes to H, which
// clears `v` while `r` points into it.
effect Run { fn run(x: u64) }
fn mk() -> Vec<fn() / Run> {
    let vs = Vec.new()
    vs.push(|| run(1))
    vs
}
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(x) { v.clear()
        resume(()) } } in {
        let vs = mk()
        let r = &v[0]
        handle Run { fn run(x) { resume(()) } } in { let g = vs[0]
            g() }
        print(r)
    }
}
fn main() { outer() }
