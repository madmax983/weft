// HENV-SHADOW c31 (clean; round 2 of the review): as c30, with a field of
// a struct.
effect Run { fn run(x: u64) }
fn mk() -> fn() / Run { || run(1) }
struct B { f: fn() / Run }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(x) { v.clear()
        resume(()) } } in {
        let r = &v[0]
        handle Run { fn run(x) { resume(()) } } in { let b = B { f: mk() }
            let g = b.f
            g() }
        print(r)
    }
}
fn main() { outer() }
