// HENV-SHADOW p07d, the clean twin: the clause of H does not clear `v`.
effect Run { fn run(x: u64) }
fn mk() -> fn() / Run { || run(1) }
fn call(f: fn()) { f() }
fn outer() {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(x) { print(x)
        resume(()) } } in {
        let c0 = mk()
        let r = &v[0]
        handle Run { fn run(x) { resume(()) } } in {
            let g = mk()
            call(|| { g = c0 })
            g() }
        print(r)
    }
}
fn main() { outer() }
