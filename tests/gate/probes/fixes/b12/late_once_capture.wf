// Stage B12 (item: closure modes of function values). `k` captures `c` while
// `c` holds a plain closure; later `c` gets a `once` closure. `k` shares the
// cell of `c` (a `Kept` capture), so `k()` calls the value that `c` has at the
// call: it prints 7, and it runs `eat(b)` once. The analysis gives `c` the
// mode `once` over the whole body; the IR keeps the read of `c` a `copy`, so
// the capture stays `Kept`. A correct program: the `ir` pipeline must accept it.
struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(7) }

fn main() {
    let b = Buf { items: Vec.new() }
    let c = || print(0)
    let k = || c()
    c = || eat(b)
    k()
}
