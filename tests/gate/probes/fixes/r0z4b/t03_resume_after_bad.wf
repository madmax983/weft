// z4b probe (bad): the block of with_timeout resumes the `once` continuation, and the clause resumes it again after the block (W0501).
effect Ask { fn ask() -> u64 }
fn main() / clock, fail {
    let r = handle Ask {
        fn ask() {
            let a = with_timeout(50.ms) { resume(1) }
            resume(a)
        }
    } in {
        let a = ask()
        a + 1
    }
    print(r)
}
