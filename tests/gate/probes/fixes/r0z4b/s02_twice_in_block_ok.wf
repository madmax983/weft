// z4b probe (ok): as s02 bad, but the block of sim.run resumes one time, then it uses its own locals only.
effect Ask { fn ask() -> u64 }
fn main() / clock {
    let r = handle Ask {
        fn ask() {
            sim.run(seed: 1) { let v = resume(1); let u = v + 1; print("{v} {u}") }
            0
        }
    } in {
        let a = ask()
        a + 1
    }
    print(r)
}
