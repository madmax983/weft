// z4b probe (bad, refusal): a block of with_timeout in a block of sim.run resumes. The outer block is not a resumer: the program keeps the fallback. The rest clears `w`, and the clause reads its reference after.
effect Tick { fn tick(r: &u64) }
fn main() / clock, fail {
    let w = Vec.new()
    w.push(5)
    handle Tick { fn tick(r: &u64) {
            sim.run(seed: 1) { with_timeout(50.ms) { resume(()) } }
            print(r + 1)
        } } in {
        tick(&w[0])
        w.clear()
    }
}
