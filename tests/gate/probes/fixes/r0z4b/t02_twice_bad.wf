// z4b probe (bad): two blocks of with_timeout resume the same `once` continuation (W0501).
effect Ask { fn ask() -> u64 }
fn main() / clock, fail {
    let r = handle Ask {
        fn ask() {
            let a = with_timeout(50.ms) { resume(1) }
            let b = with_timeout(50.ms) { resume(2) }
            a + b
        }
    } in {
        let a = ask()
        a + 1
    }
    print(r)
}
