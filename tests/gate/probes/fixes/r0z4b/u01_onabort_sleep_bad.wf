// z4b probe (bad, refusal R-RT-UNWIND; review round 2, c01): the rest runs a nested handler whose clause does not resume. The unwinding runs an `on abort` function that sleeps past the deadline, and the deadline cuts the rest at the end of the unwinding, while a linear value with no `on abort` is live. The program keeps the fallback.
effect Ask { fn ask() -> u64 }
effect N { fn n() }
linear struct T { id: u64 }
linear struct U { id: u64 }
    on abort = slow
fn slow(u: U) / clock { sleep(10.ms); let U(i) = u }
fn fin(u: U) { let U(i) = u }
fn done(t: T) { let T(i) = t }
fn main() / clock, fail {
    let r = handle Ask { fn ask() { with_timeout(5.ms) { resume(1) } } } in {
        let a = ask()
        let t = T { id: a }
        handle N { fn n() { () } } in { let u = U { id: 1 }; n(); fin(u) }
        done(t)
        a + 1
    }
    print(r)
}
