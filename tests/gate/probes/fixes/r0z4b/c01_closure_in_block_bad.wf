// z4b probe (bad, refusal): the block of with_timeout runs a closure that resumes. The block is not a resumer: the program keeps the fallback. The rest clears `w`, and the clause reads its reference after.
effect Tick { fn tick(r: &u64) }
fn main() / clock, fail {
    let w = Vec.new()
    w.push(5)
    handle Tick { fn tick(r: &u64) {
            with_timeout(50.ms) { let f = || resume(()); f() }
            print(r + 1)
        } } in {
        tick(&w[0])
        w.clear()
    }
}
