// z4b probe (ok): as n01 bad, but the block of sim.run in the rest reads `w` only.
effect Tick { fn tick(r: &u64) }
fn main() / clock, fail {
    let w = Vec.new()
    w.push(5)
    handle Tick { fn tick(r: &u64) {
            with_timeout(50.ms) { resume(()) }
            print(r + 1)
        } } in {
        tick(&w[0])
        sim.run(seed: 2) { print(w.len()) }
    }
}
