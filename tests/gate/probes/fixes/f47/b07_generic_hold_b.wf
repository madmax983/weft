// Issue 47 (follow-up F20.1), bad twin: a generic callee gives the `Option` back, or drops it.
linear struct Tx { id: u64 }
fn begin(n: u64) -> Tx { Tx { id: n } }
fn commit(t: Tx) { let Tx(i) = t; print("commit {i}") }
fn drop_it<T>(o: Option<T>) { match o { Some(x) => {}, None => {} } }
fn main() {
    let t = begin(1)
    drop_it(Some(|| commit(t)))
}
