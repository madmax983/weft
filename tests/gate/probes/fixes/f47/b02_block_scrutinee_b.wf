// Issue 47 (follow-up F20.1), bad twin: the scrutinee is a block value (a temporary).
linear struct Tx { id: u64 }
fn begin(n: u64) -> Tx { Tx { id: n } }
fn commit(t: Tx) { let Tx(i) = t; print("commit {i}") }
fn main() {
    let t = begin(1)
    match { Some(|| commit(t)) } { None => {}, Some(_) => {} }
}
