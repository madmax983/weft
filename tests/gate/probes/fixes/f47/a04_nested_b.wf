// Issue 47 (follow-up F20.1), bad twin: a linear closure in `Some(Some(..))`; the arm `Some(None)`.
linear struct Tx { id: u64 }
fn begin(n: u64) -> Tx { Tx { id: n } }
fn commit(t: Tx) { let Tx(i) = t; print("commit {i}") }
fn main() {
    let t = begin(1)
    let o = Some(Some(|| commit(t)))
    match o { Some(Some(_)) => {}, Some(None) => {}, None => {} }
}
