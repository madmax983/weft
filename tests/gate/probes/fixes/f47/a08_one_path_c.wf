// Issue 47 (follow-up F20.1), clean twin: each branch of an `if` has a `match`.
linear struct Tx { id: u64 }
fn begin(n: u64) -> Tx { Tx { id: n } }
fn commit(t: Tx) { let Tx(i) = t; print("commit {i}") }
fn go(c: bool) {
    let t = begin(1)
    let o = Some(|| commit(t))
    if c { match o { Some(g) => g(), None => {} } } else { match o { None => {}, Some(g) => g() } }
}
fn main() { go(true); go(false) }
