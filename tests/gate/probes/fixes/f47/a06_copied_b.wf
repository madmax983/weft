// Issue 47 (follow-up F20.1), bad twin: the `Option` is copied to a second local first.
linear struct Tx { id: u64 }
fn begin(n: u64) -> Tx { Tx { id: n } }
fn commit(t: Tx) { let Tx(i) = t; print("commit {i}") }
fn main() {
    let t = begin(1)
    let o = Some(|| commit(t))
    let o2 = o
    match o2 { Some(g) => {}, None => {} }
}
