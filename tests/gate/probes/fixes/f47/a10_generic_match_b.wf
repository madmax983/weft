// Issue 47 (follow-up F20.1), bad twin: a generic `match` gives the `Option` back.
linear struct Tx { id: u64 }
fn begin(n: u64) -> Tx { Tx { id: n } }
fn commit(t: Tx) { let Tx(i) = t; print("commit {i}") }
fn first<T>(o: Option<T>) -> Option<T> { match o { Some(x) => Some(x), None => None } }
fn main() {
    let t = begin(1)
    match first(Some(|| commit(t))) { Some(_) => {}, None => {} }
}
