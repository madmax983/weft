// Plan stage R0k-c2 (a probe of the design review of the R0k-c2 note; an acceptance test of the stage).
// D5: a clause local w is pushed after the row in the first copy; the second copy sees the row-time w (copied); clean if the model copies
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
fn body() -> u64 / Pick { pick() + 1 }
fn run() -> u64 / Choice {
    handle Pick { fn pick() {
        let w = Vec.new()
        w.push(1)
        let r = &w[0]
        let b = choose()
        if b { w.push(2) }
        print(r)
        resume(1)
    } } in body()
}
fn main() {
    handle Choice { fn choose() { resume(true)
        resume(false) } } in { print(run()) }
}
