// Plan stage R0k-c2 (a probe of the design review of the R0k-c2 note; an acceptance test of the stage).
// clean twin of m7: run clears the rc Vec after the handle, and the second copy reads b.v.len() through the handle (no stale reference)
struct B { v: Vec<u64> }
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
fn body() -> u64 / Pick { pick() + 1 }
fn run(b: Rc<B>) -> u64 / Choice, mut(B) {
    let x = handle Pick { fn pick() {
        let c = choose()
        print(b.v.len())
        resume(1)
    } } in body()
    b.v.clear()
    x
}
fn main() {
    let b = Rc.new(B { v: Vec.new() })
    b.v.push(4)
    handle Choice { fn choose() { resume(true)
        resume(false) } } in { print(run(b)) }
}
