// Plan stage R0k-c2 (a probe of the design review of the R0k-c2 note; an acceptance test of the stage).
// D5 with a once Pick: each copy of the clause resumes the once continuation (the interpreter copies the record: no fault; the old pipeline gives W0503)
effect Choice { multi fn choose() -> bool }
effect Pick { fn pick() -> u64 }
fn body() -> u64 / Pick { pick() + 1 }
fn run() -> u64 / Choice {
    handle Pick { fn pick() {
        let b = choose()
        resume(1)
    } } in body()
}
fn main() {
    handle Choice { fn choose() { resume(true)
        resume(false) } } in { print(run()) }
}
