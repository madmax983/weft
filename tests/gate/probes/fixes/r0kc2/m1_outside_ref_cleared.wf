// Plan stage R0k-c2 (a probe of the design review of the R0k-c2 note; an acceptance test of the stage).
// D5: run holds r into main's v across the row (choose); the outer clause clears v between its two resumes; the second copy of the Pick clause reads r (dangling)
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
fn body() -> u64 / Pick { pick() + 1 }
fn run(v: &Vec<u64>) -> u64 / Choice {
    let r = &v[0]
    handle Pick { fn pick() {
        let b = choose()
        print(r)
        resume(1)
    } } in body()
}
fn main() {
    let v = Vec.new()
    v.push(5)
    handle Choice { fn choose() { resume(true)
        v.clear()
        resume(false) } } in { print(run(&v)) }
}
