// Plan stage R0k-c2 (a probe of the design review of the R0k-c2 note; an acceptance test of the stage).
// clean twin of m1: the outer clause pushes nothing and clears nothing between the resumes
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
fn body() -> u64 / Pick { pick() + 1 }
fn run(v: &Vec<u64>) -> u64 / Choice {
    let r = &v[0]
    handle Pick { fn pick() {
        let b = choose()
        print(r)
        resume(1)
    } } in body()
}
fn main() {
    let v = Vec.new()
    v.push(5)
    handle Choice { fn choose() { resume(true)
        print(v.len())
        resume(false) } } in { print(run(&v)) }
}
