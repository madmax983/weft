// F18-JOIN (clean twin): a join through a pattern, a callee or a closure ends the task before the access (O3-9)
struct H { t: Task<()>, n: u64 }
fn main() / async {
    let v = Vec.new()
    v.push(1)
    scope { s =>
        let h = H { t: s.spawn(|| v.push(2)), n: 1 }
        print(h.n)
        h.t.join()
        v.push(3)
    }
}
