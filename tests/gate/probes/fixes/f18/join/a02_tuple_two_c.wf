// F18-JOIN (clean twin): a join through a pattern, a callee or a closure ends the task before the access (O3-9)
fn main() / async {
    let v = Vec.new()
    v.push(1)
    scope { s =>
        let p = (s.spawn(|| v.push(2)), s.spawn(|| print(1)))
        let (a, b) = p
        b.join()
        a.join()
        v.push(3)
    }
}
