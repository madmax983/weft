// Stage F8d, hole R1: a variant step read late (own variant a15 of F8d).
struct Entity { hp: i32 }
impl Entity {
    fn plus(self, n: i32) -> i32 { self.hp + n }
    fn plusv(self: Entity, n: i32) -> i32 { self.hp + n }
}
struct Other { b: i32 }
enum Two { A(Entity), B(Other) }
struct H { t: Two }
fn flip(h: &H) -> i32 / mut(h.t) { h.t = Two.B(Other { b: 1000 }); 5 }
fn main() { let h = H { t: Two.A(Entity { hp: 1 }) }; h.t.A.hp = flip(&h); match h.t { Two.B(o) => print(o.b), Two.A(x) => print(x.hp) } }
