// Stage F8d, control of hole R1: valid (own variant a14 of F8d).
struct Entity { hp: i32 }
impl Entity {
    fn plus(self, n: i32) -> i32 { self.hp + n }
    fn plusv(self: Entity, n: i32) -> i32 { self.hp + n }
}
struct Other { b: i32 }
enum Two { A(Entity), B(Other) }
fn main() { let e = Two.A(Entity { hp: 1 }); let k = 3; print(e.A.plus({ k = 4; k })) }
