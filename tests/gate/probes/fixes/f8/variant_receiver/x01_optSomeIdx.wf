// Third review of stage F8, hole R1 (f8/variants3/x01_optSomeIdx.wf, header trimmed).
struct Entity { hp: i32 }
impl Entity {
    fn plus(self, n: i32) -> i32 { self.hp + n }
    fn bump(self, n: i32) -> i32 / mut(self) { self.hp += n; self.hp }
}
fn main() { let v = Vec.new(); v.push(Entity { hp: 1 }); let o = Some(v); print(o.Some[0].plus({ o = None; 0 })) }
