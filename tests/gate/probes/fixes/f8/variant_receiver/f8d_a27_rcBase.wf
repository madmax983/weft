// Stage F8d, hole R1: a variant step read late (own variant a27 of F8d).
struct Entity { hp: i32 }
impl Entity {
    fn plus(self, n: i32) -> i32 { self.hp + n }
    fn plusv(self: Entity, n: i32) -> i32 { self.hp + n }
}
struct Other { b: i32 }
enum Two { A(Entity), B(Other) }
struct H { t: Two }
fn main() { let h = Rc.new(H { t: Two.A(Entity { hp: 1 }) }); print(h.t.A.plus({ h = Rc.new(H { t: Two.B(Other { b: 1000 }) }); 0 })) }
