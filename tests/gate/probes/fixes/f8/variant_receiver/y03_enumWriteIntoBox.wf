// Third review of stage F8, hole R1 (f8/variants3/y03_enumWriteIntoBox.wf, header trimmed).
struct Entity { hp: i32 }
impl Entity {
    fn plus(self, n: i32) -> i32 { self.hp + n }
    fn bump(self, n: i32) -> i32 / mut(self) { self.hp += n; self.hp }
}
struct Holder { r: Box<i32> }
enum Two { A(Entity), B(Holder) }
fn main() { let e = Two.A(Entity { hp: 1 }); print(e.A.bump({ e = Two.B(Holder { r: Box.new(3) }); 5 })); match e { Two.B(h) => print(h.r), Two.A(x) => print(x.hp) } }
