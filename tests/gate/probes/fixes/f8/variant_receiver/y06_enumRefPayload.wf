// Third review of stage F8, hole R1 (f8/variants3/y06_enumRefPayload.wf, header trimmed).
struct Entity { hp: i32 }
impl Entity {
    fn plus(self, n: i32) -> i32 { self.hp + n }
    fn bump(self, n: i32) -> i32 / mut(self) { self.hp += n; self.hp }
}
enum Two { A(Entity), B(&Entity) }
fn main() { let x = Entity { hp: 3 }; let e = Two.A(Entity { hp: 1 }); print(e.A.bump({ e = Two.B(&x); 5 })); print(x.hp) }
