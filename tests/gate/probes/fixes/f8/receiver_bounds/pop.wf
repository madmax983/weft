struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
impl Entity {
    fn plus(self, n: i32) -> i32 { self.hp + n }
}
fn mkw() -> World { let w = World { entities: Vec.new() }; w.entities.push(Entity { hp: 1 }); w }
// The argument pops the only element.
fn popit(w: &World) -> i32 / mut(w.entities) { w.entities.pop(); 0 }
fn main() {
    let w = mkw()
    print(w.entities[0].plus(popit(&w)))
}
