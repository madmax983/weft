// A clause keeps its reference parameter in a local outside the `handle`. The
// operation runs in a callee, with a reference into a local of the callee. The
// local ends before the call returns, so the kept reference dangles after the
// `handle`.
effect Keep { fn keep(r: &u64) }
fn deep() / Keep {
    let x = 5
    keep(&x)
}
fn main() {
    let y = 1
    let last = &y
    handle Keep { fn keep(r) { last = r; resume(()) } } in deep()
    print(last)   // expected W0301; the checker accepts
}
