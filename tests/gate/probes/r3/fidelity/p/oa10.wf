// The check of an `on abort` function ignores the type arguments of its
// parameter. `undo_g` takes `G<u64>`, but the unwinder gives it a `G<Tx>`.
effect Stop { fn stop() }
linear struct Tx { id: u64 }
fn commit(t: Tx) { let Tx(i) = t; print("commit {i}") }
linear struct G<T> { x: T }
    on abort = undo_g
fn undo_g(g: G<u64>) {
    let G(x) = g
    print(x + 1)   // `x` is a `Tx` at run time
}
fn body() / Stop {
    let g = G { x: Tx { id: 1 } }
    stop()
    let G(t) = g
    commit(t)
}
fn main() {
    handle Stop { fn stop() { () } } in body()
}
