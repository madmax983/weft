struct W { v: Vec<u64> }
fn f(w: &W) / mut(w.v) {
    let c0 = || w.v.push(1)
    let c1 = || w.v.push(2)
    let c2 = || { c1(); c0() }
    let c3 = || { c2(); c1() }
    let c4 = || { c3(); c2() }
    let c5 = || { c4(); c3() }
    let c6 = || { c5(); c4() }
    let c7 = || { c6(); c5() }
    let c8 = || { c7(); c6() }
    let c9 = || { c8(); c7() }
    let c10 = || { c9(); c8() }
    let c11 = || { c10(); c9() }
    let c12 = || { c11(); c10() }
    let c13 = || { c12(); c11() }
    let c14 = || { c13(); c12() }
    let c15 = || { c14(); c13() }
    c15()
}
