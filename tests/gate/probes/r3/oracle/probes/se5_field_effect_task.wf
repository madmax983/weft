struct H { f: fn() }
linear struct Lk { id: u64 }
fn unlock(l: Lk) { let Lk(id) = l; print("unlock", id) }
fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v }
fn take_v(v: Vec<u64>) -> usize { v.len() }
fn run_h(h: &H) { let g = h.f; g() }
effect Note { fn note(x: u64) }
fn main() {
    handle Note { fn note(x) { resume(()) } } in {
        let h = H { f: || note(1) }
        scope { s =>
            s.spawn(|| { let g = h.f; g() })
        }
    }
}
