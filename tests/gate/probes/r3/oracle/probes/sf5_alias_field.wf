struct H { f: fn() }
fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v }
fn run_twice(h: &H) { let g = h.f; g(); g() }
fn run_h(h: &H) { let g = h.f; g() }
fn twice(f: fn()) { f(); f() }
fn run_both(h: &H, x: &Vec<u64>) { let g = h.f; let n = x.len(); g(); print(n) }
fn main() {
    let v = mk_v()
    let h = H { f: || v.clear() }
    let r = &v[0]
    run_both(&h, &v)
    print(r + 0)
}
