fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v.push(2); v }
fn take_v(v: Vec<u64>) -> usize { v.len() }
effect Note { fn note(x: u64) }
struct R { items: Vec<u64>, n: u64 }

fn main() {
    let v = mk_v()
    handle Note { fn note(x) { v.push(x); resume(()) } } in {
        for x in v[] { note(1); print(x) }
    }
}
