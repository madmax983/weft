effect Ask { fn ask() -> u64 }
effect Pick { multi fn pick() -> bool }
fn apply(f: fn()) { f() }
fn twice(f: fn()) { f(); f() }
fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v.push(2); v }

fn main() {
    let n = handle Ask { fn ask() { for i in 0..2 { let _ = resume(i) } } } in { ask() + 1 }
    print(n)
}
