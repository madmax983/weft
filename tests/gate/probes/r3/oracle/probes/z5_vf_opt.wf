struct Frame: !Move { buf: [u8; 4], cur: &u8 in self.buf[] }
struct VF: !Move { items: Vec<u64>, cur: &u64 in self.items[] }
fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v.push(2); v }
fn id<T>(x: T) -> T { x }
fn apply(f: fn()) { f() }
fn main() {
    let f = VF { items: mk_v() }
    f.cur = &f.items[0]
    let o = Some(f)
    match o { Some(g) => print(g.cur), None => {} }
}
