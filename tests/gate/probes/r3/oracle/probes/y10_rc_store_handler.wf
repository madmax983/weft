struct Cache { refs: Vec<&u64>, fs: Vec<fn()> }
fn mk_c() -> Rc<Cache> { Rc.new(Cache { refs: Vec.new(), fs: Vec.new() }) }
fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v.push(2); v }
fn put(c: Rc<Cache>, r: &u64) / mut(Cache) { c.refs.push(r) }
fn put_f(c: Rc<Cache>, f: fn()) / mut(Cache) { c.fs.push(f) }
impl Cache {
    fn add(self, r: &u64) { self.refs.push(r) }
}
fn id<T>(x: T) -> T { x }
effect Note { fn note(x: u64) }
fn main() {
    let c = mk_c()
    handle Note { fn note(x) { c.refs.push(&x); resume(()) } } in { note(3) }
    print(c.refs[0])
}
