linear struct Tx { id: u64 }
    on abort = tx_abort
fn tx_abort(t: Tx) { let Tx(id) = t; if id > 0 { fail("again") } }
fn commit(t: Tx) { let Tx(id) = t; print("commit", id) }
fn main() {
    handle Fail { fn fail(m) { print(m) } } in {
        let t = Tx { id: 1 }
        fail("x")
        commit(t)
    }
}
