// A multi operation inside a scope whose child fails. The first copy of the
// continuation raises the failure. The second copy runs the same scope again.
effect Choice { multi fn choose() -> bool }

fn main() / io, par {
    handle Choice { fn choose() { resume(true); resume(false); print("clause done") } } in {
        handle Fail { fn fail(m) { print("caught: {m}") } } in {
            scope { s =>
                s.spawn(|| { sleep(5.ms); fail("child failed") })
                let b = choose()
                print("branch {b}")
                sleep(10.ms)
                print("branch {b} ends at {Clock.now()}")
            }
            print("scope ended normally")
        }
    }
    print("end")
}
