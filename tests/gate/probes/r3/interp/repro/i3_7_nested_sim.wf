// A simulation inside a simulation. The order of the outer simulation must
// depend only on its seed.
fn work(id: u64) / clock {
    let i = 0
    while i < 3 {
        print("task {id} step {i}")
        sleep(1.ms)
        i += 1
    }
}

test "nested simulations" {
    sim.run(seed: 5) {
        scope { s =>
            s.spawn(|| work(1))
            s.spawn(|| work(2))
            s.spawn(|| sim.run(seed: 7) {
                scope { t =>
                    t.spawn(|| work(3))
                    t.spawn(|| work(4))
                }
            })
        }
    }
}
