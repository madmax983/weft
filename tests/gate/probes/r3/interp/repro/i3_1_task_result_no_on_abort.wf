// A task returns a linear value whose type has no `on abort`. The task
// finishes. Then the owner aborts before it joins the task. Nothing can
// finish the linear result.
linear struct Tx { id: u64 }

fn commit(t: Tx) / io { let Tx(id) = t; print("commit {id}") }

fn main() / io, par {
    handle Fail { fn fail(m) { print("caught: {m}") } } in {
        scope { s =>
            let t = s.spawn(|| Tx { id: 3 })
            sleep(5.ms)
            fail("abort before the join")
            commit(t.join())
        }
    }
    print("end")
}
