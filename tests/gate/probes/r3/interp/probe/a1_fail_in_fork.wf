// A child of scope A fails while the owner waits in a fork inside A.
fn slow() -> u64 / clock { sleep(1000.ms); 1 }

fn main() / io, par {
    handle Fail { fn fail(m) { print("caught: {m} at {Clock.now()}") } } in {
        scope { s =>
            s.spawn(|| { sleep(5.ms); fail("child failed") })
            let (a, b) = fork(|| slow(), || slow())
            print("fork done {a} {b}")
        }
        print("scope returned normally")
    }
    print("end at {Clock.now()}")
}
