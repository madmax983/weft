// The race detector keeps at most 256 accesses for one cell. A task writes
// 200 elements of a buffer. Another task writes the last element at the same
// time. The checker rejects this; with --unchecked the oracle must find it.
struct P { x: u64 }

fn fill(v: &Vec<P>, n: u64) / mut(v[]) {
    let i = 0
    while i < n {
        let e = &v[i]
        e.x = 1
        i += 1
    }
}

fn main() / io, par {
    let v = Vec.new()
    let i = 0
    while i < 200 { v.push(P { x: 0 }); i += 1 }
    scope { s =>
        s.spawn(|| fill(&v, 200))
        s.spawn(|| { sleep(1.ms); let e = &v[199]; e.x = 2 })
        print("spawned")
    }
}
