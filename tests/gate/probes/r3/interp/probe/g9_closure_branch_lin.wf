// A closure consumes its linear capture on one branch only.
linear struct Tx { id: u64 }
    on abort = rollback

fn rollback(t: Tx) { let Tx(id) = t; print("rollback {id}") }
fn commit(t: Tx) / io { let Tx(id) = t; print("commit {id}") }

fn main() / io {
    let c = false
    let t = Tx { id: 1 }
    let f = || if c { commit(t) }
    f()
    print("end")
}
