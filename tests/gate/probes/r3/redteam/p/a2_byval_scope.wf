struct Buf { items: Vec<u64> }
fn eat(b: Buf) { print(b.items.len()) }
fn block_scope() {
    let k = || print(0)
    {
        let b = Buf { items: Vec.new() }
        k = || eat(b)
    }
    k()
}
fn loop_scope() {
    let ks = Vec.new()
    let i = 0
    while i < 3 {
        let b = Buf { items: Vec.new() }
        ks.push(|| eat(b))
        i += 1
    }
    let g = ks.pop()
    match g { Some(f) => f(), None => {} }
}
fn block_value() {
    let k = {
        let b = Buf { items: Vec.new() }
        || eat(b)
    }
    k()
}
fn main() {
    block_scope()
    loop_scope()
    block_value()
}
