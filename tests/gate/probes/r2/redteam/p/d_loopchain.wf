struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }

// A chain of ten function values. The mutating closure reaches `a` on the tenth pass.
fn chain(world: &World) / mut(world.entities) {
    let first = &world.entities[0]
    let a = || print(0)
    let b = || print(0)
    let c = || print(0)
    let d = || print(0)
    let e = || print(0)
    let f = || print(0)
    let g = || print(0)
    let h = || print(0)
    let i = || print(0)
    let j = || print(0)
    let k = || print(0)
    let n = 0
    while n < 12 {
        a()
        print(first.hp)   //~ W0301
        a = b
        b = c
        c = d
        d = e
        e = f
        f = g
        g = h
        h = i
        i = j
        j = k
        k = || world.entities.push(Entity { hp: 1 })
        n += 1
    }
}
fn main() {
    let w = World { entities: Vec.new() }
    w.entities.push(Entity { hp: 1 })
    chain(&w)
}
