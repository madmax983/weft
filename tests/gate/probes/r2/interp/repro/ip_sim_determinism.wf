// Three tasks print in an order that only the scheduler decides.
// `sim.run(seed: 7)` fixes the scheduler, so the output must not depend on
// `--seed` or `--workers` of the run.
fn work(id: u64) / clock {
    let i = 0
    while i < 3 {
        print("task {id} step {i}")
        sleep(1.ms)
        i += 1
    }
}

test "interleaving is fixed by the simulation seed" {
    sim.run(seed: 7) {
        scope { s =>
            s.spawn(|| work(1))
            s.spawn(|| work(2))
            s.spawn(|| work(3))
        }
    }
}
