// A child of the scope fails while the owner waits in a `fork`.
// The Fail handler resumes.
fn main() / io, par {
    handle Fail { fn fail(m) { print("caught {m}"); resume(()) } } in {
        scope { s =>
            s.spawn(|| { sleep(5.ms); fail("child failed") })
            let (a, b) = fork(|| { sleep(10.ms); 1 }, || 2)
            print("a + b = {a + b}")
        }
    }
    print("end")
}
