// A child of the outer scope fails while the owner waits in `h.join()` for a
// task of an inner scope. The Fail handler around both resumes.
fn main() / io {
    handle Fail { fn fail(m) { print("caught {m}"); resume(()) } } in {
        scope { s =>
            s.spawn(|| { sleep(5.ms); fail("outer child failed") })
            scope { t =>
                let h = t.spawn(|| { sleep(10.ms); 41 })
                let v = h.join()
                print("v = {v + 1}")
            }
        }
    }
    print("end")
}
