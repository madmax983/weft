effect Ask { fn ask() -> u64 }
linear struct Lk { id: u64 }
fn unlock(l: Lk) { let Lk(id) = l; print("unlock", id) }
fn main() {
    handle Ask { fn ask() { scope { s => s.spawn(|| { let _ = resume(1) }) ; print("clause") } } } in {
        let l = Lk { id: 1 }
        print(ask())
        unlock(l)
    }
    print("end")
}
