effect Pick { multi fn pick() -> bool }

fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v
}
fn pair_of(v: &Vec<u64>) -> (&u64 in v[], u64) { (&v[0], 1) }



fn main() {
    handle Pick { fn pick() { resume(true); resume(false) } } in {
        if false {
            let v13 = mk_v()
            let (x15, _) = pair_of(&v13); v13.push(1); print(x15)
        } else {
        }
    }
}
