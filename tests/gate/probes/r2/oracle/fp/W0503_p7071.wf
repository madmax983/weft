linear struct Tx { id: u64 }
    on abort = tx_abort
effect Pick { multi fn pick() -> bool }

fn tx_abort(t: Tx) { let Tx(id) = t; print("abort", id) }
fn commit(t: Tx) { let Tx(id) = t; print("commit", id) }

fn main() {
    handle Pick { fn pick() { print("no") } } in {
        let tx2 = Tx { id: 2 }
        if pick() { print(1) } else { print(2) }
        commit(tx2)
    }
}
