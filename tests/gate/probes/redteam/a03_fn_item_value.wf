struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn grow(w: &World) / mut(w.entities) { w.entities.push(Entity { hp: 1 }) }
fn via_item(world: &World) / mut(world.entities) {
    let first = &world.entities[0]
    let g = grow
    g(world)
    print(first.hp)
}
pub fn undeclared(world: &World) {
    let g = grow
    g(world)
}
fn shared_via_item(world: &World @ shared) {
    let g = grow
    g(world)
}
