// weft: library
fn body() { print(1) }
fn other(seed: u64, f: fn()) { f() }
struct R { f: fn(u64, fn()) }
fn apply(f: fn(u64, fn())) { f(1, body) }

// v1: sim.run joined by `if`.
fn joined(c: bool) {
    let r = if c { sim.run } else { other }   // expect W0802
    r(1, body)
}
// v2: sim.run in a struct field.
fn in_struct() {
    let s = R { f: sim.run }   // expect W0802
    let g = s.f
    g(1, body)
}
// v3: sim.run returned as a value.
fn get() -> fn(u64, fn()) { sim.run }   // expect W0802
// v4: sim.run inside a closure.
fn in_closure() {
    let c = || apply(sim.run)   // expect W0802
    c()
}
// v5: sim.run in a tuple.
fn in_tuple() {
    let t = (sim.run, 1)   // expect W0802
    let (g, n) = t
    g(1, body)
}
// v6: a direct call of sim.run in a library (control: existing check).
fn direct() {
    sim.run(1, body)   // expect W0802
}
// v7: a trailing-closure call.
fn trailing() {
    sim.run(1) { print(2) }   // expect W0802
}
// v8: a local named `sim` is not the prelude module.
struct Sim { run: u64 }
fn shadow(sim: Sim) -> u64 { sim.run }
