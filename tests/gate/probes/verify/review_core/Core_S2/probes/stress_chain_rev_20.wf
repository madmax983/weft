struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn top(world: &World) { let first = &world.entities[0]; ap19(|x| x.entities.clear(), world); print(first.hp) }
fn ap19(f: fn(&World), w: &World) { ap18(f, w) }
fn ap18(f: fn(&World), w: &World) { ap17(f, w) }
fn ap17(f: fn(&World), w: &World) { ap16(f, w) }
