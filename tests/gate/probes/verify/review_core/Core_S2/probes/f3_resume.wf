effect Bump { fn bump(v: &Vec<u64>) }
effect Mark { fn mark() }

// Control: a captured place, held across resume. The handled body clears it.
fn captured_across_resume() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    handle Mark {
        fn mark() {
            let e = &v[0]
            resume(())
            print(e)   // expect W0301
        }
    } in {
        mark()
        v.clear()
    }
}

// The same through the parameter of the clause.
fn param_across_resume() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    handle Bump {
        fn bump(x) {
            let e = &x[0]
            resume(())
            print(e)   // expect W0301
        }
    } in {
        bump(&v)
        v.clear()
    }
}

// The same, and the body clears it through a callee.
fn clears(v: &Vec<u64>) / mut(v) { v.clear() }
fn param_across_resume_callee() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    handle Bump {
        fn bump(x) {
            let e = &x[0]
            resume(())
            print(e)   // expect W0301
        }
    } in {
        bump(&v)
        clears(&v)
    }
}
