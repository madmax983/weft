struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn top(world: &World) { let first = &world.entities[0]; m19(world); print(first.hp) }
fn m19(w: &World) { m18(w) }
fn m18(w: &World) { m17(w) }
fn m17(w: &World) { m16(w) }
fn m16(w: &World) { m15(w) }
fn m15(w: &World) { m14(w) }
