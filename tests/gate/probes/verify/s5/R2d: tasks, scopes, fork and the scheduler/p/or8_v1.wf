struct C { k: u64, j: u64 }

fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}

fn show(x: u64) { print(x) }

// parent passes count by value to a function while the task writes it.
fn pass_value() / async {
    let count = 0
    scope { s =>
        s.spawn(|| count += 1)
        show(count)
    }
}

// parent borrows count while the task writes it.
fn borrow_whole() / async {
    let count = 0
    scope { s =>
        s.spawn(|| count += 1)
        let r = &count
        print(r)
    }
}

// parent compares count in an if.
fn if_cond() / async {
    let count = 0
    scope { s =>
        s.spawn(|| count += 1)
        if count > 0 { print(1) }
    }
}

// parent matches on count.
fn match_on() / async {
    let count = 0
    scope { s =>
        s.spawn(|| count += 1)
        match count { 0 => print(0), _ => print(1) }
    }
}

// interpolation
fn interp_str() / async {
    let count = 0
    scope { s =>
        s.spawn(|| count += 1)
        print("{count}")
    }
}

// parent shadows count with a read
fn shadow_read() / async {
    let count = 0
    scope { s =>
        s.spawn(|| count += 1)
        let count = count + 1
        print(count)
    }
}

// parent reads via a closure that it calls
fn closure_read() / async {
    let count = 0
    let g = || print(count)
    scope { s =>
        s.spawn(|| count += 1)
        g()
    }
}

// task calls closure f while parent sets f
fn task_calls_f() / async {
    let f = || print(1)
    scope { s =>
        s.spawn(|| f())
        f = || print(2)
    }
}

// whole struct read in parent via method-ish
fn struct_copy_field() / async {
    let c = C { k: 0, j: 0 }
    scope { s =>
        s.spawn(|| c = C { k: 1, j: 1 })
        print(c.k)
    }
}

// task writes via a whole-struct assignment while parent writes field j.
fn struct_assign_field() / async {
    let c = C { k: 0, j: 0 }
    scope { s =>
        s.spawn(|| c = C { k: 1, j: 1 })
        c.j = 5
    }
}

// tuple read
fn tuple_whole() / async {
    let t = (1, 2)
    scope { s =>
        s.spawn(|| t = (3, 4))
        let (a, b) = t
        print(a + b)
    }
}

// return value is the local
fn ret_local() -> u64 / async {
    let count = 0
    scope { s =>
        s.spawn(|| count += 1)
        count
    }
}

fn ret_local_w() / async { print(ret_local()) }

fn main() / async {
}
