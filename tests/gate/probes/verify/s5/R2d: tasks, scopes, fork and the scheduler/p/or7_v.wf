struct E { hp: u64 }
struct Pool { k: u64 }

fn par(f: fn(), g: fn()) / par { fork(f, g) }
fn bg(f: fn()) / async {
    scope { s =>
        s.spawn(f)
        s.spawn(f)
    }
}
fn fork_same(f: fn()) / par { fork(f, f) }
fn all(fs: Vec<fn()>) / async {
    scope { s =>
        let f = fs[0]
        let g = fs[1]
        s.spawn(f)
        s.spawn(g)
    }
}
fn opt(o: Option<fn()>) / async {
    match o {
        Some(f) => scope { s =>
            s.spawn(f)
            s.spawn(f)
        },
        None => (),
    }
}
impl Pool {
    fn run2(self, f: fn()) / async {
        scope { s =>
            s.spawn(f)
            s.spawn(f)
        }
    }
}
fn rec(f: fn(), k: u64) / async {
    if k > 0 {
        scope { s =>
            s.spawn(f)
            rec(f, k - 1)
        }
    }
}
fn spawn_in(s: Scope, f: fn()) / async { s.spawn(f) }

fn same_closure_twice() / par {
    let n = 0
    let c = || n += 1
    par(c, c)
}

fn fork_same_param() / par {
    let n = 0
    fork_same(|| n += 1)
}

fn via_vec() / async {
    let n = 0
    let fs = Vec.new()
    fs.push(|| n += 1)
    fs.push(|| n += 2)
    all(fs)
}

fn via_option() / async {
    let n = 0
    opt(Some(|| n += 1))
}

fn via_method() / async {
    let n = 0
    let p = Pool { k: 0 }
    p.run2(|| n += 1)
}

fn via_rec() / async {
    let n = 0
    rec(|| n += 1, 3)
}

fn via_scope_param() / async {
    let n = 0
    scope { s =>
        spawn_in(s, || n += 1)
        print(n)
    }
}

fn via_scope_param_twice() / async {
    let n = 0
    scope { s =>
        spawn_in(s, || n += 1)
        spawn_in(s, || n += 2)
    }
}

fn fork_rc_param() / par {
    let a = Rc.new(E { hp: 1 })
    fork_same(|| print(a.hp))
}

fn main() / par, async {
}
