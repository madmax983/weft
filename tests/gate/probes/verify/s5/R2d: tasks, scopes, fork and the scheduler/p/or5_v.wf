fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}
fn first(v: &Vec<u64>) -> &u64 in v[] { &v[0] }
fn grow(v: &Vec<u64>) / mut(v) { v.clear() }

// via get
fn via_get() / io {
    let v = mk_v()
    let r = v.get(0)
    scope { s =>
        let t = s.spawn(|| v.clear())
        r = v.get(1)
        t.join()
    }
    print(r + 1)
}

// via a callee that returns a ref
fn via_callee_ref() / io {
    let v = mk_v()
    let r = first(&v)
    scope { s =>
        let t = s.spawn(|| v.clear())
        r = first(&v)
        t.join()
    }
    print(r + 1)
}

// the task mutates through a callee
fn task_callee() / io {
    let v = mk_v()
    let r = &v[0]
    scope { s =>
        s.spawn(|| grow(&v))
        r = &v[1]
    }
    print(r + 1)
}

// nested task: the task spawns another task into s
fn nested_task() / io {
    let v = mk_v()
    let r = &v[0]
    scope { s =>
        let t = s.spawn(|| { s.spawn(|| v.clear()); () })
        t.join()
        r = &v[1]
    }
    print(r + 1)
}

// closure in parent makes the ref while the task runs
fn closure_borrow() / io {
    let v = mk_v()
    let w = mk_v()
    let r = &w[0]
    scope { s =>
        let g = || { r = &v[1] }
        let t = s.spawn(|| v.clear())
        g()
        t.join()
    }
    print(r + 1)
}

// for loop over v while the task clears it
fn iter_while_task() / io {
    let v = mk_v()
    scope { s =>
        s.spawn(|| v.clear())
        for x in v[] { print(x) }
    }
}

// whole borrow while task writes
fn whole_borrow() / io {
    let v = mk_v()
    let w = mk_v()
    let r = &w
    scope { s =>
        s.spawn(|| v.clear())
        r = &v
    }
    print(r[0])
}

// the task runs inside a nested scope; the borrow is in the outer scope after the inner ends
fn inner_scope_task() / io {
    let v = mk_v()
    let r = &v[0]
    scope { a =>
        scope { b =>
            a.spawn(|| v.clear())
        }
        r = &v[1]
    }
    print(r + 1)
}

// a task that is detached
fn detached() / io {
    let v = mk_v()
    let r = &v[0]
    scope { s =>
        let t = s.spawn(|| v.clear())
        t.detach()
        r = &v[1]
    }
    print(r + 1)
}

fn main() / io {
}
