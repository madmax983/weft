linear struct Tx { id: u64 }
    on abort = rollback
linear struct Lock { id: u64 }
linear struct Named { id: u64, name: Vec<u64> }
linear struct Holder { inner: Vec<u64>, tx: Tx }
fn rollback(tx: Tx) { print(tx.id); let Tx(i) = tx }
fn begin(n: u64) -> Tx { Tx { id: n } }
fn unlock(l: Lock) { let Lock(i) = l }
fn mk_v() -> Vec<u64> { let v = Vec.new(); v.push(1); v }
enum Slot { Full(Tx, Tx), Empty }
struct Two { a: Tx, b: Tx }
struct Outer { two: Two, n: u64 }
effect Stop { fn stop() }

fn linear_shell() {
    let t = Named { id: 1, name: mk_v() }
    let n = t.name
    print(n.len())
}
fn linear_shell_tx() {
    let h = Holder { inner: mk_v(), tx: begin(1) }
    let n = h.inner
    print(n.len())
}
fn nested_part() {
    let o = Outer { two: Two { a: begin(1), b: begin(2) }, n: 3 }
    rollback(o.two.a)
}
fn branch_part() {
    let c = true
    let t = (begin(1), begin(2))
    if c { rollback(t.0) } else { let (a, b) = t; rollback(a); rollback(b) }
}
fn loop_part() {
    let t = (begin(1), begin(2))
    let i = 0
    while i < 1 {
        i = i + 1
        rollback(t.0)
        break
    }
}
fn param_part(t: (Tx, Tx)) {
    rollback(t.0)
}
fn param_caller() {
    param_part((begin(1), begin(2)))
}
fn vec_elem() {
    let v = Vec.new()
    v.push(begin(1))
    v.push(begin(2))
    rollback(v[0])
}
fn option_part() {
    let o = (Some(begin(1)), begin(2))
    match o.0 { Some(x) => rollback(x), None => {} }
}
fn enum_payload() {
    let s = (Slot.Full(begin(1), begin(2)), 1)
    match s.0 { Slot.Full(a, b) => { rollback(a); rollback(b) }, Slot.Empty => {} }
}
fn refill_clean() {
    let t = (begin(1), begin(2))
    rollback(t.0)
    t.0 = begin(3)
    let (a, b) = t
    rollback(a)
    rollback(b)
}
fn box_part() {
    let b = Box.new((begin(1), begin(2)))
    rollback(b.0)
}
fn generic_pair<T>(p: (Tx, T)) {
    rollback(p.0)
}
fn generic_caller() {
    generic_pair((begin(1), Lock { id: 2 }))
}
fn tail_part() -> Tx {
    let t = (begin(1), begin(2))
    t.0
}
fn tail_caller() {
    rollback(tail_part())
}
fn main() {
    linear_shell()
}
