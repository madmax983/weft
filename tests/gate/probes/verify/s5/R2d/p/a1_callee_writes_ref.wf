// The callee runs f as a task and writes through x while it runs.
fn bg_write(f: fn(), x: &u64) / mut(x), async, clock {
    scope { s =>
        s.spawn(f)
        sleep(1.ms)
        x += 1
        sleep(1.ms)
    }
}

// The callee reads through x while the task of f writes.
fn bg_read(f: fn(), x: &u64) / async, clock {
    scope { s =>
        s.spawn(f)
        sleep(1.ms)
        print(x)
        sleep(1.ms)
    }
}

fn writer_param() / async, clock {
    let n = 0
    bg_write(|| { sleep(1.ms); print(n); sleep(1.ms); print(n) }, &n)
}

fn reader_param() / async, clock {
    let n = 0
    bg_read(|| { sleep(1.ms); n += 1; sleep(1.ms); n += 1 }, &n)
}

fn main() / async, clock {
    writer_param()
    reader_param()
}
