struct P { a: u64, b: u64 }

// The task makes a reference into a kept copy variable after its scope ends.
fn kept_ref() / async, clock {
    scope { s =>
        let x = 1
        s.spawn(|| { sleep(2.ms); let r = &x; print(r) })
    }
}

// The task holds a reference into a kept struct across the end.
fn kept_ref_early() / async, clock {
    scope { s =>
        let p = P { a: 1, b: 2 }
        s.spawn(|| { let r = &p.a; sleep(2.ms); print(r) })
    }
}

// The task writes the kept copy variable after its scope ends.
fn kept_write() / async, clock {
    scope { s =>
        let x = 1
        s.spawn(|| { sleep(2.ms); x += 1; print(x) })
    }
}

// Two tasks share the kept variable: one writes, one reads.
fn kept_two() / async, clock {
    scope { s =>
        let x = 1
        s.spawn(|| { sleep(2.ms); x += 1 })
        s.spawn(|| { sleep(2.ms); print(x) })
    }
}

fn main() / async, clock {
    kept_ref()
}
