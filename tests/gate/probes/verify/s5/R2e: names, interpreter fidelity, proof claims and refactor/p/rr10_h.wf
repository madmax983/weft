// Item value in a struct field, then a local.
fn diff(a: i32, b: i32) -> i32 { a - b }
fn rdiff(b: i32, a: i32) -> i32 { a - b }
struct H { f: fn(i32, i32) -> i32 }
fn main() {
    let h = H { f: rdiff }
    let g = h.f
    print(g(b: 10, a: 3))
    let k = diff
    k = h.f
    print(k(b: 10, a: 3))
}
