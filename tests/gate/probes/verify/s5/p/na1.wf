struct Entity { hp: i32 }
fn diff(a: i32, b: i32) -> i32 { a - b }
fn diff2(b: i32, a: i32) -> i32 { a - b }
fn show(e: &Entity, n: i32) { print("e.hp = {e.hp}, n = {n}") }
impl Entity {
    fn diff(self, a: i32, b: i32) -> i32 { a - b }
}
effect Ask { fn ask(q: u64) -> u64 }
fn get() -> fn(i32, i32) -> i32 { diff }

fn main() {
    let x = Entity { hp: 1 }
    let y = Entity { hp: 2 }
    // copy of an item value
    let h = diff
    let g = h
    print(g(b: 10, a: 3))
    // item value in closure body
    let c = || { let k = diff
 k(b: 10, a: 3) }
    print(c())
    // method of value in closure body
    let c2 = || x.diff(b: 10, a: 3)
    print(c2())
    // interpolation
    print("{x.diff(b: 10, a: 3)}")
    // in a handler clause
    let v = handle Ask { fn ask(q) { let kk = diff
 print(kk(b: 10, a: 3))
 resume(q) } } in ask(1)
    // function returned
    let r = get()
    print(r(3, 10))
    // reference receiver
    let rr = &x
    print(rr.diff(b: 10, a: 3))
    // loop
    let i = 0
    while i < 2 {
        let m = diff
        print(m(b: 10, a: 3))
        i = i + 1
    }
}
