linear struct Tx { id: u64 }
    on abort = rollback
fn rollback(t: Tx) { let Tx(id) = t; print("rollback {id}") }
fn commit(t: Tx) { let Tx(id) = t; print("commit {id}") }
effect Stop { fn stop() }

struct Box1 { f: fn() }

fn main() / io {
    let r = handle Stop { fn stop() { None } } in {
        let tx = Tx { id: 1 }
        let f = || commit(tx)
        let b = Some(f)
        b
    }
    match r {
        Some(f) => f(),
        None => print("none"),
    }
    print("end")
}
