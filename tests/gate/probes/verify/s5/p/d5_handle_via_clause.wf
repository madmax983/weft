linear struct Tx { id: u64 }
    on abort = rollback
fn rollback(t: Tx) { let Tx(id) = t; print("rollback {id}") }
fn commit(t: Tx) { let Tx(id) = t; print("commit {id}") }
effect Give { fn give(t: Task<Tx>) }

fn main() / io, async {
    let r = handle Give { fn give(t) { Some(t) } } in {
        scope { s =>
            let t = s.spawn(|| Tx { id: 1 })
            sleep(5.ms)
            give(t)
            None
        }
    }
    match r {
        Some(t) => commit(t.join()),
        None => print("none"),
    }
    print("end")
}
