effect Stop { fn stop() }
linear struct Tx { id: u64 }
fn begin() -> Tx { Tx { id: 1 } }
fn commit(t: Tx) { let Tx(i) = t; print("commit {i}") }

fn run_bg<T>(mk: fn() -> T, k: fn(T)) / async, Stop, clock {
    scope { s =>
        let t = s.spawn(mk)
        sleep(5.ms)
        stop()
        k(t.join())
    }
}

fn caller() / async, Stop, clock {
    run_bg(begin, commit)
}

fn main() / async, clock {
    handle Stop { fn stop() { print("stopped") } } in caller()
    print("end")
}
