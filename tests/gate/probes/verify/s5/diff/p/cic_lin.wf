effect Log { fn log(msg: String) }
effect Op { fn op() }
linear struct Tx { id: u64 }
    on abort = rollback
fn rollback(t: Tx) { let Tx(i) = t; print("rollback") }
fn commit(t: Tx) { let Tx(i) = t; print("commit") }
fn begin() -> Tx { Tx { id: 1 } }

fn cic() {
    let t = begin()
    handle Op { fn op() { print(9) } } in {
        handle Log { fn log(m) { op(); resume(()) } } in {
            log("x")
            commit(t)
        }
    }
}
fn main() { cic() }
