// on abort calls closures from a Vec of fn() in its value.
effect Ask { fn ask() -> u64 }
effect Stop { fn stop() }
linear struct T { fs: Vec<fn()> }
    on abort = undo
fn undo(t: T) {
    let T(fs) = t
    let f = fs[0]
    f()
}
fn done(t: T) { let T(fs) = t }
fn main() {
    handle Ask { fn ask() { resume(5) } } in {
        handle Stop { fn stop() { () } } in {
            let v: Vec<fn()> = Vec.new()
            v.push(|| print(ask()))
            let t = T { fs: v }
            stop()
            done(t)
        }
    }
}
