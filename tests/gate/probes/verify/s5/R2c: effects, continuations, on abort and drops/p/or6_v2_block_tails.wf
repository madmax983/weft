// A place as the tail of a block whose value is discarded.
linear struct Tx { id: u64 }
fn commit(t: Tx) { let Tx(id) = t }
fn loop_tail() {
    let v = Vec.new()
    v.push(1)
    for i in 0..2 { v }
    print(v.len())
}
fn while_tail() {
    let v = Vec.new()
    v.push(1)
    let i = 0
    while i < 2 { i += 1; v }
    print(v.len())
}
fn block_stmt() {
    let v = Vec.new()
    v.push(1)
    { v }
    print(v.len())
}
fn block_linear() {
    let t = Tx { id: 1 }
    { t }
    commit(t)
}
fn loop_linear() {
    let t = Tx { id: 1 }
    loop { t; break }
    commit(t)
}
fn block_dangling() {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    { v }
    print(r + 1)
}
fn main() {
    loop_tail()
}
