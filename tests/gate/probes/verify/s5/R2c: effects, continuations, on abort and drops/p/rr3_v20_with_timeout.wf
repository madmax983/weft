// A clause resumes inside with_timeout; the deadline aborts the rest of the body.
effect Ask { fn ask() -> u64 }
linear struct T { id: u64 }
fn done(t: T) { let T(i) = t }
fn main() / clock, fail {
    let r = handle Ask {
        fn ask() {
            with_timeout(5.ms) { resume(1) }
        }
    } in {
        let a = ask()
        sleep(10.ms)
        a + 1
    }
    print(r)
}
