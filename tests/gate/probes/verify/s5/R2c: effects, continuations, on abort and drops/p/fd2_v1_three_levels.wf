// Three multi handlers nested: the clauses of Pick and Pick2 each hold their
// continuation while they perform the outer operation.
effect Choice { multi fn choose() -> bool }
effect Pick { multi fn pick() -> u64 }
effect Pick2 { multi fn pick2() -> u64 }

fn body2() -> u64 / Pick2 { pick2() + 100 }
fn body() -> u64 / Pick, Choice {
    handle Pick2 {
        fn pick2() {
            let p = pick()
            if p == 0 { 0 } else { resume(p) }
        }
    } in body2()
}
fn run() -> u64 / Choice {
    handle Pick {
        fn pick() {
            let b = choose()
            if b { 0 } else { resume(10) }
        }
    } in body()
}
fn main() {
    let out: Vec<u64> = Vec.new()
    handle Choice { fn choose() { resume(true); resume(false); resume(false) } } in out.push(run())
    print(out)
}
