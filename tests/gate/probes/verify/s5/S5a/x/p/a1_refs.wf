effect Note { fn note(x: u64) }
struct Job { f: fn() }

fn start_refs(v: &Vec<&Job>) / async {
    scope { s =>
        let t = s.spawn(v[0].f)
        t.join()
    }
}
fn p_refs() / async {
    handle Note { fn note(x) { print(x)
 resume(()) } } in {
        let j = Job { f: || note(2) }
        let v = Vec.new()
        v.push(&j)
        start_refs(&v)
    }
}
fn main() / async { p_refs() }
