effect Note { fn note(x: u64) }
struct Job { f: fn() }

fn start_gen<T>(x: &T, run: fn(&T)) / async {
    scope { s =>
        let t = s.spawn(|| run(x))
        t.join()
    }
}
fn run_job(j: &Job) { let g = j.f
 g() }
fn p_gen() / async {
    handle Note { fn note(x) { print(x)
 resume(()) } } in {
        let j = Job { f: || note(6) }
        start_gen(&j, run_job)
    }
}
fn main() / async { p_gen() }
