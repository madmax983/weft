linear struct Lock { id: u64 }
fn unlock(l: Lock) { print("unlocked")
 let Lock(i) = l }
fn lock() -> Lock { print("locked")
 Lock { id: 1 } }
fn hold_fail<T>(x: T) -> T / fail { fail("boom")
 x }
fn apply<T>(x: T, f: fn(T) -> T / fail) -> T / fail { f(x) }
fn apply_lock(x: Lock, f: fn(Lock) -> Lock / fail) -> Lock / fail { f(x) }

fn g_apply() / fail {
    let m = apply(lock(), hold_fail)
    unlock(m)
}
fn g_apply_lock() / fail {
    let m = apply_lock(lock(), hold_fail)
    unlock(m)
}
fn g_value() / fail {
    let h = hold_fail
    let m = h(lock())
    unlock(m)
}
fn main() {
    handle Fail { fn fail(m) { print(m) } } in g_apply()
}
