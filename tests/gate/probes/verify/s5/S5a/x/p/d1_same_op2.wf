effect Pick { fn pick(i: u64) -> &u64 }

fn picks_twice() / Pick {
    let r = pick(0)
    let r2 = pick(1)
    print(r)
}
fn d_caller_handler() {
    let v = Vec.new()
    v.push(1)
    let w = Vec.new()
    w.push(2)
    handle Pick { fn pick(i) {
        if i == 1 { v.clear() }
        resume(&w[0])
    } } in picks_twice()
}
fn d_caller_handler_v() {
    let v = Vec.new()
    v.push(1)
    handle Pick { fn pick(i) {
        if i == 1 { v.clear() 
 v.push(5) }
        resume(&v[0])
    } } in picks_twice()
}
fn main() { d_caller_handler() }
