effect Note { fn note(x: u64) }
struct Job { f: fn() }

fn get(j: &Job) -> fn() { j.f }
fn start_get(j: &Job) / async {
    scope { s =>
        let t = s.spawn(get(j))
        t.join()
    }
}
fn p_get() / async {
    handle Note { fn note(x) { print(x)
 resume(()) } } in {
        let j = Job { f: || note(4) }
        start_get(&j)
    }
}
fn main() / async { p_get() }
