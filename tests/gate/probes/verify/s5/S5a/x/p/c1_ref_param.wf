effect Note { fn note(x: u64) }
effect RegR { fn regr(j: &Job) }
struct Job { f: fn() }

fn p_ref_param() {
    let keep = || print(0)
    handle Note { fn note(x) { print(x)
 resume(()) } } in {
        handle RegR { fn regr(j) { keep = j.f
 resume(()) } } in {
            let j = Job { f: || note(5) }
            regr(&j)
        }
    }
    keep()
}
fn p_ref_param_field() {
    let keep = Job { f: || print(0) }
    handle Note { fn note(x) { print(x)
 resume(()) } } in {
        handle RegR { fn regr(j) { keep.f = j.f
 resume(()) } } in {
            let j = Job { f: || note(6) }
            regr(&j)
        }
    }
    let g = keep.f
    g()
}
fn main() { p_ref_param() 
 p_ref_param_field() }
