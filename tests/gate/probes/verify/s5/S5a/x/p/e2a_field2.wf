struct Stats { count: u64 }
struct Job { f: fn() }
fn twice(g: fn()) { g()
 g() }
fn s_field_local(st: &Stats) / mut(st), async {
    scope { s =>
        let j = Job { f: || { s.spawn(|| { st.count += 1; print(st.count) }); () } }
        let g = j.f
        twice(g)
    }
}
fn s_vec(st: &Stats) / mut(st), async {
    scope { s =>
        let v = Vec.new()
        v.push(|| { s.spawn(|| { st.count += 1; print(st.count) }); () })
        twice(v[0])
    }
}
fn main() / async {
    let st = Stats { count: 0 }
    s_field_local(&st)
    s_vec(&st)
}
