linear struct Lock { id: u64 }
fn unlock(l: Lock) { let Lock(i) = l }
fn lock() -> Lock { Lock { id: 1 } }
extern fn drop_ext<T>(x: T)
extern fn hold_ext<T>(x: T) -> T / fail
extern fn hold_multi_ext<T>(x: T) -> T / Choice
effect Choice { multi fn choose() -> bool }
fn g_drop() { drop_ext(lock()) }
fn g_hold() / fail { let m = hold_ext(lock())
 unlock(m) }
fn g_multi() / Choice { let m = hold_multi_ext(lock())
 unlock(m) }
fn main() {}
