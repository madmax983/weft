// RR2 shapes that still slip: two closures meet in one type inside a tuple
// (the element type of a Vec or an array, or a new value of a tuple local).
// 0 errors at head; each test faults (oracle: dangling).
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
fn mkw() -> World {
    let w = World { entities: Vec.new() }
    w.entities.push(Entity { hp: 1 })
    w
}
fn tuple_elems(world: &World) / mut(world.entities) {
    let first = &world.entities[0]
    let v = Vec.new()
    v.push((1, || print(1)))
    v.push((2, || world.entities.clear()))
    let (n, g) = v[1]
    g()
    print(first.hp)        // expected W0301
}
fn tuple_array(world: &World) / mut(world.entities) {
    let first = &world.entities[0]
    let a = [(1, || print(1)), (2, || world.entities.clear())]
    let (n, g) = a[1]
    g()
    print(first.hp)        // expected W0301
}
fn tuple_reassign(world: &World) / mut(world.entities) {
    let first = &world.entities[0]
    let t = (1, || print(1))
    t = (2, || world.entities.clear())
    let (n, g) = t
    g()
    print(first.hp)        // expected W0301
}
test "tuple_elems" { let w = mkw()
 tuple_elems(&w) }
test "tuple_array" { let w = mkw()
 tuple_array(&w) }
test "tuple_reassign" { let w = mkw()
 tuple_reassign(&w) }
