// RR2 missed shape: function values that meet in a tuple type (a tuple local,
// a tuple part, a Vec of tuples, a tuple in a generic field). The tuple type
// holds the function types directly, not type variables, so no join happens.
// Expected: W0301 at print(first.hp). HEAD: 0 errors, each faults.
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
struct Wrap<T> { x: T }
fn mkw() -> World {
    let w = World { entities: Vec.new() }
    w.entities.push(Entity { hp: 1 })
    w
}
fn tuple_part() {
    let world = mkw()
    let first = &world.entities[0]
    let t = (|| print(1), 1)
    t.0 = || world.entities.clear()
    let g = t.0
    g()
    print(first.hp)
}
fn tuple_whole() {
    let world = mkw()
    let first = &world.entities[0]
    let t = (|| print(1), 1)
    t = (|| world.entities.clear(), 2)
    let g = t.0
    g()
    print(first.hp)
}
fn tuple_in_vec() {
    let world = mkw()
    let first = &world.entities[0]
    let v = Vec.new()
    v.push((|| print(1), 1))
    v.push((|| world.entities.clear(), 2))
    let g = v[1].0
    g()
    print(first.hp)
}
fn wrap_tuple_part() {
    let world = mkw()
    let first = &world.entities[0]
    let w = Wrap { x: (|| print(1), 1) }
    w.x.0 = || world.entities.clear()
    let g = w.x.0
    g()
    print(first.hp)
}
fn main() {
    tuple_part()
}
