linear struct Tx { id: u64 }
fn commit(t: Tx) { let Tx(id) = t; print("commit {id}") }

fn match_tail(c: bool) {
    let t = Tx { id: 1 }
    match c { true => t, false => t }
    commit(t)
}
fn while_tail() {
    let t = Tx { id: 1 }
    let i = 0
    while i < 1 { i += 1; t }
    commit(t)
}
fn vec_block_tail() {
    let v: Vec<u64> = Vec.new()
    v.push(1)
    let r = &v[0]
    { v }
    print(r + 1)
}
fn handle_tail() {
    let t = Tx { id: 1 }
    handle Fail { fn fail(m) { () } } in { t }
    commit(t)
}
fn main() {
    vec_block_tail()
}
