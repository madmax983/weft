fn g39(w: &World) / mut(w.entities) { w.entities.push(Entity { hp: 39 }) }
fn run(cb: &Cb, w: &World) { let h = cb.f; h(w) }
fn big(world: &World, c: u64) / mut(world.entities) {
    let g = g0
