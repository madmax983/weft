struct Buf { items: Vec<u64> }
fn eat(b: Buf) {}
effect Run { fn run(f: fn()) }
fn o01() / Run {
    let b = Buf { items: Vec.new() }
    run(|| eat(b))
}
fn o02() {
    let b = Buf { items: Vec.new() }
    let f = || eat(b)
    loop { f()
 break }
}
fn o03(n: u32) {
    let b = Buf { items: Vec.new() }
    let f = || eat(b)
    for i in 0..n { f() }
}
fn twice(f: fn()) { f()
 f() }
fn pass(f: fn()) { twice(f) }
fn o04() {
    let b = Buf { items: Vec.new() }
    pass(|| eat(b))
}
fn store(f: fn()) -> fn() { f }
fn o05() {
    let b = Buf { items: Vec.new() }
    let g = store(|| eat(b))
    g()
    g()
}
struct Holder { f: fn() }
fn o06() {
    let b = Buf { items: Vec.new() }
