    let g = || { f()
 f() }
}
fn apply(f: fn()) { f() }
fn o10() {
    let b = Buf { items: Vec.new() }
    let f = || eat(b)
    apply(f)
    apply(f)
}
fn twice_item(f: fn()) { let g = f
 g()
 g() }
fn o11() {
    let b = Buf { items: Vec.new() }
