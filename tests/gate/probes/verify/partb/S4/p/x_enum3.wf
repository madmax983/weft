enum E { V0, V1, V2, V3, V4, V5, V6, V7, V8, V9, V10, V11, V12, V13, V14, V15, V16, V17, V18, V19, V20, V21, V22, V23, V24, V25, V26, V27, V28, V29 }
fn f(a: E, b: E, c: E) -> u64 {
    match (a, b, c) {
        (E.V0, _, _) => 0,
        (E.V1, _, _) => 1,
        (E.V2, _, _) => 2,
        (E.V3, _, _) => 3,
        (E.V4, _, _) => 4,
        (E.V5, _, _) => 5,
        (E.V6, _, _) => 6,
        (E.V7, _, _) => 7,
        (E.V8, _, _) => 8,
        (E.V9, _, _) => 9,
        (E.V10, _, _) => 10,
        (E.V11, _, _) => 11,
        (E.V12, _, _) => 12,
        (E.V13, _, _) => 13,
        (E.V14, _, _) => 14,
        (E.V15, _, _) => 15,
        (E.V16, _, _) => 16,
        (E.V17, _, _) => 17,
        (E.V18, _, _) => 18,
        (E.V19, _, _) => 19,
        (E.V20, _, _) => 20,
        (E.V21, _, _) => 21,
        (E.V22, _, _) => 22,
        (E.V23, _, _) => 23,
        (E.V24, _, _) => 24,
        (E.V25, _, _) => 25,
        (E.V26, _, _) => 26,
        (E.V27, _, _) => 27,
        (E.V28, _, _) => 28,
        (_, E.V0, E.V0) => 99,
    }
}
