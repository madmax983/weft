fn refs(v: &Vec<u64>) -> Vec<&u64> { let rs = Vec.new()
 rs.push(&v[0])
 rs }
fn q1() { let v: Vec<u64> = Vec.new()
 v.push(1)
 let rs = refs(&v)
 v.clear()
 for r in rs[] { print(r) } }
