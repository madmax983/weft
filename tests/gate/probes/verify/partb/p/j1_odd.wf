    put(b: 1, b: 2, a: 3, 4)
    put() { 5 }
    put(1, 2) { 3 }
    put(c: 1) { 2 }
    z(1)
    z() { 1 }
    fork()
    fork() { 1 }
    scope { s => s.spawn() }
    scope { s => s.spawn(|| 1) { 2 } }
    let f = || { return; return }
