    loop { let h = || { loop { break }; return 1 }; break }
    handle Z { fn z() { let k = || { return resume(()) }; k() } } in z()
    handle Z { fn z() { loop { break }; resume(()) } } in { loop { z(); break } }
    while true { handle Z { fn z() { resume(()) } } in { let q = || { break } } }
}
