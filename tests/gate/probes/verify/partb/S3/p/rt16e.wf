fn get_f(c: Cb) -> fn() { c.f }
fn first(v: Vec<fn()>) -> fn() { let f = v.pop(); match f { Some(g) => g, None => || print(0) } }
fn e1() {
    let out = Cb { f: || print(0) }
    handle Log { fn log(m) { resume(()) } } in {
        let cb = Cb { f: || log("x") }
        out = id_cb(cb)     // W0313
    }
}
fn e2() {
    let out = || print(0)
    handle Log { fn log(m) { resume(()) } } in {
        let cb = Cb { f: || log("x") }
        out = get_f(cb)     // W0313
    }
}
fn e3() {
    let out = || print(0)
    handle Log { fn log(m) { resume(()) } } in {
        let o = Some(|| log("x"))
        out = match o { Some(f) => f, None => || print(0) }    // W0313
    }
}
