// The result of a call with no stated place points anywhere inside the
// reference arguments. Each such result is one place: a call result gets its
// own wildcard instance. A write through the result, also a write of a field,
// then follows rule 3 for references into the same result. Two results, or
// results of two iterations, can still be the same place (ADR 0003).
struct Entity { hp: i32, id: u64, kids: Vec<Entity> }
struct Inbox { items: Vec<u32>, n: u64 }

fn find(v: &Vec<Entity>, id: u64) -> Option<&Entity> {
    for e in v[] { if e.id == id { return Some(e) } }
    None
}

// Writes of a scalar field through the result do not invalidate it.
fn hit(v: &Vec<Entity>, id: u64) / mut(v..) {
    match find(v, id) {
        Some(e) => {
            e.hp -= 1
            e.hp -= 1
        }
        None => {}
    }
}

fn bump(choose: fn(&Vec<Inbox>) -> &Inbox, boxes: &Vec<Inbox>) / mut(boxes..) {
    let b = choose(boxes)
    b.n += 1
    b.n += 1
}

// A write below `boxes` does not invalidate the reference `boxes` itself.
fn count(choose: fn(&Vec<Inbox>) -> &Inbox, boxes: &Vec<Inbox>) / mut(boxes..) {
    let b = choose(boxes)
    b.items.push(1)
    print(boxes.len())
}

// Rule 3 inside one result: a push frees the elements of the result.
fn kids(v: &Vec<Entity>, id: u64) / mut(v..) {
    match find(v, id) {
        Some(e) => {
            let k = &e.kids[0]
            e.kids.push(Entity { hp: 1, id: 2, kids: Vec.new() })
            print(k.hp)   //~ W0301
        }
        None => {}
    }
}

// Two results can be one place, or one can be inside the other.
fn two(v: &Vec<Entity>) / mut(v..) {
    match find(v, 1) {
        Some(a) => match find(v, 2) {
            Some(b) => {
                let k = &a.kids[0]
                b.kids.clear()
                print(k.hp)   //~ W0301
            }
            None => {}
        },
        None => {}
    }
}

// The result of the iteration before can be inside the result of this one.
fn again(v: &Vec<Entity>, w: &Vec<Entity>, n: u64) / mut(v..) {
    let last = &w[0]
    let i = 0
    while i < n {
        match find(v, i) {
            Some(e) => {
                e.kids.clear()
                print(last.hp)   //~ W0301
                last = e
            }
            None => {}
        }
        i += 1
    }
}

// A result that a closure gives: each call of the closure gives another place.
fn closure_twice(v: &Vec<Entity>) / mut(v..) {
    let get = || find(v, 1)
    match get() {
        Some(a) => match get() {
            Some(b) => {
                let k = &a.kids[0]
                b.kids.clear()
                print(k.hp)   //~ W0301
            }
            None => {}
        },
        None => {}
    }
}

// A result with more than one reference is not one place.
fn all(v: &Vec<Entity>) -> Vec<&Entity> {
    let out = Vec.new()
    out.push(&v[0])
    out
}
fn both(v: &Vec<Entity>) / mut(v..) {
    let r = all(v)
    let a = r[0]
    let b = r[1]
    let k = &a.kids[0]
    b.kids.clear()
    print(k.hp)   //~ W0301
}

// After a `multi` operation the handled body runs again, and its locals keep
// their values from the run before. So a call result there is not one place:
// the result of the first run and of the second run can differ. In the second
// run `last` is the result of the first run, and the push through `e` can free
// it (ADR 0003, ADR 0005).
effect Choice { multi fn choose() -> bool }
fn pick(v: &Vec<Entity>, b: bool) -> Option<&Entity> {
    if b { Some(&v[0].kids[0]) } else { Some(&v[0]) }
}
fn twice(v: &Vec<Entity>, w: &Vec<Entity>) / mut(v.., w..) {
    let last = &w[0]
    handle Choice {
        fn choose() {
            resume(true)
            resume(false)
        }
    } in {
        let b = choose()
        match pick(v, b) {
            Some(e) => {
                let k = &last.hp
                e.kids.push(Entity { hp: 7, id: 9, kids: Vec.new() })
                print(k)   //~ W0301
                last = e
            }
            None => {}
        }
    }
}

// A task and its parent use two fields of one result: the steps below the
// result decide, so the footprints are separate.
fn split_fields(v: &Vec<Entity>) / mut(v..), async {
    match find(v, 1) {
        Some(e) => {
            scope { s =>
                let t = s.spawn(|| e.hp += 1)
                print(e.id)
                t.join()
            }
        }
        None => {}
    }
}

// The same field of one result.
fn same_field(v: &Vec<Entity>) / mut(v..), async {
    match find(v, 1) {
        Some(e) => {
            scope { s =>
                let t = s.spawn(|| e.hp += 1)
                print(e.hp)   //~ W0405
                t.join()
            }
        }
        None => {}
    }
}
