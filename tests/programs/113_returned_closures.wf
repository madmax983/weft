// A call result that can hold a function value points where the arguments can
// flow (ADR 0003): a returned closure can capture a reference argument. The
// callee states the places of its parameters that the closure captures
// (`ret_refs`). A function value that the body does not know can capture a
// place anywhere inside a reference argument. A call of the result uses these
// places.
fn reader(v: &Vec<u64>) -> fn() { || print(v.len()) }
fn elem_reader(r: &u64) -> fn() { || print(r + 1) }
fn take(v: Vec<u64>) {}
fn pass(f: fn()) -> fn() { f }

fn moved() {
    let v = Vec.new()
    v.push(1)
    let f = reader(&v)
    take(v)
    f()   //~ W0301
}
// The block value is held across the end of the block (ADR 0003).
fn scope_ended() {
    let f = {
        let v = Vec.new()
        v.push(1)
        reader(&v)   //~ W0301
    }
    f()
}
fn cleared() {
    let v = Vec.new()
    v.push(1)
    let f = elem_reader(&v[0])
    v.clear()
    f()   //~ W0301
}
fn plain_scope_ended() {
    let f = {
        let x = 5
        elem_reader(&x)   //~ W0301
    }
    f()
}
// A function argument flows into the result too.
fn passed_on() {
    let v = Vec.new()
    v.push(1)
    let r = &v[0]
    let f = pass(|| print(r + 1))
    v.clear()
    f()   //~ W0301
}
// A function value that the body does not know can return a closure too.
fn unknown_maker(mk: fn(&Vec<u64>) -> fn()) {
    let v = Vec.new()
    v.push(1)
    let f = mk(&v)
    v.clear()
    f()   //~ W0301
}

// A result that holds closures in a container, a part or a field. The
// callee puts the closure there after it makes the value.
struct Entity { hp: i32 }
struct World { entities: Vec<Entity> }
struct H { f: fn() }
struct Wrap<T> { x: T }
fn noop() { print(0) }
fn mkw() -> World {
    let w = World { entities: Vec.new() }
    w.entities.push(Entity { hp: 1 })
    w
}
fn vec_of(v: &Vec<u64>) -> Vec<fn()> {
    let o = Vec.new()
    o.push(|| print(v.len()))
    o
}
fn tuple_of(v: &Vec<u64>) -> (Vec<fn()>, u64) {
    let o = Vec.new()
    o.push(|| print(v.len()))
    (o, 1)
}
fn field_of(w: &World) -> H {
    let r = &w.entities[0]
    let h = H { f: noop }
    h.f = || print(r.hp)
    h
}
fn wrap_of(w: &World) -> Wrap<fn()> {
    let r = &w.entities[0]
    let h = Wrap { x: || print(0) }
    h.x = || print(r.hp)
    h
}
// A callee puts a closure behind a reference argument.
fn out(v: &Vec<u64>, o: &Vec<fn()>) / mut(o) { o.push(|| print(v.len())) }
fn out_elem(r: &u64, o: &Vec<fn()>) / mut(o) { o.push(|| print(r + 1)) }
fn in_vec() {
    let v = Vec.new()
    v.push(1)
    let fs = vec_of(&v)
    take(v)
    let f = fs[0]   //~ W0301
    f()
}
fn in_tuple() {
    let v = Vec.new()
    v.push(1)
    let (fs, n) = tuple_of(&v)
    take(v)
    let f = fs[0]   //~ W0301
    f()
}
fn in_field() {
    let w = mkw()
    let h = field_of(&w)
    w.entities.clear()
    let g = h.f   //~ W0301
    g()
}
fn in_wrap() {
    let w = mkw()
    let h = wrap_of(&w)
    w.entities.clear()
    let g = h.x   //~ W0301
    g()
}
fn out_param() {
    let v = Vec.new()
    v.push(1)
    let fs = Vec.new()
    out(&v, &fs)
    take(v)
    let f = fs[0]   //~ W0301
    f()
}
fn out_elem_param() {
    let fs = Vec.new()
    let v = Vec.new()
    v.push(1)
    out_elem(&v[0], &fs)
    v.clear()
    let f = fs[0]   //~ W0301
    f()
}

// Clean: each call runs before the move, the end of the scope or the change.
fn moved_after() {
    let v = Vec.new()
    v.push(1)
    let f = reader(&v)
    f()
    take(v)
}
fn cleared_after() {
    let v = Vec.new()
    v.push(1)
    let f = elem_reader(&v[0])
    f()
    v.clear()
}
// Clean: a value argument is a copy, so the result does not point into it.
fn counter(n: u64) -> fn() { || print(n) }
fn value_arg() {
    let x = 1
    let f = counter(x)
    x = 2
    f()
}
// Clean: the closure captures the reference `v`, not a place inside it.
fn stable_change() {
    let v = Vec.new()
    v.push(1)
    let f = reader(&v)
    v.push(2)
    f()
}

// Clean: the closures in the containers and fields run before the change.
fn held_before() {
    let v = Vec.new()
    v.push(1)
    let fs = vec_of(&v)
    let f = fs[0]
    f()
    let (gs, n) = tuple_of(&v)
    let g = gs[0]
    g()
    let hs = Vec.new()
    out(&v, &hs)
    let k = hs[0]
    k()
    // The container is made before the change of `v`: it points into `v[]`
    // only from the call on.
    let es = Vec.new()
    v.push(2)
    out_elem(&v[0], &es)
    let e = es[0]
    e()
    take(v)
    let w = mkw()
    let h = field_of(&w)
    let g = h.f
    g()
    let x = wrap_of(&w)
    let g = x.x
    g()
    w.entities.clear()
}

// The clean cases run.
fn main() {
    moved_after()
    cleared_after()
    value_arg()
    stable_change()
    held_before()
}
