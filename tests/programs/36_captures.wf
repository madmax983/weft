// A closure captures the variable, not a copy of its value. A captured copy
// value stays readable after its scope ends; another value goes away with its
// variable, also when the closure moves it.
struct Bag { items: Vec<u64> }

fn take_bag(b: Bag) -> usize { b.items.len() }

// A closure that captures a copy value can leave the scope of the value.
fn adder(n: u64) -> fn(u64) -> u64 { |x| x + n }
fn greeter(s: String) -> fn() -> String { || s }
fn block_copy() {
    let f = { let n: u64 = 5; || n + 1 }
    print(f())
}

// A closure that captures another value cannot.
fn ret_vec_closure(v: Vec<u64>) -> fn() -> usize { || v.len() }   //~ W0204
fn block_vec() {
    let f = {
        let v: Vec<u64> = Vec.new()
        // C3: the default marker is the ir result; old: is the old pipeline: ledger `changed`, stage F13 (R3RT5)
        || v.len()   //~ old: W0301
    }
    // C3: the default marker is the ir result; old: is the old pipeline: ledger `changed`, stage F13 (R3RT5)
    print(f())   //~ W0301 old:
}

// A closure that moves a capture takes it when it runs. Until then the
// variable holds it, so the closure cannot leave the scope of the variable.
// C3: the default marker is the ir result; old: is the old pipeline: ledger `changed`, stage F13 (R3RT5)
fn ret_moving_closure(b: Bag) -> fn() -> usize { || take_bag(b) }   //~ old: W0204
fn block_moving() {
    let f = {
        let b = Bag { items: Vec.new() }
        b.items.push(1)
        // C3: the default marker is the ir result; old: is the old pipeline: ledger `changed`, stage F13 (R3RT5)
        || take_bag(b)   //~ old: W0301
    }
    print(f())
}

// Controls: the moving closure runs in the scope of its capture.
fn moving_in_scope() {
    let b = Bag { items: Vec.new() }
    let f = || take_bag(b)
    print(f())
}
