// Plan stage R0z Z4 Part B: a resume point in a handled body inside the clause.
// The handled body of a local handler of the clause runs in the run of the
// clause. A `resume` there (also the `resume` of a closure that the handled
// body makes and runs) is a resume point of the clause: the rest of the
// handled body of the outer handler runs at that node. No code performs an
// operation of the local handler, so no clause of it runs. The probes
// `tests/gate/probes/fixes/r0z4pb/` run these forms with `main`.

effect Tick { fn tick() }

effect Peek { fn peek(r: &u64) }

effect Other { fn other() }

// The clause resumes in the handled body of a local handler. After the
// `handle`, the clause clears `v`, which the rest borrowed. The old pipeline
// does not see the `resume` in the handled body.
fn clears_after() {
    let u = Vec.new()
    u.push(7)
    let v = Vec.new()
    v.push(1)
    let keep = &u[0]
    handle Tick { fn tick() {
            handle Other { fn other() { resume(()) } } in {
                resume(())
            }
            v.clear()
        } } in {
        tick()
        keep = &v[0]
    }
    print(keep + 1)   //~ W0301 old:
}

// The parameter points into `w` of the handled body. The rest ends and frees
// `w`, then the clause reads the parameter.
fn param_after() {
    handle Peek { fn peek(r: &u64) {
            handle Other { fn other() { resume(()) } } in { resume(()) }
            print(r + 1)   //~ W0301
        } } in {
        let w = Vec.new()
        w.push(5)
        peek(&w[0])
    }
}

// Clean: the clause reads its parameter before the nested `handle`.
fn param_before() {
    handle Peek { fn peek(r: &u64) {
            print(r + 1)
            handle Other { fn other() { resume(()) } } in { resume(()) }
        } } in {
        let w = Vec.new()
        w.push(5)
        peek(&w[0])
    }
}

// The handled body makes and runs a closure that resumes (the copy of the
// closure body at its run is a resume point of the clause). A local of the
// handled body points into `w`, which the rest frees.
fn closure_inner_local() {
    handle Peek { fn peek(r: &u64) {
            handle Other { fn other() { resume(()) } } in {
                let q = r
                let k = || resume(())
                k()
                print(q + 1)   //~ W0301
            }
        } } in {
        let w = Vec.new()
        w.push(5)
        peek(&w[0])
    }
}

// Clean: two levels of handled bodies, and the value of the `resume` and of
// each `handle`.
fn two_levels() -> i64 {
    handle Tick { fn tick() {
            let x = handle Other { fn other() { resume(()) } } in {
                handle Fail { fn fail(m) { print(m); 0 } } in {
                    resume(())
                    5
                }
            }
            x + 1
        } } in {
        tick()
        2
    }
}

fn main() {
    clears_after()
    param_after()
    param_before()
    closure_inner_local()
    print(two_levels())
}
