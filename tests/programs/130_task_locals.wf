// A use of a whole local as a value reads the variable. A new value of a local
// writes the variable. A task and its parent must not do both at one time
// (W0405, ADR 0006). This holds for a reference local too: its variable holds
// the reference, not the value that it points to.
struct C { k: u64, j: u64 }

fn mk_v() -> Vec<u64> {
    let v = Vec.new()
    v.push(1)
    v.push(2)
    v
}

// The parent reads `count` while the task writes it.
fn parent_reads() / async {
    let count = 0
    scope { s =>
        s.spawn(|| count += 1)
        print(count)   //~ W0405
    }
}

// The parent writes `count` while the task reads it.
fn task_reads() / async {
    let count = 0
    scope { s =>
        s.spawn(|| print(count))
        count += 5   //~ W0405
    }
}

// The parent gives `count` a new value while the task reads it.
fn parent_rebinds() / async {
    let count = 0
    scope { s =>
        s.spawn(|| print(count))
        count = 7   //~ W0405
    }
}

// The parent reads the whole `Vec` while the task clears it.
fn whole_vec() / async {
    let v = mk_v()
    scope { s =>
        s.spawn(|| v.clear())
        print(v)   //~ W0405
    }
}

// The parent gives a reference local a new value while the task reads it.
fn ref_rebind() / async {
    let v = mk_v()
    let r = &v[0]
    scope { s =>
        s.spawn(|| print(r))
        r = &v[1]   //~ W0405
    }
}

// The task gives a reference local a new value while the parent reads it.
fn task_rebinds_ref() / async {
    let v = mk_v()
    let r = &v[0]
    scope { s =>
        s.spawn(|| r = &v[1])
        print(r)   //~ W0405
    }
}

// The parent reads the whole struct while the task writes one field.
fn whole_struct() / async {
    let c = C { k: 0, j: 0 }
    scope { s =>
        s.spawn(|| c.k += 1)
        let d = c   //~ W0405
    }
}

// The parent calls `f` while the task gives it a new value.
fn call_while_set() / async {
    let f = || print(1)
    scope { s =>
        s.spawn(|| f = || print(2))
        f()   //~ W0405
    }
}

// A fork branch reads `n` while the other one writes it.
fn fork_whole() / par {
    let n = 0
    fork(|| print(n), || n += 1)   //~ W0403 W0405
}

// A task keeps a copy variable that it captures, but not a reference into it
// (ADR 0006). The task borrows the variable, and the variable ends while the
// task runs.
fn task_borrows_kept() / async, clock {
    scope { s =>
        {
            let n = 5
            s.spawn(|| { let r = &n; sleep(1.ms); print(r) })
        }   //~ W0405
        print(1)
    }
}

fn show_later(r: &u64) / clock {
    sleep(1.ms)
    print(r)
}

// The task gives a reference into the kept variable to a callee.
fn task_lends_kept() / async, clock {
    scope { s =>
        {
            let n = 5
            s.spawn(|| show_later(&n))
        }   //~ W0405
        print(1)
    }
}

// The task borrows a field of a kept copy struct.
fn task_borrows_field() / async, clock {
    scope { s =>
        {
            let c = C { k: 1, j: 2 }
            s.spawn(|| { let r = &c.k; sleep(1.ms); print(r) })
        }   //~ W0405
        print(1)
    }
}

// The loop variable ends at the end of each iteration.
fn task_borrows_loop_var() / async, clock {
    scope { s =>
        let i = 0
        while i < 2 {
            let k = i
            s.spawn(|| { let r = &k; sleep(1.ms); print(r) })
            i += 1
        }   //~ W0405
    }
}

// Clean: the task reads the value of the kept variable after its end. A
// `match` of a copy value binds a copy.
fn task_reads_kept() / async, clock {
    scope { s =>
        {
            let n = 5
            let c = C { k: 1, j: 2 }
            let o = Some(C { k: 3, j: 4 })
            s.spawn(|| {
                sleep(1.ms)
                print(n)
                print(c.k)
                match o { Some(x) => print(x.k), None => () }
            })
        }
        print(1)
    }
}

// Clean: both read `count`.
fn both_read() / async {
    let count = 0
    scope { s =>
        s.spawn(|| print(count))
        print(count)
    }
}

// Clean: the task and the parent touch two fields of one local.
fn two_fields() / async {
    let c = C { k: 0, j: 0 }
    scope { s =>
        s.spawn(|| c.k += 1)
        c.j += 1
    }
}

// Clean: the task and the parent touch two fields through one reference.
fn two_fields_ref() / async {
    let c = C { k: 0, j: 0 }
    let r = &c
    scope { s =>
        s.spawn(|| r.k += 1)
        r.j += 1
    }
}

// Clean: the parent reads `count` after the join.
fn after_join() / async {
    let count = 0
    scope { s =>
        let t = s.spawn(|| count += 1)
        t.join()
        print(count)
    }
    count += 1
}

// Clean: a loop variable gets a new variable on each iteration, so a task of
// one iteration does not see the next value.
fn loop_vars() / async {
    let v = mk_v()
    scope { s =>
        for x in v[] {
            s.spawn(|| print(x))
        }
        let i = 0
        while i < 2 {
            let k = i
            s.spawn(|| print(k))
            i += 1
        }
    }
}

fn main() / async, clock {
    task_reads_kept()
    both_read()
    two_fields()
    two_fields_ref()
    after_join()
    loop_vars()
}
