// Plan stage R0z Z7: a `multi` clause runs a function value. If the value
// can resume more than once (it performs a `multi` operation of a handler of
// a caller), the node that runs the clause gets the re-entry of the clause
// frame (stage R0k-c2), and the rest of the clause runs again. If the value
// cannot resume more than once, the run is no row and no `multi` point. The
// probes `tests/gate/probes/fixes/r0z7/` run these forms with `main`.
effect Pick { multi fn pick() -> u64 }
effect Run { multi fn run(g: fn()) }
effect Calc { multi fn calc(n: u64, f: fn() -> u64) -> u64 }

// The value performs `pick`. A later `resume` of `pick` runs the clause
// again, after the rest of the function cleared `v`.
fn value_multi(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { g()
        print(r)   //~ W0301 old:
        resume(()) } } in { run(|| print(pick())) }
    v.clear()
}

// The same form. The rest of the function does not change `v`.
fn value_multi_ok(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { g()
        print(r)
        resume(()) } } in { run(|| print(pick())) }
    print(v.len())
}

// The clause runs the value after its `resume` (a row after the `resume`).
fn value_after_resume(v: &Vec<u64>) / Pick, mut(v) {
    let r = &v[0]
    handle Run { fn run(g) { resume(())   //~ W0301 old:
        g()
        print(r) } } in { run(|| print(pick())) }
    v.clear()
}

// A `once` closure that the clause runs after the value is live across it.
fn eat(w: Vec<u64>) { print(w.len()) }
fn once_after() / Pick {
    let w = Vec.new()
    let c = || eat(w)
    handle Run { fn run(g) { g()   //~ W0503
        c()
        resume(()) } } in { run(|| print(pick())) }
}

// The value does not resume more than once. The handled body changes `v`
// before it makes `r`, so the run of `g` between the two `resume`s reads a
// valid reference.
fn between_ok(v: &Vec<u64>) / mut(v) {
    handle Run { fn run(g) { resume(())
        g()
        resume(()) } } in {
        v.push(2)
        let r = &v[0]
        run(|| print(r))
    }
}

// The clause runs its parameter before each `resume`. The value does not
// resume more than once.
fn param_runs(v: &Vec<u64>) -> u64 {
    let r = &v[0]
    handle Calc { fn calc(n, f) { let a = resume(n + f())
        resume(a + f()) } } in {
        let x = calc(1) { print(r)
            10 }
        print(v.len())
        x
    }
}
