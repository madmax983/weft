// `!Move` passes through each part that holds a value inline: a struct field, a
// tuple part, an enum payload and a `Vec` element. A `Box` keeps its target in
// place. A self-reference field points into its own struct, and it has no value
// until the body gives it one.

struct Frame: !Move { buf: [u8; 4], cur: &u8 in self.buf[] }

struct Outer { f: Frame, n: u64 }
fn keep(o: Outer) {}
fn moves_outer() {
    let o = Outer { f: Frame { buf: [1, 2, 3, 4] }, n: 1 }
    keep(o)   //~ W0604
}
fn outer_in_place() {
    let o = Outer { f: Frame { buf: [1, 2, 3, 4] }, n: 1 }
    o.f.cur = &o.f.buf[0]
    print(o.f.cur)
}
fn take_opt(o: Option<Frame>) {}
fn in_option() {
    let o = Some(Frame { buf: [1, 2, 3, 4] })
    take_opt(o)   //~ W0604
}
fn in_tuple() {
    let t = (Frame { buf: [1, 2, 3, 4] }, 1)
    let u = t   //~ W0604
}

// A `Vec` moves its elements when its buffer grows.
fn in_vec() {
    let v = Vec.new()
    v.push(Frame { buf: [1, 2, 3, 4] })   //~ W0604
}
fn boxed(b: Box<Frame>) -> Box<Frame> { b }

// A self-reference field can point only into its own struct.
fn cur_outside() {
    let f = Frame { buf: [1, 2, 3, 4] }
    let v: Vec<u8> = Vec.new()
    v.push(1)
    f.cur = &v[0]   //~ W0605
    print(f.cur)
}
fn cur_inside() {
    let f = Frame { buf: [1, 2, 3, 4] }
    f.cur = &f.buf[1]
    print(f.cur)
}
fn cur_literal_outside(v: &Vec<u8>) {
    let f = Frame { buf: [1, 2, 3, 4], cur: &v[0] }   //~ W0605
}

// A place field that the literal does not give has no value yet.
fn cur_unset() {
    let f = Frame { buf: [1, 2, 3, 4] }
    print(f.cur)   //~ W0304
}
fn cur_unset_borrow() {
    let f = Frame { buf: [1, 2, 3, 4] }
    let r = &f   //~ W0304
}
fn cur_set_on_one_path(c: bool) {
    let f = Frame { buf: [1, 2, 3, 4] }
    if c { f.cur = &f.buf[0] }
    print(f.cur)   //~ W0304
}
fn buf_only() {
    let f = Frame { buf: [1, 2, 3, 4] }
    f.buf[0] = 9
    print(f.buf[1])
}
fn cur_set_then_borrow() {
    let f = Frame { buf: [1, 2, 3, 4] }
    f.cur = &f.buf[3]
    let r = &f
    print(r.cur)
}
impl Frame {
    fn peek(self) -> u8 { self.buf[0] }
}
fn method_before_set() {
    let f = Frame { buf: [1, 2, 3, 4] }
    let x = f.peek()   //~ W0304
}
fn method_after_set() {
    let f = Frame { buf: [1, 2, 3, 4] }
    f.cur = &f.buf[0]
    let x = f.peek()
}

// A value that no place held before is built in place. So a call result, a
// by-value parameter and a part of a literal have no value in a place field.
fn mk() -> Frame { Frame { buf: [1, 2, 3, 4] } }
fn from_call() {
    let f = mk()
    print(f.cur)   //~ W0304
}
fn from_call_set() {
    let f = mk()
    f.cur = &f.buf[0]
    print(f.cur)
}
fn nested_literal() {
    let o = Outer { f: Frame { buf: [1, 2, 3, 4] }, n: 1 }
    print(o.f.cur)   //~ W0304
}
fn tuple_literal() {
    let t = (Frame { buf: [1, 2, 3, 4] }, 1)
    print(t.0.cur)   //~ W0304
}
fn param_frame(f: Frame) {
    print(f.cur)   //~ W0304
}
fn param_frame_set(f: Frame) {
    f.cur = &f.buf[1]
    print(f.cur)
}

// A closure that reads a place field reads it where the closure is made.
fn closure_reads_unset() {
    let f = Frame { buf: [1, 2, 3, 4] }
    let c = || print(f.cur)   //~ W0304
    c()
}
fn closure_reads_set() {
    let f = Frame { buf: [1, 2, 3, 4] }
    f.cur = &f.buf[0]
    let c = || print(f.cur)
    c()
}
fn closure_reads_buf() {
    let f = Frame { buf: [1, 2, 3, 4] }
    let c = || print(f.buf[0])
    c()
}

// A branch value moves into the value of the `if`.
fn branch_moves(c: bool) {
    let a = Frame { buf: [1, 2, 3, 4] }
    let x = if c { a } else { Frame { buf: [5, 6, 7, 8] } }   //~ W0604
}
// `Box.new` and `Rc.new` build their argument in place on the heap.
fn boxed_in_place() {
    let b = Box.new(Frame { buf: [1, 2, 3, 4] })
    b.cur = &b.buf[0]
    print(b.cur)
}
