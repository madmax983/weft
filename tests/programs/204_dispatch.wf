// Plan stage R0z Z6: a run of a local that can hold closures of two or more
// origins gets a dispatch: a test of the closure for each group, and one arm
// for each group (a copy of the closure body, or the call for a closure that
// needs no copy). The probes `tests/gate/probes/fixes/r0z6/` run these forms
// with `main`.
struct H { f: fn() }
fn noop() {}
effect Run { fn run(g: fn()) }
effect Sw { fn sw() }

// A scope body gives `k` its second closure. The arm of the first closure is
// dead: the scope body writes `k` on each path.
fn scope_body() / async {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(0))
        scope { s => k = || run(|| print(r)) }
        k()
    }
    v.clear()
    let x = h.f   //~ W0301 old:
    x()   //~ W0301 old:
}

// A branch in the body of the run gives `k` its second closure.
fn branch(t: bool) {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(0))
        if t { k = || run(|| print(r)) }
        k()
    }
    v.clear()
    let x = h.f   //~ W0301 old:
    x()   //~ W0301 old:
}

// The same form, with a second closure that keeps no reference.
fn branch_ok(t: bool) {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(0))
        if t { k = || print(1) }
        k()
        print(r)
    }
    v.clear()
    let x = h.f
    x()
}

// The clause of `Sw` gives `k` its second closure (one direct perform before
// the run, the form of `u13`).
fn clause_write() {
    let v = Vec.new()
    v.push(1)
    let h = H { f: noop }
    handle Run { fn run(g) { h.f = g
        resume(()) } } in {
        let r = &v[0]
        let k = || run(|| print(0))
        handle Sw { fn sw() { k = || run(|| print(r))
            resume(()) } } in { sw() }
        k()
    }
    v.clear()
    let x = h.f   //~ W0301 old:
    x()   //~ W0301 old:
}

// A callee gives back one of two closures; its copy at the call makes both
// closures in the function.
fn mk(h: fn(), b: bool) -> fn() / Run {
    if b { || run(h) } else { || print(1) }
}
fn two_paths(t: bool) {
    let v = Vec.new()
    v.push(1)
    handle Run { fn run(g) { v.clear()
        resume(()) } } in {
        let c = mk(|| print(0), t)
        let r = &v[0]
        handle Run { fn run(g) { g()
            resume(()) } } in { c() }
        print(r)   //~ W0301
    }
}
